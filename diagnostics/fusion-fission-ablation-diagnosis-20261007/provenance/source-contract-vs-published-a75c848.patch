+static bool addWithoutOverflow(int64_t lhs, int64_t rhs, int64_t &result) {
+  if ((rhs > 0 && lhs > std::numeric_limits<int64_t>::max() - rhs) ||
+      (rhs < 0 && lhs < std::numeric_limits<int64_t>::min() - rhs))
+    return false;
+  result = lhs + rhs;
+  return true;
