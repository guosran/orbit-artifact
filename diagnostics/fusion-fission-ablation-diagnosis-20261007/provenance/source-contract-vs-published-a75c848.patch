+      lhs->getAttrs() != rhs->getAttrs() || lhs->getNumRegions() != 0 ||
+      rhs->getNumRegions() != 0 || lhs->getNumResults() != 1 ||
+      rhs->getNumResults() != 1 || lhs->getResult(0).getType() !=
