{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/guosran/orbit-artifact/schemas/candidate_result.schema.json",
  "title": "ORBIT layered candidate result",
  "type": "object",
  "required": ["workload_id", "semantic_graph_id", "resource_candidate_id", "spatial_candidate_id", "temporal_schedule_id", "replay_id", "evidence_class", "semantic_legal", "backend_legal", "artifact_available", "measurement_available", "status", "cost", "architecture_id", "fabric_capacity", "max_cgras_per_task"],
  "properties": {
    "workload_id": {"type": "string"},
    "semantic_graph_id": {"type": "string"},
    "resource_candidate_id": {"type": "string"},
    "spatial_candidate_id": {"type": "string"},
    "temporal_schedule_id": {"type": "string"},
    "replay_id": {"type": "string"},
    "evidence_class": {"enum": ["analytical_estimate", "predictor_estimate", "native_mapper_replay", "rtl_cycle_measurement", "host_semantic_execution"]},
    "semantic_legal": {"type": "boolean"},
    "backend_legal": {"type": "boolean"},
    "artifact_available": {"type": "boolean"},
    "measurement_available": {"type": "boolean"},
    "status": {"enum": ["accepted", "semantic_rejected", "backend_unsupported", "artifact_missing", "measurement_censored", "execution_failed", "not_selected", "selected"]},
    "cost": {"type": ["object", "null"]},
    "architecture_id": {"type": "string"},
    "fabric_capacity": {"type": "integer"},
    "max_cgras_per_task": {"type": "integer"}
  }
}
