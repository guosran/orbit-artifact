{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/guosran/orbit-artifact/schemas/semantic_summary.schema.json",
  "title": "ORBIT semantic summary",
  "type": "object",
  "required": ["schema", "attempted_actions", "unique_semantic_graphs", "graph_ids", "materialized_witnesses", "mlir_verified", "graph_fact_matches", "k_mode_counts", "fusion_mode_counts", "rejection_reasons", "coverage"],
  "properties": {
    "schema": {"const": "orbit-semantic-summary-v1"},
    "attempted_actions": {"type": "integer", "minimum": 0},
    "unique_semantic_graphs": {"type": "integer", "minimum": 0},
    "graph_ids": {"type": "array", "items": {"type": "string"}},
    "materialized_witnesses": {"type": "integer", "minimum": 0},
    "mlir_verified": {"type": "integer", "minimum": 0},
    "graph_fact_matches": {"type": "integer", "minimum": 0},
    "k_mode_counts": {"type": "object"},
    "fusion_mode_counts": {"type": "object"},
    "rejection_reasons": {"type": "object"},
    "coverage": {"type": "object"}
  }
}
