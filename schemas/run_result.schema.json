{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/guosran/orbit-artifact/schemas/run_result.schema.json",
  "title": "ORBIT semantic artifact run",
  "type": "object",
  "required": ["artifact_schema_version", "artifact_git_commit", "amoeba_git_commit", "start_time", "end_time", "hostname", "command", "status", "completed_stage", "optional_dependency_state", "output_paths"],
  "properties": {
    "artifact_schema_version": {"const": "orbit-semantic-artifact-v1"},
    "artifact_git_commit": {"type": ["string", "null"]},
    "amoeba_git_commit": {"type": "string", "minLength": 40, "maxLength": 40},
    "start_time": {"type": "string"},
    "end_time": {"type": ["string", "null"]},
    "hostname": {"type": "string"},
    "command": {"type": "array", "items": {"type": "string"}},
    "status": {"enum": ["incomplete", "completed"]},
    "completed_stage": {"enum": ["initialization", "enumeration", "witness", "numeric"]},
    "optional_dependency_state": {"enum": ["available", "optional_dependency_missing"]},
    "output_paths": {"type": "object"}
  }
}
