+namespace {
+std::string moduleBytes(ModuleOp module) {
+  std::string text;
+  llvm::raw_string_ostream stream(text);
+  module.print(stream, OpPrintingFlags().printGenericOpForm());
+  stream.flush();
+  return text;
+}
+std::string digest(StringRef text) {
+  return llvm::toHex(llvm::SHA256::hash(llvm::arrayRefFromStringRef(text)),
+                     true);
+}
+llvm::json::Array shapesJSON(ArrayRef<NeighborhoodShape> shapes) {
+  llvm::json::Array rows;
+  for (const auto &shape : shapes) {
+    llvm::json::Object row{
+        {"task", shape.task}, {"rows", shape.rows}, {"cols", shape.cols}};
+    if (!shape.axes.empty()) {
+      llvm::json::Array axes;
+      for (int64_t extent : shape.axes)
+        axes.push_back(extent);
+      row["axes"] = std::move(axes);
+    }
+    rows.push_back(std::move(row));
+  }
+  return rows;
+}
+std::string candidateKey(ModuleOp module, ArrayRef<NeighborhoodShape> shapes,
+                         const SourceSearchBackend &backend) {
+  // Keep every semantic attribute. Removing only source rewrite witnesses
+  // avoids evaluating identity actions repeatedly without erasing target facts.
+  OwningOpRef<ModuleOp> canonical = module.clone();
+  canonical->walk([&](Operation *op) {
+    SmallVector<StringAttr> removed;
+    for (auto attribute : op->getAttrs()) {
+      StringRef name = attribute.getName().strref();
+      if (name.starts_with("amoeba.fission.") ||
+          name.starts_with("amoeba.tiling.") ||
+          name.starts_with("amoeba.fusion."))
+        removed.push_back(attribute.getName());
+    }
+    for (auto name : removed)
+      op->removeAttr(name);
+  });
+  std::string text = moduleBytes(*canonical);
+  auto ordered = std::vector<NeighborhoodShape>(shapes.begin(), shapes.end());
+  std::sort(ordered.begin(), ordered.end(),
+            [](const auto &a, const auto &b) { return a.task < b.task; });
+  llvm::raw_string_ostream stream(text);
+  // Length-prefixed identities prevent delimiter-dependent collisions.
+  stream << '\n'
+         << backend.identity.size() << ':' << backend.identity << '\n'
+         << backend.capabilityIdentity.size() << ':'
+         << backend.capabilityIdentity << '\n'
+         << llvm::json::Value(shapesJSON(ordered));
+  stream.flush();
+  return digest(text);
+}
+// Round-robin families and their task scopes before applying a finite
+// evaluation quota. The full menu remains available; ordering is not legality.
+void fairProposals(std::vector<NeighborhoodAction> &actions, uint64_t round) {
+  std::map<std::string, std::map<std::string, std::vector<NeighborhoodAction>>>
+      groups;
+  const size_t count = actions.size();
+  for (auto &action : actions) {
+    std::string scope = action.shapeTask;
+    if (scope.empty() && !action.primitives.empty())
+      scope = action.primitives.front().firstTask;
+    groups[action.family][scope].push_back(std::move(action));
+  }
+  struct Queue {
+    std::vector<std::vector<NeighborhoodAction>> scopes;
+    std::vector<size_t> positions;
+    size_t cursor = 0;
+  };
+  std::vector<Queue> families;
+  for (auto &family : groups) {
+    Queue queue;
+    for (auto &scope : family.second)
+      queue.scopes.push_back(std::move(scope.second));
+    queue.positions.resize(queue.scopes.size());
+    queue.cursor = round % queue.scopes.size();
+    families.push_back(std::move(queue));
+  }
+  if (families.empty())
+    return;
+  std::rotate(families.begin(), families.begin() + round % families.size(),
+              families.end());
+  actions.clear();
+  actions.reserve(count);
+  while (actions.size() < count)
+    for (auto &family : families)
+      for (size_t tries = 0; tries < family.scopes.size(); ++tries) {
+        size_t scope = family.cursor;
+        family.cursor = (scope + 1) % family.scopes.size();
+        if (family.positions[scope] < family.scopes[scope].size()) {
+          actions.push_back(
+              std::move(family.scopes[scope][family.positions[scope]++]));
+          break;
+        }
+      }
+}
+struct State {
+  OwningOpRef<ModuleOp> module;
+  std::vector<NeighborhoodShape> shapes;
+  std::vector<NeighborhoodAction> history;
+  double cost = 0;
+  std::string key;
+};
+} // namespace
+
+llvm::json::Value serializeSourceSearchReplay(
+    StringRef function, StringRef backendIdentity, StringRef capabilityIdentity,
+    ArrayRef<NeighborhoodAction> actions, ArrayRef<NeighborhoodShape> shapes) {
+  llvm::json::Array rows;
+  for (const auto &action : actions) {
+    llvm::json::Array primitives;
+    for (const auto &primitive : action.primitives) {
+      llvm::json::Array nodes;
+      for (unsigned node : primitive.leftNodes)
+        nodes.push_back(static_cast<int64_t>(node));
+      primitives.push_back(
+          llvm::json::Object{{"kind", primitive.kind},
+                             {"first_task", primitive.firstTask},
+                             {"second_task", primitive.secondTask},
+                             {"mode", primitive.mode},
+                             {"axis", primitive.axis},
+                             {"factor", primitive.factor},
+                             {"left_nodes", std::move(nodes)}});
+    }
+    rows.push_back(
+        llvm::json::Object{{"family", action.family},
+                           {"label", action.label},
+                           {"primitives", std::move(primitives)},
+                           {"shape_task", action.shapeTask},
+                           {"shape_rows", action.shapeRows},
+                           {"shape_cols", action.shapeCols},
+                           {"canonical_reset", action.canonicalReset}});
+  }
+  return llvm::json::Object{
+      {"schema", "orbit-taskflow-source-search-replay-v2"},
+      {"function", function.str()},
+      {"backend", backendIdentity.str()},
+      {"capability", capabilityIdentity.str()},
+      {"actions", std::move(rows)},
+      {"shapes", shapesJSON(shapes)}};
+}
+
+LogicalResult parseSourceSearchReplay(const llvm::json::Value &record,
+                                      std::string &function,
+                                      std::string &backendIdentity,
+                                      std::string &capabilityIdentity,
+                                      std::vector<NeighborhoodAction> &actions,
+                                      std::vector<NeighborhoodShape> &shapes,
+                                      std::string &error) {
+  error.clear();
+  auto fail = [&] {
+    error = "malformed source search replay record";
+    return failure();
+  };
+  auto *root = record.getAsObject();
+  if (!root || (root->size() != 6 && root->size() != 7) ||
+      (root->getString("schema") != "orbit-taskflow-source-search-replay-v1" &&
+       root->getString("schema") != "orbit-taskflow-source-search-replay-v2"))
+    return fail();
+  if (root->size() == 7) {
+    auto binding = root->getString("source_fingerprint");
+    if (!binding || binding->size() != 64 ||
+        !llvm::all_of(*binding, [](char c) { return llvm::isHexDigit(c); }))
+      return fail();
+  }
+  auto fn = root->getString("function"), backend = root->getString("backend"),
+       capability = root->getString("capability");
+  auto *rows = root->getArray("actions"), *resources = root->getArray("shapes");
+  if (!fn || fn->empty() || !backend || backend->empty() || !capability ||
+      capability->empty() || !rows || !resources)
+    return fail();
+  std::vector<NeighborhoodAction> parsedActions;
+  std::vector<NeighborhoodShape> parsedShapes;
+  for (const auto &value : *rows) {
+    auto *row = value.getAsObject();
+    if (!row || row->size() != 7)
+      return fail();
+    auto family = row->getString("family"), label = row->getString("label"),
+         shapeTask = row->getString("shape_task");
+    auto shapeRows = row->getInteger("shape_rows"),
+         shapeCols = row->getInteger("shape_cols");
+    auto reset = row->getBoolean("canonical_reset");
+    auto *primitives = row->getArray("primitives");
+    if (!family || !label || !shapeTask || !shapeRows || !shapeCols || !reset ||
+        !primitives || *reset)
+      return fail();
+    NeighborhoodAction action;
+    action.family = family->str();
+    action.label = label->str();
+    action.shapeTask = shapeTask->str();
+    action.shapeRows = *shapeRows;
+    action.shapeCols = *shapeCols;
+    for (const auto &primitiveValue : *primitives) {
+      auto *primitive = primitiveValue.getAsObject();
+      if (!primitive || primitive->size() != 7)
+        return fail();
+      auto kind = primitive->getString("kind"),
+           first = primitive->getString("first_task"),
+           second = primitive->getString("second_task"),
+           mode = primitive->getString("mode");
+      auto axis = primitive->getInteger("axis"),
+           factor = primitive->getInteger("factor");
+      auto *nodes = primitive->getArray("left_nodes");
+      if (!kind || kind->empty() || !first || !second || !mode || !axis ||
+          !factor || !nodes)
+        return fail();
+      NeighborhoodPrimitive parsed;
+      parsed.kind = kind->str();
+      parsed.firstTask = first->str();
+      parsed.secondTask = second->str();
+      parsed.mode = mode->str();
+      parsed.axis = *axis;
+      parsed.factor = *factor;
+      for (const auto &node : *nodes) {
+        auto ordinal = node.getAsInteger();
+        if (!ordinal || *ordinal < 0 ||
+            static_cast<uint64_t>(*ordinal) >
+                std::numeric_limits<unsigned>::max())
+          return fail();
+        parsed.leftNodes.push_back(*ordinal);
+      }
+      action.primitives.push_back(std::move(parsed));
+    }
+    parsedActions.push_back(std::move(action));
+  }
+  std::set<std::string> names;
+  for (const auto &resource : *resources) {
+    auto *row = resource.getAsObject();
+    if (!row || (row->size() != 3 && row->size() != 4))
+      return fail();
+    auto task = row->getString("task");
+    auto rows = row->getInteger("rows"), cols = row->getInteger("cols");
+    if (!task || task->empty() || !rows || !cols || *rows <= 0 || *cols <= 0 ||
+        !names.insert(task->str()).second)
+      return fail();
+    NeighborhoodShape shape{task->str(), *rows, *cols};
+    if (row->size() == 4) {
+      auto *axes = row->getArray("axes");
+      if (!axes || axes->empty())
+        return fail();
+      for (const auto &extent : *axes) {
+        auto integer = extent.getAsInteger();
+        if (!integer || *integer <= 0)
+          return fail();
+        shape.axes.push_back(*integer);
+      }
+      if (!shape.validMirror())
+        return fail();
+    }
+    parsedShapes.push_back(std::move(shape));
+  }
+  function = fn->str();
+  backendIdentity = backend->str();
+  capabilityIdentity = capability->str();
+  actions = std::move(parsedActions);
+  shapes = std::move(parsedShapes);
+  return success();
+}
+
+LogicalResult searchTaskflowSource(ModuleOp parent, StringRef function,
+                                   ArrayRef<NeighborhoodShape> initialShapes,
+                                   const SourceSearchBackend &backend,
+                                   const SourceSearchOptions &options,
+                                   SourceSearchResult &result,
+                                   std::string &error) {
+  result = {};
+  error.clear();
+  using Clock = std::chrono::steady_clock;
+  auto started = Clock::now();
+  auto milliseconds = [](Clock::time_point begin) {
+    return std::chrono::duration<double, std::milli>(Clock::now() - begin)
+        .count();
+  };
+  double enumerationMs = 0, materializationMs = 0, replayMs = 0,
+         normalizationMs = 0, capabilityMs = 0, evaluationMs = 0;
+  if (!parent || failed(verify(parent)) || backend.identity.empty() ||
+      backend.capabilityIdentity.empty() || !backend.capability ||
+      !backend.evaluate || !options.beamWidth ||
+      !(options.actions.shapeDomain.axes.empty()
+            ? options.actions.shapeDomain.contains(1, 1)
+            : options.actions.shapeDomain.contains(
+                  options.actions.shapeDomain.axes)) ||
+      !std::isfinite(options.wallSeconds) || options.wallSeconds < 0) {
+    error = "source search requires verified source, backend "
+            "capability/evaluator and beam";
+    return failure();
+  }
+  NeighborhoodAction identity{"identity", "identity"};
+  auto phaseStart = Clock::now();
+  auto seed = applySourceAction(parent, function, identity, initialShapes,
+                                options.actions.shapeDomain, error,
+                                backend.materialize);
+  materializationMs += milliseconds(phaseStart);
+  if (failed(seed))
+    return failure();
+  if (!initialShapes.empty()) {
+    if (initialShapes.size() != seed->shapes.size()) {
+      error = "initial source shapes must cover each task exactly once";
+      return failure();
+    }
+    std::set<std::string> names, sourceNames;
+    for (const auto &shape : seed->shapes)
+      sourceNames.insert(shape.task);
+    for (const auto &shape : initialShapes)
+      if (!sourceNames.count(shape.task) || !names.insert(shape.task).second ||
+          !shape.validMirror() ||
+          !options.actions.shapeDomain.contains(shape.dimensions())) {
+        error = "initial source shape is duplicated or outside target geometry";
+        return failure();
+      }
+  }
+  const auto baseShapes = seed->shapes;
+  std::vector<State> beam;
+  std::set<std::string> decided;
+  std::map<std::string, uint64_t> lastAttempt;
+  llvm::json::Array records, diagnostics;
+  uint64_t evaluations = 0, unknown = 0, rejected = 0, duplicates = 0,
+           generated = 0, rounds = 0;
+  auto elapsed = [&] {
+    return std::chrono::duration<double>(std::chrono::steady_clock::now() -
+                                         started)
+        .count();
+  };
+  std::string termination = "round-budget";
+  auto stopped = [&] {
+    if (options.stopRequested && options.stopRequested()) {
+      termination = "requested-stop";
+      return true;
+    }
+    if (options.maxEvaluations && evaluations >= options.maxEvaluations) {
+      termination = "evaluation-budget";
+      return true;
+    }
+    if (options.wallSeconds && elapsed() >= options.wallSeconds) {
+      termination = "wall-budget";
+      return true;
+    }
+    return false;
+  };
+  auto evaluate = [&](State &state, uint64_t round) -> bool {
+    state.key = candidateKey(*state.module, state.shapes, backend);
+    if (decided.count(state.key) ||
+        (lastAttempt.count(state.key) && lastAttempt[state.key] == round)) {
+      ++duplicates;
+      return false;
+    }
+    lastAttempt[state.key] = round;
+    auto begin = Clock::now();
+    auto replayStatus = verifySourceActionReplay(
+        parent, *state.module, function, state.history, baseShapes,
+        state.shapes, options.actions.shapeDomain, error, backend.materialize);
+    replayMs += milliseconds(begin);
+    if (failed(replayStatus))
+      return false;
+    llvm::json::Object record{
+        {"key", state.key},
+        {"round", static_cast<int64_t>(round)},
+        {"actions", static_cast<int64_t>(state.history.size())},
+        {"source_replay_verified", true},
+        {"family",
+         state.history.empty() ? "baseline" : state.history.back().family},
+        {"action",
+         state.history.empty() ? "baseline" : state.history.back().label}};
+    std::string reason;
+    auto capabilitySource = moduleBytes(*state.module);
+    begin = Clock::now();
+    bool capable = backend.capability(*state.module, state.shapes, reason);
+    capabilityMs += milliseconds(begin);
+    if (capabilitySource != moduleBytes(*state.module)) {
+      error = "source capability callback mutated a read-only candidate";
+      return false;
+    }
+    if (!capable) {
+      ++unknown;
+      decided.insert(state.key); // Deterministic for this capability identity.
+      record["status"] = "unsupported-capability";
+      record["message"] = reason;
+      records.push_back(std::move(record));
+      return false;
+    }
+    OwningOpRef<ModuleOp> normalized;
+    TaskflowSourceNormalizationWitness witness;
+    begin = Clock::now();
+    bool normalizedOK = succeeded(
+        normalizeTaskflowSource(*state.module, normalized, witness, reason));
+    if (normalizedOK)
+      normalizedOK = succeeded(verifyTaskflowSourceNormalization(
+          *state.module, *normalized, witness, reason));
+    normalizationMs += milliseconds(begin);
+    if (!normalizedOK) {
+      ++unknown;
+      decided.insert(state.key); // Source/normalizer identity is unchanged.
+      record["status"] = "unsupported-normalization";
+      record["message"] = reason;
+      records.push_back(std::move(record));
+      return false;
+    }
+    auto before = moduleBytes(*state.module);
+    auto physicalBefore = moduleBytes(*normalized);
+    ++evaluations;
+    begin = Clock::now();
+    ProgramSearchEvaluation evaluation =
+        backend.evaluate(*state.module, *normalized, state.shapes, witness);
+    evaluationMs += milliseconds(begin);
+    if (before != moduleBytes(*state.module) ||
+        physicalBefore != moduleBytes(*normalized)) {
+      error = "source evaluator mutated a read-only candidate";
+      return false;
+    }
+    record["message"] = evaluation.message;
+    record["evaluation"] = std::move(evaluation.result);
+    if (!evaluation.feasibilityKnown) {
+      ++unknown;
+      record["status"] = "unknown";
+      records.push_back(std::move(record));
+      return false;
+    }
+    if (!evaluation.feasible) {
+      ++rejected;
+      decided.insert(state.key);
+      record["status"] = "backend-rejected";
+      records.push_back(std::move(record));
+      return false;
+    }
+    if (!evaluation.costMs || !std::isfinite(*evaluation.costMs) ||
+        *evaluation.costMs < 0) {
+      ++unknown;
+      record["status"] = "unpriced";
+      records.push_back(std::move(record));
+      return false;
+    }
+    state.cost = *evaluation.costMs;
+    decided.insert(state.key);
+    record["status"] = "scored";
+    record["cost_ms"] = state.cost;
+    records.push_back(std::move(record));
+    if (!result.bestCostMs || state.cost < *result.bestCostMs) {
+      result.bestSource = state.module->clone();
+      result.bestNormalized = normalized->clone();
+      result.bestActions = state.history;
+      result.bestShapes = state.shapes;
+      result.bestNormalization = witness;
+      result.bestCostMs = state.cost;
+    }
+    return true;
+  };
+
+  State baseline;
+  baseline.module = std::move(seed->module);
+  baseline.shapes = baseShapes;
+  if (evaluate(baseline, 0))
+    beam.push_back(std::move(baseline));
+  if (!error.empty())
+    return failure();
+  if (!options.seedActions.empty() && !stopped()) {
+    State resumed;
+    resumed.module = parent.clone();
+    resumed.shapes = baseShapes;
+    for (const auto &action : options.seedActions) {
+      auto begin = Clock::now();
+      auto next = applySourceAction(*resumed.module, function, action,
+                                    resumed.shapes, options.actions.shapeDomain,
+                                    error, backend.materialize);
+      materializationMs += milliseconds(begin);
+      if (failed(next))
+        return failure();
+      resumed.module = std::move(next->module);
+      resumed.shapes = std::move(next->shapes);
+      resumed.history.push_back(action);
+    }
+    if (evaluate(resumed, 0))
+      beam.push_back(std::move(resumed));
+    if (!error.empty())
+      return failure();
+  }
+  auto order = [](const State &a, const State &b) {
+    return a.cost != b.cost ? a.cost < b.cost : a.key < b.key;
+  };
+  for (uint64_t round = 0;
+       (!options.maxRounds || round < options.maxRounds) && !stopped();
+       ++round) {
+    ++rounds;
+    std::vector<State> next;
+    auto retain = [&](State &&state) {
+      next.push_back(std::move(state));
+      // Bound owned IR while exploring, not only after constructing an entire
+      // neighborhood of a potentially large model.
+      if (next.size() > options.beamWidth &&
+          next.size() - options.beamWidth > options.beamWidth) {
+        std::sort(next.begin(), next.end(), order);
+        next.resize(options.beamWidth);
+      }
+    };
+    // An unpriced original is only an input proposal root, never a survivor.
+    // This allows e.g. fusion to make an otherwise unsupported source
+    // lowerable.
+    if (beam.empty()) {
+      State root;
+      root.module = parent.clone();
+      root.shapes = baseShapes;
+      beam.push_back(std::move(root));
+    }
+    for (auto &state : beam) {
+      std::vector<NeighborhoodAction> actions;
+      std::vector<std::string> notes;
+      auto actionOptions = options.actions;
+      actionOptions.round = static_cast<unsigned>(
+          std::min<uint64_t>(round, std::numeric_limits<unsigned>::max()));
+      auto begin = Clock::now();
+      auto enumerated =
+          enumerateSourceActions(*state.module, function, actionOptions,
+                                 actions, notes, error, backend.enumerate);
+      fairProposals(actions, round);
+      enumerationMs += milliseconds(begin);
+      if (failed(enumerated))
+        return failure();
+      for (const auto &note : notes)
+        diagnostics.push_back(note);
+      for (const auto &action : actions) {
+        if (stopped())
+          break;
+        ++generated;
+        std::string diagnostic;
+        begin = Clock::now();
+        auto materialized = applySourceAction(
+            *state.module, function, action, state.shapes,
+            options.actions.shapeDomain, diagnostic, backend.materialize);
+        materializationMs += milliseconds(begin);
+        if (failed(materialized)) {
+          diagnostics.push_back(action.label + ": " + diagnostic);
+          continue;
+        }
+        State candidate;
+        candidate.module = std::move(materialized->module);
+        candidate.shapes = std::move(materialized->shapes);
+        candidate.history = state.history;
+        candidate.history.push_back(action);
+        if (evaluate(candidate, round + 1))
+          retain(std::move(candidate));
+        if (!error.empty())
+          return failure();
+      }
+      // Keep every scored predecessor eligible, including the baseline.
+      if (!state.key.empty() && decided.count(state.key))
+        retain(std::move(state));
+      if (stopped())
+        break;
+    }
+    std::sort(next.begin(), next.end(), order);
+    std::set<std::string> kept;
+    std::vector<State> survivors;
+    for (auto &state : next)
+      if (survivors.size() < options.beamWidth && kept.insert(state.key).second)
+        survivors.push_back(std::move(state));
+    beam = std::move(survivors);
+  }
+  result.report = llvm::json::Object{
+      {"schema", "orbit-taskflow-source-search-v1"},
+      {"backend", backend.identity},
+      {"capability", backend.capabilityIdentity},
+      {"source_fingerprint", digest(moduleBytes(parent))},
+      {"termination", termination},
+      {"complete_domain", false},
+      {"global_optimality_claim", false},
+      {"deterministic_unsupported_cached", true},
+      {"runtime_unknown_retry_policy", "at-most-once-per-round"},
+      {"has_best", bool(result.bestCostMs)},
+      {"rounds", static_cast<int64_t>(rounds)},
+      {"generated", static_cast<int64_t>(generated)},
+      {"evaluations", static_cast<int64_t>(evaluations)},
+      {"unknown", static_cast<int64_t>(unknown)},
+      {"backend_rejected", static_cast<int64_t>(rejected)},
+      {"deduplicated", static_cast<int64_t>(duplicates)},
+      {"elapsed_seconds", elapsed()},
+      {"proposal_order", "round-robin-family-and-task; rotated-by-round"},
+      {"phase_ms", llvm::json::Object{{"enumeration", enumerationMs},
+                                      {"materialization", materializationMs},
+                                      {"replay", replayMs},
+                                      {"normalization", normalizationMs},
+                                      {"capability", capabilityMs},
+                                      {"evaluation", evaluationMs}}},
+      {"observations", std::move(records)},
+      {"diagnostics", std::move(diagnostics)},
+      {"initial_shapes", shapesJSON(baseShapes)},
+      {"replay", serializeSourceSearchReplay(
+                     function, backend.identity, backend.capabilityIdentity,
+                     result.bestActions, result.bestShapes)}};
+  if (result.bestCostMs)
+    result.report["best_cost_ms"] = *result.bestCostMs;
+  return success();
+}
+} // namespace orbit::taskflow
diff --git a/lib/Taskflow/SourceSearchDriver.cpp b/lib/Taskflow/SourceSearchDriver.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..341e5c79c16934f212afd77a08554a2145435f8b
--- /dev/null
+++ b/lib/Taskflow/SourceSearchDriver.cpp
@@ -0,0 +1,351 @@
+//===- SourceSearchDriver.cpp - Common source-search integration
+//------------===//
+#include "Taskflow/SourceSearchDriver.h"
+#include "Taskflow/GenericMapping.h"
+#include "Taskflow/Search.h"
+#include "Taskflow/SourceMappingActions.h"
+#include "Taskflow/SourceSearch.h"
+#include "Taskflow/TaskflowReplica.h"
+#include "TaskflowDialect/TaskflowDialect.h"
+#include "mlir/Dialect/Affine/IR/AffineOps.h"
+#include "mlir/Dialect/Arith/IR/Arith.h"
+#include "mlir/Dialect/Func/IR/FuncOps.h"
+#include "mlir/Dialect/Math/IR/Math.h"
+#include "mlir/Dialect/MemRef/IR/MemRef.h"
+#include "mlir/Dialect/SCF/IR/SCF.h"
+#include "mlir/Parser/Parser.h"
+#include "llvm/ADT/StringExtras.h"
+#include "llvm/Support/FileSystem.h"
+#include "llvm/Support/FormatVariadic.h"
+#include "llvm/Support/MemoryBuffer.h"
+#include "llvm/Support/Path.h"
+#include "llvm/Support/SHA256.h"
+#include "llvm/Support/raw_ostream.h"
+#include <array>
+#include <cmath>
+
+using namespace mlir;
+namespace orbit::taskflow {
+namespace {
+std::string moduleText(ModuleOp module) {
+  std::string text;
+  llvm::raw_string_ostream stream(text);
+  module.print(stream, OpPrintingFlags().printGenericOpForm());
+  stream.flush();
+  return text;
+}
+std::string digest(llvm::StringRef bytes) {
+  return llvm::toHex(llvm::SHA256::hash(llvm::arrayRefFromStringRef(bytes)),
+                     true);
+}
+bool writeFile(llvm::StringRef path, llvm::StringRef text, std::string &error) {
+  std::error_code ec;
+  llvm::raw_fd_ostream stream(path, ec);
+  if (ec) {
+    error = ec.message();
+    return false;
+  }
+  stream << text;
+  stream.close();
+  if (stream.has_error()) {
+    error = stream.error().message();
+    stream.clear_error();
+    return false;
+  }
+  return true;
+}
+// Match the existing native search's conservative file binding. Referenced
+// model/calibration bytes matter even when the JSON pathname is unchanged.
+bool bindDependencies(const llvm::json::Value &value, std::string &binding,
+                      std::string &error) {
+  if (auto text = value.getAsString()) {
+    if (llvm::sys::fs::is_regular_file(*text)) {
+      auto bytes = llvm::MemoryBuffer::getFile(*text);
+      if (!bytes) {
+        error = "cannot bind source-search dependency: " + text->str();
+        return false;
+      }
+      binding += text->str() + ":" + digest((*bytes)->getBuffer()) + "\n";
+    }
+  } else if (auto array = value.getAsArray()) {
+    for (const auto &element : *array)
+      if (!bindDependencies(element, binding, error))
+        return false;
+  } else if (auto object = value.getAsObject()) {
+    for (const auto &entry : *object)
+      if (!bindDependencies(entry.second, binding, error))
+        return false;
+  }
+  return true;
+}
+} // namespace
+
+bool tryRunSourceSearch(const SearchOptions &request, bool &handled,
+                        std::string &error) {
+  handled = false;
+  if (request.targetConfigFile.empty())
+    return true;
+  auto bytes = llvm::MemoryBuffer::getFile(request.targetConfigFile);
+  if (!bytes) {
+    error = bytes.getError().message();
+    return false;
+  }
+  auto parsed = llvm::json::parse((*bytes)->getBuffer());
+  if (!parsed) {
+    error = llvm::toString(parsed.takeError());
+    return false;
+  }
+  auto *config = parsed->getAsObject();
+  if (!config || !config->get("source_auto_candidates"))
+    return true;
+  handled = true;
+  auto *automatic = config->getObject("source_auto_candidates");
+  if (!automatic || request.nativeSourceMLIR.empty() ||
+      request.backend != "air" || request.resume ||
+      !request.checkpoint.empty() || request.outputDir.empty() ||
+      request.maxRounds < 0 || request.maxCandidates < 1 ||
+      request.beamWidth < 1 ||
+      (!request.evaluator.empty() && request.evaluator != "native")) {
+    error = "source_auto_candidates requires actual source, backend=air, "
+            "positive candidate/beam budgets, native evaluator and a fresh "
+            "output directory";
+    return false;
+  }
+  // Other adapters must supply a shape-aware physical evaluator before this
+  // path may claim their support. A generic AIR plan does not place a CGRA.
+  for (const auto &entry : *automatic)
+    if (entry.first != "function" && entry.first != "rows" &&
+        entry.first != "cols" && entry.first != "max_fission_actions" &&
+        entry.first != "tiling" && entry.first != "fusion" &&
+        entry.first != "fission" && entry.first != "replica" &&
+        entry.first != "wall_seconds" && entry.first != "mapping" &&
+        entry.first != "task_tiling" && entry.first != "tile_page_slots" &&
+        entry.first != "max_residency_proposals" &&
+        entry.first != "max_residency_groups") {
+      error = "unknown source_auto_candidates field: " + entry.first.str();
+      return false;
+    }
+  auto function = automatic->getString("function");
+  const std::string functionName = function ? function->str() : "";
+  SourceSearchOptions options;
+  SourceMappingActionOptions mappingOptions;
+  options.maxRounds = request.maxRounds;
+  options.maxEvaluations = request.maxCandidates;
+  options.beamWidth = request.beamWidth;
+  options.actions.shapeDomain = {1, 1};
+  auto integer = [&](llvm::StringRef key, int64_t &value) {
+    if (!automatic->get(key))
+      return true;
+    auto number = automatic->getInteger(key);
+    if (!number || *number < 1) {
+      error =
+          "source_auto_candidates." + key.str() + " must be a positive integer";
+      return false;
+    }
+    value = *number;
+    return true;
+  };
+  int64_t cuts = options.actions.maxFissionActionsPerTask;
+  if (!function || function->empty() ||
+      !integer("rows", options.actions.shapeDomain.rows) ||
+      !integer("cols", options.actions.shapeDomain.cols) ||
+      !integer("max_fission_actions", cuts)) {
+    if (error.empty())
+      error = "source_auto_candidates.function is required";
+    return false;
+  }
+  options.actions.maxFissionActionsPerTask = cuts;
+  int64_t tileSlots = mappingOptions.tilePageSlots;
+  int64_t mappingProposals = mappingOptions.maxResidencyProposals;
+  int64_t mappingGroups = mappingOptions.maxResidencyGroups;
+  if (!integer("tile_page_slots", tileSlots) ||
+      !integer("max_residency_proposals", mappingProposals) ||
+      !integer("max_residency_groups", mappingGroups))
+    return false;
+  mappingOptions.tilePageSlots = tileSlots;
+  mappingOptions.maxResidencyProposals = mappingProposals;
+  mappingOptions.maxResidencyGroups = mappingGroups;
+  const std::array<std::pair<const char *, bool *>, 6> booleanFields{
+      {{"tiling", &options.actions.tiling},
+       {"fusion", &options.actions.fusion},
+       {"fission", &options.actions.fission},
+       {"replica", &options.actions.replica},
+       {"mapping", &mappingOptions.mapping},
+       {"task_tiling", &mappingOptions.taskTiling}}};
+  for (const auto &entry : booleanFields) {
+    if (!automatic->get(entry.first))
+      continue;
+    auto value = automatic->getBoolean(entry.first);
+    if (!value) {
+      error = std::string("source_auto_candidates.") + entry.first +
+              " must be boolean";
+      return false;
+    }
+    *entry.second = *value;
+  }
+  if (automatic->get("wall_seconds")) {
+    auto seconds = automatic->getNumber("wall_seconds");
+    if (!seconds || !std::isfinite(*seconds) || *seconds < 0) {
+      error = "source_auto_candidates.wall_seconds must be finite and >=0";
+      return false;
+    }
+    options.wallSeconds = *seconds;
+  }
+  if (llvm::sys::fs::exists(request.outputDir)) {
+    error = "source search output directory must be new";
+    return false;
+  }
+  DialectRegistry registry;
+  registry.insert<mlir::taskflow::TaskflowDialect, affine::AffineDialect,
+                  arith::ArithDialect, math::MathDialect, memref::MemRefDialect,
+                  func::FuncDialect, scf::SCFDialect>();
+  MLIRContext context(registry);
+  auto source = parseSourceString<ModuleOp>(request.nativeSourceMLIR, &context);
+  if (!source) {
+    error = "source search requires parseable Taskflow MLIR";
+    return false;
+  }
+  const std::string configurationBytes = (*bytes)->getBuffer().str();
+  const std::string sourceIdentity = digest(moduleText(*source));
+  std::string dependencyBytes;
+  if (!bindDependencies(*parsed, dependencyBytes, error))
+    return false;
+  auto compiler = llvm::MemoryBuffer::getFile(llvm::sys::fs::getMainExecutable(
+      nullptr, reinterpret_cast<void *>(&tryRunSourceSearch)));
+  if (!compiler) {
+    error = "cannot bind source-search compiler bytes";
+    return false;
+  }
+  SourceSearchBackend backend;
+  backend.identity =
+      "taskflow-generic-air-source-v1:" + digest((*compiler)->getBuffer());
+  if (request.nativeEvaluator)
+    backend.identity += ":" + request.nativeBackendIdentity;
+  backend.capabilityIdentity = digest(configurationBytes + dependencyBytes);
+  if (!getGenericTargetCapabilities(*parsed, mappingOptions.capabilities,
+                                    error))
+    return false;
+  backend.materialize = makeSourceMappingActionMaterializer(mappingOptions);
+  backend.enumerate = makeSourceMappingActionEnumerator(mappingOptions);
+  backend.capability = [&](ModuleOp source,
+                           llvm::ArrayRef<NeighborhoodShape> shapes,
+                           std::string &reason) {
+    if (failed(checkSourceMappingActionBindings(source, functionName, reason)))
+      return false;
+    // The target plugin must consume the source-owned placement and replica
+    // contracts itself. Core cannot infer physical legality from shape area.
+    if (request.nativeEvaluator)
+      return true;
+    if (hasTaskflowReplicaGroups(source)) {
+      reason = "generic AIR adapter has no checked independent concurrent "
+               "replica realization";
+      return false;
+    }
+    for (const auto &shape : shapes)
+      if (!shape.axes.empty() || shape.rows != 1 || shape.cols != 1) {
+        reason = "generic AIR adapter has no checked multi-resource shape "
+                 "realization; resource proposal remains unknown";
+        return false;
+      }
+    return true;
+  };
+  // The proposal declaration is not an evaluator option. Keep its original
+  // bytes in the binding, while passing only target/cost fields downstream.
+  config->erase("source_auto_candidates");
+  backend.evaluate = [&](ModuleOp source, ModuleOp normalized,
+                         llvm::ArrayRef<NeighborhoodShape>,
+                         const TaskflowSourceNormalizationWitness &) {
+    ProgramSearchEvaluation observation;
+    std::string reason;
+    auto value =
+        request.nativeEvaluator
+            ? request.nativeEvaluator(moduleText(source), *parsed, "source",
+                                      reason)
+            : evaluateGenericMLIR(moduleText(normalized), *parsed, reason);
+    auto *object = value.getAsObject();
+    auto *plan = object ? object->getObject("best_plan") : nullptr;
+    const auto status = object ? object->getString("status") : std::nullopt;
+    observation.feasible =
+        plan && (status == "passed" || status == "uncalibrated");
+    // Unsupported mapping/numerics is absence of proof, not infeasibility.
+    observation.feasibilityKnown = observation.feasible;
+    observation.message = reason;
+    if (object && object->getString("reason"))
+      observation.message = object->getString("reason")->str();
+    if (plan)
+      if (auto cost = plan->getNumber("estimated_ms"))
+        observation.costMs = *cost;
+    observation.result = std::move(value);
+    return observation;
+  };
+  SourceSearchResult result;
+  if (failed(searchTaskflowSource(*source, functionName, {}, backend, options,
+                                  result, error)))
+    return false;
+  // Rebinding catches changed, deleted or newly created referenced files.
+  // Such a campaign cannot publish costs under its original cache identity.
+  auto currentConfig = llvm::MemoryBuffer::getFile(request.targetConfigFile);
+  auto sealedConfig = llvm::json::parse(configurationBytes);
+  if (!sealedConfig) {
+    error = llvm::toString(sealedConfig.takeError());
+    return false;
+  }
+  std::string currentDependencies;
+  if (!currentConfig || (*currentConfig)->getBuffer() != configurationBytes ||
+      !bindDependencies(*sealedConfig, currentDependencies, error) ||
+      currentDependencies != dependencyBytes) {
+    error =
+        "source-search configuration or dependencies changed during evaluation";
+    return false;
+  }
+  auto parentPath = llvm::sys::path::parent_path(request.outputDir);
+  if (!parentPath.empty())
+    if (auto ec = llvm::sys::fs::create_directories(parentPath)) {
+      error = ec.message();
+      return false;
+    }
+  // Exclusive creation prevents a long-running search from overwriting a
+  // directory that another campaign created after the initial check.
+  if (auto ec = llvm::sys::fs::create_directory(request.outputDir, false)) {
+    error = ec.message();
+    return false;
+  }
+  result.report["source_fingerprint"] = sourceIdentity;
+  result.report["target_fingerprint"] = backend.capabilityIdentity;
+  result.report["physical_execution"] = false;
+  result.report["cost_scope"] = "configured generic AIR cost provider";
+  if (result.bestSource)
+    result.report["best_normalization"] = llvm::json::Object{
+        {"schema", result.bestNormalization.protocol},
+        {"source_fingerprint", result.bestNormalization.sourceFingerprint},
+        {"normalized_fingerprint",
+         result.bestNormalization.normalizedFingerprint},
+        {"normalized_tasks",
+         static_cast<int64_t>(result.bestNormalization.normalizedTasks)},
+        {"normalized_counters",
+         static_cast<int64_t>(result.bestNormalization.normalizedCounters)},
+        {"replay_verified", true}};
+  const auto prefix = request.outputDir + "/";
+  if (!writeFile(prefix + "source.mlir", request.nativeSourceMLIR, error) ||
+      !writeFile(prefix + "target.json", configurationBytes, error))
+    return false;
+  if (result.bestSource) {
+    auto replay = serializeSourceSearchReplay(
+        functionName, backend.identity, backend.capabilityIdentity,
+        result.bestActions, result.bestShapes);
+    (*replay.getAsObject())["source_fingerprint"] = sourceIdentity;
+    if (!writeFile(prefix + "best.source.mlir", moduleText(*result.bestSource),
+                   error) ||
+        !writeFile(prefix + "best.normalized.mlir",
+                   moduleText(*result.bestNormalized), error) ||
+        !writeFile(prefix + "replay.json",
+                   llvm::formatv("{0:2}\n", replay).str(), error))
+      return false;
+  }
+  return writeFile(
+      prefix + "search.json",
+      llvm::formatv("{0:2}\n", llvm::json::Value(std::move(result.report)))
+          .str(),
+      error);
+}
+} // namespace orbit::taskflow
diff --git a/lib/Taskflow/TaskPlacement.cpp b/lib/Taskflow/TaskPlacement.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..b759ad8ba8f519ed248776bcaba84c40b2b93070
--- /dev/null
+++ b/lib/Taskflow/TaskPlacement.cpp
@@ -0,0 +1,151 @@
+//===- TaskPlacement.cpp - Source-owned execution placement ---------------===//
+#include "Taskflow/TaskPlacement.h"
+#include "TaskflowDialect/TaskflowOps.h"
+#include "mlir/Dialect/Func/IR/FuncOps.h"
+#include "mlir/IR/Builders.h"
+#include "mlir/IR/SymbolTable.h"
+#include "llvm/ADT/STLExtras.h"
+#include <limits>
+#include <set>
+
+using namespace mlir;
+namespace orbit::taskflow {
+namespace {
+constexpr llvm::StringLiteral kPlacement = "orbit.placement";
+bool fail(std::string &error, llvm::StringRef message) {
+  error = message.str();
+  return false;
+}
+bool tasks(ModuleOp module, llvm::StringRef function,
+           SmallVector<mlir::taskflow::TaskflowTaskOp> &out,
+           std::string &error) {
+  auto selected = module ? dyn_cast_or_null<func::FuncOp>(
+                               SymbolTable::lookupSymbolIn(module, function))
+                         : func::FuncOp{};
+  if (!selected)
+    return fail(error, "task placement requires an existing function");
+  std::set<std::string> names;
+  bool unique = true;
+  selected.walk([&](mlir::taskflow::TaskflowTaskOp task) {
+    unique &= names.insert(task.getTaskName().str()).second;
+    out.push_back(task);
+  });
+  return unique || fail(error, "task placement requires unique task names");
+}
+bool geometry(const MappingTaskPlacement &choice, std::string &error) {
+  if (choice.resourceCount < 1 || choice.resourceShape.empty())
+    return fail(error, "task placement requires positive count and shape");
+  int64_t area = 1;
+  for (int64_t extent : choice.resourceShape) {
+    if (extent < 1 || area > std::numeric_limits<int64_t>::max() / extent)
+      return fail(error, "task placement shape is nonpositive or overflows");
+    area *= extent;
+  }
+  // Shape describes a fabric assigned to a task. Count is a separate target
+  // reservation; neither quantity divides the task's source iteration domain.
+  return true;
+}
+} // namespace
+
+bool readTaskPlacementChoices(ModuleOp module, llvm::StringRef function,
+                              std::vector<MappingTaskPlacement> &out,
+                              std::string &error) {
+  error.clear();
+  out.clear();
+  SmallVector<mlir::taskflow::TaskflowTaskOp> selected;
+  if (!tasks(module, function, selected, error))
+    return false;
+  std::vector<MappingTaskPlacement> result;
+  for (auto [index, task] : llvm::enumerate(selected)) {
+    Attribute raw = task->getAttr(kPlacement);
+    if (!raw)
+      continue;
+    auto value = dyn_cast<DictionaryAttr>(raw);
+    auto resource = value ? value.getAs<StringAttr>("resource") : StringAttr{};
+    auto memory = value ? value.getAs<StringAttr>("memory") : StringAttr{};
+    auto implementation =
+        value ? value.getAs<StringAttr>("implementation") : StringAttr{};
+    auto count = value ? value.getAs<IntegerAttr>("count") : IntegerAttr{};
+    auto shape =
+        value ? value.getAs<DenseI64ArrayAttr>("shape") : DenseI64ArrayAttr{};
+    if (!value || value.size() != 5 || !resource || !memory ||
+        !implementation || !count || !count.getType().isInteger(64) || !shape)
+      return fail(error, "orbit.placement requires resource, memory, "
+                         "implementation strings, i64 count and i64 shape");
+    MappingTaskPlacement choice{index,
+                                resource.getValue().str(),
+                                memory.getValue().str(),
+                                implementation.getValue().str(),
+                                count.getInt(),
+                                std::vector<int64_t>(shape.asArrayRef().begin(),
+                                                     shape.asArrayRef().end())};
+    if (!geometry(choice, error))
+      return false;
+    result.push_back(std::move(choice));
+  }
+  out = std::move(result);
+  return true;
+}
+
+bool setTaskPlacementChoices(ModuleOp module, llvm::StringRef function,
+                             llvm::ArrayRef<MappingTaskPlacement> choices,
+                             std::string &error) {
+  error.clear();
+  SmallVector<mlir::taskflow::TaskflowTaskOp> selected;
+  if (!tasks(module, function, selected, error))
+    return false;
+  std::set<size_t> seen;
+  for (const auto &choice : choices)
+    if (choice.task >= selected.size() || !seen.insert(choice.task).second ||
+        !geometry(choice, error)) {
+      if (error.empty())
+        error = "task placement requires unique in-range task indices";
+      return false;
+    }
+  Builder builder(module.getContext());
+  SmallVector<std::pair<size_t, DictionaryAttr>> attributes;
+  for (const auto &choice : choices)
+    attributes.emplace_back(
+        choice.task,
+        builder.getDictionaryAttr(
+            {builder.getNamedAttr("resource",
+                                  builder.getStringAttr(choice.resource)),
+             builder.getNamedAttr("memory",
+                                  builder.getStringAttr(choice.memory)),
+             builder.getNamedAttr("implementation",
+                                  builder.getStringAttr(choice.implementation)),
+             builder.getNamedAttr(
+                 "count", builder.getI64IntegerAttr(choice.resourceCount)),
+             builder.getNamedAttr("shape", builder.getDenseI64ArrayAttr(
+                                               choice.resourceShape))}));
+  for (auto task : selected)
+    task->removeAttr(kPlacement);
+  for (const auto &[task, attribute] : attributes)
+    selected[task]->setAttr(kPlacement, attribute);
+  return true;
+}
+
+bool checkTaskPlacementChoices(const GenericAnalysis &analysis,
+                               const ProgramGraph &graph, std::string &error) {
+  auto function = analysis.function;
+  std::vector<MappingTaskPlacement> choices;
+  if (!readTaskPlacementChoices(analysis.function->getParentOfType<ModuleOp>(),
+                                function.getSymName(), choices, error))
+    return false;
+  for (const auto &choice : choices) {
+    auto actual = llvm::find_if(graph.placements, [&](const auto &placement) {
+      return placement.task == choice.task;
+    });
+    if (actual == graph.placements.end() ||
+        (!choice.resource.empty() && choice.resource != actual->resource) ||
+        (!choice.memory.empty() && choice.memory != actual->memory) ||
+        (!choice.implementation.empty() &&
+         choice.implementation != actual->implementation) ||
+        choice.resourceCount != actual->resourceCount ||
+        choice.resourceShape != actual->resourceShape)
+      return fail(error,
+                  "realized graph does not implement source task placement");
+  }
+  return true;
+}
+} // namespace orbit::taskflow
diff --git a/lib/Taskflow/TaskTiling.cpp b/lib/Taskflow/TaskTiling.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..2b8f1cb102d7013831ac0e689da3a1e06e2c0dfe
--- /dev/null
+++ b/lib/Taskflow/TaskTiling.cpp
@@ -0,0 +1,76 @@
+#include "Taskflow/TaskTiling.h"
+#include "mlir/IR/Builders.h"
+#include <algorithm>
+
+using namespace mlir;
+namespace orbit::taskflow {
+namespace {
+bool validate(size_t count, const std::vector<TaskTileChoice> &choices,
+              std::string &error) {
+  for (size_t i = 0; i < choices.size(); ++i) {
+    const auto &choice = choices[i];
+    if (choice.task >= count || (i && choices[i - 1].task >= choice.task)) {
+      error = "task tiles require unique, in-range task indices";
+      return false;
+    }
+    if (choice.sizes.empty() ||
+        std::any_of(choice.sizes.begin(), choice.sizes.end(),
+                    [](int64_t n) { return n <= 0; })) {
+      error = "task tiles require a nonempty list of positive iteration sizes";
+      return false;
+    }
+  }
+  return true;
+}
+} // namespace
+bool readTaskTileChoices(ModuleOp module, size_t count,
+                         std::vector<TaskTileChoice> &out, std::string &error) {
+  out.clear();
+  auto raw = module->getAttr("orbit.task_tiles");
+  if (!raw)
+    return true;
+  auto table = dyn_cast<ArrayAttr>(raw);
+  if (!table) {
+    error = "orbit.task_tiles requires an array";
+    return false;
+  }
+  for (auto rawEntry : table) {
+    auto entry = dyn_cast<DictionaryAttr>(rawEntry);
+    auto task = entry ? entry.getAs<IntegerAttr>("task") : IntegerAttr{};
+    auto sizes =
+        entry ? entry.getAs<DenseI64ArrayAttr>("sizes") : DenseI64ArrayAttr{};
+    if (!entry || entry.size() != 2 || !task || !task.getType().isInteger(64) ||
+        task.getInt() < 0 || !sizes) {
+      error = "task tile entry requires i64 task and dense i64 sizes";
+      return false;
+    }
+    out.push_back({size_t(task.getInt()),
+                   std::vector<int64_t>(sizes.asArrayRef().begin(),
+                                        sizes.asArrayRef().end())});
+  }
+  std::sort(out.begin(), out.end(),
+            [](const auto &a, const auto &b) { return a.task < b.task; });
+  return validate(count, out, error);
+}
+bool setTaskTileChoices(ModuleOp module, size_t count,
+                        const std::vector<TaskTileChoice> &input,
+                        std::string &error) {
+  auto choices = input;
+  std::sort(choices.begin(), choices.end(),
+            [](const auto &a, const auto &b) { return a.task < b.task; });
+  if (!validate(count, choices, error))
+    return false;
+  Builder builder(module.getContext());
+  SmallVector<Attribute> entries;
+  for (const auto &choice : choices)
+    entries.push_back(builder.getDictionaryAttr(
+        {builder.getNamedAttr("task", builder.getI64IntegerAttr(choice.task)),
+         builder.getNamedAttr("sizes",
+                              builder.getDenseI64ArrayAttr(choice.sizes))}));
+  if (entries.empty())
+    module->removeAttr("orbit.task_tiles");
+  else
+    module->setAttr("orbit.task_tiles", builder.getArrayAttr(entries));
+  return true;
+}
+} // namespace orbit::taskflow
diff --git a/lib/Taskflow/TaskflowDeferredPlan.cpp b/lib/Taskflow/TaskflowDeferredPlan.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..da62c97540f2af70ff862b283d367e9ff6c26dfb
--- /dev/null
+++ b/lib/Taskflow/TaskflowDeferredPlan.cpp
@@ -0,0 +1,95 @@
+//===- TaskflowDeferredPlan.cpp - Guarded dynamic source actions
+//-----------===//
+#include "Taskflow/TaskflowDeferredPlan.h"
+#include "Taskflow/SourceSearch.h"
+using namespace mlir;
+namespace orbit::taskflow {
+LogicalResult materializeTaskflowDeferredPlan(
+    ModuleOp original, const TaskflowDeferredPlan &plan,
+    TaskflowDeferredPlanResult &result, std::string &error,
+    const SourceActionExtension &extension) {
+  result = {};
+  error.clear();
+  TaskflowDeferredPlanResult trial;
+  trial.plan = plan;
+  if (failed(specializeTaskflowArguments(original, plan.function,
+                                         plan.arguments, trial.specialized,
+                                         trial.specialization, error)))
+    return failure();
+  NeighborhoodAction identity;
+  auto canonical =
+      applySourceAction(*trial.specialized, plan.function, identity,
+                        plan.initialShapes, plan.shapeDomain, error, extension);
+  if (failed(canonical))
+    return failure();
+  trial.source = std::move(canonical->module);
+  trial.shapes = std::move(canonical->shapes);
+  for (const auto &action : plan.actions) {
+    auto next =
+        applySourceAction(*trial.source, plan.function, action, trial.shapes,
+                          plan.shapeDomain, error, extension);
+    if (failed(next))
+      return failure();
+    trial.source = std::move(next->module);
+    trial.shapes = std::move(next->shapes);
+  }
+  if (failed(normalizeTaskflowSource(*trial.source, trial.normalized,
+                                     trial.normalization, error)))
+    return failure();
+  if (failed(verifyTaskflowDeferredPlan(original, trial, plan.arguments, error,
+                                        extension)))
+    return failure();
+  result = std::move(trial);
+  return success();
+}
+LogicalResult verifyTaskflowDeferredPlan(
+    ModuleOp original, const TaskflowDeferredPlanResult &result,
+    ArrayRef<TaskflowArgumentBinding> actual, std::string &error,
+    const SourceActionExtension &extension) {
+  error.clear();
+  if (!result.specialized || !result.source || !result.normalized ||
+      result.plan.function != result.specialization.function ||
+      !checkTaskflowInvocationArguments(result.specialization, actual, error) ||
+      !checkTaskflowInvocationArguments(result.specialization,
+                                        result.plan.arguments, error)) {
+    if (error.empty())
+      error = "deferred plan requires complete modules and the original "
+              "invocation guard";
+    return failure();
+  }
+  if (failed(verifyTaskflowSpecialization(original, *result.specialized,
+                                          result.specialization, error)) ||
+      failed(verifySourceActionReplay(
+          *result.specialized, *result.source, result.plan.function,
+          result.plan.actions, result.plan.initialShapes, result.shapes,
+          result.plan.shapeDomain, error, extension)) ||
+      failed(verifyTaskflowSourceNormalization(
+          *result.source, *result.normalized, result.normalization, error)))
+    return failure();
+  return success();
+}
+llvm::json::Value
+serializeTaskflowDeferredPlan(const TaskflowDeferredPlanResult &result) {
+  llvm::json::Array axes;
+  for (int64_t extent : result.plan.shapeDomain.axes)
+    axes.push_back(extent);
+  return llvm::json::Object{
+      {"protocol", "orbit-taskflow-deferred-plan-v1"},
+      {"guard", serializeTaskflowSpecialization(result.specialization)},
+      {"shape_domain",
+       llvm::json::Object{{"rows", result.plan.shapeDomain.rows},
+                          {"cols", result.plan.shapeDomain.cols},
+                          {"axes", std::move(axes)}}},
+      {"initial_replay",
+       serializeSourceSearchReplay(result.plan.function, "source",
+                                   "guarded-specialization-v1", {},
+                                   result.plan.initialShapes)},
+      {"replay",
+       serializeSourceSearchReplay(result.plan.function, "source",
+                                   "guarded-specialization-v1",
+                                   result.plan.actions, result.shapes)},
+      {"transformed_source_fingerprint",
+       result.normalization.sourceFingerprint},
+      {"normalized_fingerprint", result.normalization.normalizedFingerprint}};
+}
+} // namespace orbit::taskflow
diff --git a/lib/Taskflow/TaskflowFission.cpp b/lib/Taskflow/TaskflowFission.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..66401cf17fbd863df25389997c80ecf5bec837ac
--- /dev/null
+++ b/lib/Taskflow/TaskflowFission.cpp
@@ -0,0 +1,1489 @@
+#include "Taskflow/TaskflowReplica.h"
+//===- TaskflowFission.cpp - Source-owned DFG fission -----------*- C++ -*-===//
+//
+// Splits a hyperblock DFG at a stable predecessor-closed node partition and
+// materializes every live scalar cut edge in a static tensor indexed by the
+// unchanged counter domain.
+// The two derived tasks therefore retain canonical counter/hyperblock form,
+// and their temporary write/read state is an explicit Taskflow RAW edge.
+//
+//===----------------------------------------------------------------------===//
+
+#include "Taskflow/SourceIterationDomain.h"
+#include "Taskflow/TaskflowFission.h"
+#include "TaskflowDialect/TaskflowOps.h"
+
+#include "mlir/Dialect/Affine/IR/AffineOps.h"
+#include "mlir/Dialect/Arith/IR/Arith.h"
+#include "mlir/Dialect/Func/IR/FuncOps.h"
+#include "mlir/Dialect/MemRef/IR/MemRef.h"
+#include "mlir/Dialect/SCF/IR/SCF.h"
+#include "mlir/IR/BuiltinOps.h"
+#include "mlir/IR/IRMapping.h"
+#include "mlir/IR/SymbolTable.h"
+#include "mlir/IR/Verifier.h"
+#include "mlir/Interfaces/SideEffectInterfaces.h"
+#include "mlir/Pass/Pass.h"
+
+#include "llvm/ADT/DenseMap.h"
+#include "llvm/ADT/DenseSet.h"
+#include "llvm/ADT/STLExtras.h"
+#include "llvm/ADT/SmallVector.h"
+#include "llvm/ADT/StringExtras.h"
+#include "llvm/Support/raw_ostream.h"
+
+#include <algorithm>
+#include <cstdint>
+#include <functional>
+#include <limits>
+#include <optional>
+#include <set>
+#include <sstream>
+#include <string>
+
+using namespace mlir;
+using namespace mlir::taskflow;
+
+namespace {
+
+constexpr StringLiteral kParentTaskAttr = "amoeba.fission.parent_task";
+constexpr StringLiteral kLeftNodesAttr = "amoeba.fission.left_nodes";
+constexpr StringLiteral kPartIndexAttr = "amoeba.fission.part_index";
+constexpr StringLiteral kControlPredecessorsAttr =
+    "amoeba.control_predecessors";
+constexpr StringLiteral kNoAliasAttr = "amoeba.noalias";
+constexpr StringLiteral kSourceIterationDomainAttr =
+    "amoeba.source_iteration_domain";
+constexpr StringLiteral kSourceIterationCapturePendingAttr =
+    "amoeba.source_iteration_capture_pending";
+constexpr StringLiteral kSourceIterationControlBindingAttr =
+    "amoeba.source_iteration_control_binding";
+constexpr StringLiteral kSourceIterationSourceControlBindingAttr =
+    "amoeba.source_iteration_source_control_binding";
+constexpr StringLiteral kDlpReplicableAttr = "dlp_replicable";
+constexpr StringLiteral kRuntimeManageableAttr = "runtime_managable";
+
+struct FissionPlan {
+  TaskflowTaskOp task;
+  SmallVector<TaskflowCounterOp> counters;
+  TaskflowHyperblockOp hyperblock;
+  TaskflowYieldOp taskYield;
+  SmallVector<Operation *> nodes;
+  SmallVector<Value> interfaceValues;
+  DenseMap<Value, unsigned> producers;
+  SmallVector<SmallVector<unsigned>> predecessors;
+  SmallVector<int64_t> shape;
+  SmallVector<unsigned> leftNodes;
+  SmallVector<unsigned> rightNodes;
+  SmallVector<unsigned> prefixOutputs;
+  SmallVector<unsigned> suffixOutputs;
+  SmallVector<unsigned> prefixCarries;
+  SmallVector<unsigned> suffixCarries;
+  SmallVector<unsigned> prefixValues, suffixValues;
+  scf::IfOp initialization;
+  arith::CmpIOp initializationCondition;
+  bool hasInPlaceState = false;
+};
+
+static std::optional<int64_t> constantIndex(Value value, TaskflowTaskOp task) {
+  DenseSet<Value> active;
+  return mlir::taskflow::sourceStaticIndex(value, task, active);
+}
+
+// The source capture is pending until the target lowering
+// binds it to the current control/body. Fission may duplicate that pending
+// capture only when its represented axes are independently rederived from the
+// exact Taskflow counter bounds that remain in both children. Internal axes
+// and already-bound certificates are outside this canonical source form.
+static LogicalResult
+validatePendingSourceIterationDomain(TaskflowTaskOp task,
+                                     ArrayRef<TaskflowCounterOp> counters,
+                                     std::string &error) {
+  bool hasDomain = task->hasAttr(kSourceIterationDomainAttr);
+  bool hasPending = task->hasAttr(kSourceIterationCapturePendingAttr);
+  if (!hasDomain && !hasPending)
+    return success();
+  if (!isa_and_nonnull<DictionaryAttr>(
+          task->getAttr(kSourceIterationDomainAttr)) ||
+      !isa_and_nonnull<UnitAttr>(
+          task->getAttr(kSourceIterationCapturePendingAttr)) ||
+      task->hasAttr(kSourceIterationControlBindingAttr) ||
+      task->hasAttr(kSourceIterationSourceControlBindingAttr)) {
+    error = "fission requires an unbound pending source iteration-domain "
+            "capture";
+    return failure();
+  }
+
+  FailureOr<mlir::taskflow::SourceIterationDomainInfo> source =
+      mlir::taskflow::parseSourceIterationDomain(task, error);
+  if (failed(source))
+    return failure();
+  auto &info = *source;
+  if (!info.complete || info.axes.size() != counters.size() ||
+      info.internalMultiplicity != 1) {
+    error = "fission source iteration-domain capture does not describe only "
+            "the current Taskflow counters";
+    return failure();
+  }
+
+  int64_t representedMultiplicity = 1;
+  for (auto [index, counterHandle] : llvm::enumerate(counters)) {
+    TaskflowCounterOp counter = counterHandle;
+    std::optional<int64_t> lower = constantIndex(counter.getLowerBound(), task);
+    std::optional<int64_t> upper = constantIndex(counter.getUpperBound(), task);
+    std::optional<int64_t> step = constantIndex(counter.getStep(), task);
+    const auto &axis = info.axes[index];
+    if (!lower || !upper || !step || *step <= 0 || *upper <= *lower ||
+        (*lower < 0 && *upper > std::numeric_limits<int64_t>::max() + *lower)) {
+      error = "fission cannot rederive a static captured Taskflow counter axis";
+      return failure();
+    }
+    int64_t distance = *upper - *lower;
+    int64_t extent = 1 + (distance - 1) / *step;
+    if (!axis.representedByTaskflow || axis.ordinal != index ||
+        axis.lower != *lower || axis.upper != *upper || axis.step != *step ||
+        axis.extent != extent || axis.expandedInsideMapperFiring ||
+        axis.parentCounterOrdinal != -1 || axis.carriedValues != 0 ||
+        axis.resultUses != 0 ||
+        !mlir::taskflow::checkedMultiply(representedMultiplicity, extent,
+                                         representedMultiplicity)) {
+      error = "fission source iteration-domain capture disagrees with the "
+              "current Taskflow counter chain";
+      return failure();
+    }
+  }
+  if (representedMultiplicity != info.representedMultiplicity ||
+      representedMultiplicity != info.sourceMultiplicity) {
+    error = "fission source iteration-domain multiplicity does not match "
+            "the current Taskflow counter chain";
+    return failure();
+  }
+  return success();
+}
+
+static bool isStructuralOrSafeTaskAttribute(NamedAttribute attribute) {
+  StringRef name = attribute.getName().strref();
+  if (name.starts_with("orbit.replica.") ||
+      name.starts_with("amoeba.tiling.") || name == "orbit.placement")
+    return true;
+  if (name == kParentTaskAttr)
+    return isa<StringAttr>(attribute.getValue());
+  if (name == kLeftNodesAttr)
+    return isa<DenseI64ArrayAttr>(attribute.getValue());
+  if (name == kPartIndexAttr) {
+    auto part = dyn_cast<IntegerAttr>(attribute.getValue());
+    return part && (part.getInt() == 0 || part.getInt() == 1);
+  }
+  if (name == kDlpReplicableAttr || name == kRuntimeManageableAttr)
+    return isa<BoolAttr>(attribute.getValue());
+  if (name == kSourceIterationDomainAttr)
+    return isa<DictionaryAttr>(attribute.getValue());
+  if (name == kSourceIterationCapturePendingAttr)
+    return isa<UnitAttr>(attribute.getValue());
+  return name == "task_name" || name == "operandSegmentSizes" ||
+         name == "resultSegmentSizes" || name == "operand_segment_sizes" ||
+         name == "result_segment_sizes";
+}
+
+static bool isStorableScalar(Type type) { return type.isIntOrIndexOrFloat(); }
+
+static Value canonicalStorageRoot(Value value) {
+  DenseSet<Operation *> visited;
+  while (auto cast = value.getDefiningOp<memref::CastOp>()) {
+    if (!visited.insert(cast.getOperation()).second)
+      return Value();
+    value = cast.getSource();
+  }
+  return value;
+}
+
+static bool isNoAliasFunctionArgument(Value value) {
+  auto argument = dyn_cast<BlockArgument>(canonicalStorageRoot(value));
+  if (!argument)
+    return false;
+  auto function =
+      dyn_cast_or_null<func::FuncOp>(argument.getOwner()->getParentOp());
+  if (!function || argument.getOwner() != &function.getBody().front())
+    return false;
+  Attribute proof = function.getArgAttr(argument.getArgNumber(), kNoAliasAttr);
+  if (auto boolean = dyn_cast_or_null<BoolAttr>(proof))
+    return boolean.getValue();
+  return isa_and_nonnull<UnitAttr>(proof);
+}
+
+static bool provesDistinctStorage(Value lhs, Value rhs) {
+  lhs = canonicalStorageRoot(lhs);
+  rhs = canonicalStorageRoot(rhs);
+  if (!lhs || !rhs || lhs == rhs)
+    return false;
+  Operation *lhsDefinition = lhs.getDefiningOp();
+  Operation *rhsDefinition = rhs.getDefiningOp();
+  bool lhsAllocation =
+      lhsDefinition && isa<memref::AllocOp, memref::AllocaOp>(lhsDefinition);
+  bool rhsAllocation =
+      rhsDefinition && isa<memref::AllocOp, memref::AllocaOp>(rhsDefinition);
+  if (lhsAllocation && rhsAllocation)
+    return lhsDefinition != rhsDefinition;
+  if (lhsAllocation && isNoAliasFunctionArgument(rhs))
+    return true;
+  if (rhsAllocation && isNoAliasFunctionArgument(lhs))
+    return true;
+  return isNoAliasFunctionArgument(lhs) && isNoAliasFunctionArgument(rhs);
+}
+
+static bool isNamedControlPredecessor(TaskflowTaskOp task) {
+  auto function = task->getParentOfType<func::FuncOp>();
+  if (!function || task->hasAttr(kControlPredecessorsAttr))
+    return true;
+  bool referenced = false;
+  function.walk([&](TaskflowTaskOp consumer) {
+    Attribute attribute = consumer->getAttr(kControlPredecessorsAttr);
+    if (!attribute)
+      return;
+    auto names = dyn_cast<ArrayAttr>(attribute);
+    if (!names) {
+      referenced = true;
+      return;
+    }
+    for (Attribute nameAttribute : names) {
+      StringRef name;
+      if (auto string = dyn_cast<StringAttr>(nameAttribute))
+        name = string.getValue();
+      else if (auto symbol = dyn_cast<FlatSymbolRefAttr>(nameAttribute))
+        name = symbol.getValue();
+      else {
+        referenced = true;
+        return;
+      }
+      referenced |= name == task.getTaskName();
+    }
+  });
+  return referenced;
+}
+
+static bool hasFissionTaskNameCollision(TaskflowTaskOp task) {
+  auto function = task->getParentOfType<func::FuncOp>();
+  if (!function)
+    return true;
+  std::string prefixName = (Twine(task.getTaskName()) + ".split.0").str();
+  std::string suffixName = (Twine(task.getTaskName()) + ".split.1").str();
+  bool collision = false;
+  function.walk([&](TaskflowTaskOp other) {
+    collision |= other != task && (other.getTaskName() == prefixName ||
+                                   other.getTaskName() == suffixName);
+  });
+  return collision;
+}
+
+// A structured conditional is one indivisible DFG node. Its implicit
+// captures are real graph edges; values private to its regions are not cuts.
+static SmallVector<Value> nodeInputs(Operation *node) {
+  SmallVector<Value> inputs;
+  node->walk([&](Operation *operation) {
+    for (Value value : operation->getOperands()) {
+      bool internal = false;
+      if (Operation *definition = value.getDefiningOp())
+        internal = definition == node || node->isProperAncestor(definition);
+      else if (auto argument = dyn_cast<BlockArgument>(value)) {
+        Operation *owner = argument.getOwner()->getParentOp();
+        internal = owner == node || node->isProperAncestor(owner);
+      }
+      if (!internal && !llvm::is_contained(inputs, value))
+        inputs.push_back(value);
+    }
+  });
+  return inputs;
+}
+
+static FailureOr<FissionPlan> analyzeFission(TaskflowTaskOp task,
+                                             std::string &error) {
+  FissionPlan plan;
+  plan.task = task;
+  if (!task || !task.getBody().hasOneBlock()) {
+    error = "fission requires a selected single-block task";
+    return failure();
+  }
+  if (failed(orbit::taskflow::validateTaskflowReplicaContract(task, error)))
+    return failure();
+  if (isNamedControlPredecessor(task)) {
+    error = "fission rejects tasks named by unsupported control edges";
+    return failure();
+  }
+  if (hasFissionTaskNameCollision(task)) {
+    error = "fission-derived task name collides with an existing task";
+    return failure();
+  }
+  if (task.getDoneReads().size() > task.getWillReads().size() ||
+      task.getWillWrites().empty() ||
+      task.getDoneWrites().size() != task.getWillWrites().size() ||
+      task.getOriginalWriteMemrefs().size() != task.getWillWrites().size() ||
+      task.getOriginalReadMemrefs().size() != task.getWillReads().size()) {
+    error = "fission requires tensor write results, matching read/write "
+            "provenance, canonical read completions and no value result";
+    return failure();
+  }
+  for (NamedAttribute attribute : task->getAttrs())
+    if (!isStructuralOrSafeTaskAttribute(attribute)) {
+      error = "fission rejects unsupported task state attribute " +
+              attribute.getName().str();
+      return failure();
+    }
+  for (Value input : task.getOriginalReadMemrefs())
+    for (Value output : task.getOriginalWriteMemrefs())
+      if (input == output)
+        plan.hasInPlaceState = true;
+      else if (!provesDistinctStorage(input, output)) {
+        error = "fission requires exact same-coordinate roots or proven "
+                "distinct storage";
+        return failure();
+      }
+
+  for (auto [index, output] : llvm::enumerate(task.getOriginalWriteMemrefs()))
+    for (Value other : task.getOriginalWriteMemrefs().drop_front(index + 1))
+      if (!provesDistinctStorage(output, other)) {
+        error = "fission requires pairwise disjoint output storage";
+        return failure();
+      }
+
+  for (Operation &operation : task.getBody().front()) {
+    if (auto counter = dyn_cast<TaskflowCounterOp>(&operation)) {
+      plan.counters.push_back(counter);
+    } else if (auto hyperblock = dyn_cast<TaskflowHyperblockOp>(&operation)) {
+      if (plan.hyperblock) {
+        error = "fission requires exactly one hyperblock";
+        return failure();
+      }
+      plan.hyperblock = hyperblock;
+    } else if (auto yield = dyn_cast<TaskflowYieldOp>(&operation)) {
+      plan.taskYield = yield;
+    } else if (!isa<arith::ConstantOp>(&operation)) {
+      error = "fission requires canonical counters and one hyperblock";
+      return failure();
+    }
+  }
+  if (!plan.hyperblock || !plan.taskYield || plan.counters.empty() ||
+      plan.hyperblock.getIndices().size() != plan.counters.size()) {
+    error = "fission rejects recurrence or a non-canonical counter domain";
+    return failure();
+  }
+  auto hyperYield = dyn_cast<TaskflowHyperblockYieldOp>(
+      plan.hyperblock.getBody().front().getTerminator());
+  if (!hyperYield ||
+      llvm::any_of(plan.hyperblock->getUsers(),
+                   [&](Operation *user) {
+                     return user != plan.taskYield.getOperation();
+                   }) ||
+      hyperYield.getIterArgsNext().size() !=
+          plan.hyperblock.getIterArgs().size() ||
+      hyperYield.getResults().size() != plan.hyperblock.getNumResults()) {
+    error =
+        "fission requires complete recurrence and last-iteration result slots";
+    return failure();
+  }
+  Block &taskBody = task.getBody().front();
+  size_t expectedArguments = task.getWillReads().size() +
+                             task.getWillWrites().size() +
+                             task.getValueInputs().size();
+  if (taskBody.getNumArguments() != expectedArguments ||
+      plan.taskYield.getDoneReads().size() != task.getDoneReads().size() ||
+      !llvm::equal(
+          plan.taskYield.getDoneReads(),
+          taskBody.getArguments().take_front(task.getDoneReads().size())) ||
+      plan.taskYield.getDoneWrites().size() != task.getWillWrites().size() ||
+      !llvm::equal(
+          plan.taskYield.getDoneWrites(),
+          taskBody.getArguments().slice(task.getWillReads().size(),
+                                        task.getWillWrites().size())) ||
+      llvm::any_of(plan.taskYield.getValueResults(), [&](Value value) {
+        return value.getDefiningOp() != plan.hyperblock.getOperation();
+      })) {
+    error = "fission requires task operands and yield to directly mirror "
+            "tensor state";
+    return failure();
+  }
+  for (auto [index, counter] : llvm::enumerate(plan.counters)) {
+    std::optional<int64_t> lower = constantIndex(counter.getLowerBound(), task);
+    std::optional<int64_t> upper = constantIndex(counter.getUpperBound(), task);
+    std::optional<int64_t> step = constantIndex(counter.getStep(), task);
+    if (!lower || !upper || !step || *lower < 0 || *step != 1 ||
+        *upper <= *lower || (index == 0 && counter.getParentIndex()) ||
+        (index != 0 && counter.getParentIndex() !=
+                           plan.counters[index - 1].getCounterIndex()) ||
+        plan.hyperblock.getIndices()[index] != counter.getCounterIndex()) {
+      error = "fission requires a nonnegative static unit-step counter chain";
+      return failure();
+    }
+    plan.shape.push_back(*upper);
+  }
+  if (failed(validatePendingSourceIterationDomain(task, plan.counters, error)))
+    return failure();
+
+  Block &hyperblockBody = plan.hyperblock.getBody().front();
+  DenseSet<Value> arguments(hyperblockBody.getArguments().begin(),
+                            hyperblockBody.getArguments().end());
+  DenseSet<Value> scaffoldConstants;
+  for (Operation &operation : taskBody)
+    if (isa<arith::ConstantOp>(&operation))
+      for (Value result : operation.getResults())
+        scaffoldConstants.insert(result);
+  // Recognize the source's joint reduction reset as an effect scaffold.
+  // It may be duplicated only after filtering disjoint output stores by owner;
+  // no predicate, side effect or recurrence update is dropped.
+  for (Operation &operation : hyperblockBody.without_terminator()) {
+    auto conditional = dyn_cast<scf::IfOp>(&operation);
+    if (!conditional)
+      continue;
+    auto compare = conditional.getCondition().getDefiningOp<arith::CmpIOp>();
+    bool reset =
+        !plan.initialization && !conditional.getNumResults() &&
+        conditional.getElseRegion().empty() && compare &&
+        compare.getResult().hasOneUse() &&
+        llvm::all_of(compare.getOperands(), [&](Value value) {
+          return scaffoldConstants.contains(value) ||
+                 llvm::is_contained(hyperblockBody.getArguments().take_front(
+                                        plan.counters.size()),
+                                    value);
+        });
+    if (!reset)
+      continue;
+    for (Operation &effect :
+         conditional.getThenRegion().front().without_terminator()) {
+      auto store = dyn_cast<memref::StoreOp>(&effect);
+      auto outputs = taskBody.getArguments().slice(task.getWillReads().size(),
+                                                   task.getWillWrites().size());
+      auto stored = store ? dyn_cast<BlockArgument>(store.getValueToStore())
+                          : BlockArgument();
+      reset &=
+          store && llvm::is_contained(outputs, store.getMemRef()) &&
+          (scaffoldConstants.contains(store.getValueToStore()) ||
+           (stored && stored.getOwner() == &taskBody &&
+            stored.getArgNumber() >=
+                task.getWillReads().size() + task.getWillWrites().size())) &&
+          llvm::all_of(store.getIndices(), [&](Value value) {
+            return llvm::is_contained(
+                hyperblockBody.getArguments().take_front(plan.counters.size()),
+                value);
+          });
+    }
+    // Other conditionals remain intact as ordinary atomic DFG nodes.
+    if (!reset || &hyperblockBody.front() != compare.getOperation() ||
+        compare->getNextNode() != conditional.getOperation())
+      continue;
+    plan.initialization = conditional;
+    plan.initializationCondition = compare;
+  }
+  for (Operation &operation : hyperblockBody.without_terminator()) {
+    if (&operation == plan.initialization.getOperation() ||
+        &operation == plan.initializationCondition.getOperation())
+      continue;
+    bool valid = true;
+    operation.walk([&](Operation *effect) {
+      if (isa<scf::IfOp, scf::YieldOp>(effect))
+        return;
+      if (effect->getNumRegions() ||
+          (!isa<memref::LoadOp, memref::StoreOp>(effect) &&
+           (!isPure(effect) || !isMemoryEffectFree(effect)))) {
+        valid = false;
+        return;
+      }
+      if (auto load = dyn_cast<memref::LoadOp>(effect)) {
+        bool known = false;
+        for (unsigned index = 0; index < task.getWillReads().size(); ++index)
+          known |= load.getMemRef() == taskBody.getArgument(index);
+        valid &= known;
+        auto argument = dyn_cast<BlockArgument>(load.getMemRef());
+        if (argument && argument.getOwner() == &taskBody &&
+            argument.getArgNumber() < task.getOriginalReadMemrefs().size() &&
+            llvm::is_contained(
+                task.getOriginalWriteMemrefs(),
+                task.getOriginalReadMemrefs()[argument.getArgNumber()]))
+          valid &= llvm::equal(
+              load.getIndices(),
+              hyperblockBody.getArguments().take_front(plan.counters.size()));
+      }
+      if (auto store = dyn_cast<memref::StoreOp>(effect)) {
+        auto outputs = taskBody.getArguments().slice(
+            task.getWillReads().size(), task.getWillWrites().size());
+        DenseSet<Value> indices(store.getIndices().begin(),
+                                store.getIndices().end());
+        if (auto argument = dyn_cast<BlockArgument>(store.getMemRef())) {
+          unsigned slot = argument.getArgNumber() - task.getWillReads().size();
+          if (argument.getOwner() == &taskBody &&
+              slot < task.getOriginalWriteMemrefs().size() &&
+              llvm::is_contained(task.getOriginalReadMemrefs(),
+                                 task.getOriginalWriteMemrefs()[slot]))
+            valid &= llvm::equal(
+                store.getIndices(),
+                hyperblockBody.getArguments().take_front(plan.counters.size()));
+        }
+        valid &= llvm::is_contained(outputs, store.getMemRef()) &&
+                 !store.getIndices().empty() &&
+                 indices.size() == store.getIndices().size() &&
+                 llvm::all_of(store.getIndices(),
+                              [&](Value index) {
+                                return llvm::is_contained(
+                                    hyperblockBody.getArguments().take_front(
+                                        plan.counters.size()),
+                                    index);
+                              }) &&
+                 (!plan.hyperblock.getIterArgs().empty() ||
+                  indices.size() == plan.counters.size());
+      }
+    });
+    if (!valid) {
+      error = "fission requires declared memory, injective stores and "
+              "indivisible structured-if boundaries without unknown effects";
+      return failure();
+    }
+    unsigned nodeIndex = plan.nodes.size();
+    for (Value operand : nodeInputs(&operation)) {
+      if (arguments.contains(operand) || scaffoldConstants.contains(operand))
+        continue;
+      if (auto argument = dyn_cast<BlockArgument>(operand)) {
+        if (argument.getOwner() != &taskBody) {
+          error = "fission rejects a value captured from outside the task";
+          return failure();
+        }
+        continue;
+      }
+      auto producer = plan.producers.find(operand);
+      if (producer == plan.producers.end() || producer->second >= nodeIndex) {
+        error = "fission rejects a backward or unknown DFG edge";
+        return failure();
+      }
+    }
+    for (Value result : operation.getResults())
+      plan.producers[result] = nodeIndex;
+    plan.nodes.push_back(&operation);
+  }
+  if (plan.nodes.size() < 2) {
+    error = "fission requires at least two hyperblock DFG operations";
+    return failure();
+  }
+  plan.predecessors.resize(plan.nodes.size());
+  for (auto [index, node] : llvm::enumerate(plan.nodes)) {
+    for (Value operand : nodeInputs(node)) {
+      auto producer = plan.producers.find(operand);
+      if (producer != plan.producers.end())
+        plan.predecessors[index].push_back(producer->second);
+    }
+    llvm::sort(plan.predecessors[index]);
+    plan.predecessors[index].erase(std::unique(plan.predecessors[index].begin(),
+                                               plan.predecessors[index].end()),
+                                   plan.predecessors[index].end());
+  }
+  return plan;
+}
+
+static bool taskArgumentAvailableInStage(Value value, TaskflowTaskOp task,
+                                         bool prefix) {
+  auto argument = dyn_cast<BlockArgument>(value);
+  if (!argument || argument.getOwner() != &task.getBody().front())
+    return false;
+  unsigned index = argument.getArgNumber();
+  if (index < task.getWillReads().size())
+    return true;
+  index -= task.getWillReads().size();
+  if (index < task.getWillWrites().size())
+    return true; // Output ownership is checked for the complete partition.
+  index -= task.getWillWrites().size();
+  return index < task.getValueInputs().size();
+}
+
+static LogicalResult validatePartition(FissionPlan &plan,
+                                       ArrayRef<unsigned> leftNodes,
+                                       std::string &error) {
+  plan.leftNodes.clear();
+  plan.rightNodes.clear();
+  plan.interfaceValues.clear();
+  plan.prefixOutputs.clear();
+  plan.suffixOutputs.clear();
+  plan.prefixCarries.clear();
+  plan.suffixCarries.clear();
+  plan.leftNodes.append(leftNodes.begin(), leftNodes.end());
+  if (leftNodes.empty() || leftNodes.size() >= plan.nodes.size()) {
+    error =
+        "left-nodes must select a non-empty proper hyperblock DFG partition";
+    return failure();
+  }
+  SmallVector<bool> isLeft(plan.nodes.size(), false);
+  unsigned previous = 0;
+  for (auto [position, index] : llvm::enumerate(leftNodes)) {
+    if (index >= plan.nodes.size() || (position != 0 && index <= previous)) {
+      error = "left-nodes must be unique increasing hyperblock node ordinals";
+      return failure();
+    }
+    previous = index;
+    isLeft[index] = true;
+  }
+  Block &taskBody = plan.task.getBody().front();
+  for (unsigned index = 0; index < plan.nodes.size(); ++index) {
+    if (!isLeft[index]) {
+      plan.rightNodes.push_back(index);
+      continue;
+    }
+    Operation *node = plan.nodes[index];
+    for (Value operand : nodeInputs(node)) {
+      if (auto argument = dyn_cast<BlockArgument>(operand)) {
+        if (argument.getOwner() == &plan.hyperblock.getBody().front())
+          continue;
+        if (argument.getOwner() != &taskBody ||
+            !taskArgumentAvailableInStage(operand, plan.task, true)) {
+          error = "fission prefix depends on task state unavailable before "
+                  "the output write";
+          return failure();
+        }
+      }
+      auto producer = plan.producers.find(operand);
+      if (producer != plan.producers.end() && !isLeft[producer->second]) {
+        error = "left-nodes must be predecessor closed";
+        return failure();
+      }
+    }
+  }
+  if (!llvm::any_of(plan.rightNodes, [&](unsigned index) {
+        bool store = false;
+        plan.nodes[index]->walk([&](memref::StoreOp) { store = true; });
+        return store;
+      })) {
+    error = "fission suffix must retain the tensor write";
+    return failure();
+  }
+  // Every public output has exactly one owner. Splitting writes to the same
+  // tensor across stages would reorder observable effects and is rejected.
+  SmallVector<int> outputOwners(plan.task.getWillWrites().size(), -1);
+  bool splitOutput = false;
+  for (auto [index, node] : llvm::enumerate(plan.nodes))
+    node->walk([&](memref::StoreOp store) {
+      unsigned output = cast<BlockArgument>(store.getMemRef()).getArgNumber() -
+                        plan.task.getWillReads().size();
+      int owner = isLeft[index] ? 0 : 1;
+      splitOutput |=
+          outputOwners[output] != -1 && outputOwners[output] != owner;
+      outputOwners[output] = owner;
+    });
+  if (splitOutput) {
+    error = "fission output writes must have one partition owner";
+    return failure();
+  }
+  for (auto [index, owner] : llvm::enumerate(outputOwners)) {
+    if (owner == -1) {
+      error = "fission declared output has no owned store";
+      return failure();
+    }
+    (owner == 0 ? plan.prefixOutputs : plan.suffixOutputs).push_back(index);
+  }
+  for (unsigned index : plan.rightNodes)
+    for (Value operand : nodeInputs(plan.nodes[index])) {
+      if (auto argument = dyn_cast<BlockArgument>(operand)) {
+        if (argument.getOwner() != &plan.hyperblock.getBody().front() &&
+            (argument.getOwner() != &taskBody ||
+             !taskArgumentAvailableInStage(operand, plan.task, false))) {
+          error = "fission suffix depends on task state outside its inputs";
+          return failure();
+        }
+      }
+      auto producer = plan.producers.find(operand);
+      if (producer != plan.producers.end() && isLeft[producer->second]) {
+        if (!isStorableScalar(operand.getType())) {
+          error = "fission cut edge has a non-storable value type";
+          return failure();
+        }
+        if (!llvm::is_contained(plan.interfaceValues, operand))
+          plan.interfaceValues.push_back(operand);
+      }
+    }
+  // In-place splitting may reorder different coordinates, never effects on
+  // one coordinate. Require the actual aliased effects to be prefix-then-suffix
+  // in source order, including each intact structured conditional.
+  for (Value root : plan.task.getOriginalWriteMemrefs()) {
+    if (!llvm::is_contained(plan.task.getOriginalReadMemrefs(), root))
+      continue;
+    bool seenSuffix = false;
+    for (auto [ordinal, node] : llvm::enumerate(plan.nodes)) {
+      bool touches = false;
+      node->walk([&](Operation *operation) {
+        Value memory;
+        if (auto load = dyn_cast<memref::LoadOp>(operation))
+          memory = load.getMemRef();
+        if (auto store = dyn_cast<memref::StoreOp>(operation))
+          memory = store.getMemRef();
+        auto argument = dyn_cast_or_null<BlockArgument>(memory);
+        if (!argument || argument.getOwner() != &taskBody)
+          return;
+        unsigned index = argument.getArgNumber();
+        if (index < plan.task.getWillReads().size())
+          touches |= plan.task.getOriginalReadMemrefs()[index] == root;
+        else if (index < plan.task.getWillReads().size() +
+                             plan.task.getWillWrites().size())
+          touches |=
+              plan.task
+                  .getOriginalWriteMemrefs()[index -
+                                             plan.task.getWillReads().size()] ==
+              root;
+      });
+      if (!touches)
+        continue;
+      if (isLeft[ordinal] && seenSuffix) {
+        error = "fission would reverse same-coordinate in-place memory effects";
+        return failure();
+      }
+      seenSuffix |= !isLeft[ordinal];
+    }
+  }
+  // Loop-carried cycles must stay wholly within one stage. In particular a
+  // left-to-right cut is not sufficient proof for a reverse recurrence edge.
+  auto yield = cast<TaskflowHyperblockYieldOp>(
+      plan.hyperblock.getBody().front().getTerminator());
+  for (auto [index, next] : llvm::enumerate(yield.getIterArgsNext())) {
+    auto producer = plan.producers.find(next);
+    Value carried = plan.hyperblock.getBody().front().getArgument(
+        plan.counters.size() + index);
+    if (producer == plan.producers.end()) {
+      auto argument = dyn_cast<BlockArgument>(next);
+      bool invariant =
+          next == carried || next.getDefiningOp<arith::ConstantOp>() ||
+          (argument && argument.getOwner() == &taskBody &&
+           argument.getArgNumber() >= plan.task.getWillReads().size() +
+                                          plan.task.getWillWrites().size());
+      if (!invariant) {
+        error = "fission cannot assign an unproduced recurrence update";
+        return failure();
+      }
+      bool prefix = false, suffix = false;
+      for (OpOperand &use : carried.getUses()) {
+        if (use.getOwner() == yield.getOperation())
+          continue;
+        auto node = llvm::find_if(plan.nodes, [&](Operation *candidate) {
+          return candidate == use.getOwner() ||
+                 candidate->isProperAncestor(use.getOwner());
+        });
+        if (node == plan.nodes.end()) {
+          error = "invariant carry escapes the source DFG";
+          return failure();
+        }
+        (isLeft[node - plan.nodes.begin()] ? prefix : suffix) = true;
+      }
+      // Identity/invariant transitions have no producer SCC to split. Each
+      // reader keeps the identical initial/update state over the same domain.
+      if (prefix || !suffix)
+        plan.prefixCarries.push_back(index);
+      if (suffix)
+        plan.suffixCarries.push_back(index);
+      continue;
+    }
+    bool owner = isLeft[producer->second];
+    for (OpOperand &use : carried.getUses()) {
+      auto found = llvm::find_if(plan.nodes, [&](Operation *node) {
+        return node == use.getOwner() || node->isProperAncestor(use.getOwner());
+      });
+      if (found == plan.nodes.end() ||
+          isLeft[std::distance(plan.nodes.begin(), found)] != owner) {
+        error = "fission partition crosses a loop-carried dependence";
+        return failure();
+      }
+    }
+    (owner ? plan.prefixCarries : plan.suffixCarries).push_back(index);
+  }
+  for (auto [index, value] : llvm::enumerate(yield.getResults())) {
+    auto producer = plan.producers.find(value);
+    bool prefix = true;
+    if (producer != plan.producers.end())
+      prefix = isLeft[producer->second];
+    else if (auto argument = dyn_cast<BlockArgument>(value)) {
+      if (argument.getOwner() == &plan.hyperblock.getBody().front() &&
+          argument.getArgNumber() >= plan.counters.size()) {
+        unsigned carry = argument.getArgNumber() - plan.counters.size();
+        prefix = llvm::is_contained(plan.prefixCarries, carry);
+      }
+    }
+    (prefix ? plan.prefixValues : plan.suffixValues).push_back(index);
+  }
+  // A stage must not capture an output owned by its sibling through a pure
+  // address operation or another operand outside the recognized store path.
+  for (auto [index, node] : llvm::enumerate(plan.nodes))
+    for (Value operand : nodeInputs(node)) {
+      auto argument = dyn_cast<BlockArgument>(operand);
+      if (!argument || argument.getOwner() != &taskBody)
+        continue;
+      unsigned ordinal = argument.getArgNumber();
+      if (ordinal >= plan.task.getWillReads().size() &&
+          ordinal < plan.task.getWillReads().size() +
+                        plan.task.getWillWrites().size() &&
+          outputOwners[ordinal - plan.task.getWillReads().size()] !=
+              (isLeft[index] ? 0 : 1)) {
+        error =
+            "fission stage references an output owned by the other partition";
+        return failure();
+      }
+    }
+  if (plan.interfaceValues.empty() && plan.prefixOutputs.empty()) {
+    error = "fission cut has neither a live DFG edge nor an independently "
+            "owned output";
+    return failure();
+  }
+  return success();
+}
+
+static void setLineage(TaskflowTaskOp source, TaskflowTaskOp target,
+                       OpBuilder &builder, ArrayRef<unsigned> leftNodes,
+                       unsigned partIndex) {
+  for (StringRef name :
+       {kDlpReplicableAttr, kRuntimeManageableAttr, kSourceIterationDomainAttr,
+        kSourceIterationCapturePendingAttr})
+    if (Attribute value = source->getAttr(name))
+      target->setAttr(name, value);
+  orbit::taskflow::copyTaskflowReplicaContract(source, target);
+  if (Attribute placement = source->getAttr("orbit.placement"))
+    target->setAttr("orbit.placement", placement);
+  target->setAttr(kParentTaskAttr, builder.getStringAttr(source.getTaskName()));
+  SmallVector<int64_t> ordinals(leftNodes.begin(), leftNodes.end());
+  target->setAttr(kLeftNodesAttr, builder.getDenseI64ArrayAttr(ordinals));
+  target->setAttr(kPartIndexAttr, builder.getI64IntegerAttr(partIndex));
+}
+
+static void cloneScaffold(FissionPlan &plan, TaskflowTaskOp target,
+                          IRMapping &mapping,
+                          SmallVectorImpl<TaskflowCounterOp> &counters,
+                          OpBuilder &builder) {
+  Block &sourceBody = plan.task.getBody().front();
+  for (Operation &operation : sourceBody) {
+    if (isa<TaskflowHyperblockOp, TaskflowYieldOp>(&operation))
+      continue;
+    Operation *clone = builder.clone(operation, mapping);
+    if (auto counter = dyn_cast<TaskflowCounterOp>(clone))
+      counters.push_back(counter);
+  }
+}
+
+static TaskflowHyperblockOp
+createHyperblock(FissionPlan &plan, ArrayRef<TaskflowCounterOp> counters,
+                 IRMapping &mapping, OpBuilder &builder,
+                 ArrayRef<unsigned> carries, ArrayRef<unsigned> values) {
+  SmallVector<Value> indices;
+  llvm::transform(
+      counters, std::back_inserter(indices),
+      [](TaskflowCounterOp counter) { return counter.getCounterIndex(); });
+  SmallVector<Value> initial;
+  SmallVector<Type> results;
+  for (unsigned index : carries) {
+    initial.push_back(
+        mapping.lookupOrDefault(plan.hyperblock.getIterArgs()[index]));
+  }
+  for (unsigned index : values)
+    results.push_back(plan.hyperblock.getResult(index).getType());
+  auto hyperblock = builder.create<TaskflowHyperblockOp>(
+      plan.task.getLoc(), results, indices, initial);
+  Block *body = &hyperblock.getBody().emplaceBlock();
+  SmallVector<BlockArgument> arguments;
+  auto sourceArguments = plan.hyperblock.getBody().front().getArguments();
+  llvm::append_range(arguments,
+                     sourceArguments.take_front(plan.counters.size()));
+  for (unsigned index : carries)
+    arguments.push_back(sourceArguments[plan.counters.size() + index]);
+  for (BlockArgument sourceArgument : arguments) {
+    BlockArgument argument =
+        body->addArgument(sourceArgument.getType(), plan.task.getLoc());
+    mapping.map(sourceArgument, argument);
+  }
+  return hyperblock;
+}
+
+// A stage owns its original output states and, for the prefix, cut tensors.
+// Only actual cut tensors create prefix->suffix dependencies. Independent
+// disjoint-output branches have no manufactured global completion join.
+static TaskflowTaskOp createStage(FissionPlan &plan, OpBuilder &builder,
+                                  ValueRange temporaries, TaskflowTaskOp prefix,
+                                  bool isPrefix) {
+  auto &owned = isPrefix ? plan.prefixOutputs : plan.suffixOutputs;
+  SmallVector<Value> reads, originalReads, writes, originalWrites;
+  if (!isPrefix) {
+    llvm::append_range(reads,
+                       prefix.getDoneWrites().take_front(temporaries.size()));
+    llvm::append_range(originalReads, temporaries);
+  }
+  SmallVector<unsigned> readIndices;
+  auto &stageNodes = isPrefix ? plan.leftNodes : plan.rightNodes;
+  Block &sourceBody = plan.task.getBody().front();
+  for (unsigned index = 0; index < plan.task.getWillReads().size(); ++index) {
+    Value argument = sourceBody.getArgument(index);
+    bool used = llvm::any_of(argument.getUses(), [&](OpOperand &use) {
+      return llvm::any_of(stageNodes,
+                          [&](unsigned ordinal) {
+                            Operation *node = plan.nodes[ordinal];
+                            return node == use.getOwner() ||
+                                   node->isProperAncestor(use.getOwner());
+                          }) ||
+             (!isa<TaskflowYieldOp>(use.getOwner()) &&
+              !plan.hyperblock->isProperAncestor(use.getOwner()));
+    });
+    bool observed = index < plan.task.getDoneReads().size() &&
+                    !plan.task.getDoneReads()[index].use_empty();
+    if (!used && !observed)
+      continue;
+    readIndices.push_back(index);
+    Value readState = plan.task.getWillReads()[index];
+    if (!isPrefix)
+      for (auto [position, output] : llvm::enumerate(plan.prefixOutputs))
+        if (plan.task.getOriginalWriteMemrefs()[output] ==
+            plan.task.getOriginalReadMemrefs()[index])
+          readState = prefix.getDoneWrites()[temporaries.size() + position];
+    reads.push_back(readState);
+    originalReads.push_back(plan.task.getOriginalReadMemrefs()[index]);
+  }
+  if (isPrefix && plan.hasInPlaceState)
+    for (auto [index, state] : llvm::enumerate(plan.task.getWillWrites()))
+      if (llvm::is_contained(plan.task.getOriginalReadMemrefs(),
+                             plan.task.getOriginalWriteMemrefs()[index]) &&
+          !llvm::is_contained(reads, state)) {
+        reads.push_back(state);
+        originalReads.push_back(plan.task.getOriginalWriteMemrefs()[index]);
+      }
+  if (isPrefix) {
+    llvm::append_range(writes, temporaries);
+    llvm::append_range(originalWrites, temporaries);
+  }
+  for (unsigned index : owned) {
+    Value state = plan.task.getWillWrites()[index];
+    if (!isPrefix && plan.hasInPlaceState)
+      for (auto [input, root] :
+           llvm::enumerate(prefix.getOriginalReadMemrefs()))
+        if (root == plan.task.getOriginalWriteMemrefs()[index]) {
+          state = prefix.getDoneReads()[input];
+          break;
+        }
+    writes.push_back(state);
+    originalWrites.push_back(plan.task.getOriginalWriteMemrefs()[index]);
+  }
+  SmallVector<Type> resultTypes;
+  for (Value write : writes)
+    resultTypes.push_back(write.getType());
+  auto &stageValues = isPrefix ? plan.prefixValues : plan.suffixValues;
+  SmallVector<Type> carryTypes;
+  for (unsigned index : stageValues)
+    carryTypes.push_back(plan.hyperblock.getResult(index).getType());
+  auto stage = builder.create<TaskflowTaskOp>(
+      plan.task.getLoc(), TypeRange(reads), resultTypes, carryTypes, reads,
+      writes, plan.task.getValueInputs(),
+      builder.getStringAttr((Twine(plan.task.getTaskName()) +
+                             (isPrefix ? ".split.0" : ".split.1"))
+                                .str()),
+      originalReads, originalWrites);
+  Block *body = new Block();
+  stage.getBody().push_back(body);
+  SmallVector<Value> operands(reads);
+  llvm::append_range(operands, writes);
+  llvm::append_range(operands, plan.task.getValueInputs());
+  for (Value operand : operands)
+    body->addArgument(operand.getType(), plan.task.getLoc());
+  IRMapping mapping;
+  Block &source = plan.task.getBody().front();
+  unsigned inputOffset = isPrefix ? 0 : temporaries.size();
+  for (auto [position, index] : llvm::enumerate(readIndices))
+    mapping.map(source.getArgument(index),
+                body->getArgument(inputOffset + position));
+  unsigned writeOffset = reads.size() + (isPrefix ? temporaries.size() : 0);
+  for (auto [position, index] : llvm::enumerate(owned))
+    mapping.map(source.getArgument(plan.task.getWillReads().size() + index),
+                body->getArgument(writeOffset + position));
+  unsigned sourceValues =
+      plan.task.getWillReads().size() + plan.task.getWillWrites().size();
+  for (unsigned index = 0; index < plan.task.getValueInputs().size(); ++index)
+    mapping.map(source.getArgument(sourceValues + index),
+                body->getArgument(reads.size() + writes.size() + index));
+  OpBuilder bodyBuilder = OpBuilder::atBlockEnd(body);
+  SmallVector<TaskflowCounterOp> counters;
+  cloneScaffold(plan, stage, mapping, counters, bodyBuilder);
+  auto &carries = isPrefix ? plan.prefixCarries : plan.suffixCarries;
+  auto hyperblock = createHyperblock(plan, counters, mapping, bodyBuilder,
+                                     carries, stageValues);
+  Block &hyperblockBody = hyperblock.getBody().front();
+  OpBuilder kernelBuilder = OpBuilder::atBlockEnd(&hyperblockBody);
+  if (plan.initialization) {
+    Operation *compare =
+        kernelBuilder.clone(*plan.initializationCondition, mapping);
+    auto conditional = kernelBuilder.create<scf::IfOp>(
+        plan.task.getLoc(), compare->getResult(0), false);
+    OpBuilder resetBuilder = conditional.getThenBodyBuilder();
+    for (Operation &effect :
+         plan.initialization.getThenRegion().front().without_terminator()) {
+      auto store = cast<memref::StoreOp>(effect);
+      unsigned output = cast<BlockArgument>(store.getMemRef()).getArgNumber() -
+                        plan.task.getWillReads().size();
+      if (llvm::is_contained(owned, output))
+        resetBuilder.clone(effect, mapping);
+    }
+  }
+  if (!isPrefix)
+    for (auto [index, interfaceValue] : llvm::enumerate(plan.interfaceValues)) {
+      Value loaded = kernelBuilder.create<memref::LoadOp>(
+          plan.task.getLoc(), body->getArgument(index),
+          hyperblockBody.getArguments().take_front(plan.counters.size()));
+      mapping.map(interfaceValue, loaded);
+    }
+  for (unsigned index : isPrefix ? plan.leftNodes : plan.rightNodes)
+    kernelBuilder.clone(*plan.nodes[index], mapping);
+  if (isPrefix)
+    for (auto [index, interfaceValue] : llvm::enumerate(plan.interfaceValues))
+      kernelBuilder.create<memref::StoreOp>(
+          plan.task.getLoc(), mapping.lookup(interfaceValue),
+          body->getArgument(reads.size() + index),
+          hyperblockBody.getArguments().take_front(plan.counters.size()));
+  auto originalYield = cast<TaskflowHyperblockYieldOp>(
+      plan.hyperblock.getBody().front().getTerminator());
+  SmallVector<Value> next;
+  for (unsigned index : carries)
+    next.push_back(
+        mapping.lookupOrDefault(originalYield.getIterArgsNext()[index]));
+  SmallVector<Value> finalValues;
+  for (unsigned index : stageValues)
+    finalValues.push_back(
+        mapping.lookupOrDefault(originalYield.getResults()[index]));
+  kernelBuilder.create<TaskflowHyperblockYieldOp>(plan.task.getLoc(), next,
+                                                  finalValues);
+  bodyBuilder.setInsertionPointToEnd(body);
+  SmallVector<Value> yields;
+  for (unsigned index = 0; index < writes.size(); ++index)
+    yields.push_back(body->getArgument(reads.size() + index));
+  bodyBuilder.create<TaskflowYieldOp>(
+      plan.task.getLoc(), body->getArguments().take_front(reads.size()), yields,
+      hyperblock.getResults());
+  setLineage(plan.task, stage, builder, plan.leftNodes, isPrefix ? 0 : 1);
+  return stage;
+}
+
+static LogicalResult rewriteFission(FissionPlan &plan, func::FuncOp function) {
+  std::string prefixName = (Twine(plan.task.getTaskName()) + ".split.0").str();
+  std::string suffixName = (Twine(plan.task.getTaskName()) + ".split.1").str();
+  bool collision = false;
+  function.walk([&](TaskflowTaskOp task) {
+    collision |= task != plan.task && (task.getTaskName() == prefixName ||
+                                       task.getTaskName() == suffixName);
+  });
+  if (collision) {
+    plan.task.emitError(
+        "fission-derived task name collides with an existing task");
+    return failure();
+  }
+
+  OpBuilder builder(plan.task);
+  SmallVector<Value> temporaries;
+  for (Value interfaceValue : plan.interfaceValues) {
+    auto type = MemRefType::get(plan.shape, interfaceValue.getType());
+    temporaries.push_back(
+        builder.create<memref::AllocOp>(plan.task.getLoc(), type));
+  }
+  TaskflowTaskOp prefix = createStage(plan, builder, temporaries, {}, true);
+  TaskflowTaskOp suffix =
+      createStage(plan, builder, temporaries, prefix, false);
+  for (auto [position, index] : llvm::enumerate(plan.prefixOutputs))
+    plan.task.getDoneWrites()[index].replaceAllUsesWith(
+        prefix.getDoneWrites()[temporaries.size() + position]);
+  for (auto [position, index] : llvm::enumerate(plan.suffixOutputs))
+    plan.task.getDoneWrites()[index].replaceAllUsesWith(
+        suffix.getDoneWrites()[position]);
+  for (auto [index, value] :
+       llvm::enumerate(plan.taskYield.getValueResults())) {
+    auto result = cast<OpResult>(value);
+    unsigned carry = result.getResultNumber();
+    auto prefixCarry = llvm::find(plan.prefixValues, carry);
+    Value replacement;
+    if (prefixCarry != plan.prefixValues.end())
+      replacement =
+          prefix.getValueOutputs()[prefixCarry - plan.prefixValues.begin()];
+    else {
+      auto suffixCarry = llvm::find(plan.suffixValues, carry);
+      assert(suffixCarry != plan.suffixValues.end() &&
+             "validated recurrence ownership");
+      replacement =
+          suffix.getValueOutputs()[suffixCarry - plan.suffixValues.begin()];
+    }
+    plan.task.getValueOutputs()[index].replaceAllUsesWith(replacement);
+  }
+  for (auto [index, original] : llvm::enumerate(plan.task.getDoneReads())) {
+    if (original.use_empty())
+      continue;
+    SmallVector<Value> states;
+    for (auto stage : {prefix, suffix})
+      for (auto [input, state] : llvm::enumerate(stage.getWillReads()))
+        if (stage.getOriginalReadMemrefs()[input] ==
+            plan.task.getOriginalReadMemrefs()[index]) {
+          states.push_back(stage.getDoneReads()[input]);
+          break;
+        }
+    assert(states.size() == 2 &&
+           "observed source inputs preserved in both stages");
+    auto barrier = builder.create<TaskflowReadCompletionJoinOp>(
+        plan.task.getLoc(), original.getType(), states,
+        plan.task.getWillReads()[index],
+        plan.task.getOriginalReadMemrefs()[index],
+        suffix.getDoneWrites().front());
+    barrier->setAttr("orbit.read_completion.kind",
+                     builder.getStringAttr("barrier"));
+    original.replaceAllUsesWith(barrier.getJoined());
+  }
+  plan.task.erase();
+  return success();
+}
