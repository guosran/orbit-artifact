diff --git a/lib/Taskflow/ProgramEventTransform.cpp b/lib/Taskflow/ProgramEventTransform.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..a55f3577cdd0b7ff46fdfe55d1c49979519b6667
--- /dev/null
+++ b/lib/Taskflow/ProgramEventTransform.cpp
@@ -0,0 +1,270 @@
+#include "Taskflow/ProgramMapping.h"
+#include "Taskflow/ProgramTargetBinding.h"
+#include <algorithm>
+#include <set>
+using namespace orbit::taskflow;
+namespace {
+bool reject(std::string &error, llvm::StringRef message) {
+  error = ("program event transform: " + message).str();
+  return false;
+}
+void canonical(std::vector<size_t> &values) {
+  std::sort(values.begin(), values.end());
+  values.erase(std::unique(values.begin(), values.end()), values.end());
+}
+} // namespace
+bool orbit::taskflow::reorderProgramGraphEvents(ProgramGraph &graph,
+                                                llvm::ArrayRef<size_t> order,
+                                                std::string &error) {
+  if (!checkProgramGraph(graph, error))
+    return false;
+  size_t n = graph.events.size();
+  if (order.size() != n || !graph.regionEvents.empty() ||
+      graph.executionRegions.size() != 1 ||
+      graph.executionRegions.front().submissionCount != 0)
+    return reject(error, "reorder requires one unbound host region and a "
+                         "complete event permutation");
+  std::vector<size_t> inverse(n, SIZE_MAX);
+  for (size_t i = 0; i < n; ++i) {
+    if (order[i] >= n || inverse[order[i]] != SIZE_MAX)
+      return reject(error, "event order is not a permutation");
+    inverse[order[i]] = i;
+  }
+  ProgramGraph candidate = graph;
+  for (size_t i = 0; i < n; ++i) {
+    candidate.events[i] = graph.events[order[i]];
+    auto &event = candidate.events[i];
+    for (auto &parent : event.dependencies)
+      parent = inverse[parent];
+    canonical(event.dependencies);
+    if (!event.dependencies.empty() && event.dependencies.back() >= i)
+      return reject(error,
+                    "event permutation violates a source or copy dependency");
+  }
+  for (auto &version : candidate.versions)
+    if (version.producer >= 0)
+      version.producer = inverse[version.producer];
+  for (auto &edge : candidate.dataEdges) {
+    if (edge.producer >= 0)
+      edge.producer = inverse[edge.producer];
+    edge.consumer = inverse[edge.consumer];
+  }
+  for (auto &edge : candidate.orderEdges) {
+    edge.producer = inverse[edge.producer];
+    edge.consumer = inverse[edge.consumer];
+  }
+  for (auto &instance : candidate.instances)
+    instance.event = inverse[instance.event];
+  // Instances follow the execution witness, even when independent computes
+  // change order. Updating their event indices alone leaves stale bindings.
+  std::sort(candidate.instances.begin(), candidate.instances.end(),
+            [](const auto &a, const auto &b) { return a.event < b.event; });
+  for (auto &group : candidate.executionGroups) {
+    for (auto &event : group.memberEvents)
+      event = inverse[event];
+    canonical(group.memberEvents);
+  }
+  for (auto &copy : candidate.copies) {
+    bool retained = copy.releasedAfter == n;
+    if (copy.createdBy >= 0)
+      copy.createdBy = inverse[copy.createdBy];
+    copy.availableFrom = copy.createdBy < 0 ? 0 : size_t(copy.createdBy);
+    for (auto &user : copy.users)
+      user = inverse[user];
+    canonical(copy.users);
+    copy.lastUsers.clear();
+    if (!copy.users.empty())
+      copy.lastUsers.push_back(copy.users.back());
+    size_t last = copy.createdBy < 0 ? 0 : size_t(copy.createdBy);
+    if (!copy.users.empty())
+      last = std::max(last, copy.users.back());
+    copy.releasedAfter = retained ? n : last + 1;
+  }
+  auto &scope = candidate.executionRegions.front();
+  scope.beginEvent = 0;
+  scope.endEvent = n;
+  scope.memberEvents.clear();
+  candidate.schedule.policy = "dependency-order-witness";
+  if (!refreshProgramGraphSchedule(candidate, error) ||
+      !checkProgramGraph(candidate, error))
+    return false;
+  graph = std::move(candidate);
+  return true;
+}
+bool orbit::taskflow::bindProgramInvocationWaves(
+    ProgramGraph &graph, llvm::ArrayRef<ProgramInvocationWave> waves,
+    llvm::StringRef submissionResource, llvm::StringRef endpointMemory,
+    std::string &error) {
+  if (!checkProgramGraph(graph, error))
+    return false;
+  if (waves.empty() || !graph.regionEvents.empty() ||
+      graph.executionRegions.size() != 1 ||
+      graph.executionRegions.front().submissionCount != 0)
+    return reject(error, "wave binding requires an unbound complete graph");
+  StaticConfig target;
+  target.resources = graph.resources;
+  target.memories = graph.memories;
+  auto *submission = programResource(target, submissionResource);
+  if (!submission || submission->kind != "submission" ||
+      !programMemory(target, endpointMemory))
+    return reject(error,
+                  "wave invocation endpoint or submission resource is absent");
+  size_t cursor = 0;
+  for (const auto &wave : waves) {
+    if (wave.beginEvent != cursor || wave.endEvent <= cursor ||
+        wave.endEvent > graph.events.size())
+      return reject(
+          error, "wave event ranges have a gap, overlap or reordered coverage");
+    cursor = wave.endEvent;
+  }
+  if (cursor != graph.events.size())
+    return reject(error, "waves do not cover the whole graph");
+  // No device allocation can survive reconfiguration. Host BOs retain their
+  // actual versions; their visibility is synchronized once at either boundary.
+  for (const auto &copy : graph.copies) {
+    auto *memory =
+        programMemory(target, graph.allocations[copy.allocation].memory);
+    if (memory->kind == "system-bo")
+      continue;
+    for (const auto &wave : waves)
+      if (wave.endEvent < graph.events.size() && copy.createdBy >= 0 &&
+          size_t(copy.createdBy) < wave.endEvent && !copy.users.empty() &&
+          copy.users.back() >= wave.endEvent)
+        return reject(error, "wave boundary cuts a live device copy");
+  }
+  ProgramGraph candidate = graph;
+  candidate.executionRegions.clear();
+  candidate.regionEvents.clear();
+  for (size_t w = 0; w < waves.size(); ++w) {
+    const auto &wave = waves[w];
+    MappingExecutionRegion region;
+    region.id = "physical-wave-" + std::to_string(w);
+    region.placement = "device";
+    region.submissionResource = submissionResource.str();
+    region.endpointMemory = endpointMemory.str();
+    region.beginEvent = wave.beginEvent;
+    region.endEvent = wave.endEvent;
+    region.submissionCount = 1;
+    region.implementation = "selected-physical-configuration";
+    region.invocationLifecycle = "host-device";
+    if (w)
+      region.predecessorRegions.push_back(w - 1);
+    for (size_t event = wave.beginEvent; event < wave.endEvent; ++event) {
+      region.memberEvents.push_back(event);
+      if (candidate.events[event].kind != "transfer")
+        region.sourceTasks.push_back(candidate.events[event].task);
+      // Serial host wait2 between invocations is a real implementation edge,
+      // independent of otherwise parallel source tasks and physical resources.
+      if (w)
+        for (size_t previous = waves[w - 1].beginEvent;
+             previous < waves[w - 1].endEvent; ++previous)
+          candidate.events[event].dependencies.push_back(previous);
+      canonical(candidate.events[event].dependencies);
+    }
+    canonical(region.sourceTasks);
+    for (size_t copy = 0; copy < candidate.copies.size(); ++copy) {
+      const auto &value = candidate.copies[copy];
+      const auto &allocation = candidate.allocations[value.allocation];
+      auto *memory = programMemory(target, allocation.memory);
+      if (memory->kind != "system-bo")
+        continue;
+      if (w == 0 && value.createdBy < 0)
+        region.inputCopies.push_back(copy);
+      if (w + 1 == waves.size() &&
+          value.releasedAfter == candidate.events.size() &&
+          isOutputStorageRole(
+              candidate.source.storages[allocation.storage].role))
+        region.outputCopies.push_back(copy);
+    }
+    candidate.executionRegions.push_back(region);
+    for (auto kind :
+         {"visible-to-device", "submit", "complete", "visible-to-host"}) {
+      MappingRegionEvent event;
+      event.kind = kind;
+      event.region = w;
+      event.resource = submissionResource.str();
+      if (!candidate.regionEvents.empty())
+        event.dependencies.push_back(candidate.regionEvents.size() - 1);
+      if (event.kind == "visible-to-device")
+        event.copies = region.inputCopies;
+      if (event.kind == "visible-to-host")
+        event.copies = region.outputCopies;
+      candidate.regionEvents.push_back(std::move(event));
+    }
+  }
+  candidate.schedule.policy = "dependency-order-witness";
+  if (!refreshProgramGraphSchedule(candidate, error) ||
+      !checkProgramGraph(candidate, error))
+    return false;
+  graph = std::move(candidate);
+  return true;
+}
+bool orbit::taskflow::checkProgramInvocationWaves(const ProgramGraph &graph,
+                                                  std::string &error) {
+  bool waves = false;
+  for (const auto &region : graph.executionRegions)
+    waves |= region.implementation == "selected-physical-configuration";
+  if (!waves)
+    return true;
+  size_t cursor = 0;
+  std::vector<size_t> allInputs, allOutputs;
+  StaticConfig target;
+  target.memories = graph.memories;
+  for (size_t copy = 0; copy < graph.copies.size(); ++copy) {
+    const auto &value = graph.copies[copy];
+    const auto &allocation = graph.allocations[value.allocation];
+    const auto *memory = programMemory(target, allocation.memory);
+    if (!memory || memory->kind != "system-bo")
+      continue;
+    if (value.createdBy < 0)
+      allInputs.push_back(copy);
+    if (value.releasedAfter == graph.events.size() &&
+        isOutputStorageRole(graph.source.storages[allocation.storage].role))
+      allOutputs.push_back(copy);
+  }
+  for (size_t w = 0; w < graph.executionRegions.size(); ++w) {
+    const auto &region = graph.executionRegions[w];
+    if (region.implementation != "selected-physical-configuration" ||
+        region.invocationLifecycle != "host-device" ||
+        region.beginEvent != cursor || region.endEvent <= cursor ||
+        region.endEvent > graph.events.size())
+      return reject(error, "physical wave coverage is incomplete or mixed with "
+                           "another invocation policy");
+    std::vector<size_t> members, tasks, parents;
+    if (w)
+      parents.push_back(w - 1);
+    for (size_t event = region.beginEvent; event < region.endEvent; ++event) {
+      members.push_back(event);
+      if (graph.events[event].kind != "transfer")
+        tasks.push_back(graph.events[event].task);
+      if (w)
+        for (size_t before = graph.executionRegions[w - 1].beginEvent;
+             before < graph.executionRegions[w - 1].endEvent; ++before)
+          if (!llvm::is_contained(graph.events[event].dependencies, before))
+            return reject(
+                error,
+                "physical wave body lacks serial prior-call completion edges");
+    }
+    canonical(tasks);
+    if (region.memberEvents != members || region.sourceTasks != tasks ||
+        region.predecessorRegions != parents ||
+        region.inputCopies != (w == 0 ? allInputs : std::vector<size_t>{}) ||
+        region.outputCopies != (w + 1 == graph.executionRegions.size()
+                                    ? allOutputs
+                                    : std::vector<size_t>{}))
+      return reject(
+          error,
+          "physical wave source members or boundary BO visibility differs");
+    for (const auto &copy : graph.copies) {
+      const auto *memory =
+          programMemory(target, graph.allocations[copy.allocation].memory);
+      if (memory && memory->kind != "system-bo" && copy.createdBy >= 0 &&
+          size_t(copy.createdBy) < region.endEvent && !copy.users.empty() &&
+          copy.users.back() >= region.endEvent)
+        return reject(error, "physical wave boundary cuts a live device copy");
+    }
+    cursor = region.endEvent;
+  }
+  return cursor == graph.events.size() ||
+         reject(error, "physical wave union omits events");
+}
