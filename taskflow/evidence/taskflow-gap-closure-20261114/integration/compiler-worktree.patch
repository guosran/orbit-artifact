+bool orbit::taskflow::lowerNPUPlacedProgram(ModuleOp source,
+                                            const j::Value &config,
+                                            OwningOpRef<ModuleOp> &output,
+                                            j::Value &manifest,
+                                            std::string &error) {
+  OwningOpRef<ModuleOp> physicalSource, originalNormalized;
+  ProgramGraph graph;
+  std::vector<ProgramGraphAIRSelection> unusedSelections;
+  if (!placedWaveGraph(source, config, physicalSource, graph, unusedSelections,
+                       manifest, error, true))
+    return false;
+  j::Value realization = nullptr;
+  if (!lowerProgramGraphToAIR(graph, output, realization, error))
+    return false;
+  TaskflowSourceNormalizationWitness witness;
+  if (failed(
+          normalizeTaskflowSource(source, originalNormalized, witness, error)))
+    return false;
+  auto &record = *manifest.getAsObject();
+  record["immutable_source_fingerprint"] = witness.sourceFingerprint;
+  record["shape_expansion_replay_verified"] =
+      hasTaskflowReplicaGroups(*physicalSource) &&
+      !hasTaskflowReplicaGroups(source);
+  record["full_configuration_implementation"] = std::move(realization);
+  record["air_graph_binding"] = "exact global ProgramGraph emission";
+  return true;
