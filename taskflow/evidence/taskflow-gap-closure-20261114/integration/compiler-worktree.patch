@@ -0,0 +1,110 @@
+// Source-bound policy survives an authenticated replica implementation rewrite.
+#include "Taskflow/GenericMapping.h"
+#include "Taskflow/NPUShapePolicyProjection.h"
+#include "Taskflow/NativeTransforms.h"
+#include "Taskflow/SourceMappingActions.h"
+#include "Taskflow/TaskTiling.h"
+#include "TaskflowDialect/TaskflowDialect.h"
+#include "TaskflowDialect/TaskflowOps.h"
+#include "mlir/Dialect/Affine/IR/AffineOps.h"
+#include "mlir/Dialect/Arith/IR/Arith.h"
+#include "mlir/Dialect/Func/IR/FuncOps.h"
+#include "mlir/Dialect/MemRef/IR/MemRef.h"
+#include "mlir/Dialect/SCF/IR/SCF.h"
+#include "mlir/Parser/Parser.h"
+#include "llvm/Support/raw_ostream.h"
+using namespace mlir;
+using namespace orbit::taskflow;
+int main(int argc, char **argv) {
+  if (argc != 2)
+    return 2;
+  DialectRegistry registry;
+  registry.insert<mlir::taskflow::TaskflowDialect, affine::AffineDialect,
+                  arith::ArithDialect, func::FuncDialect, memref::MemRefDialect,
+                  scf::SCFDialect>();
+  MLIRContext context(registry);
+  auto parent = parseSourceFile<ModuleOp>(argv[1], &context);
+  std::string error;
+  SourceMappingActionOptions options;
+  options.mapping = false;
+  const llvm::json::Value config = llvm::json::Object{};
+  if (!parent ||
+      !getGenericTargetCapabilities(config, options.capabilities, error))
+    return 3;
+  std::vector<NeighborhoodAction> actions;
+  SourceActionOptions domain;
+  auto enumerate = makeSourceMappingActionEnumerator(options);
+  if (failed(enumerate(*parent, "pointwise", domain, actions, error)))
+    return 4;
+  auto selected = llvm::find_if(actions, [](const auto &action) {
+    return action.primitives.size() == 1 &&
+           action.primitives.front().kind == "native-task-tile";
+  });
+  if (selected == actions.end())
+    return 5;
+  auto materialize = makeSourceMappingActionMaterializer(options);
+  if (failed(materialize(*parent, "pointwise", selected->primitives.front(),
+                         error)))
+    return 6;
+  const std::vector<NativeTaskImplementationChoice> implementation{
+      {0, "scalar", 1}};
+  if (!setNativeTaskImplementations(*parent, 1, implementation, error) ||
+      !setNativeAIRTileSizes(*parent, 7, 16, 1, error) ||
+      failed(checkSourceMappingActionBindings(*parent, "pointwise", error)))
+    return 7;
+  std::vector<TaskTileChoice> originalTiles;
+  if (!readTaskTileChoices(*parent, 1, originalTiles, error) ||
+      originalTiles.size() != 1)
+    return 8;
+  auto expanded = parent->clone();
+  const TaskflowReplicaAction replica{"pointwise", "Pointwise", 0, 3};
+  if (failed(materializeTaskflowReplicas(expanded, replica, error)))
+    return 9;
+  if (succeeded(checkSourceMappingActionBindings(expanded, "pointwise", error)))
+    return 10; // The old binding must reject the changed numeric graph.
+  llvm::json::Value receipt = nullptr;
+  if (!projectNPUReplicaPolicies(*parent, expanded, replica, receipt, error)) {
+    llvm::errs() << error;
+    return 11;
+  }
+  if (failed(checkSourceMappingActionBindings(expanded, "pointwise", error)))
+    return 12;
+  std::vector<TaskTileChoice> tiles;
+  std::vector<NativeTaskImplementationChoice> implementations;
+  if (!readTaskTileChoices(expanded, 3, tiles, error) || tiles.size() != 3 ||
+      !readNativeTaskImplementations(expanded, 3, implementations, error) ||
+      implementations.size() != 3)
+    return 13;
+  for (size_t task = 0; task < 3; ++task)
+    if (tiles[task].task != task ||
+        tiles[task].sizes != originalTiles.front().sizes ||
+        implementations[task].task != task ||
+        implementations[task].kind != "scalar")
+      return 14;
+  if (parent->getOperation()->getAttr("orbit.air_tile_sizes") !=
+      expanded->getAttr("orbit.air_tile_sizes"))
+    return 15;
+  std::vector<TaskTileChoice> unchanged;
+  if (!readTaskTileChoices(*parent, 1, unchanged, error) ||
+      unchanged.size() != 1 ||
+      failed(checkSourceMappingActionBindings(*parent, "pointwise", error)))
+    return 16;
+  auto forged = parent->clone();
+  if (failed(materializeTaskflowReplicas(forged, replica, error)))
+    return 17;
+  bool renamed = false;
+  forged.walk([&](mlir::taskflow::TaskflowTaskOp task) {
+    if (!renamed) {
+      task->setAttr("task_name", StringAttr::get(&context, "ForgedDescendant"));
+      renamed = true;
+    }
+  });
+  if (projectNPUReplicaPolicies(*parent, forged, replica, receipt, error))
+    return 18;
+  expanded.erase();
+  forged.erase();
+  llvm::outs() << "source-bound action, stale binding rejection, "
+                  "every-descendant tiles/implementation, immutable parent and "
+                  "forged replay rejection passed\n";
+  return 0;
+}
