+//===- SourceMappingActions.h - Mapping choices in source search -*- C++
+//-*-===//
+#ifndef ORBIT_TASKFLOW_SOURCE_MAPPING_ACTIONS_H
+#define ORBIT_TASKFLOW_SOURCE_MAPPING_ACTIONS_H
+#include "Taskflow/GenericMapping.h"
+#include "Taskflow/SourceActions.h"
+namespace orbit::taskflow {
+struct SourceMappingActionOptions {
+  GenericTargetCapabilities capabilities;
+  size_t tilePageSlots = 12;
+  size_t maxResidencyProposals = 8;
+  size_t maxResidencyGroups = 4;
+  bool taskTiling = true, mapping = true;
+};
+// Native policy indices are meaningful only for the source graph that created
+// them. Call before capability/evaluation, including after structural actions.
+// Unbound imported native choices are rejected; graph changes require an
+// explicit policy withdrawal or a newly source-bound choice.
+mlir::LogicalResult checkSourceMappingActionBindings(mlir::ModuleOp source,
+                                                     llvm::StringRef function,
+                                                     std::string &error);
+// Rebind existing policies after a caller independently authenticated the
+// numeric rewrite and projected every ordinal policy. This only updates the
+// source binding; it proves neither rewrite equivalence nor policy projection.
+// An unbound original grants no new binding. A stale original is rejected.
+mlir::LogicalResult refreshSourceMappingActionBindings(
+    mlir::ModuleOp original, mlir::ModuleOp transformed,
+    llvm::StringRef function, std::string &error);
+SourceActionExtension
