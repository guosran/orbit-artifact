@@ -0,0 +1,52 @@
+//===- TaskflowReplica.h - Independent source-domain replicas ---*- C++ -*-===//
+#ifndef ORBIT_TASKFLOW_TASKFLOW_REPLICA_H
+#define ORBIT_TASKFLOW_TASKFLOW_REPLICA_H
+#include "mlir/IR/BuiltinOps.h"
+#include "mlir/Support/LogicalResult.h"
+#include "llvm/ADT/ArrayRef.h"
+#include <cstdint>
+#include <string>
+#include <vector>
+namespace orbit::taskflow {
+struct TaskflowReplicaAction {
+  std::string function, task;
+  int64_t axis = 0, count = 2;
+};
+/// Partition independent source instances using the common checked interval
+/// materializer. Unlike ordinary domain tiling, every instance carries an
+/// explicit independent-replica group contract. The physical backend must
+/// realize its resources/concurrency or reject the proposal as unsupported.
+/// This does not prove concurrent placement or multiply executed source work.
+mlir::LogicalResult
+materializeTaskflowReplicas(mlir::ModuleOp module,
+                            const TaskflowReplicaAction &action,
+                            std::string &error);
+mlir::LogicalResult
+verifyTaskflowReplicaReplay(mlir::ModuleOp parent, mlir::ModuleOp candidate,
+                            llvm::ArrayRef<TaskflowReplicaAction> actions,
+                            std::string &error);
+/// One ownership domain in an independent-replica hierarchy. A task with a
+/// shorter path executes in its parent domain; siblings reserve independent
+/// child domains. A backend must prove that physical hierarchy, not flatten
+/// leaf tasks onto the outer instance's one core.
+struct TaskflowReplicaLevel {
+  std::string owner;
+  int64_t instance = 0, count = 0;
+};
+mlir::LogicalResult
+readTaskflowReplicaHierarchy(mlir::Operation *task,
+                             std::vector<TaskflowReplicaLevel> &,
+                             std::string &error);
+/// Validate a complete source resource obligation; no contract is also valid.
+/// Multiple sequential tasks may belong to one instance. Splitting such a task
+/// preserves that instance, rather than allocating new independent resources.
+mlir::LogicalResult validateTaskflowReplicaContract(mlir::Operation *task,
+                                                    std::string &error);
+bool haveSameTaskflowReplicaContract(mlir::Operation *first,
+                                     mlir::Operation *second);
+void copyTaskflowReplicaContract(mlir::Operation *source,
+                                 mlir::Operation *destination);
+/// Report a resource obligation, not a proof that the target implements it.
+bool hasTaskflowReplicaGroups(mlir::ModuleOp module);
+} // namespace orbit::taskflow
+#endif
diff --git a/include/Taskflow/TaskflowSourceNormalization.h b/include/Taskflow/TaskflowSourceNormalization.h
new file mode 100644
index 0000000000000000000000000000000000000000..2d28f5f796d1ab83e70293de54bdd42167d8284e
--- /dev/null
+++ b/include/Taskflow/TaskflowSourceNormalization.h
@@ -0,0 +1,32 @@
+//===- TaskflowSourceNormalization.h - Checked physical form ----*- C++ -*-===//
+#ifndef ORBIT_TASKFLOW_SOURCE_NORMALIZATION_H
+#define ORBIT_TASKFLOW_SOURCE_NORMALIZATION_H
+#include "mlir/IR/BuiltinOps.h"
+#include "mlir/IR/OwningOpRef.h"
+#include "mlir/Support/LogicalResult.h"
+#include <cstdint>
+#include <string>
+namespace orbit::taskflow {
+/// Separate source and physical-normalization identities. Neither fingerprint
+/// is a replacement for the caller's immutable source-semantic identity.
+struct TaskflowSourceNormalizationWitness {
+  std::string protocol = "orbit-taskflow-source-normalization-v1";
+  std::string sourceFingerprint;
+  std::string normalizedFingerprint;
+  uint64_t normalizedTasks = 0;
+  uint64_t normalizedCounters = 0;
+};
+/// Clone canonical counter/hyperblock bodies into affine nests, or SCF nests
+/// with actual iter_args for rectangular dynamic domains/recurrences. Preserve
+/// scalar SSA, structured control, memory accesses and task dependencies.
+/// Positive steps must be proved; recurrence results must equal next-state
+/// values. Unsupported control/effects fail explicitly; source is immutable.
+mlir::LogicalResult normalizeTaskflowSource(
+    mlir::ModuleOp source, mlir::OwningOpRef<mlir::ModuleOp> &normalized,
+    TaskflowSourceNormalizationWitness &witness, std::string &error);
+/// Re-derive from immutable source; do not trust a producer's claimed witness.
+mlir::LogicalResult verifyTaskflowSourceNormalization(
+    mlir::ModuleOp source, mlir::ModuleOp normalized,
+    const TaskflowSourceNormalizationWitness &witness, std::string &error);
+} // namespace orbit::taskflow
+#endif
