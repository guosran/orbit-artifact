+//===- TaskflowInvocation.h - Runtime-bound graph ownership ------*- C++
+//-*-===//
+#ifndef ORBIT_TASKFLOW_INVOCATION_H
+#define ORBIT_TASKFLOW_INVOCATION_H
+#include "Taskflow/ProgramMapping.h"
+#include "Taskflow/TaskflowDeferredPlan.h"
+namespace orbit::taskflow {
+/// Resolve the actual invocation, including its ordered source actions. A
+/// provider must bind real arguments; iteration numbers are not tensor bounds.
+using TaskflowInvocationPlanProvider = std::function<bool(
+    int64_t iteration, TaskflowDeferredPlan &, std::string &error)>;
+using TaskflowInvocationGraphBuilder = std::function<bool(
+    mlir::ModuleOp normalized, ProgramGraph &, std::string &error)>;
+struct TaskflowInvocationSequence {
+  // Graphs borrow MLIR handles from these owners. Keep this object alive until
+  // all backend callbacks complete; moving it does not move the IR objects.
+  std::vector<TaskflowDeferredPlanResult> calls;
+  ProgramInvocationSequence execution;
+};
+bool materializeTaskflowInvocationSequence(
+    mlir::ModuleOp immutableSource, const ProgramInvocationRange &,
+    llvm::ArrayRef<ProgramPersistentState>,
+    const TaskflowInvocationPlanProvider &,
+    const TaskflowInvocationGraphBuilder &, TaskflowInvocationSequence &,
+    std::string &error, const SourceActionExtension &extension = {});
+using TaskflowInvocationArguments = std::function<bool(
+    int64_t iteration, std::vector<TaskflowArgumentBinding> &,
+    std::string &error)>;
+/// Authenticate every actual call before submitting any of the sequence. The
+/// backend executes the existing graph and applies its physical handoffs.
+bool executeTaskflowInvocationSequence(
+    mlir::ModuleOp immutableSource, const TaskflowInvocationSequence &,
+    const TaskflowInvocationArguments &, const ProgramInvocationExecutor &,
+    std::string &error, const SourceActionExtension &extension = {});
+llvm::json::Value
+serializeTaskflowInvocationSequence(const TaskflowInvocationSequence &);
+} // namespace orbit::taskflow
+#endif
