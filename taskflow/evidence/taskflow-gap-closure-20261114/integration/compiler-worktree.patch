+//===- TaskflowSpecialization.cpp - Runtime argument binding --------------===//
+#include "Taskflow/TaskflowSpecialization.h"
+#include "TaskflowDialect/TaskflowOps.h"
+#include "mlir/Dialect/Arith/IR/Arith.h"
+#include "mlir/Dialect/Func/IR/FuncOps.h"
+#include "mlir/Dialect/MemRef/IR/MemRef.h"
+#include "mlir/IR/Builders.h"
+#include "mlir/IR/SymbolTable.h"
+#include "mlir/IR/Verifier.h"
+#include "mlir/Pass/PassManager.h"
+#include "mlir/Transforms/Passes.h"
+#include "llvm/ADT/BitVector.h"
+#include "llvm/ADT/STLExtras.h"
+#include "llvm/ADT/StringExtras.h"
+#include "llvm/Support/MathExtras.h"
+#include "llvm/Support/SHA256.h"
+#include "llvm/Support/raw_ostream.h"
+#include <map>
+
+using namespace mlir;
+namespace orbit::taskflow {
+namespace {
+std::string bytes(ModuleOp module) {
+  std::string text;
+  llvm::raw_string_ostream out(text);
+  module.print(out, OpPrintingFlags().printGenericOpForm());
+  out.flush();
+  return text;
+}
+std::string digest(ModuleOp module) {
+  return llvm::toHex(
+      llvm::SHA256::hash(llvm::arrayRefFromStringRef(bytes(module))), true);
+}
+LogicalResult reject(std::string &error, llvm::StringRef why) {
+  error = why.str();
+  return failure();
+}
+} // namespace
+LogicalResult
+specializeTaskflowArguments(ModuleOp source, llvm::StringRef name,
+                            llvm::ArrayRef<TaskflowArgumentBinding> bindings,
+                            OwningOpRef<ModuleOp> &out,
+                            TaskflowSpecializationWitness &witness,
+                            std::string &error) {
+  out = nullptr;
+  witness = {};
+  error.clear();
+  if (!source || failed(verify(source)))
+    return reject(error, "argument specialization requires verified source");
+  auto selected =
+      dyn_cast_or_null<func::FuncOp>(SymbolTable::lookupSymbolIn(source, name));
+  if (!selected || selected.empty() || !selected.getBody().hasOneBlock())
+    return reject(
+        error,
+        "argument specialization requires a defined single-block function");
+  std::map<size_t, const TaskflowArgumentBinding *> table;
+  for (const auto &binding : bindings)
+    if (binding.argument >= selected.getNumArguments() ||
+        !table.emplace(binding.argument, &binding).second ||
+        (binding.scalar && !binding.shape.empty()))
+      return reject(error, "argument binding needs a unique index and exactly "
+                           "one scalar or shape");
+  OwningOpRef<ModuleOp> trial = source.clone();
+  auto function = cast<func::FuncOp>(SymbolTable::lookupSymbolIn(*trial, name));
+  OpBuilder builder = OpBuilder::atBlockBegin(&function.getBody().front());
+  llvm::BitVector erased(function.getNumArguments());
+  SmallVector<Type> argumentTypes(function.getArgumentTypes());
+  for (auto [index, argument] : llvm::enumerate(function.getArguments())) {
+    auto found = table.find(index);
+    auto type = dyn_cast<MemRefType>(argument.getType());
+    if (type) {
+      if (found == table.end()) {
+        if (!type.hasStaticShape())
+          return reject(error, "runtime shape missing for a dynamic memref");
+        continue;
+      }
+      const auto &binding = *found->second;
+      if (binding.scalar || binding.shape.size() != size_t(type.getRank()))
+        return reject(
+            error, "runtime memref shape has the wrong rank or binding kind");
+      for (auto [axis, extent] : llvm::enumerate(binding.shape))
+        if (extent <= 0 ||
+            (!type.isDynamicDim(axis) && type.getDimSize(axis) != extent))
+          return reject(error, "runtime shape contradicts a source dimension");
+      auto concrete = MemRefType::get(binding.shape, type.getElementType(),
+                                      type.getLayout(), type.getMemorySpace());
+      if (concrete != type) {
+        argument.setType(concrete);
+        auto view =
+            builder.create<memref::CastOp>(function.getLoc(), type, argument);
+        argument.replaceAllUsesExcept(view.getResult(), view.getOperation());
+        argumentTypes[index] = concrete;
+      }
+    } else {
+      if (found == table.end() || !found->second->scalar)
+        return reject(error, "runtime scalar argument value is missing");
+      Type scalarType = argument.getType();
+      if (!isa<IndexType, IntegerType>(scalarType))
+        return reject(
+            error,
+            "runtime specialization currently binds index/integer scalars");
+      int64_t value = *found->second->scalar;
+      if (auto integer = dyn_cast<IntegerType>(scalarType)) {
+        unsigned width = integer.getWidth();
+        if ((width == 1 && value != 0 && value != 1) ||
+            (width != 1 && width < 64 && !llvm::isIntN(width, value)))
+          return reject(error,
+                        "runtime scalar does not fit the source integer type");
+      }
+      auto declared = function->getAttrOfType<IntegerAttr>(
+          "amoeba.static_bound.arg." + std::to_string(index));
+      if (declared &&
+          (!declared.getType().isInteger(64) || declared.getInt() != value))
+        return reject(
+            error,
+            "runtime value violates the source's declared argument bound");
+      auto constant = builder.create<arith::ConstantOp>(
+          function.getLoc(), scalarType,
+          builder.getIntegerAttr(scalarType, value));
+      argument.replaceAllUsesWith(constant.getResult());
+      erased.set(index);
+    }
+  }
+  function.setType(
+      builder.getFunctionType(argumentTypes, function.getResultTypes()));
+  function.eraseArguments(erased);
+  // The isolated task interface is part of the real type graph. Updating only
+  // the host argument would leave dynamic task ports behind a cast and would
+  // prevent the same checked invocation from being tiled or replicated.
+  bool changed;
+  do {
+    changed = false;
+    auto refine = [&](Value value, Type type) {
+      if (value.getType() != type) {
+        value.setType(type);
+        changed = true;
+      }
+    };
+    SmallVector<memref::CastOp> redundant;
+    function.walk<WalkOrder::PreOrder>([&](Operation *operation) {
+      if (auto view = dyn_cast<memref::CastOp>(operation)) {
+        auto from = dyn_cast<MemRefType>(view.getSource().getType());
+        auto to = dyn_cast<MemRefType>(view.getType());
+        if (from && to && from.hasStaticShape() &&
+            memref::CastOp::areCastCompatible(TypeRange{from}, TypeRange{to})) {
+          view.getResult().replaceAllUsesWith(view.getSource());
+          redundant.push_back(view);
+          changed = true;
+        }
+      } else if (auto task =
+                     dyn_cast<mlir::taskflow::TaskflowTaskOp>(operation)) {
+        Block &body = task.getBody().front();
+        size_t index = 0;
+        for (Value value : task.getWillReads())
+          refine(body.getArgument(index++), value.getType());
+        for (Value value : task.getWillWrites())
+          refine(body.getArgument(index++), value.getType());
+        auto yield =
+            cast<mlir::taskflow::TaskflowYieldOp>(body.getTerminator());
+        for (auto [result, value] :
+             llvm::zip(task.getResults(), yield.getOperands()))
+          refine(result, value.getType());
+      } else if (auto channel =
+                     dyn_cast<mlir::taskflow::TaskflowChannelOp>(operation)) {
+        refine(channel.getTarget(), channel.getSource().getType());
+      } else if (auto join =
+                     dyn_cast<mlir::taskflow::TaskflowJoinOp>(operation)) {
+        refine(join.getResult(), join.getBase().getType());
+      } else if (auto join =
+                     dyn_cast<mlir::taskflow::TaskflowReadCompletionJoinOp>(
+                         operation)) {
+        refine(join.getJoined(), join.getBaseState().getType());
+      }
+    });
+    for (auto view : redundant)
+      view.erase();
+  } while (changed);
+  function.walk([&](func::ReturnOp returned) {
+    OpBuilder builder(returned);
+    for (auto [index, value] : llvm::enumerate(returned.getOperands())) {
+      Type expected = function.getResultTypes()[index];
+      if (value.getType() != expected && isa<MemRefType>(expected)) {
+        auto view =
+            builder.create<memref::CastOp>(returned.getLoc(), expected, value);
+        returned.setOperand(index, view);
+      }
+    }
+  });
+  // Isolated task bodies need their own literal. Remove the corresponding
+  // scalar port only after replacing every use; do not erase carried values.
+  function.walk([&](mlir::taskflow::TaskflowTaskOp task) {
+    for (size_t index = task.getValueInputs().size(); index-- > 0;) {
+      auto constant =
+          task.getValueInputs()[index].getDefiningOp<arith::ConstantOp>();
+      if (!constant)
+        continue;
+      Block &body = task.getBody().front();
+      auto local = OpBuilder::atBlockBegin(&body).create<arith::ConstantOp>(
+          constant.getLoc(), constant.getType(), constant.getValue());
+      size_t port =
+          task.getWillReads().size() + task.getWillWrites().size() + index;
+      body.getArgument(port).replaceAllUsesWith(local.getResult());
+      task.getValueInputsMutable().erase(index);
+      body.eraseArgument(port);
+    }
+  });
+  PassManager manager(source.getContext());
+  manager.addPass(createCanonicalizerPass());
+  if (failed(manager.run(*trial)) || failed(verify(*trial)))
+    return reject(error, "runtime specialization produced invalid source");
+  witness.function = name.str();
+  witness.sourceFingerprint = digest(source);
+  witness.specializedFingerprint = digest(*trial);
+  witness.arguments.assign(bindings.begin(), bindings.end());
+  out = std::move(trial);
+  return success();
+}
+bool checkTaskflowInvocationArguments(
+    const TaskflowSpecializationWitness &witness,
+    llvm::ArrayRef<TaskflowArgumentBinding> actual, std::string &error) {
+  std::map<size_t, const TaskflowArgumentBinding *> expected, provided;
+  for (const auto &binding : witness.arguments)
+    if (!expected.emplace(binding.argument, &binding).second) {
+      error = "specialization witness contains duplicate arguments";
+      return false;
+    }
+  for (const auto &binding : actual)
+    if (!provided.emplace(binding.argument, &binding).second) {
+      error = "runtime invocation contains duplicate arguments";
+      return false;
+    }
+  if (expected.size() != provided.size()) {
+    error = "runtime invocation differs from specialization guard";
+    return false;
+  }
+  for (const auto &[index, binding] : expected) {
+    auto found = provided.find(index);
+    if (found == provided.end() || binding->scalar != found->second->scalar ||
+        binding->shape != found->second->shape) {
+      error =
+          "runtime scalar or memref shape differs from specialization guard";
+      return false;
+    }
+  }
+  return true;
+}
+LogicalResult
+verifyTaskflowSpecialization(ModuleOp source, ModuleOp candidate,
+                             const TaskflowSpecializationWitness &witness,
+                             std::string &error) {
+  OwningOpRef<ModuleOp> replay;
+  TaskflowSpecializationWitness actual;
+  if (!candidate ||
+      failed(specializeTaskflowArguments(
+          source, witness.function, witness.arguments, replay, actual, error)))
+    return failure();
+  if (witness.sourceFingerprint != actual.sourceFingerprint ||
+      witness.specializedFingerprint != actual.specializedFingerprint ||
+      bytes(candidate) != bytes(*replay))
+    return reject(error,
+                  "runtime specialization differs from actual source replay");
+  return success();
+}
+bool parseTaskflowArgumentBindings(const llvm::json::Value &value,
+                                   std::string &function,
+                                   std::vector<TaskflowArgumentBinding> &out,
+                                   std::string &error) {
+  auto *root = value.getAsObject();
+  auto name = root ? root->getString("function") : std::nullopt;
+  auto *arguments = root ? root->getArray("arguments") : nullptr;
+  if (!root || root->size() != 2 || !name || name->empty() || !arguments) {
+    error = "runtime argument profile needs function and arguments";
+    return false;
+  }
+  std::vector<TaskflowArgumentBinding> parsed;
+  for (const auto &value : *arguments) {
+    auto *entry = value.getAsObject();
+    auto index = entry ? entry->getInteger("argument") : std::nullopt;
+    if (!entry || entry->size() != 2 || !index || *index < 0) {
+      error = "runtime argument entry needs index and scalar value or shape";
+      return false;
+    }
+    TaskflowArgumentBinding binding;
+    binding.argument = *index;
+    if (auto scalar = entry->getInteger("value"))
+      binding.scalar = *scalar;
+    else if (auto *shape = entry->getArray("shape")) {
+      for (const auto &dimension : *shape) {
+        auto extent = dimension.getAsInteger();
+        if (!extent || *extent <= 0) {
+          error = "runtime shape dimensions must be positive integers";
+          return false;
+        }
+        binding.shape.push_back(*extent);
+      }
+    } else {
+      error = "runtime argument entry needs integer value or shape";
+      return false;
+    }
+    parsed.push_back(std::move(binding));
+  }
+  function = name->str();
+  out = std::move(parsed);
+  return true;
+}
+llvm::json::Value
+serializeTaskflowSpecialization(const TaskflowSpecializationWitness &witness) {
+  llvm::json::Array arguments;
+  for (const auto &binding : witness.arguments) {
+    llvm::json::Object argument{{"argument", int64_t(binding.argument)}};
+    if (binding.scalar)
+      argument["value"] = *binding.scalar;
+    else {
+      llvm::json::Array shape;
+      for (int64_t extent : binding.shape)
+        shape.push_back(extent);
+      argument["shape"] = std::move(shape);
+    }
+    arguments.push_back(std::move(argument));
+  }
+  return llvm::json::Object{
+      {"schema", "orbit-taskflow-argument-specialization-v1"},
+      {"function", witness.function},
+      {"arguments", std::move(arguments)},
+      {"source_fingerprint", witness.sourceFingerprint},
+      {"specialized_fingerprint", witness.specializedFingerprint},
+      {"dispatch_guard", "exact scalar values and memref shapes"},
+      {"source_replay_verified", true}};
+}
+} // namespace orbit::taskflow
