new file mode 100644
index 0000000000000000000000000000000000000000..2325b6e2bbeafdada499233a3a725924091a4a86
--- /dev/null
+++ b/lib/Taskflow/TaskflowInvocation.cpp
@@ -0,0 +1,79 @@
+//===- TaskflowInvocation.cpp - Runtime-bound graph ownership
+//--------------===//
+#include "Taskflow/TaskflowInvocation.h"
+#include "llvm/ADT/STLExtras.h"
+using namespace mlir;
+namespace orbit::taskflow {
+bool materializeTaskflowInvocationSequence(
+    ModuleOp original, const ProgramInvocationRange &range,
+    llvm::ArrayRef<ProgramPersistentState> states,
+    const TaskflowInvocationPlanProvider &provider,
+    const TaskflowInvocationGraphBuilder &builder,
+    TaskflowInvocationSequence &out, std::string &error,
+    const SourceActionExtension &extension) {
+  out = {};
+  if (!provider || !builder) {
+    error =
+        "runtime-bound sequence requires actual arguments and a graph builder";
+    return false;
+  }
+  TaskflowInvocationSequence trial;
+  if (!buildProgramInvocationSequence(
+          range, states,
+          [&](int64_t iteration, ProgramGraph &graph, std::string &error) {
+            TaskflowDeferredPlan plan;
+            TaskflowDeferredPlanResult call;
+            if (!provider(iteration, plan, error) ||
+                failed(materializeTaskflowDeferredPlan(original, plan, call,
+                                                       error, extension)) ||
+                !builder(*call.normalized, graph, error))
+              return false;
+            GenericAnalysis actual;
+            if (!analyzeGenericProgram(*call.normalized, actual, error) ||
+                !checkProgramGraphSource(actual, graph, error))
+              return false;
+            trial.calls.push_back(std::move(call));
+            return true;
+          },
+          trial.execution, error))
+    return false;
+  out = std::move(trial);
+  return true;
+}
+bool executeTaskflowInvocationSequence(
+    ModuleOp original, const TaskflowInvocationSequence &sequence,
+    const TaskflowInvocationArguments &arguments,
+    const ProgramInvocationExecutor &executor, std::string &error,
+    const SourceActionExtension &extension) {
+  if (!arguments || !executor ||
+      sequence.calls.size() != sequence.execution.steps.size() ||
+      !checkProgramInvocationSequence(sequence.execution, error)) {
+    if (error.empty())
+      error = "runtime-bound sequence lacks its real call owners or callbacks";
+    return false;
+  }
+  for (auto [index, step] : llvm::enumerate(sequence.execution.steps)) {
+    std::vector<TaskflowArgumentBinding> actual;
+    if (!arguments(step.iteration, actual, error) ||
+        failed(verifyTaskflowDeferredPlan(original, sequence.calls[index],
+                                          actual, error, extension)))
+      return false;
+    GenericAnalysis source;
+    if (!analyzeGenericProgram(*sequence.calls[index].normalized, source,
+                               error) ||
+        !checkProgramGraphSource(source, step.graph, error))
+      return false;
+  }
+  return executeProgramInvocationSequence(sequence.execution, executor, error);
+}
+llvm::json::Value serializeTaskflowInvocationSequence(
+    const TaskflowInvocationSequence &sequence) {
+  llvm::json::Array calls;
+  for (const auto &call : sequence.calls)
+    calls.push_back(serializeTaskflowDeferredPlan(call));
+  return llvm::json::Object{
+      {"schema", "orbit-taskflow-runtime-invocations-v1"},
+      {"calls", std::move(calls)},
+      {"execution", serializeProgramInvocationSequence(sequence.execution)}};
+}
+} // namespace orbit::taskflow
diff --git a/lib/Taskflow/TaskflowReplica.cpp b/lib/Taskflow/TaskflowReplica.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..4215ff99058a98b04c6cd46134e45a3ab9ccf319
--- /dev/null
+++ b/lib/Taskflow/TaskflowReplica.cpp
@@ -0,0 +1,143 @@
+//===- TaskflowReplica.cpp - Independent source-domain replicas -----------===//
+#include "Taskflow/TaskflowReplica.h"
+#include "Taskflow/TaskflowTiling.h"
+#include "TaskflowDialect/TaskflowOps.h"
+#include "mlir/IR/OwningOpRef.h"
+#include "mlir/IR/Verifier.h"
+#include "llvm/Support/raw_ostream.h"
+using namespace mlir;
+namespace orbit::taskflow {
+namespace {
+std::string witness(ModuleOp module) {
+  std::string text;
+  llvm::raw_string_ostream stream(text);
+  module.print(stream, OpPrintingFlags().printGenericOpForm());
+  stream.flush();
+  return text;
+}
+} // namespace
+LogicalResult
+readTaskflowReplicaHierarchy(Operation *task,
+                             std::vector<TaskflowReplicaLevel> &out,
+                             std::string &error) {
+  out.clear();
+  bool present = false;
+  for (NamedAttribute attr : task->getAttrs()) {
+    StringRef name = attr.getName().strref();
+    if (!name.starts_with("orbit.replica."))
+      continue;
+    present = true;
+    if (name != "orbit.replica.group" && name != "orbit.replica.instance" &&
+        name != "orbit.replica.count" &&
+        name != "orbit.replica.requires_independent_resources" &&
+        name != "orbit.replica.path" && name != "orbit.replica.level_counts" &&
+        name != "orbit.replica.owners") {
+      error = "unknown source replica resource obligation";
+      return failure();
+    }
+  }
+  if (!present)
+    return success();
+  auto group = task->getAttrOfType<StringAttr>("orbit.replica.group");
+  auto instance = task->getAttrOfType<IntegerAttr>("orbit.replica.instance");
+  auto count = task->getAttrOfType<IntegerAttr>("orbit.replica.count");
+  if (!group || group.getValue().empty() || !instance || !count ||
+      !instance.getType().isInteger(64) || !count.getType().isInteger(64) ||
+      count.getInt() < 2 || instance.getInt() < 0 ||
+      instance.getInt() >= count.getInt() ||
+      !task->getAttrOfType<UnitAttr>(
+          "orbit.replica.requires_independent_resources")) {
+    error = "incomplete source replica resource obligation";
+    return failure();
+  }
+  bool hierarchical = task->hasAttr("orbit.replica.path") ||
+                      task->hasAttr("orbit.replica.level_counts") ||
+                      task->hasAttr("orbit.replica.owners");
+  if (!hierarchical) {
+    out.push_back({group.getValue().str(), instance.getInt(), count.getInt()});
+    return success();
+  }
+  auto path = task->getAttrOfType<DenseI64ArrayAttr>("orbit.replica.path");
+  auto counts =
+      task->getAttrOfType<DenseI64ArrayAttr>("orbit.replica.level_counts");
+  auto owners = task->getAttrOfType<ArrayAttr>("orbit.replica.owners");
+  if (!path || !counts || !owners || path.size() < 2 ||
+      path.size() != counts.size() || path.size() != owners.size() ||
+      path[0] != instance.getInt() || counts[0] != count.getInt()) {
+    error =
+        "replica hierarchy must preserve its complete outer ownership contract";
+    return failure();
+  }
+  std::vector<TaskflowReplicaLevel> parsed;
+  for (size_t level = 0; level < path.size(); ++level) {
+    auto owner = dyn_cast<StringAttr>(owners[level]);
+    if (!owner || owner.getValue().empty() || counts[level] < 2 ||
+        path[level] < 0 || path[level] >= counts[level] ||
+        (level == 0 && owner.getValue() != group.getValue())) {
+      error = "invalid independent replica ownership path";
+      return failure();
+    }
+    parsed.push_back({owner.getValue().str(), path[level], counts[level]});
+  }
+  out = std::move(parsed);
+  return success();
+}
+LogicalResult validateTaskflowReplicaContract(Operation *task,
+                                              std::string &error) {
+  std::vector<TaskflowReplicaLevel> levels;
+  return readTaskflowReplicaHierarchy(task, levels, error);
+}
+bool haveSameTaskflowReplicaContract(Operation *first, Operation *second) {
+  std::string error;
+  if (failed(validateTaskflowReplicaContract(first, error)) ||
+      failed(validateTaskflowReplicaContract(second, error)))
+    return false;
+  for (StringRef name :
+       {"orbit.replica.group", "orbit.replica.instance", "orbit.replica.count",
+        "orbit.replica.requires_independent_resources", "orbit.replica.path",
+        "orbit.replica.level_counts", "orbit.replica.owners"})
+    if (first->getAttr(name) != second->getAttr(name))
+      return false;
+  return true;
+}
+void copyTaskflowReplicaContract(Operation *source, Operation *destination) {
+  for (NamedAttribute attr : source->getAttrs())
+    if (attr.getName().strref().starts_with("orbit.replica."))
+      destination->setAttr(attr.getName(), attr.getValue());
+}
+LogicalResult materializeTaskflowReplicas(ModuleOp module,
+                                          const TaskflowReplicaAction &action,
+                                          std::string &error) {
+  return materializeTaskflowDomainPartition(
+      module, {action.function, action.task, action.axis, action.count},
+      TaskflowDomainPartitionKind::IndependentReplicas, error);
+}
+LogicalResult
+verifyTaskflowReplicaReplay(ModuleOp parent, ModuleOp candidate,
+                            ArrayRef<TaskflowReplicaAction> actions,
+                            std::string &error) {
+  error.clear();
+  if (!parent || !candidate || failed(verify(parent)) ||
+      failed(verify(candidate))) {
+    error = "replica replay requires verified parent and candidate modules";
+    return failure();
+  }
+  OwningOpRef<ModuleOp> replay = parent.clone();
+  for (const auto &action : actions)
+    if (failed(materializeTaskflowReplicas(*replay, action, error)))
+      return failure();
+  if (witness(*replay) != witness(candidate)) {
+    error = "candidate is not the exact independent-replica source replay";
+    return failure();
+  }
+  return success();
+}
+bool hasTaskflowReplicaGroups(ModuleOp module) {
+  bool found = false;
+  if (module)
+    module.walk([&](mlir::taskflow::TaskflowTaskOp task) {
+      found |= task->hasAttr("orbit.replica.group");
+    });
+  return found;
+}
+} // namespace orbit::taskflow
