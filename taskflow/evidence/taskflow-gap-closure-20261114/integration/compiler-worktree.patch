@@ -0,0 +1,402 @@
+// Actual source instance groups lower to concrete independently owned herds.
+#include "Taskflow/NPUIndependentShards.h"
+#include "Taskflow/NPUPhysicalProgram.h"
+#include "Taskflow/NativeTransforms.h"
+#include "Taskflow/ProgramGraphAIE.h"
+#include "Taskflow/ProgramGraphAIR.h"
+#include "Taskflow/ProgramGraphAIRSelection.h"
+#include "Taskflow/SourceMappingActions.h"
+#include "Taskflow/TaskPlacement.h"
+#include "Taskflow/TaskTiling.h"
+#include "Taskflow/TaskflowFission.h"
+#include "Taskflow/TaskflowReplica.h"
+#include "TaskflowDialect/TaskflowDialect.h"
+#include "mlir/Dialect/Affine/IR/AffineOps.h"
+#include "mlir/Dialect/Arith/IR/Arith.h"
+#include "mlir/Dialect/Func/IR/FuncOps.h"
+#include "mlir/Dialect/MemRef/IR/MemRef.h"
+#include "mlir/Dialect/SCF/IR/SCF.h"
+#include "mlir/Parser/Parser.h"
+#include "llvm/Support/FileSystem.h"
+#include "llvm/Support/FormatVariadic.h"
+#include "llvm/Support/Path.h"
+#include "llvm/Support/raw_ostream.h"
+#include <set>
+using namespace mlir;
+using namespace orbit::taskflow;
+int main(int argc, char **argv) {
+  if (argc != 2 && argc != 3 && argc != 4)
+    return 2;
+  DialectRegistry registry;
+  registry.insert<mlir::taskflow::TaskflowDialect, affine::AffineDialect,
+                  arith::ArithDialect, func::FuncDialect, memref::MemRefDialect,
+                  scf::SCFDialect>();
+  MLIRContext context(registry);
+  auto source = parseSourceFile<ModuleOp>(argv[1], &context);
+  auto parsed = llvm::json::parse(R"json({"generic_air":{
+    "capacity_bytes":24576,
+    "capabilities":{"tile_alignment":[1,1,1],"implementations":[{"kind":"scalar","lanes":1}]},
+    "npu_independent_target":{"device":"npu2","columns":8,
+      "first_compute_row":3,"compute_rows":1,"capacity_bytes":24576,"max_static_bds":4}}})json");
+  if (!source || !parsed)
+    return 3;
+  std::string error;
+  if (failed(materializeTaskflowReplicas(
+          *source, {"pointwise", "Pointwise", 0, 6}, error)) ||
+      failed(materializeTaskflowFission(
+          *source, "pointwise", "Pointwise.replica.0.0", {0, 1}, error))) {
+    llvm::errs() << error;
+    return 4;
+  }
+  OwningOpRef<ModuleOp> air;
+  llvm::json::Value manifest = nullptr;
+  if (!lowerNPUReplicaProgram(*source, *parsed, air, manifest, error)) {
+    llvm::errs() << error;
+    return 5;
+  }
+  auto *records = manifest.getAsObject()->getArray("shards");
+  if (!records || records->size() != 6)
+    return 6;
+  std::set<std::pair<int64_t, int64_t>> coordinates;
+  unsigned herds = 0;
+  air->walk([&](Operation *op) {
+    if (op->getName().getStringRef() != "air.herd")
+      return;
+    ++herds;
+    coordinates.emplace(op->getAttrOfType<IntegerAttr>("x_loc").getInt(),
+                        op->getAttrOfType<IntegerAttr>("y_loc").getInt());
+  });
+  if (herds != 6 || coordinates.size() != 6 || !coordinates.count({5, 3}))
+    return 7;
+  auto emit = [&](StringRef label, ModuleOp input, ModuleOp lowered,
+                  const llvm::json::Value &record) {
+    if (argc < 3)
+      return;
+    std::string prefix = std::string(argv[2]) + "/" + label.str();
+    llvm::sys::fs::create_directories(argv[2]);
+    std::error_code ec;
+    llvm::raw_fd_ostream src(prefix + ".source.mlir", ec);
+    input.print(src, OpPrintingFlags().printGenericOpForm());
+    llvm::raw_fd_ostream physical(prefix + ".air.mlir", ec);
+    lowered.print(physical, OpPrintingFlags().printGenericOpForm());
+    llvm::raw_fd_ostream receipt(prefix + ".manifest.json", ec);
+    receipt << llvm::formatv("{0:2}\n", record);
+    llvm::raw_fd_ostream target(prefix + ".target.json", ec);
+    target << llvm::formatv("{0:2}\n", *parsed);
+  };
+  emit("replica6-fission", *source, *air, manifest);
+  // A narrower explicit geometry cannot inherit the old placement meaning.
+  auto *profile = parsed->getAsObject()
+                      ->getObject("generic_air")
+                      ->getObject("npu_independent_target");
+  (*profile)["columns"] = 4;
+  if (lowerNPUReplicaProgram(*source, *parsed, air, manifest, error))
+    return 8;
+  (*profile)["columns"] = 8;
+  auto malformed = source->clone();
+  malformed.walk([&](mlir::taskflow::TaskflowTaskOp task) {
+    task->setAttr("orbit.replica.instance",
+                  IntegerAttr::get(IntegerType::get(&context, 64), 0));
+  });
+  if (lowerNPUReplicaProgram(malformed, *parsed, air, manifest, error))
+    return 9;
+  malformed.erase();
+  // A single task's shape is actually expanded and placed over a 2x2 grid.
+  // It does not change resourceCount into repeated program work.
+  auto shaped = parseSourceFile<ModuleOp>(argv[1], &context);
+  (*profile)["compute_rows"] = 2;
+  const std::vector<MappingTaskPlacement> shapeChoice{
+      {0, "", "", "scalar", 1, {2, 2}}};
+  if (!setTaskPlacementChoices(*shaped, "pointwise", shapeChoice, error) ||
+      !lowerNPUPlacedProgram(*shaped, *parsed, air, manifest, error)) {
+    llvm::errs() << error;
+    return 10;
+  }
+  coordinates.clear();
+  air->walk([&](Operation *op) {
+    if (op->getName().getStringRef() == "air.herd")
+      coordinates.emplace(op->getAttrOfType<IntegerAttr>("x_loc").getInt(),
+                          op->getAttrOfType<IntegerAttr>("y_loc").getInt());
+  });
+  if (coordinates !=
+      std::set<std::pair<int64_t, int64_t>>{{0, 3}, {1, 3}, {0, 4}, {1, 4}})
+    return 11;
+  emit("shape2x2", *shaped, *air, manifest);
+  // The public source-bound tile policy must survive shape expansion and
+  // produce two actual temporal instances per physical core, not one task/core.
+  auto policyShape = parseSourceFile<ModuleOp>(argv[1], &context);
+  SourceMappingActionOptions policyOptions;
+  policyOptions.mapping = false;
+  if (!setTaskPlacementChoices(*policyShape, "pointwise", shapeChoice, error) ||
+      !getGenericTargetCapabilities(*parsed, policyOptions.capabilities, error))
+    return 40;
+  std::vector<NeighborhoodAction> policyActions;
+  SourceActionOptions policyDomain;
+  auto enumeratePolicy = makeSourceMappingActionEnumerator(policyOptions);
+  if (failed(enumeratePolicy(*policyShape, "pointwise", policyDomain,
+                             policyActions, error)))
+    return 41;
+  auto tileAction = llvm::find_if(policyActions, [](const auto &action) {
+    return action.primitives.size() == 1 &&
+           action.primitives.front().kind == "native-task-tile";
+  });
+  if (tileAction == policyActions.end())
+    return 42;
+  auto applyPolicy = makeSourceMappingActionMaterializer(policyOptions);
+  const std::vector<TaskTileChoice> tilePolicy{{0, {8, 64}}};
+  const std::vector<NativeTaskImplementationChoice> scalarPolicy{
+      {0, "scalar", 1}};
+  if (failed(applyPolicy(*policyShape, "pointwise",
+                         tileAction->primitives.front(), error)) ||
+      !setTaskTileChoices(*policyShape, 1, tilePolicy, error) ||
+      !setNativeTaskImplementations(*policyShape, 1, scalarPolicy, error) ||
+      failed(
+          checkSourceMappingActionBindings(*policyShape, "pointwise", error))) {
+    llvm::errs() << error;
+    return 43;
+  }
+  std::vector<OwningOpRef<ModuleOp>> policyWaves;
+  if (!lowerNPUPlacedProgramWaves(*policyShape, *parsed, policyWaves, manifest,
+                                  error)) {
+    llvm::errs() << error;
+    return 44;
+  }
+  auto *policyGraph = manifest.getAsObject()->getObject("program_graph");
+  auto *policyInstances =
+      policyGraph ? policyGraph->getArray("instances") : nullptr;
+  if (!policyInstances || policyInstances->size() != 8 || policyWaves.empty())
+    return 45;
+  emit("policy-shape2x2", *policyShape, *policyWaves.front(), manifest);
+  // A concrete resource names an actual core and its own SRAM. This is not
+  // merely a preferred ordinal: the emitted herd must occupy that coordinate.
+  const std::string smallFixture = llvm::sys::path::parent_path(argv[1]).str() +
+                                   "/source-placement-pointwise32.mlir";
+  auto explicitUnit = parseSourceFile<ModuleOp>(smallFixture, &context);
+  const std::vector<MappingTaskPlacement> coordinateChoice{
+      {0, "npu.tile.6.4", "npu.l1.6.4", "scalar", 1, {1, 1}}};
+  if (!setTaskPlacementChoices(*explicitUnit, "pointwise", coordinateChoice,
+                               error) ||
+      !lowerNPUPlacedProgram(*explicitUnit, *parsed, air, manifest, error)) {
+    llvm::errs() << error;
+    return 13;
+  }
+  coordinates.clear();
+  air->walk([&](Operation *op) {
+    if (op->getName().getStringRef() == "air.herd")
+      coordinates.emplace(op->getAttrOfType<IntegerAttr>("x_loc").getInt(),
+                          op->getAttrOfType<IntegerAttr>("y_loc").getInt());
+  });
+  if (coordinates != std::set<std::pair<int64_t, int64_t>>{{6, 4}})
+    return 14;
+  auto mismatchedChoice = coordinateChoice;
+  mismatchedChoice[0].memory = "npu.l1.5.4";
+  if (!setTaskPlacementChoices(*explicitUnit, "pointwise", mismatchedChoice,
+                               error) ||
+      lowerNPUPlacedProgram(*explicitUnit, *parsed, air, manifest, error))
+    return 15;
+  auto defaultChoice = coordinateChoice;
+  defaultChoice.front().resource = "npu.tile.0.2";
+  defaultChoice.front().memory = "npu.l1.0.2";
+  const llvm::json::Value defaultTarget = llvm::json::Object{};
+  if (!setTaskPlacementChoices(*explicitUnit, "pointwise", defaultChoice,
+                               error) ||
+      !lowerNPUPlacedProgram(*explicitUnit, defaultTarget, air, manifest,
+                             error)) {
+    llvm::errs() << error;
+    return 28;
+  }
+  auto state = parseSourceFile<ModuleOp>(argv[1], &context);
+  auto stateFunction = *state->getOps<func::FuncOp>().begin();
+  stateFunction.getArgument(1).replaceAllUsesWith(stateFunction.getArgument(0));
+  stateFunction.eraseArgument(1);
+  stateFunction.setArgAttr(0, "orbit.role", StringAttr::get(&context, "state"));
+  stateFunction.setArgAttr(0, "orbit.name", StringAttr::get(&context, "S"));
+  if (!setTaskPlacementChoices(*state, "pointwise", shapeChoice, error) ||
+      !lowerNPUPlacedProgram(*state, *parsed, air, manifest, error)) {
+    llvm::errs() << error;
+    return 12;
+  }
+  emit("state2x2", *state, *air, manifest);
+  // Three compute rows exceed the two simultaneous direct shim streams per
+  // column. Preserve the complete global graph and execute proven event cuts
+  // in separate configurations; no local version is allowed to cross a cut.
+  (*profile)["columns"] = 2;
+  (*profile)["compute_rows"] = 3;
+  std::vector<NPUShardBinding> waveBindings;
+  for (int64_t instance = 0; instance < 6; ++instance)
+    waveBindings.push_back({0, 1, instance % 2, 3 + instance / 2, true});
+  OwningOpRef<ModuleOp> physicalSource;
+  ProgramGraph graph;
+  llvm::json::Value graphReceipt = nullptr, unionReceipt = nullptr;
+  if (!buildNPUPhysicalProgram(*source, *parsed, waveBindings, physicalSource,
+                               graph, graphReceipt, error)) {
+    llvm::errs() << error;
+    return 16;
+  }
+  std::vector<ProgramGraphAIRSelection> waves;
+  if (!buildProgramGraphAIRSelections(graph, 4, waves, unionReceipt, error) ||
+      waves.size() < 3) {
+    llvm::errs() << error;
+    return 17;
+  }
+  std::vector<ProgramInvocationWave> invocationRanges;
+  for (const auto &wave : waves)
+    invocationRanges.push_back({wave.begin, wave.end});
+  if (!bindProgramInvocationWaves(graph, invocationRanges, "host-submission",
+                                  "system_memory_bo", error)) {
+    llvm::errs() << error;
+    return 21;
+  }
+  for (auto &wave : waves)
+    wave.graphId = programGraphIdentity(graph);
+  if (!checkProgramGraphAIRSelectionUnion(graph, waves, unionReceipt, error))
+    return 22;
+  std::set<std::pair<int64_t, int64_t>> waveCores;
+  for (size_t i = 0; i < waves.size(); ++i) {
+    llvm::json::Value waveManifest = nullptr;
+    if (!lowerProgramGraphAIRSelection(graph, waves[i], air, waveManifest,
+                                       error)) {
+      llvm::errs() << error;
+      return 18;
+    }
+    air->walk([&](Operation *op) {
+      if (op->getName().getStringRef() == "air.herd")
+        waveCores.emplace(op->getAttrOfType<IntegerAttr>("x_loc").getInt(),
+                          op->getAttrOfType<IntegerAttr>("y_loc").getInt());
+    });
+    (*waveManifest.getAsObject())["configuration_union"] = unionReceipt;
+    emit("wave" + std::to_string(i), *physicalSource, *air, waveManifest);
+    if (argc == 4) {
+      auto actual = parseSourceFile<ModuleOp>(std::string(argv[3]) + "/wave" +
+                                                  std::to_string(i) + ".mlir",
+                                              &context);
+      llvm::json::Value aieReceipt = nullptr;
+      if (!actual || !checkProgramGraphAIE(graph, *air, *actual, aieReceipt,
+                                           error, &waves[i])) {
+        llvm::errs() << error;
+        return 19;
+      }
+      std::error_code ec;
+      llvm::raw_fd_ostream proof(std::string(argv[2]) + "/wave" +
+                                     std::to_string(i) + ".aie-proof.json",
+                                 ec);
+      proof << llvm::formatv("{0:2}\n", aieReceipt);
+    }
+  }
+  if (waveCores != std::set<std::pair<int64_t, int64_t>>{
+                       {0, 3}, {1, 3}, {0, 4}, {1, 4}, {0, 5}, {1, 5}})
+    return 20;
+  // Ordinary task placement is independent of replica grouping. A real
+  // producer/consumer cut on different cores must materialize its host BO
+  // handoff and survive the same checked serial invocation mechanism.
+  auto crossCore = parseSourceFile<ModuleOp>(smallFixture, &context);
+  if (failed(materializeTaskflowFission(*crossCore, "pointwise", "Pointwise",
+                                        {0, 1}, error))) {
+    llvm::errs() << error;
+    return 23;
+  }
+  const std::vector<MappingTaskPlacement> crossChoices{
+      {0, "npu.tile.0.3", "npu.l1.0.3", "scalar", 1, {1, 1}},
+      {1, "npu.tile.1.3", "npu.l1.1.3", "scalar", 1, {1, 1}}};
+  std::vector<OwningOpRef<ModuleOp>> crossWaves;
+  if (!setTaskPlacementChoices(*crossCore, "pointwise", crossChoices, error) ||
+      !lowerNPUPlacedProgramWaves(*crossCore, *parsed, crossWaves, manifest,
+                                  error) ||
+      crossWaves.size() < 2) {
+    llvm::errs() << error;
+    return 24;
+  }
+  emit("crosscore", *crossCore, *crossWaves.front(), manifest);
+  auto forgedChoices = crossChoices;
+  forgedChoices[1].memory = "npu.l1.0.3";
+  if (!setTaskPlacementChoices(*crossCore, "pointwise", forgedChoices, error) ||
+      lowerNPUPlacedProgramWaves(*crossCore, *parsed, crossWaves, manifest,
+                                 error))
+    return 25;
+  auto nested = parseSourceFile<ModuleOp>(smallFixture, &context);
+  if (failed(materializeTaskflowReplicas(
+          *nested, {"pointwise", "Pointwise", 0, 2}, error)) ||
+      failed(materializeTaskflowReplicas(
+          *nested, {"pointwise", "Pointwise.replica.0.0", 1, 2}, error)) ||
+      failed(materializeTaskflowReplicas(
+          *nested, {"pointwise", "Pointwise.replica.0.1", 1, 2}, error)) ||
+      !lowerNPUPlacedProgramWaves(*nested, *parsed, crossWaves, manifest,
+                                  error)) {
+    llvm::errs() << error;
+    return 26;
+  }
+  std::set<std::pair<int64_t, int64_t>> nestedCores;
+  for (auto &wave : crossWaves)
+    wave->walk([&](Operation *op) {
+      if (op->getName().getStringRef() == "air.herd")
+        nestedCores.emplace(op->getAttrOfType<IntegerAttr>("x_loc").getInt(),
+                            op->getAttrOfType<IntegerAttr>("y_loc").getInt());
+    });
+  if (nestedCores !=
+      std::set<std::pair<int64_t, int64_t>>{{0, 3}, {0, 4}, {1, 3}, {1, 4}})
+    return 27;
+  emit("nested2x2", *nested, *crossWaves.front(), manifest);
+  // Distinct source stages retain their own numeric identities while both
+  // expand over the same actual grid and communicate through the real ledger.
+  auto multiShape = parseSourceFile<ModuleOp>(argv[1], &context);
+  const std::vector<MappingTaskPlacement> twoShapeChoices{
+      {0, "", "", "scalar", 1, {2, 2}}, {1, "", "", "scalar", 1, {2, 2}}};
+  (*profile)["columns"] = 4;
+  (*profile)["compute_rows"] = 2;
+  if (failed(materializeTaskflowFission(*multiShape, "pointwise", "Pointwise",
+                                        {0, 1}, error)) ||
+      !setTaskPlacementChoices(*multiShape, "pointwise", twoShapeChoices,
+                               error) ||
+      !lowerNPUPlacedProgramWaves(*multiShape, *parsed, crossWaves, manifest,
+                                  error)) {
+    llvm::errs() << error;
+    return 46;
+  }
+  auto *multiGraph = manifest.getAsObject()->getObject("program_graph");
+  if (!multiGraph || multiGraph->getArray("instances")->size() != 8)
+    return 47;
+  emit("multidfg-shape2x2", *multiShape, *crossWaves.front(), manifest);
+  auto replicaShape = parseSourceFile<ModuleOp>(argv[1], &context);
+  const std::vector<MappingTaskPlacement> replicaShapeChoices{
+      {0, "", "", "scalar", 1, {1, 2}}, {1, "", "", "scalar", 1, {1, 2}}};
+  if (failed(materializeTaskflowReplicas(
+          *replicaShape, {"pointwise", "Pointwise", 0, 2}, error)) ||
+      !setTaskPlacementChoices(*replicaShape, "pointwise", replicaShapeChoices,
+                               error) ||
+      !lowerNPUPlacedProgramWaves(*replicaShape, *parsed, crossWaves, manifest,
+                                  error)) {
+    llvm::errs() << error;
+    return 48;
+  }
+  auto *replicaShapeGraph = manifest.getAsObject()->getObject("program_graph");
+  if (!replicaShapeGraph ||
+      replicaShapeGraph->getArray("instances")->size() != 4)
+    return 49;
+  emit("replica-shape1x2", *replicaShape, *crossWaves.front(), manifest);
+  // A valid-width hierarchy can still overflow mixed-radix multiplication
+  // plus its digit before full-group coverage validation; reject without UB.
+  auto oversizedHierarchy = replicaShape->clone();
+  oversizedHierarchy.walk([&](mlir::taskflow::TaskflowTaskOp task) {
+    const auto group = task->getAttrOfType<StringAttr>("orbit.replica.group");
+    const int64_t instance =
+        task->getAttrOfType<IntegerAttr>("orbit.replica.instance").getInt();
+    task->setAttr("orbit.replica.path",
+                  DenseI64ArrayAttr::get(&context, {instance, 1}));
+    task->setAttr("orbit.replica.level_counts",
+                  DenseI64ArrayAttr::get(&context, {2, INT64_MAX}));
+    task->setAttr(
+        "orbit.replica.owners",
+        ArrayAttr::get(
+            &context,
+            {group, StringAttr::get(&context, group.str() + "/oversized")}));
+  });
+  if (lowerNPUPlacedProgramWaves(oversizedHierarchy, *parsed, crossWaves,
+                                 manifest, error) ||
+      error.find("overflows") == std::string::npos)
+    return 50;
+  oversizedHierarchy.erase();
+  llvm::outs()
+      << "six real replica herds, nondefault target row, grouped "
+         "fission stages, geometry and forged-instance rejection passed\n";
+  return 0;
+}
diff --git a/test/TaskflowGeneric/generic-carry-domain.cpp b/test/TaskflowGeneric/generic-carry-domain.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..5433550ec4897fbba20a01caaf3c8e3b76106e6d
--- /dev/null
+++ b/test/TaskflowGeneric/generic-carry-domain.cpp
@@ -0,0 +1,96 @@
+#include "Taskflow/GenericMapping.h"
+#include "TaskflowDialect/TaskflowDialect.h"
+#include "mlir/Dialect/Arith/IR/Arith.h"
+#include "mlir/Dialect/MemRef/IR/MemRef.h"
+#include "mlir/Dialect/SCF/IR/SCF.h"
+#include "mlir/Parser/Parser.h"
+#include "llvm/Support/raw_ostream.h"
+using namespace orbit::taskflow;
+static const char *source = R"mlir(module {
+ func.func @carry(%out: memref<8xf32> {orbit.role="output",orbit.name="O"}, %total: memref<1xf32> {orbit.role="output",orbit.name="T"}) attributes {orbit.noalias} {
+ %r:2 = taskflow.task @scan will_writes(%out,%total : memref<8xf32>,memref<1xf32>) [original_write_memrefs(%out,%total : memref<8xf32>,memref<1xf32>)] : (memref<8xf32>,memref<1xf32>) -> (memref<8xf32>,memref<1xf32>) {
+ ^bb0(%o: memref<8xf32>, %t: memref<1xf32>):
+ %z=arith.constant 0 : index
+ %n=arith.constant 8 : index
+ %one=arith.constant 1 : index
+ %seed=arith.constant 0.0 : f32
+ %v=scf.for %i=%z to %n step %one iter_args(%acc=%seed) -> (f32) {
+  %increment=arith.constant 1.0 : f32
+  %next=arith.addf %acc,%increment : f32
+  memref.store %next,%o[%i] : memref<8xf32>
+  scf.yield %next : f32
+ }
+ memref.store %v,%t[%z] : memref<1xf32>
+ taskflow.yield done_writes(%o,%t : memref<8xf32>,memref<1xf32>)
+ }
+ return
+ }
+})mlir";
+int main() {
+  mlir::DialectRegistry registry;
+  registry.insert<mlir::taskflow::TaskflowDialect, mlir::arith::ArithDialect,
+                  mlir::memref::MemRefDialect, mlir::scf::SCFDialect,
+                  mlir::func::FuncDialect>();
+  mlir::MLIRContext context(registry);
+  std::string error;
+  unsigned checks = 0;
+  bool ok = true;
+  auto require = [&](bool value, const char *label) {
+    if (value)
+      ++checks;
+    else {
+      ok = false;
+      llvm::errs() << label << ": " << error << '\n';
+    }
+  };
+  auto module = mlir::parseSourceString<mlir::ModuleOp>(source, &context);
+  GenericAnalysis facts;
+  require(module && analyzeGenericProgram(*module, facts, error),
+          "static scalar recurrence source is analyzed");
+  if (facts.tasks.empty())
+    return 1;
+  require(facts.tasks[0].loops.size() == 1 &&
+              facts.tasks[0].loops[0].loopCarried,
+          "source axis records real loop-carried state");
+  GenericMappingPlan plan;
+  llvm::json::Value full = llvm::json::Object{
+      {"generic_air",
+       llvm::json::Object{{"tile_sizes", llvm::json::Array{8}}}}};
+  require(planGenericMapping(facts, full, plan, error) &&
+              checkGenericMapping(facts, plan, error),
+          "complete recurrence axis maps without resetting iter_args");
+  llvm::json::Value split = llvm::json::Object{
+      {"generic_air",
+       llvm::json::Object{{"tile_sizes", llvm::json::Array{4}}}}};
+  GenericMappingPlan rejected;
+  require(!planGenericMapping(facts, split, rejected, error),
+          "raw partial tile cannot reset scalar carry");
+  if (!plan.communication.instances.empty()) {
+    auto bad = plan.communication;
+    bad.instances[0].domain[0].upper = 4;
+    require(!checkProgramGraph(bad, error),
+            "public graph rejects forged recurrence split");
+  }
+  // A compatible top-level view keeps one real static storage; no new alias
+  // storage or fabricated dynamic extent is introduced by parameter binding.
+  auto function = module->lookupSymbol<mlir::func::FuncOp>("carry");
+  mlir::OpBuilder builder(&context);
+  builder.setInsertionPointToStart(&function.front());
+  auto argument = function.getArgument(0);
+  auto dynamic =
+      mlir::MemRefType::get({mlir::ShapedType::kDynamic}, builder.getF32Type());
+  auto cast = builder.create<mlir::memref::CastOp>(function.getLoc(), dynamic,
+                                                   argument);
+  auto fixed = builder.create<mlir::memref::CastOp>(
+      function.getLoc(), argument.getType(), cast.getResult());
+  argument.replaceUsesWithIf(fixed.getResult(), [&](mlir::OpOperand &use) {
+    return use.getOwner() != cast.getOperation();
+  });
+  GenericAnalysis rebound;
+  require(
+      analyzeGenericProgram(*module, rebound, error) &&
+          rebound.storages.size() == 2 && rebound.storages[0].root == argument,
+      "verified compatible casts retain the concrete static source identity");
+  llvm::outs() << "generic carry domain: " << checks << " checks\n";
+  return ok ? 0 : 1;
+}
diff --git a/test/TaskflowGeneric/heterogeneous-state.cpp b/test/TaskflowGeneric/heterogeneous-state.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..fa91fa8cfa48898fea8a0ab317e10469599dd02e
--- /dev/null
+++ b/test/TaskflowGeneric/heterogeneous-state.cpp
@@ -0,0 +1,86 @@
+// A mutable boundary has one storage root and two versioned directions.
+#include "Taskflow/GenericAnalysis.h"
+#include "Taskflow/HeterogeneousMapping.h"
+#include "TaskflowDialect/TaskflowDialect.h"
+#include "mlir/Dialect/Affine/IR/AffineOps.h"
+#include "mlir/Dialect/Arith/IR/Arith.h"
+#include "mlir/Dialect/Func/IR/FuncOps.h"
+#include "mlir/Dialect/MemRef/IR/MemRef.h"
+#include "mlir/Parser/Parser.h"
+#include "llvm/Support/raw_ostream.h"
+using namespace mlir;
+using namespace orbit::taskflow;
+static const char *source = R"mlir(module {
+func.func @update(%kv: memref<8xf32> {orbit.role="state", orbit.name="KV"}) attributes {orbit.noalias} {
+ %first = taskflow.task @first will_reads(%kv : memref<8xf32>) will_writes(%kv : memref<8xf32>) [original_read_memrefs(%kv : memref<8xf32>), original_write_memrefs(%kv : memref<8xf32>)] : (memref<8xf32>, memref<8xf32>) -> memref<8xf32> {
+ ^bb0(%read: memref<8xf32>, %write: memref<8xf32>):
+  affine.for %i = 0 to 8 {
+   %v = affine.load %read[%i] : memref<8xf32>
+   %one = arith.constant 1.0 : f32
+   %next = arith.addf %v, %one : f32
+   affine.store %next, %write[%i] : memref<8xf32>
+  }
+  taskflow.yield done_writes(%write : memref<8xf32>)
+ }
+ %last = taskflow.task @last will_reads(%first : memref<8xf32>) will_writes(%first : memref<8xf32>) [original_read_memrefs(%kv : memref<8xf32>), original_write_memrefs(%kv : memref<8xf32>)] : (memref<8xf32>, memref<8xf32>) -> memref<8xf32> {
+ ^bb0(%read: memref<8xf32>, %write: memref<8xf32>):
+  affine.for %i = 0 to 8 {
+   %v = affine.load %read[%i] : memref<8xf32>
+   %two = arith.constant 2.0 : f32
+   %next = arith.mulf %v, %two : f32
+   affine.store %next, %write[%i] : memref<8xf32>
+  }
+  taskflow.yield done_writes(%write : memref<8xf32>)
+ }
+ return
+}})mlir";
+int main() {
+  DialectRegistry registry;
+  registry
+      .insert<mlir::taskflow::TaskflowDialect, affine::AffineDialect,
+              arith::ArithDialect, func::FuncDialect, memref::MemRefDialect>();
+  MLIRContext context(registry);
+  auto module = parseSourceString<ModuleOp>(source, &context);
+  GenericAnalysis analysis;
+  std::string error;
+  if (!module || !analyzeGenericProgram(*module, analysis, error)) {
+    llvm::errs() << error;
+    return 1;
+  }
+  for (const std::vector<std::string> devices :
+       {std::vector<std::string>{"cpu", "npu"},
+        std::vector<std::string>{"npu", "cpu"},
+        std::vector<std::string>{"npu", "npu"}}) {
+    HeterogeneousMappingChoice choice;
+    choice.taskDevices = devices;
+    choice.implementationOwned = true;
+    HeterogeneousMappingPlan plan;
+    if (!buildHeterogeneousMapping(analysis, choice, plan, error) ||
+        !checkHeterogeneousMapping(analysis, choice, plan, error)) {
+      llvm::errs() << error;
+      return 2;
+    }
+    for (size_t region = 0; region < plan.slices.size(); ++region) {
+      OwningOpRef<ModuleOp> child;
+      HeterogeneousRegionProjection projection;
+      if (!materializeHeterogeneousRegion(plan, region, child, projection,
+                                          error)) {
+        llvm::errs() << error;
+        return 3;
+      }
+      GenericAnalysis facts;
+      if (!analyzeGenericProgram(*child, facts, error) ||
+          facts.function.getNumArguments() != 1 || facts.storages.size() != 1 ||
+          facts.storages[0].role != "state" ||
+          projection.arguments.size() != 1 ||
+          projection.arguments[0].inputCopy < 0 ||
+          projection.arguments[0].outputCopy < 0 ||
+          projection.arguments[0].inputCopy ==
+              projection.arguments[0].outputCopy)
+        return 4;
+    }
+  }
+  llvm::outs() << "CPU/NPU state cuts preserve one ABI root and both boundary "
+                  "versions\n";
+  return 0;
+}
diff --git a/test/TaskflowGeneric/program-native-projection.cpp b/test/TaskflowGeneric/program-native-projection.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..9296dc8540cdea47f20aab751549cdbd368bd590
--- /dev/null
+++ b/test/TaskflowGeneric/program-native-projection.cpp
@@ -0,0 +1,285 @@
+#include "Taskflow/GenericMapping.h"
+#include "Taskflow/NativeTransforms.h"
+#include "Taskflow/ProgramNativeProjection.h"
+#include "Taskflow/TaskPlacement.h"
+#include "Taskflow/TaskTiling.h"
+#include "Taskflow/TaskflowFission.h"
+#include "Taskflow/TaskflowReplica.h"
+#include "Taskflow/TaskflowSourceNormalization.h"
+#include "TaskflowDialect/TaskflowDialect.h"
+#include "mlir/Dialect/Affine/IR/AffineOps.h"
+#include "mlir/Dialect/Arith/IR/Arith.h"
+#include "mlir/Dialect/MemRef/IR/MemRef.h"
+#include "mlir/IR/Builders.h"
+#include "mlir/Parser/Parser.h"
+#include "llvm/Support/raw_ostream.h"
+#include <set>
+using namespace orbit::taskflow;
+static const char *source = R"mlir(module {
+func.func @pipeline(%state: memref<16xf32> {amoeba.noalias,orbit.role="state", orbit.name="KV"}) attributes {orbit.noalias} {
+ %updated = taskflow.task @update will_reads(%state : memref<16xf32>) will_writes(%state : memref<16xf32>) [original_read_memrefs(%state : memref<16xf32>), original_write_memrefs(%state : memref<16xf32>)] : (memref<16xf32>,memref<16xf32>) -> memref<16xf32> {
+ ^bb0(%read: memref<16xf32>, %write: memref<16xf32>):
+  %zero = arith.constant 0 : index
+  %oneIndex = arith.constant 1 : index
+  %eight = arith.constant 16 : index
+  %counter = taskflow.counter from %zero to %eight step %oneIndex : index
+  "taskflow.hyperblock"(%counter) <{operandSegmentSizes = array<i32: 1, 0>}> ({
+  ^bb0(%i: index):
+   %v = memref.load %read[%i] : memref<16xf32>
+   %one = arith.constant 1.0 : f32
+   %next = arith.addf %v, %one : f32
+   memref.store %next, %write[%i] : memref<16xf32>
+   "taskflow.hyperblock.yield"() : () -> ()
+  }) : (index) -> ()
+  taskflow.yield done_writes(%write : memref<16xf32>)
+ }
+ return
+}
+})mlir";
+int main() {
+  mlir::DialectRegistry registry;
+  registry.insert<mlir::taskflow::TaskflowDialect, mlir::affine::AffineDialect,
+                  mlir::arith::ArithDialect, mlir::memref::MemRefDialect,
+                  mlir::func::FuncDialect>();
+  mlir::MLIRContext context(registry);
+  std::string error;
+  unsigned checks = 0;
+  auto require = [&](bool condition, const char *label) {
+    if (condition)
+      ++checks;
+    else
+      llvm::errs() << label << ": " << error << '\n';
+    return condition;
+  };
+  auto module = mlir::parseSourceString<mlir::ModuleOp>(source, &context);
+  if (!module)
+    return 1;
+  if (!require(mlir::succeeded(materializeTaskflowReplicas(
+                   *module, {"pipeline", "update", 0, 2}, error)),
+               "real complete DFG source replicas"))
+    return 1;
+  std::vector<std::string> children;
+  module->walk([&](mlir::taskflow::TaskflowTaskOp task) {
+    children.push_back(task.getTaskName().str());
+  });
+  for (const auto &child : children)
+    if (!require(mlir::succeeded(materializeTaskflowFission(*module, "pipeline",
+                                                            child, {0}, error)),
+                 "actual same-instance fission exports a private cut"))
+      return 1;
+  mlir::OwningOpRef<mlir::ModuleOp> normalized;
+  TaskflowSourceNormalizationWitness witness;
+  GenericAnalysis analysis;
+  if (!require(mlir::succeeded(normalizeTaskflowSource(*module, normalized,
+                                                       witness, error)) &&
+                   analyzeGenericProgram(*normalized, analysis, error),
+               "whole replicated pipeline normalizes"))
+    return 1;
+  std::set<size_t> cuts;
+  size_t state = SIZE_MAX;
+  for (size_t i = 0; i < analysis.storages.size(); ++i) {
+    if (analysis.storages[i].role == "temporary")
+      cuts.insert(i);
+    if (analysis.storages[i].role == "state")
+      state = i;
+  }
+  if (cuts.empty() || state == SIZE_MAX)
+    return 1;
+  ProgramMappingChoice mapping;
+  mapping.residency = "tiled-phase-local";
+  mapping.grouping = "tile-major";
+  mapping.dataOrganization = "retain-across-users";
+  std::vector<MappingTaskPlacement> placements;
+  std::vector<TaskTileChoice> tiles;
+  std::vector<NativeTaskImplementationChoice> implementations;
+  for (int64_t instance = 0; instance < 2; ++instance) {
+    ProgramResidencyGroup group;
+    group.retainedStorages = {state};
+    for (size_t task = 0; task < analysis.tasks.size(); ++task) {
+      auto actual =
+          analysis.tasks[task]
+              .operation
+              ->getAttrOfType<mlir::IntegerAttr>("orbit.replica.instance")
+              .getInt();
+      if (actual == instance)
+        group.tasks.push_back(task);
+    }
+    for (size_t cut : cuts) {
+      bool touched = false;
+      for (size_t task : group.tasks)
+        for (const auto &access : analysis.tasks[task].accesses)
+          touched |= access.storage == cut;
+      if (touched)
+        group.retainedStorages.push_back(cut);
+    }
+    mapping.residencyGroups.push_back(group);
+  }
+  for (size_t task = 0; task < analysis.tasks.size(); ++task) {
+    auto instance =
+        analysis.tasks[task]
+            .operation
+            ->getAttrOfType<mlir::IntegerAttr>("orbit.replica.instance")
+            .getInt();
+    placements.push_back({task,
+                          "core" + std::to_string(instance),
+                          "local" + std::to_string(instance),
+                          "",
+                          1,
+                          {1, 1}});
+    tiles.push_back({task, {4}});
+    implementations.push_back({task, "scalar", 1});
+  }
+  if (!require(setNativeMappingChoice(*normalized, mapping, error) &&
+                   setTaskTileChoices(*normalized, analysis.tasks.size(), tiles,
+                                      error) &&
+                   setNativeTaskImplementations(*normalized,
+                                                analysis.tasks.size(),
+                                                implementations, error) &&
+                   setTaskPlacementChoices(*normalized, "pipeline", placements,
+                                           error) &&
+                   analyzeGenericProgram(*normalized, analysis, error),
+               "actual task-local tiles, implementations and per-instance "
+               "retained scopes bind source"))
+    return 1;
+  StaticConfig target;
+  target.domains = {{"chip", "", "device", {}},
+                    {"tile0", "chip", "tile", {{"column", 0}, {"row", 2}}},
+                    {"tile1", "chip", "tile", {{"column", 1}, {"row", 2}}}};
+  target.resources = {{"core0", "compute", "npu", 1, "tile0"},
+                      {"core1", "compute", "npu", 1, "tile1"},
+                      {"dma", "transfer", "npu", 1, "chip"}};
+  target.memories = {{"host", 4096, {"npu"}, "chip", "system-bo"},
+                     {"local0", 256, {"npu"}, "tile0", "local-sram"},
+                     {"local1", 256, {"npu"}, "tile1", "local-sram"}};
+  for (int i = 0; i < 2; ++i) {
+    StaticTransfer link;
+    link.id = "import" + std::to_string(i);
+    link.source = "host";
+    link.target = "local" + std::to_string(i);
+    link.resource = "dma";
+    target.links.push_back(link);
+    std::swap(link.source, link.target);
+    link.id = "export" + std::to_string(i);
+    target.links.push_back(link);
+  }
+  for (const auto &storage : analysis.storages) {
+    if (isInputStorageRole(storage.role))
+      target.assumptions.initialLocations[storage.id] = "host";
+    if (isOutputStorageRole(storage.role))
+      target.assumptions.outputLocations[storage.id] = "host";
+  }
+  llvm::json::Value config = llvm::json::Object{
+      {"generic_air", llvm::json::Object{{"capacity_bytes", 256}}}};
+  ProgramGraph graph;
+  if (!require(
+          buildPhysicalProgramGraph(analysis, target, placements, config, graph,
+                                    error),
+          "complete native pipeline ledger projects to actual replica cores"))
+    return 1;
+  bool localCut = false, reused = false;
+  std::set<std::string> owners;
+  for (size_t a = 0; a < graph.allocations.size(); ++a) {
+    const auto &allocation = graph.allocations[a];
+    if (!cuts.count(allocation.storage))
+      continue;
+    if (!require(allocation.memory != "host",
+                 "retained cut never materializes a host copy"))
+      return 1;
+    localCut = true;
+    owners.insert(allocation.spatialOwner);
+    std::set<size_t> regions;
+    for (const auto &copy : graph.copies)
+      if (copy.allocation == a)
+        regions.insert(graph.versions[copy.version].region);
+    reused |= regions.size() > 1;
+  }
+  if (!require(localCut && reused && owners.size() == 2 &&
+                   graph.instances.size() > analysis.tasks.size() &&
+                   graph.source.function == analysis.function &&
+                   graph.bodyFingerprint == analysis.bodyFingerprint &&
+                   checkProgramGraph(graph, error),
+               "real source identities, tile instances, per-owner slots and "
+               "reuse survive projection"))
+    return 1;
+  for (const auto &instance : graph.instances)
+    for (const auto &bound : instance.domain)
+      if (!require(bound.upper - bound.lower <= 4,
+                   "task-local tile bound is consumed"))
+        return 1;
+  auto tampered = graph;
+  tampered.instances[0].domain[0].upper++;
+  if (!require(!checkProgramGraph(tampered, error),
+               "forged tile/source coverage rejected after projection"))
+    return 1;
+  auto contradictory = placements;
+  contradictory[mapping.residencyGroups[0].tasks.back()].resource = "core1";
+  contradictory[mapping.residencyGroups[0].tasks.back()].memory = "local1";
+  if (!require(!buildPhysicalProgramGraph(analysis, target, contradictory,
+                                          config, tampered, error),
+               "one retained private-L1 scope cannot silently broadcast across "
+               "cores"))
+    return 1;
+  ProgramResidencyGroup authored;
+  for (size_t task = 0; task < analysis.tasks.size(); ++task)
+    authored.tasks.push_back(task);
+  authored.retainedStorages = {state};
+  authored.retainedStorages.insert(authored.retainedStorages.end(),
+                                   cuts.begin(), cuts.end());
+  mapping.residencyGroups = {authored};
+  if (!require(setNativeMappingChoice(*normalized, mapping, error) &&
+                   analyzeGenericProgram(*normalized, analysis, error) &&
+                   buildPhysicalProgramGraph(analysis, target, placements,
+                                             config, graph, error) &&
+                   checkProgramGraph(graph, error),
+               "one authored group projects all descendants into real "
+               "per-owner retained scopes"))
+    return 1;
+  auto wide = mlir::OwningOpRef<mlir::ModuleOp>(normalized->clone());
+  auto *wideOperation = wide->getOperation();
+  wideOperation->setAttr(
+      "orbit.implementation",
+      mlir::StringAttr::get(&context, "independent-lane-f32"));
+  wideOperation->setAttr(
+      "orbit.vector_lanes",
+      mlir::IntegerAttr::get(mlir::IntegerType::get(&context, 128),
+                             llvm::APInt(128, 8)));
+  GenericAnalysis wideAnalysis;
+  if (!require(
+          analyzeGenericProgram(*wide, wideAnalysis, error) &&
+              !buildPhysicalProgramGraph(wideAnalysis, target, placements,
+                                         config, tampered, error),
+          "oversized external lane integer rejects before numeric conversion"))
+    return 1;
+  auto stale = mlir::OwningOpRef<mlir::ModuleOp>(normalized->clone());
+  mlir::Builder builder(&context);
+  llvm::SmallVector<mlir::Attribute> boundTasks, boundStorages;
+  for (const auto &task : analysis.tasks)
+    boundTasks.push_back(builder.getStringAttr(task.id));
+  for (const auto &storage : analysis.storages)
+    boundStorages.push_back(builder.getStringAttr(storage.id));
+  stale->getOperation()->setAttr(
+      "orbit.source_mapping_binding",
+      builder.getDictionaryAttr(
+          {builder.getNamedAttr(
+               "body", builder.getStringAttr(analysis.bodyFingerprint)),
+           builder.getNamedAttr("function", builder.getStringAttr("pipeline")),
+           builder.getNamedAttr("tasks", builder.getArrayAttr(boundTasks)),
+           builder.getNamedAttr("storages",
+                                builder.getArrayAttr(boundStorages))}));
+  GenericAnalysis staleAnalysis;
+  if (!analyzeGenericProgram(*stale, staleAnalysis, error))
+    return 1;
+  staleAnalysis.tasks[0].operation->setAttr(
+      "task_name", builder.getStringAttr("different_source"));
+  if (!require(analyzeGenericProgram(*stale, staleAnalysis, error) &&
+                   !buildPhysicalProgramGraph(staleAnalysis, target, placements,
+                                              config, tampered, error) &&
+                   !planPhysicalNativeProgramMapping(staleAnalysis, target,
+                                                     placements, config,
+                                                     tampered, error),
+               "original stale source policy binding rejects both public "
+               "entrypoints"))
+    return 1;
+  llvm::outs() << "native physical projection: " << checks << " checks\n";
+  return 0;
+}
diff --git a/test/TaskflowGeneric/program-physical-mapping.cpp b/test/TaskflowGeneric/program-physical-mapping.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..ca44903df8a3f8866acaf81274906c9448225948
--- /dev/null
+++ b/test/TaskflowGeneric/program-physical-mapping.cpp
@@ -0,0 +1,230 @@
+#include "Taskflow/ProgramMapping.h"
+#include "Taskflow/TaskPlacement.h"
+#include "Taskflow/TaskflowReplica.h"
+#include "Taskflow/TaskflowSourceNormalization.h"
+#include "TaskflowDialect/TaskflowDialect.h"
+#include "mlir/Dialect/Affine/IR/AffineOps.h"
+#include "mlir/Dialect/Arith/IR/Arith.h"
+#include "mlir/Dialect/MemRef/IR/MemRef.h"
+#include "mlir/Parser/Parser.h"
+#include "llvm/Support/raw_ostream.h"
+using namespace orbit::taskflow;
+static const char *source = R"mlir(module {
+func.func @update(%state: memref<8xf32> {orbit.role="state", orbit.name="KV"}) attributes {orbit.noalias} {
+ %updated = taskflow.task @update will_reads(%state : memref<8xf32>) will_writes(%state : memref<8xf32>) [original_read_memrefs(%state : memref<8xf32>), original_write_memrefs(%state : memref<8xf32>)] : (memref<8xf32>,memref<8xf32>) -> memref<8xf32> {
+ ^bb0(%read: memref<8xf32>, %write: memref<8xf32>):
+  %zero = arith.constant 0 : index
+  %oneIndex = arith.constant 1 : index
+  %eight = arith.constant 8 : index
+  %counter = taskflow.counter from %zero to %eight step %oneIndex : index
+  "taskflow.hyperblock"(%counter) <{operandSegmentSizes = array<i32: 1, 0>}> ({
+  ^bb0(%i: index):
+   %v = memref.load %read[%i] : memref<8xf32>
+   %one = arith.constant 1.0 : f32
+   %next = arith.addf %v, %one : f32
+   memref.store %next, %write[%i] : memref<8xf32>
+   "taskflow.hyperblock.yield"() : () -> ()
+  }) : (index) -> ()
+  taskflow.yield done_writes(%write : memref<8xf32>)
+ }
+ return
+}
+})mlir";
+int main() {
+  mlir::DialectRegistry registry;
+  registry.insert<mlir::taskflow::TaskflowDialect, mlir::affine::AffineDialect,
+                  mlir::arith::ArithDialect, mlir::memref::MemRefDialect,
+                  mlir::func::FuncDialect>();
+  mlir::MLIRContext context(registry);
+  std::string error;
+  unsigned checks = 0;
+  auto require = [&](bool condition, const char *label) {
+    if (condition)
+      ++checks;
+    else
+      llvm::errs() << label << ": " << error << '\n';
+    return condition;
+  };
+  auto module = mlir::parseSourceString<mlir::ModuleOp>(source, &context);
+  if (!module || !require(mlir::succeeded(materializeTaskflowReplicas(
+                              *module, {"update", "update", 0, 2}, error)),
+                          "materialize real disjoint state replicas"))
+    return 1;
+  mlir::OwningOpRef<mlir::ModuleOp> normalized;
+  TaskflowSourceNormalizationWitness witness;
+  GenericAnalysis analysis;
+  if (!require(mlir::succeeded(normalizeTaskflowSource(*module, normalized,
+                                                       witness, error)) &&
+                   analyzeGenericProgram(*normalized, analysis, error),
+               "global replica source normalizes without child graphs"))
+    return 1;
+  StaticConfig target;
+  target.domains = {
+      {"chip", "", "device", {}},
+      {"tile0", "chip", "compute-tile", {{"column", 0}, {"row", 2}}},
+      {"tile1", "chip", "compute-tile", {{"column", 1}, {"row", 2}}}};
+  target.resources = {{"core0", "compute", "npu", 1, "tile0"},
+                      {"core1", "compute", "npu", 1, "tile1"},
+                      {"dma", "transfer", "npu", 1, "chip"}};
+  target.resources.push_back(
+      {"host-submission", "submission", "host", 1, "chip"});
+  target.memories = {{"host", 4096, {"npu"}, "chip", "system-bo"},
+                     {"local0", 256, {"npu"}, "tile0", "local-sram"},
+                     {"local1", 256, {"npu"}, "tile1", "local-sram"}};
+  for (int i = 0; i < 2; ++i) {
+    StaticTransfer link;
+    link.id = "import" + std::to_string(i);
+    link.source = "host";
+    link.target = "local" + std::to_string(i);
+    link.resource = "dma";
+    target.links.push_back(link);
+    std::swap(link.source, link.target);
+    link.id = "export" + std::to_string(i);
+    target.links.push_back(link);
+  }
+  target.assumptions.initialLocations["KV"] = "host";
+  target.assumptions.outputLocations["KV"] = "host";
+  std::vector<MappingTaskPlacement> placements;
+  for (size_t task = 0; task < analysis.tasks.size(); ++task) {
+    auto instance =
+        analysis.tasks[task]
+            .operation
+            ->getAttrOfType<mlir::IntegerAttr>("orbit.replica.instance")
+            .getInt();
+    placements.push_back({task,
+                          "core" + std::to_string(instance),
+                          "local" + std::to_string(instance),
+                          "scalar",
+                          1,
+                          {1, 1}});
+  }
+  if (!setTaskPlacementChoices(*normalized, "update", placements, error) ||
+      !analyzeGenericProgram(*normalized, analysis, error))
+    return 1;
+  ProgramGraph graph;
+  if (!require(
+          buildPhysicalProgramGraph(analysis, target, placements, graph, error),
+          "one complete global physical graph consumes actual replica "
+          "placements"))
+    return 1;
+  size_t hostBuffers = 0;
+  for (const auto &allocation : graph.allocations)
+    if (allocation.memory == "host") {
+      ++hostBuffers;
+      if (!require(allocation.bytes == 32 &&
+                       allocation.addressing == "region-addressed",
+                   "state views use full fixed-capacity region-addressed host "
+                   "backing"))
+        return 1;
+    }
+  if (!require(hostBuffers == 1,
+               "all state cell versions bind one actual host BO"))
+    return 1;
+  bool slots = true;
+  for (const auto &allocation : graph.allocations)
+    if (allocation.memory != "host")
+      slots &= allocation.addressing == "reusable-slot" &&
+               !allocation.spatialOwner.empty();
+  if (!require(slots && graph.instances.size() == analysis.tasks.size() &&
+                   checkProgramGraph(graph, error),
+               "physical local slots and complete source instances "
+               "independently verify"))
+    return 1;
+  auto reordered = graph;
+  std::vector<size_t> eventOrder;
+  std::vector<ProgramInvocationWave> waves;
+  for (int owner = 0; owner < 2; ++owner) {
+    size_t begin = eventOrder.size();
+    for (size_t event = 0; event < graph.events.size(); ++event) {
+      const auto &value = graph.events[event];
+      bool belongs = value.kind != "transfer" &&
+                     value.resource == "core" + std::to_string(owner);
+      for (const auto *copies : {&value.reads, &value.writes})
+        for (auto copy : *copies)
+          belongs |= graph.allocations[graph.copies[copy].allocation].memory ==
+                     "local" + std::to_string(owner);
+      if (belongs)
+        eventOrder.push_back(event);
+    }
+    waves.push_back({begin, eventOrder.size()});
+  }
+  if (!require(reorderProgramGraphEvents(reordered, eventOrder, error),
+               "physical-owner complete event blocks preserve actual "
+               "copy/version graph"))
+    return 1;
+  // Both state partitions are independent. Reversing their complete compute
+  // blocks must preserve the source versions as well as the instance table.
+  auto reverseOwners = graph;
+  std::vector<size_t> reverseOrder(eventOrder.begin() + waves[0].endEvent,
+                                   eventOrder.end());
+  reverseOrder.insert(reverseOrder.end(), eventOrder.begin(),
+                      eventOrder.begin() + waves[0].endEvent);
+  if (!require(
+          reorderProgramGraphEvents(reverseOwners, reverseOrder, error) &&
+              checkProgramGraph(reverseOwners, error) &&
+              reverseOwners.instances.front().task ==
+                  graph.instances.back().task,
+          "independent compute permutation keeps actual instance bindings"))
+    return 1;
+  if (!require(bindProgramInvocationWaves(reordered, waves, "host-submission",
+                                          "host", error) &&
+                   checkProgramGraph(reordered, error),
+               "each executable wave has checked serial launch/wait and BO "
+               "visibility"))
+    return 1;
+  if (!require(reordered.executionRegions.size() == 2 &&
+                   reordered.regionEvents.size() == 8 &&
+                   reordered.executionRegions[0].submissionCount == 1 &&
+                   reordered.executionRegions[1].submissionCount == 1 &&
+                   reordered.executionRegions[0].outputCopies.empty() &&
+                   reordered.executionRegions[1].inputCopies.empty() &&
+                   !reordered.schedule.estimatedMakespanMs,
+               "two real invocations retain unknown costs and synchronize BOs "
+               "only at sequence boundaries"))
+    return 1;
+  auto unsafeWave = reordered;
+  unsafeWave.executionRegions[1].predecessorRegions.clear();
+  if (!require(!checkProgramGraph(unsafeWave, error),
+               "missing serial wave predecessor is rejected"))
+    return 1;
+  unsafeWave = reordered;
+  unsafeWave.executionRegions[1].inputCopies =
+      unsafeWave.executionRegions[0].inputCopies;
+  if (!require(!checkProgramGraph(unsafeWave, error),
+               "private/persistent BOs cannot be restaged on later waves"))
+    return 1;
+  auto overlapping = placements;
+  for (auto &p : overlapping) {
+    p.resource = "core0";
+    p.memory = "local0";
+  }
+  ProgramGraph rejected;
+  if (!require(
+          !buildPhysicalProgramGraph(analysis, target, overlapping, rejected,
+                                     error),
+          "distinct replica instances cannot share one physical compute owner"))
+    return 1;
+  auto aliased = target;
+  aliased.domains[2].coordinates = aliased.domains[1].coordinates;
+  if (!require(!buildPhysicalProgramGraph(analysis, aliased, placements,
+                                          rejected, error),
+               "different resource names cannot alias identical physical "
+               "coordinates"))
+    return 1;
+  auto tampered = graph;
+  for (auto &placement : tampered.placements) {
+    placement.resource = "core0";
+    placement.memory = "local0";
+  }
+  if (!require(!checkProgramGraph(tampered, error),
+               "common checker revalidates replica physical independence"))
+    return 1;
+  auto incomplete = placements;
+  incomplete.pop_back();
+  if (!require(!buildPhysicalProgramGraph(analysis, target, incomplete,
+                                          rejected, error),
+               "every actual source stage requires a concrete placement"))
+    return 1;
+  llvm::outs() << "physical program graph: " << checks << " checks\n";
+  return 0;
+}
diff --git a/test/TaskflowGeneric/program-replica-hierarchy.cpp b/test/TaskflowGeneric/program-replica-hierarchy.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..0fe5de59739abc15f5ae78a43f24dd324fae8a5e
--- /dev/null
+++ b/test/TaskflowGeneric/program-replica-hierarchy.cpp
@@ -0,0 +1,201 @@
+#include "Taskflow/ProgramMapping.h"
+#include "Taskflow/ProgramReplicaPlacement.h"
+#include "Taskflow/TaskPlacement.h"
+#include "Taskflow/TaskflowFission.h"
+#include "Taskflow/TaskflowReplica.h"
+#include "Taskflow/TaskflowSourceNormalization.h"
+#include "TaskflowDialect/TaskflowDialect.h"
+#include "mlir/Dialect/Affine/IR/AffineOps.h"
+#include "mlir/Dialect/Arith/IR/Arith.h"
+#include "mlir/Dialect/MemRef/IR/MemRef.h"
+#include "mlir/Parser/Parser.h"
+#include "llvm/Support/raw_ostream.h"
+using namespace orbit::taskflow;
+static const char *source = R"mlir(module {
+func.func @update(%state: memref<8xf32> {orbit.role="state", orbit.name="KV"}) attributes {orbit.noalias} {
+ %updated = taskflow.task @update will_reads(%state : memref<8xf32>) will_writes(%state : memref<8xf32>) [original_read_memrefs(%state : memref<8xf32>), original_write_memrefs(%state : memref<8xf32>)] : (memref<8xf32>,memref<8xf32>) -> memref<8xf32> {
+ ^bb0(%read: memref<8xf32>, %write: memref<8xf32>):
+  %zero = arith.constant 0 : index
+  %oneIndex = arith.constant 1 : index
+  %eight = arith.constant 8 : index
+  %counter = taskflow.counter from %zero to %eight step %oneIndex : index
+  "taskflow.hyperblock"(%counter) <{operandSegmentSizes = array<i32: 1, 0>}> ({
+  ^bb0(%i: index):
+   %v = memref.load %read[%i] : memref<8xf32>
+   %one = arith.constant 1.0 : f32
+   %next = arith.addf %v, %one : f32
+   memref.store %next, %write[%i] : memref<8xf32>
+   "taskflow.hyperblock.yield"() : () -> ()
+  }) : (index) -> ()
+  taskflow.yield done_writes(%write : memref<8xf32>)
+ }
+ return
+}
+})mlir";
+int main() {
+  mlir::DialectRegistry registry;
+  registry.insert<mlir::taskflow::TaskflowDialect, mlir::affine::AffineDialect,
+                  mlir::arith::ArithDialect, mlir::memref::MemRefDialect,
+                  mlir::func::FuncDialect>();
+  mlir::MLIRContext context(registry);
+  std::string error;
+  unsigned checks = 0;
+  auto require = [&](bool condition, const char *label) {
+    if (condition)
+      ++checks;
+    else
+      llvm::errs() << label << ": " << error << '\n';
+    return condition;
+  };
+  auto module = mlir::parseSourceString<mlir::ModuleOp>(source, &context);
+  if (!module || !require(mlir::succeeded(materializeTaskflowReplicas(
+                              *module, {"update", "update", 0, 2}, error)),
+                          "real outer source replicas"))
+    return 1;
+  std::vector<std::string> parents;
+  module->walk([&](mlir::Operation *op) {
+    if (op->getName().getStringRef() == "taskflow.task")
+      parents.push_back(op->getAttrOfType<mlir::StringAttr>("task_name").str());
+  });
+  for (const auto &name : parents)
+    if (!require(mlir::succeeded(materializeTaskflowReplicas(
+                     *module, {"update", name, 0, 2}, error)),
+                 "real child source replicas preserve outer ownership"))
+      return 1;
+  mlir::OwningOpRef<mlir::ModuleOp> normalized;
+  TaskflowSourceNormalizationWitness witness;
+  GenericAnalysis analysis;
+  if (!require(mlir::succeeded(normalizeTaskflowSource(*module, normalized,
+                                                       witness, error)) &&
+                   analyzeGenericProgram(*normalized, analysis, error),
+               "normalize actual nested source partitions"))
+    return 1;
+  StaticConfig target;
+  target.domains.push_back({"chip", "", "device", {}});
+  target.resources.push_back({"dma", "transfer", "npu", 1, "chip"});
+  target.memories.push_back({"host", 4096, {"npu"}, "chip", "system-bo"});
+  for (int c = 0; c < 2; ++c) {
+    std::string column = "column" + std::to_string(c);
+    target.domains.push_back(
+        {column, "chip", "physical-column", {{"column", c}}});
+    for (int r = 0; r < 2; ++r) {
+      std::string id = std::to_string(c) + "." + std::to_string(r),
+                  tile = "tile" + id;
+      target.domains.push_back(
+          {tile, column, "compute-tile", {{"column", c}, {"row", r}}});
+      target.resources.push_back({"core" + id, "compute", "npu", 1, tile});
+      target.memories.push_back(
+          {"local" + id, 128, {"npu"}, tile, "local-sram"});
+      StaticTransfer link;
+      link.id = "import" + id;
+      link.source = "host";
+      link.target = "local" + id;
+      link.resource = "dma";
+      target.links.push_back(link);
+      std::swap(link.source, link.target);
+      link.id = "export" + id;
+      target.links.push_back(link);
+    }
+  }
+  target.assumptions.initialLocations["KV"] = "host";
+  target.assumptions.outputLocations["KV"] = "host";
+  std::vector<MappingTaskPlacement> placements;
+  for (size_t task = 0; task < analysis.tasks.size(); ++task) {
+    std::vector<TaskflowReplicaLevel> levels;
+    if (mlir::failed(readTaskflowReplicaHierarchy(
+            analysis.tasks[task].operation, levels, error)) ||
+        levels.size() != 2)
+      return 1;
+    std::string id = std::to_string(levels[0].instance) + "." +
+                     std::to_string(levels[1].instance);
+    placements.push_back(
+        {task, "core" + id, "local" + id, "scalar", 1, {1, 1}});
+  }
+  if (!setTaskPlacementChoices(*normalized, "update", placements, error) ||
+      !analyzeGenericProgram(*normalized, analysis, error))
+    return 1;
+  ProgramGraph graph;
+  if (!require(buildPhysicalProgramGraph(analysis, target, placements, graph,
+                                         error) &&
+                   checkProgramGraph(graph, error),
+               "nested outer columns and inner rows consume one authoritative "
+               "physical graph"))
+    return 1;
+  auto flat = target;
+  for (auto &domain : flat.domains)
+    if (domain.kind == "compute-tile")
+      domain.parent = "chip";
+  if (!require(
+          checkProgramReplicaHierarchy(analysis, flat, placements, error),
+          "flat actual disjoint owners do not require invented subdomains"))
+    return 1;
+  auto overlap = placements;
+  overlap[1].resource = overlap[0].resource;
+  overlap[1].memory = overlap[0].memory;
+  if (!require(!checkProgramReplicaHierarchy(analysis, target, overlap, error),
+               "nested siblings cannot share a physical tile"))
+    return 1;
+  auto crossed = placements;
+  std::swap(crossed[1].resource, crossed[2].resource);
+  std::swap(crossed[1].memory, crossed[2].memory);
+  if (!require(checkProgramReplicaHierarchy(analysis, target, crossed, error),
+               "disjoint scope unions may both span physical columns"))
+    return 1;
+  auto alias = flat;
+  for (auto &domain : alias.domains)
+    if (domain.id == "tile1.0")
+      domain.coordinates = {{"column", 0}, {"row", 0}};
+  if (!require(
+          !checkProgramReplicaHierarchy(analysis, alias, placements, error),
+          "different owner names cannot alias the same physical coordinates"))
+    return 1;
+  auto ancestor = flat;
+  for (auto &domain : ancestor.domains)
+    if (domain.id == "tile1.0")
+      domain.parent = "tile0.0";
+  if (!require(
+          !checkProgramReplicaHierarchy(analysis, ancestor, placements, error),
+          "siblings cannot overlap an actual ancestor owner"))
+    return 1;
+  auto tampered = graph;
+  tampered.domains = alias.domains;
+  if (!require(
+          !checkProgramGraph(tampered, error),
+          "common checker rejects coordinate aliases between nested scopes"))
+    return 1;
+  auto staged = module->clone();
+  if (mlir::failed(materializeTaskflowFission(
+          staged, "update", "update.replica.0.0.replica.0.0", {0}, error)))
+    return 1;
+  mlir::OwningOpRef<mlir::ModuleOp> stagedNormalized;
+  TaskflowSourceNormalizationWitness stagedWitness;
+  GenericAnalysis stagedAnalysis;
+  if (mlir::failed(normalizeTaskflowSource(staged, stagedNormalized,
+                                           stagedWitness, error)) ||
+      !analyzeGenericProgram(*stagedNormalized, stagedAnalysis, error))
+    return 1;
+  std::vector<MappingTaskPlacement> stagedPlacements;
+  for (size_t task = 0; task < stagedAnalysis.tasks.size(); ++task) {
+    std::vector<TaskflowReplicaLevel> levels;
+    if (mlir::failed(readTaskflowReplicaHierarchy(
+            stagedAnalysis.tasks[task].operation, levels, error)))
+      return 1;
+    std::string id = std::to_string(levels[0].instance) + "." +
+                     std::to_string(levels[1].instance);
+    stagedPlacements.push_back(
+        {task, "core" + id, "local" + id, "scalar", 1, {1, 1}});
+  }
+  if (!require(checkProgramReplicaHierarchy(stagedAnalysis, flat,
+                                            stagedPlacements, error),
+               "real fission stages share their leaf resource obligation"))
+    return 1;
+  stagedPlacements[1].resource = "core0.1";
+  stagedPlacements[1].memory = "local0.1";
+  if (!require(!checkProgramReplicaHierarchy(stagedAnalysis, flat,
+                                             stagedPlacements, error),
+               "one leaf instance cannot split its sequential stages"))
+    return 1;
+  staged.erase();
+  llvm::outs() << "nested physical replicas: " << checks << " checks\n";
+  return 0;
+}
diff --git a/test/TaskflowGeneric/program-representation-coverage.cpp b/test/TaskflowGeneric/program-representation-coverage.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..7909595ff613f64445aca05154486a9c194c6a7d
--- /dev/null
+++ b/test/TaskflowGeneric/program-representation-coverage.cpp
@@ -0,0 +1,239 @@
+#include "Taskflow/GenericMapping.h"
+#include "Taskflow/HeterogeneousMapping.h"
+#include "Taskflow/NativeTransforms.h"
+#include "Taskflow/ProgramNativeProjection.h"
+#include "Taskflow/TaskPlacement.h"
+#include "TaskflowDialect/TaskflowDialect.h"
+#include "mlir/Dialect/Affine/IR/AffineOps.h"
+#include "mlir/Dialect/Arith/IR/Arith.h"
+#include "mlir/Dialect/MemRef/IR/MemRef.h"
+#include "mlir/Parser/Parser.h"
+#include "llvm/Support/raw_ostream.h"
+#include <set>
+using namespace orbit::taskflow;
+static const char *source = R"mlir(module {
+func.func @pipeline(%a: memref<16xf32> {orbit.role="input",orbit.name="A"}, %s: memref<16xf32> {orbit.role="state",orbit.name="KV"}, %o: memref<16xf32> {orbit.role="output",orbit.name="O"}) attributes {orbit.noalias} {
+ %cut = memref.alloc() : memref<16xf32>
+ %p = taskflow.task @produce will_reads(%a,%s : memref<16xf32>,memref<16xf32>) will_writes(%cut : memref<16xf32>) [original_read_memrefs(%a,%s : memref<16xf32>,memref<16xf32>), original_write_memrefs(%cut : memref<16xf32>)] : (memref<16xf32>,memref<16xf32>,memref<16xf32>) -> memref<16xf32> {
+ ^bb0(%in: memref<16xf32>,%old: memref<16xf32>,%out: memref<16xf32>):
+ affine.for %i=0 to 16 {
+  %a0=affine.load %in[%i] : memref<16xf32>
+  %s0=affine.load %old[%i] : memref<16xf32>
+  %sum=arith.addf %a0,%s0 : f32
+  affine.store %sum,%out[%i] : memref<16xf32>
+ }
+ taskflow.yield done_writes(%out : memref<16xf32>)
+ }
+ %q = taskflow.task @update will_reads(%p : memref<16xf32>) will_writes(%s : memref<16xf32>) [original_read_memrefs(%cut : memref<16xf32>), original_write_memrefs(%s : memref<16xf32>)] : (memref<16xf32>,memref<16xf32>) -> memref<16xf32> {
+ ^bb0(%in: memref<16xf32>,%out: memref<16xf32>):
+ affine.for %i=0 to 16 {
+  %v=affine.load %in[%i] : memref<16xf32>
+  affine.store %v,%out[%i] : memref<16xf32>
+ }
+ taskflow.yield done_writes(%out : memref<16xf32>)
+ }
+ %r:2 = taskflow.task @finish will_reads(%p,%q : memref<16xf32>,memref<16xf32>) will_writes(%s,%o : memref<16xf32>,memref<16xf32>) [original_read_memrefs(%cut,%s : memref<16xf32>,memref<16xf32>), original_write_memrefs(%s,%o : memref<16xf32>,memref<16xf32>)] : (memref<16xf32>,memref<16xf32>,memref<16xf32>,memref<16xf32>) -> (memref<16xf32>,memref<16xf32>) {
+ ^bb0(%in: memref<16xf32>,%old: memref<16xf32>,%state: memref<16xf32>,%out: memref<16xf32>):
+ affine.for %i=0 to 16 {
+  %v=affine.load %in[%i] : memref<16xf32>
+  %w=affine.load %old[%i] : memref<16xf32>
+  %sum=arith.addf %v,%w : f32
+  affine.store %sum,%state[%i] : memref<16xf32>
+  affine.store %sum,%out[%i] : memref<16xf32>
+ }
+ taskflow.yield done_writes(%state,%out : memref<16xf32>,memref<16xf32>)
+ }
+ memref.dealloc %cut : memref<16xf32>
+ return
+}
+})mlir";
+int main() {
+  mlir::DialectRegistry registry;
+  registry.insert<mlir::taskflow::TaskflowDialect, mlir::affine::AffineDialect,
+                  mlir::arith::ArithDialect, mlir::memref::MemRefDialect,
+                  mlir::func::FuncDialect>();
+  mlir::MLIRContext context(registry);
+  std::string error;
+  unsigned checks = 0;
+  bool ok = true;
+  auto require = [&](bool value, const char *label) {
+    if (value)
+      ++checks;
+    else {
+      ok = false;
+      llvm::errs() << label << ": " << error << '\n';
+    }
+  };
+  auto module = mlir::parseSourceString<mlir::ModuleOp>(source, &context);
+  GenericAnalysis facts;
+  require(module && analyzeGenericProgram(*module, facts, error),
+          "fanout plus state RAW/WAR/WAW source analyzes");
+  if (!module || facts.tasks.size() != 3)
+    return 1;
+  StaticConfig target;
+  target.resources = {{"cpu", "compute", "cpu", 1},
+                      {"npu", "compute", "npu", 2},
+                      {"dma", "transfer", "system", 1}};
+  target.memories = {{"host", 4096, {"cpu", "npu"}}, {"local", 4096, {"npu"}}};
+  StaticTransfer in;
+  in.id = "import";
+  in.source = "host";
+  in.target = "local";
+  in.resource = "dma";
+  StaticTransfer out = in;
+  out.id = "export";
+  out.source = "local";
+  out.target = "host";
+  target.links = {in, out};
+  target.assumptions.initialLocations = {{"A", "host"}, {"KV", "host"}};
+  target.assumptions.outputLocations = {{"KV", "host"}, {"O", "host"}};
+  ProgramDataOrganizationChoice choice;
+  choice.policy = ProgramDataPolicy::RetainAcrossUsers;
+  choice.placements = {{0, "cpu", "host", "scalar", 1, {1}},
+                       {1, "npu", "local", "scalar", 2, {1, 2}},
+                       {2, "npu", "local", "scalar", 2, {1, 2}}};
+  // Reconfiguration boundaries must spill private cuts too, then reload only
+  // after the consumer's real source predecessors complete.
+  auto boundaryChoice = choice;
+  boundaryChoice.policy = ProgramDataPolicy::PhaseLocal;
+  boundaryChoice.semanticDependenciesOnly = true;
+  for (auto &placement : boundaryChoice.placements) {
+    placement.resource = "npu";
+    placement.memory = "local";
+    placement.resourceCount = 1;
+    placement.resourceShape = {1};
+  }
+  ProgramGraph boundary;
+  require(planPhysicalBoundaryDataOrganization(facts, target, boundaryChoice,
+                                               "host", boundary, error) &&
+              checkPhysicalBoundaryDataOrganization(
+                  facts, target, boundaryChoice, "host", boundary, error),
+          "task boundaries materialize real fanout cuts and state versions");
+  if (!boundary.events.empty()) {
+    bool cutSpilled = false, cutReloaded = false;
+    for (const auto &event : boundary.events)
+      if (event.kind == "transfer") {
+        auto storage =
+            boundary
+                .regions[boundary
+                             .versions[boundary.copies[event.writes[0]].version]
+                             .region]
+                .storage;
+        if (facts.storages[storage].role == "temporary") {
+          cutSpilled |= event.memory == "host";
+          cutReloaded |= event.memory == "local";
+        }
+      }
+    require(cutSpilled && cutReloaded,
+            "private fission cut has charged host export and device reload");
+    auto forged = boundary;
+    bool removed = false;
+    for (size_t i = 0; i < forged.events.size() && !removed; ++i) {
+      auto &event = forged.events[i];
+      if (event.kind != "transfer" || event.memory != "local" ||
+          facts.tasks[event.task].dependencies.empty())
+        continue;
+      size_t predecessor = facts.tasks[event.task].dependencies.front();
+      for (auto it = event.dependencies.begin(); it != event.dependencies.end();
+           ++it)
+        if (forged.events[*it].kind == "compute" &&
+            forged.events[*it].task == predecessor) {
+          event.dependencies.erase(it);
+          removed = true;
+          break;
+        }
+    }
+    require(removed &&
+                !checkPhysicalBoundaryDataOrganization(
+                    facts, target, boundaryChoice, "host", forged, error),
+            "independent checker rejects prefetch before source barrier");
+    require(!checkPhysicalBoundaryDataOrganization(
+                facts, target, boundaryChoice, "local", boundary, error),
+            "independent checker rejects a forged materialization memory");
+  }
+  ProgramGraph graph;
+  require(
+      planProgramDataOrganization(facts, target, choice, graph, error) &&
+          checkProgramGraph(graph, error),
+      "mixed placement and multidimensional resource demand realizes copies");
+  if (!graph.events.empty()) {
+    require(
+        graph.instances.size() == 3 && graph.instances[1].resourceCount == 2 &&
+            graph.instances[1].resourceShape == std::vector<int64_t>({1, 2}),
+        "count and shape are carried to real task instances");
+    auto json = serializeProgramGraph(graph);
+    std::string text;
+    llvm::raw_string_ostream stream(text);
+    stream << json;
+    stream.flush();
+    require(text.find("RAW") != std::string::npos &&
+                text.find("WAR") != std::string::npos &&
+                text.find("WAW") != std::string::npos,
+            "source graph exposes all three actual storage hazards");
+    require(graph.transferBytes > 0 && graph.dataEdges.size() > 3,
+            "fanout and real heterogeneous copy events coexist");
+  }
+  HeterogeneousMappingPlan heterogeneous;
+  require(
+      buildHeterogeneousMapping(facts, {{"cpu", "npu", "cpu"}, {}, true},
+                                heterogeneous, error) &&
+          checkHeterogeneousMapping(facts, heterogeneous.choice, heterogeneous,
+                                    error),
+      "CPU/NPU execution regions and launch edges compose with mutable state");
+  if (!heterogeneous.graph.executionRegions.empty())
+    require(heterogeneous.graph.executionRegions.size() == 3 &&
+                !heterogeneous.graph.regionEvents.empty(),
+            "three real regions expose submission and visibility events");
+  // Remove the unrelated state from retention: the private DFG cut alone is
+  // tile-local; state still has its actual import/export boundary.
+  size_t cut = 0;
+  for (size_t i = 0; i < facts.storages.size(); ++i)
+    if (facts.storages[i].role == "temporary")
+      cut = i;
+  ProgramMappingChoice mapping;
+  mapping.residency = "tiled-phase-local";
+  mapping.grouping = "tile-major";
+  mapping.dataOrganization = "retain-across-users";
+  mapping.residencyGroups = {{{0, 1, 2}, {cut, 1}}};
+  require(setNativeMappingChoice(*module, mapping, error) &&
+              analyzeGenericProgram(*module, facts, error),
+          "source choice binds private cut residency");
+  llvm::json::Value config = llvm::json::Object{
+      {"generic_air",
+       llvm::json::Object{{"tile_sizes", llvm::json::Array{4}}}}};
+  GenericMappingPlan native;
+  require(planGenericMapping(facts, config, native, error) &&
+              checkGenericMapping(facts, native, error),
+          "tiled state/fanout graph keeps cut buffers local");
+  if (!native.communication.events.empty()) {
+    bool local = false, host = false, reused = false;
+    for (size_t a = 0; a < native.communication.allocations.size(); ++a) {
+      const auto &allocation = native.communication.allocations[a];
+      if (allocation.storage != cut)
+        continue;
+      host |= allocation.memory == native.memoryBinding.hostMemory;
+      if (allocation.memory == native.memoryBinding.localMemory) {
+        local = true;
+        std::set<size_t> regions;
+        for (const auto &copy : native.communication.copies)
+          if (copy.allocation == a)
+            regions.insert(native.communication.versions[copy.version].region);
+        reused |= allocation.addressing == "reusable-slot" &&
+                  allocation.bytes < 64 && regions.size() > 1;
+      }
+    }
+    require(local && !host && reused,
+            "private fission cut reuses a smaller slot across source tiles "
+            "without host materialization");
+    auto broken = native;
+    for (auto &copy : broken.communication.copies)
+      if (copy.createdBy >= 0 && !copy.users.empty()) {
+        copy.releasedAfter = copy.availableFrom;
+        break;
+      }
+    require(!checkGenericMapping(facts, broken, error),
+            "tile slot cannot release before its actual readers");
+  }
+  llvm::outs() << "program representation coverage: " << checks << " checks\n";
+  return ok ? 0 : 1;
+}
