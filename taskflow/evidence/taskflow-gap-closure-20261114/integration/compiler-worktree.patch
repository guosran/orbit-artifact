+bool orbit::taskflow::lowerNPUReplicaProgram(ModuleOp source,
+                                             const j::Value &config,
+                                             OwningOpRef<ModuleOp> &output,
+                                             j::Value &manifest,
+                                             std::string &error) {
+  if (!hasTaskflowReplicaGroups(source))
+    return fail(error, "source has no actual replica group");
+  OwningOpRef<ModuleOp> physicalSource;
+  ProgramGraph graph;
+  std::vector<ProgramGraphAIRSelection> unusedSelections;
