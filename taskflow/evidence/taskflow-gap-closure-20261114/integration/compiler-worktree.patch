index 0000000000000000000000000000000000000000..b2c0ddd48e68362f7a3117aa0214382e02215264
--- /dev/null
+++ b/test/TaskflowAIR/aie_selected_pools.py
@@ -0,0 +1,48 @@
+#!/usr/bin/env python3
+"""Check actual compiled wave pools; an inactive pool grants no payload proof.
+
+Arguments: taskflow-opt source.mlir target.json final-aie.mlir output-directory.
+Uses existing compiler output; neither searches nor compiles hardware.
+"""
+import json
+from pathlib import Path
+import re
+import subprocess
+import sys
+
+
+def main():
+    tool, source, target, actual, destination = sys.argv[1:]
+    output = Path(destination)
+    output.mkdir(parents=True, exist_ok=True)
+    text = Path(actual).read_text()
+    # The generic printed source-backed view survives AIR -> AIE lowering.
+    view = re.search(r'"memref\.reinterpret_cast"[^\n]*orbit\.allocation = \d+ : i64[^\n]*', text)
+    if not view:
+        raise RuntimeError("fixture requires an actual source-backed local view")
+    missing_tag = text[:view.start()] + view.group(0).replace(
+        re.search(r'orbit\.allocation = \d+ : i64,?\s*', view.group(0)).group(0), ""
+    ) + text[view.end():]
+    checks = [("actual", text, True), ("missing-active-slice", missing_tag, False)]
+    rows = []
+    for label, body, expected in checks:
+        module = output / f"{label}.mlir"
+        module.write_text(body)
+        command = [tool, source, f"--target-config={target}",
+                   "--check-placed-wave=0", f"--check-aie={module}",
+                   f"--implementation-output={output / (label + '.receipt.json')}"]
+        result = subprocess.run(command, text=True, capture_output=True)
+        (output / f"{label}.log").write_text(result.stdout + result.stderr)
+        rows.append({"case": label, "command": command, "returncode": result.returncode,
+                     "expected_accept": expected})
+        if (result.returncode == 0) != expected:
+            raise RuntimeError(f"{label}: unexpected checker result {result.returncode}")
+        if not expected and "actual views do not bind unique selected buffers" not in result.stderr:
+            raise RuntimeError(f"{label}: expected an actual slice-binding rejection, "
+                               "not a parse or unrelated failure")
+    (output / "summary.json").write_text(json.dumps(rows, indent=2) + "\n")
+    print("actual selected wave accepted; missing active slice rejected")
+
+
+if __name__ == "__main__":
+    main()
