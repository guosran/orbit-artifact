+    std::string group;
+    std::optional<Coordinate> coordinate;
+    std::vector<TaskflowReplicaLevel> hierarchy;
+  };
+  std::vector<ExecutionSlot> slots;
+  std::map<std::string, size_t> slotIndices;
+  std::vector<size_t> taskSlots;
+  std::set<std::string> nestedRoots;
+  for (size_t task = 0; task < analysis.tasks.size(); ++task) {
+    auto *operation = analysis.tasks[task].operation;
+    std::vector<TaskflowReplicaLevel> hierarchy;
+    if (failed(readTaskflowReplicaHierarchy(operation, hierarchy, error)))
+      return false;
+    std::string key =
+        hierarchy.empty() ? "task:" + std::to_string(task) : "replica:";
+    for (const auto &level : hierarchy)
+      key += std::to_string(level.owner.size()) + ":" + level.owner + ":" +
+             std::to_string(level.instance) + ";";
+    if (hierarchy.size() > 1)
+      nestedRoots.insert(hierarchy.front().owner);
+    auto [it, inserted] = slotIndices.emplace(key, slots.size());
+    if (inserted)
+      slots.push_back({hierarchy.empty() ? "" : hierarchy.back().owner,
+                       std::nullopt, hierarchy});
+    taskSlots.push_back(it->second);
+  }
+  std::vector<MappingTaskPlacement> choices;
+  if (!readTaskPlacementChoices(*normalized, analysis.function.getSymName(),
+                                choices, error))
+    return false;
+  for (const auto &choice : choices) {
+    if (choice.task >= analysis.tasks.size())
+      return fail(error, "stale source placement index");
+    auto &slot = slots[taskSlots[choice.task]];
+    std::optional<Coordinate> coordinate;
+    if (!placementCoordinate(choice, domain, coordinate, error))
+      return false;
+    if (coordinate && slot.coordinate && coordinate != slot.coordinate)
+      return fail(error, "one source instance names different physical cores");
+    if (coordinate)
+      slot.coordinate = coordinate;
+  }
+  std::map<std::string, std::set<Coordinate>> groupCoordinates;
+  for (const auto &slot : slots)
+    if (!slot.group.empty() && slot.coordinate &&
+        !groupCoordinates[slot.group].insert(*slot.coordinate).second)
+      return fail(error, "independent source instances alias physical cores");
+  for (auto &slot : slots) {
+    if (slot.coordinate)
+      continue;
+    if (slot.group.empty()) {
+      slot.coordinate = Coordinate{domain.firstColumn, domain.firstComputeRow};
+      continue;
+    }
+    if (nestedRoots.count(slot.hierarchy.front().owner)) {
+      // The target has real chip -> column -> compute-tile ownership. Outer
+      // siblings occupy columns; inner siblings occupy rows in that column.
+      // Explicit choices are still certified by the common hierarchy checker.
+      if (slot.hierarchy.size() > 2 ||
+          slot.hierarchy.front().count > domain.columns ||
+          (slot.hierarchy.size() == 2 &&
+           slot.hierarchy.back().count > domain.computeRows))
+        return fail(
+            error,
+            "nested source hierarchy exceeds actual NPU column/tile scopes");
+      slot.coordinate = Coordinate{
+          domain.firstColumn + slot.hierarchy.front().instance,
+          domain.firstComputeRow + (slot.hierarchy.size() == 2
+                                        ? slot.hierarchy.back().instance
+                                        : 0)};
+      if (!groupCoordinates[slot.group].insert(*slot.coordinate).second)
+        return fail(error,
+                    "nested source siblings alias an actual compute tile");
+      continue;
+    }
+    for (int64_t row = domain.firstComputeRow;
+         row < domain.firstComputeRow + domain.computeRows && !slot.coordinate;
+         ++row)
+      for (int64_t col = domain.firstColumn;
+           col < domain.firstColumn + domain.columns && !slot.coordinate; ++col)
+        if (groupCoordinates[slot.group].emplace(col, row).second)
+          slot.coordinate = Coordinate{col, row};
+    if (!slot.coordinate)
+      return fail(error,
+                  "source replica group exceeds physical target geometry");
+  }
+  std::vector<NPUShardBinding> bindings;
+  std::vector<MappingTaskPlacement> concreteChoices;
+  for (size_t task = 0; task < analysis.tasks.size(); ++task) {
+    const auto coordinate = *slots[taskSlots[task]].coordinate;
+    bindings.push_back({0, 1, coordinate.first, coordinate.second, true});
+    const auto suffix = std::to_string(coordinate.first) + "." +
+                        std::to_string(coordinate.second);
+    auto selected = llvm::find_if(
+        choices, [&](const auto &choice) { return choice.task == task; });
+    concreteChoices.push_back(
+        {task,
+         "npu.tile." + suffix,
+         "npu.l1." + suffix,
+         selected == choices.end() ? "" : selected->implementation,
+         1,
+         {1, 1}});
+  }
+  j::Value physicalReceipt = nullptr, unionReceipt = nullptr;
+  if (!buildNPUPhysicalProgram(*expanded, effective, bindings, physicalSource,
+                               graph, physicalReceipt, error, concreteChoices))
+    return false;
+  std::vector<ProgramInvocationWave> invocations;
+  if (forceSingleInvocation) {
+    invocations.push_back({0, graph.events.size()});
+  } else {
+    if (!buildProgramGraphAIRSelections(graph, domain.maxStaticBdsPerDirection,
+                                        selections, unionReceipt, error))
+      return false;
+    for (const auto &selection : selections)
+      invocations.push_back({selection.begin, selection.end});
+  }
+  if (!bindProgramInvocationWaves(graph, invocations, "host-submission",
+                                  "system_memory_bo", error))
+    return false;
+  if (!forceSingleInvocation) {
+    for (auto &selection : selections)
+      selection.graphId = programGraphIdentity(graph);
+    if (!checkProgramGraphAIRSelectionUnion(graph, selections, unionReceipt,
+                                            error))
+      return false;
+  }
+  manifest = j::Object{{"schema", "orbit.npu-placed-program-waves.v1"},
+                       {"program_graph", serializeProgramGraph(graph)},
+                       {"program_graph_dot", renderProgramGraphDOT(graph)},
+                       {"cost_summary", summarizeProgramGraphCost(graph)},
+                       {"physical_graph_receipt", std::move(physicalReceipt)},
+                       {"shape_policy_projection", std::move(policyProjection)},
+                       {"configuration_union", std::move(unionReceipt)},
+                       {"effective_target", std::move(effective)},
+                       {"serial_wait_between_configurations_required", true},
+                       {"final_aie_checked", false},
+                       {"timing_claim", false}};
+  return true;
+}
+} // namespace
+bool orbit::taskflow::lowerNPUPlacedProgramWaves(
+    ModuleOp source, const j::Value &config,
+    std::vector<OwningOpRef<ModuleOp>> &outputs, j::Value &manifest,
+    std::string &error) {
+  outputs.clear();
+  OwningOpRef<ModuleOp> physicalSource;
+  ProgramGraph graph;
+  std::vector<ProgramGraphAIRSelection> selections;
+  if (!placedWaveGraph(source, config, physicalSource, graph, selections,
+                       manifest, error))
+    return false;
+  j::Array records;
+  for (const auto &selection : selections) {
+    OwningOpRef<ModuleOp> output;
+    j::Value record = nullptr;
+    if (!lowerProgramGraphAIRSelection(graph, selection, output, record,
+                                       error)) {
+      outputs.clear();
+      return false;
+    }
+    outputs.push_back(std::move(output));
+    records.push_back(std::move(record));
+  }
+  (*manifest.getAsObject())["wave_implementations"] = std::move(records);
+  return true;
+}
+bool orbit::taskflow::checkNPUPlacedWaveAIE(ModuleOp source,
+                                            const j::Value &config,
+                                            size_t waveIndex, ModuleOp actual,
+                                            j::Value &receipt,
+                                            std::string &error) {
+  OwningOpRef<ModuleOp> physicalSource, expected;
+  ProgramGraph graph;
+  j::Value manifest = nullptr, waveManifest = nullptr;
+  std::vector<ProgramGraphAIRSelection> selections;
+  if (!placedWaveGraph(source, config, physicalSource, graph, selections,
+                       manifest, error))
+    return false;
+  if (waveIndex >= selections.size())
+    return fail(error, "wave index is outside reconstructed source coverage");
+  if (!lowerProgramGraphAIRSelection(graph, selections[waveIndex], expected,
+                                     waveManifest, error) ||
+      !checkProgramGraphAIE(graph, *expected, actual, receipt, error,
+                            &selections[waveIndex]))
+    return false;
+  (*receipt.getAsObject())["configuration_union"] =
+      *manifest.getAsObject()->get("configuration_union");
+  (*receipt.getAsObject())["wave_index"] = int64_t(waveIndex);
+  return true;
+}
diff --git a/lib/TaskflowAIR/NPUPhysicalProgram.cpp b/lib/TaskflowAIR/NPUPhysicalProgram.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..6f63d35a31df8ab490a0bf181190fda0be18986b
--- /dev/null
+++ b/lib/TaskflowAIR/NPUPhysicalProgram.cpp
@@ -0,0 +1,196 @@
+#include "Taskflow/NPUPhysicalProgram.h"
+#include "Taskflow/SourceMappingActions.h"
+#include "Taskflow/TaskPlacement.h"
+#include "Taskflow/TaskflowSourceNormalization.h"
+#include "mlir/IR/BuiltinAttributes.h"
+#include <set>
+using namespace mlir;
+using namespace orbit::taskflow;
+namespace j = llvm::json;
+bool orbit::taskflow::buildNPUPhysicalProgram(
+    ModuleOp source, const j::Value &config, ArrayRef<NPUShardBinding> bindings,
+    OwningOpRef<ModuleOp> &normalized, ProgramGraph &graph, j::Value &receipt,
+    std::string &error, ArrayRef<MappingTaskPlacement> taskPlacements) {
+  NPUIndependentTargetDomain domain;
+  TaskflowSourceNormalizationWitness witness;
+  GenericAnalysis analysis;
+  if (!readNPUIndependentTargetDomain(config, domain, error) ||
+      failed(normalizeTaskflowSource(source, normalized, witness, error)) ||
+      !analyzeGenericProgram(*normalized, analysis, error))
+    return false;
+  StaticConfig target;
+  target.domains = {{"system", "", "system"}, {"npu", "system", "device"}};
+  target.resources = {{"host.worker", "compute", "host", 1, "system"},
+                      {"host-submission", "submission", "host", 1, "system"}};
+  target.memories = {{"system_memory_bo",
+                      INT64_MAX,
+                      {"host"},
+                      "system",
+                      "system-bo",
+                      {"host.worker"}}};
+  for (const auto &binding : bindings) {
+    if (binding.column < domain.firstColumn ||
+        binding.column >= domain.firstColumn + domain.columns ||
+        binding.row < domain.firstComputeRow ||
+        binding.row >= domain.firstComputeRow + domain.computeRows) {
+      error = "physical NPU program: duplicate or out-of-target coordinate";
+      return false;
+    }
+  }
+  for (int64_t column = domain.firstColumn;
+       column < domain.firstColumn + domain.columns; ++column)
+    target.domains.push_back({"npu.column." + std::to_string(column),
+                              "npu",
+                              "column",
+                              {{"column", column}}});
+  // Both shim DMA directions have two hardware channels per column. These
+  // are shared reservations, not a limit on how many compute rows may exist.
+  for (int64_t column = domain.firstColumn;
+       column < domain.firstColumn + domain.columns; ++column)
+    for (bool input : {true, false})
+      target.resources.push_back(
+          {(input ? "npu.shim.input." : "npu.shim.output.") +
+               std::to_string(column),
+           "transfer", "npu", 2, "npu.column." + std::to_string(column)});
+  // Keep the entire configured fabric in the target identity. An unused core
+  // remains a target fact; only actual allocations cause AIR herd emission.
+  for (int64_t row = domain.firstComputeRow;
+       row < domain.firstComputeRow + domain.computeRows; ++row)
+    for (int64_t column = domain.firstColumn;
+         column < domain.firstColumn + domain.columns; ++column) {
+      std::string suffix = std::to_string(column) + "." + std::to_string(row);
+      std::string core = "npu.tile." + suffix, memory = "npu.l1." + suffix;
+      std::string dma = "npu.dma." + suffix;
+      target.domains.push_back({core,
+                                "npu.column." + std::to_string(column),
+                                "tile",
+                                {{"column", column}, {"row", row}}});
+      target.resources.push_back({core, "compute", "npu", 1, core});
+      target.memories.push_back(
+          {memory, domain.capacityBytes, {"npu"}, core, "local-sram", {core}});
+      for (bool input : {true, false}) {
+        StaticTransfer link;
+        link.id = (input ? "host_to_l1." : "l1_to_host.") + suffix;
+        link.source = input ? "system_memory_bo" : memory;
+        link.target = input ? memory : "system_memory_bo";
+        link.resource = dma + (input ? ".input" : ".output");
+        const auto shared = (input ? "npu.shim.input." : "npu.shim.output.") +
+                            std::to_string(column);
+        target.resources.push_back(
+            {link.resource, "transfer", "npu", 1, core, {{shared, 1}}});
+        link.domain = core;
+        link.provenance = {"target_contract",
+                           "concrete direct DMA; timing uncalibrated"};
+        target.links.push_back(std::move(link));
+      }
+    }
+  std::vector<MappingTaskPlacement> choices;
+  choices.assign(taskPlacements.begin(), taskPlacements.end());
+  if (choices.empty())
+    for (size_t task = 0; task < analysis.tasks.size(); ++task) {
+      auto *operation = analysis.tasks[task].operation;
+      auto attr =
+          operation->getAttrOfType<IntegerAttr>("orbit.replica.instance");
+      int64_t instance = attr ? attr.getInt() : 0;
+      if (instance < 0 || uint64_t(instance) >= bindings.size()) {
+        error =
+            "physical NPU program: missing concrete source-instance binding";
+        return false;
+      }
+      const auto &binding = bindings[instance];
+      std::string suffix =
+          std::to_string(binding.column) + "." + std::to_string(binding.row);
+      choices.push_back({task,
+                         "npu.tile." + suffix,
+                         "npu.l1." + suffix,
+                         "scalar",
+                         1,
+                         {1, 1}});
+    }
+  for (const auto &storage : analysis.storages) {
+    if (isInputStorageRole(storage.role))
+      target.assumptions.initialLocations[storage.id] = "system_memory_bo";
+    if (isOutputStorageRole(storage.role))
+      target.assumptions.outputLocations[storage.id] = "system_memory_bo";
+  }
+  if (!setTaskPlacementChoices(*normalized, analysis.function.getSymName(),
+                               choices, error) ||
+      failed(refreshSourceMappingActionBindings(
+          source, *normalized, analysis.function.getSymName(), error)) ||
+      !analyzeGenericProgram(*normalized, analysis, error) ||
+      !buildPhysicalProgramGraph(analysis, target, choices, config, graph,
+                                 error))
+    return false;
+  // Complete each physical owner's existing copy ledger before starting the
+  // next owner. The common permutation checker remaps and revalidates every
+  // event reference; no dependency, transfer or source operation is removed.
+  std::vector<std::string> eventOwners;
+  for (size_t event = 0; event < graph.events.size(); ++event) {
+    const auto &value = graph.events[event];
+    std::set<std::string> owners;
+    if (value.kind == "compute" || value.kind == "initialize") {
+      auto resource = llvm::find_if(graph.resources, [&](const auto &r) {
+        return r.id == value.resource;
+      });
+      if (resource != graph.resources.end())
+        owners.insert(resource->domain);
+    } else if (value.kind == "transfer") {
+      for (const auto &copies : {value.reads, value.writes})
+        for (size_t copy : copies) {
+          auto memory = llvm::find_if(graph.memories, [&](const auto &m) {
+            return m.id ==
+                   graph.allocations[graph.copies[copy].allocation].memory;
+          });
+          if (memory != graph.memories.end() && memory->kind == "local-sram")
+            owners.insert(memory->domain);
+        }
+    }
+    if (owners.size() != 1) {
+      error = "physical NPU program: event lacks one concrete compute owner";
+      return false;
+    }
+    eventOwners.push_back(*owners.begin());
+  }
+  std::vector<size_t> eventOrder, pending(graph.events.size());
+  std::vector<std::vector<size_t>> consumers(graph.events.size());
+  std::set<size_t> ready;
+  std::map<std::string, std::set<size_t>> readyByOwner;
+  for (size_t event = 0; event < graph.events.size(); ++event) {
+    pending[event] = graph.events[event].dependencies.size();
+    for (auto dependency : graph.events[event].dependencies)
+      consumers[dependency].push_back(event);
+    if (!pending[event]) {
+      ready.insert(event);
+      readyByOwner[eventOwners[event]].insert(event);
+    }
+  }
+  std::string currentOwner;
+  while (!ready.empty()) {
+    auto &sameOwner = readyByOwner[currentOwner];
+    size_t event = sameOwner.empty() ? *ready.begin() : *sameOwner.begin();
+    currentOwner = eventOwners[event];
+    ready.erase(event);
+    readyByOwner[currentOwner].erase(event);
+    eventOrder.push_back(event);
+    for (auto consumer : consumers[event])
+      if (!--pending[consumer]) {
+        ready.insert(consumer);
+        readyByOwner[eventOwners[consumer]].insert(consumer);
+      }
+  }
+  if (eventOrder.size() != graph.events.size()) {
+    error = "physical NPU program: event dependency cycle";
+    return false;
+  }
+  if (!reorderProgramGraphEvents(graph, eventOrder, error))
+    return false;
+  receipt =
+      j::Object{{"schema", "orbit.npu-global-physical-program.v1"},
+                {"immutable_source_fingerprint", witness.sourceFingerprint},
+                {"normalized_fingerprint_before_physical_binding",
+                 witness.normalizedFingerprint},
+                {"physical_program_graph", serializeProgramGraph(graph)},
+                {"global_source_ledger", true},
+                {"final_aie_checked", false}};
+  return true;
+}
diff --git a/lib/TaskflowAIR/NPUShapePolicyProjection.cpp b/lib/TaskflowAIR/NPUShapePolicyProjection.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..0b70abcf9fd292a1d4595b3cf4d1d10838d83938
--- /dev/null
+++ b/lib/TaskflowAIR/NPUShapePolicyProjection.cpp
@@ -0,0 +1,211 @@
+#include "Taskflow/NPUShapePolicyProjection.h"
+#include "Taskflow/GenericMapping.h"
+#include "Taskflow/NativeTransforms.h"
+#include "Taskflow/SourceMappingActions.h"
+#include "Taskflow/TaskTiling.h"
+#include "Taskflow/TaskflowSourceNormalization.h"
+#include "TaskflowDialect/TaskflowOps.h"
+#include "mlir/IR/Builders.h"
+#include "llvm/Support/raw_ostream.h"
+#include <algorithm>
+#include <map>
+#include <set>
+using namespace mlir;
+using namespace orbit::taskflow;
+namespace j = llvm::json;
+namespace {
+j::Value policySnapshot(ModuleOp module) {
+  j::Object result;
+  for (StringRef name :
+       {"orbit.mapping", "orbit.task_tiles", "orbit.task_implementations",
+        "orbit.implementation", "orbit.vector_lanes", "orbit.air_tile_sizes",
+        "orbit.generated_initializer_tasks"})
+    if (auto attr = module->getAttr(name)) {
+      std::string text;
+      llvm::raw_string_ostream stream(text);
+      attr.print(stream);
+      result[name] = stream.str();
+    }
+  return result;
+}
+} // namespace
+bool orbit::taskflow::projectNPUReplicaPolicies(
+    ModuleOp parent, ModuleOp expanded, const TaskflowReplicaAction &action,
+    j::Value &receipt, std::string &error) {
+  if (failed(verifyTaskflowReplicaReplay(parent, expanded, {action}, error)))
+    return false;
+  OwningOpRef<ModuleOp> beforeModule, afterModule;
+  TaskflowSourceNormalizationWitness beforeWitness, afterWitness;
+  GenericAnalysis before, after;
+  if (failed(normalizeTaskflowSource(parent, beforeModule, beforeWitness,
+                                     error)) ||
+      failed(normalizeTaskflowSource(expanded, afterModule, afterWitness,
+                                     error)) ||
+      !analyzeGenericProgram(*beforeModule, before, error) ||
+      !analyzeGenericProgram(*afterModule, after, error))
+    return false;
+  std::map<std::string, size_t> actualNames;
+  for (size_t task = 0; task < after.tasks.size(); ++task) {
+    auto operation =
+        cast<mlir::taskflow::TaskflowTaskOp>(after.tasks[task].operation);
+    if (!actualNames.emplace(operation.getTaskName().str(), task).second) {
+      error = "NPU policy projection: duplicate authenticated task name";
+      return false;
+    }
+  }
+  std::vector<std::vector<size_t>> descendants(before.tasks.size());
+  std::set<size_t> covered;
+  j::Array mappings;
+  for (size_t task = 0; task < before.tasks.size(); ++task) {
+    auto operation =
+        cast<mlir::taskflow::TaskflowTaskOp>(before.tasks[task].operation);
+    std::vector<std::string> expected;
+    if (operation.getTaskName() == action.task) {
+      for (int64_t instance = 0; instance < action.count; ++instance)
+        expected.push_back(action.task + ".replica." +
+                           std::to_string(action.axis) + "." +
+                           std::to_string(instance));
+    } else {
+      expected.push_back(operation.getTaskName().str());
+    }
+    j::Array actualTasks;
+    for (const auto &name : expected) {
+      auto found = actualNames.find(name);
+      if (found == actualNames.end() || !covered.insert(found->second).second ||
+          before.tasks[task].loops.size() !=
+              after.tasks[found->second].loops.size()) {
+        error = "NPU policy projection: incomplete descendant or source-axis "
+                "binding";
+        return false;
+      }
+      descendants[task].push_back(found->second);
+      actualTasks.push_back(
+          j::Object{{"task", int64_t(found->second)}, {"name", name}});
+    }
+    mappings.push_back(j::Object{{"parent_task", int64_t(task)},
+                                 {"parent_name", operation.getTaskName().str()},
+                                 {"descendants", std::move(actualTasks)}});
+  }
+  if (covered.size() != after.tasks.size()) {
+    error = "NPU policy projection: unowned task after authenticated expansion";
+    return false;
+  }
+  auto originalPolicy = policySnapshot(parent);
+  std::vector<TaskTileChoice> tiles, projectedTiles;
+  std::vector<NativeTaskImplementationChoice> implementations,
+      projectedImplementations;
+  std::vector<size_t> initializers;
+  if (!readTaskTileChoices(parent, before.tasks.size(), tiles, error) ||
+      !readNativeTaskImplementations(parent, before.tasks.size(),
+                                     implementations, error) ||
+      !readNativeInitializerTasks(before, initializers, error))
+    return false;
+  for (const auto &tile : tiles)
+    for (size_t task : descendants[tile.task])
+      projectedTiles.push_back({task, tile.sizes});
+  for (const auto &implementation : implementations)
+    for (size_t task : descendants[implementation.task])
+      projectedImplementations.push_back(
+          {task, implementation.kind, implementation.lanes});
+  if (!setTaskTileChoices(expanded, after.tasks.size(), projectedTiles,
+                          error) ||
+      !setNativeTaskImplementations(expanded, after.tasks.size(),
+                                    projectedImplementations, error))
+    return false;
+  SmallVector<int64_t> projectedInitializers;
+  for (size_t initializer : initializers)
+    for (size_t task : descendants[initializer])
+      projectedInitializers.push_back(task);
+  std::sort(projectedInitializers.begin(), projectedInitializers.end());
+  if (projectedInitializers.empty()) {
+    expanded->removeAttr("orbit.generated_initializer_tasks");
+    afterModule->getOperation()->removeAttr(
+        "orbit.generated_initializer_tasks");
+  } else {
+    auto table = Builder(parent.getContext())
+                     .getDenseI64ArrayAttr(projectedInitializers);
+    expanded->setAttr("orbit.generated_initializer_tasks", table);
+    afterModule->getOperation()->setAttr("orbit.generated_initializer_tasks",
+                                         table);
+    std::vector<size_t> certified;
+    if (!readNativeInitializerTasks(after, certified, error) ||
+        certified.size() != projectedInitializers.size()) {
+      error = "NPU policy projection: descendant initializer lost source proof";
+      return false;
+    }
+  }
+  if (parent->hasAttr("orbit.mapping")) {
+    ProgramMappingChoice choice;
+    if (!readNativeMappingChoice(parent, choice, error))
+      return false;
+    auto projectTasks = [&](std::vector<size_t> &tasks) {
+      std::vector<size_t> projected;
+      for (size_t task : tasks) {
+        if (task >= descendants.size()) {
+          error = "NPU policy projection: stale residency task index";
+          return false;
+        }
+        projected.insert(projected.end(), descendants[task].begin(),
+                         descendants[task].end());
+      }
+      std::sort(projected.begin(), projected.end());
+      if (std::adjacent_find(projected.begin(), projected.end()) !=
+          projected.end()) {
