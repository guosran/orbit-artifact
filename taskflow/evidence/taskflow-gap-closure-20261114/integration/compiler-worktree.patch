@@ -0,0 +1,43 @@
+//===- TaskflowDeferredPlan.h - Guarded dynamic source actions ---*- C++
+//-*-===//
+#ifndef ORBIT_TASKFLOW_DEFERRED_PLAN_H
+#define ORBIT_TASKFLOW_DEFERRED_PLAN_H
+#include "Taskflow/SourceActions.h"
+#include "Taskflow/TaskflowSourceNormalization.h"
+#include "Taskflow/TaskflowSpecialization.h"
+namespace orbit::taskflow {
+/// Actions remain parameterized by the original source until the actual call
+/// supplies its checked scalar values and memory shapes. No speculative extent
+/// substitutes for an unbound source parameter.
+struct TaskflowDeferredPlan {
+  std::string function;
+  std::vector<TaskflowArgumentBinding> arguments;
+  std::vector<NeighborhoodAction> actions;
+  std::vector<NeighborhoodShape> initialShapes;
+  NeighborhoodShapeDomain shapeDomain;
+};
+struct TaskflowDeferredPlanResult {
+  TaskflowDeferredPlan plan;
+  TaskflowSpecializationWitness specialization;
+  TaskflowSourceNormalizationWitness normalization;
+  mlir::OwningOpRef<mlir::ModuleOp> specialized, source, normalized;
+  std::vector<NeighborhoodShape> shapes;
+};
+/// Specialize actual arguments, materialize the ordered public action history,
+/// independently replay it, then normalize the resulting real scalar program.
+/// Publish no partial module on failure. Target physical checks remain
+/// separate.
+mlir::LogicalResult materializeTaskflowDeferredPlan(
+    mlir::ModuleOp immutableSource, const TaskflowDeferredPlan &,
+    TaskflowDeferredPlanResult &, std::string &error,
+    const SourceActionExtension &extension = {});
+/// Before dispatch, bind this proof to both immutable source and actual call.
+/// Re-derive specialization, action history, and normalization independently.
+mlir::LogicalResult verifyTaskflowDeferredPlan(
+    mlir::ModuleOp immutableSource, const TaskflowDeferredPlanResult &,
+    llvm::ArrayRef<TaskflowArgumentBinding> actual, std::string &error,
+    const SourceActionExtension &extension = {});
+llvm::json::Value
+serializeTaskflowDeferredPlan(const TaskflowDeferredPlanResult &);
+} // namespace orbit::taskflow
+#endif
diff --git a/include/Taskflow/TaskflowFission.h b/include/Taskflow/TaskflowFission.h
new file mode 100644
index 0000000000000000000000000000000000000000..7ed9baa21bbdac3d9af31c9adad238ce3d1467b5
--- /dev/null
+++ b/include/Taskflow/TaskflowFission.h
@@ -0,0 +1,70 @@
+//===- TaskflowFission.h ---------------------------------------*- C++ -*-===//
+//
+// Source-owned, replayable Taskflow hyperblock DFG fission.
+//
+//===----------------------------------------------------------------------===//
+
+#ifndef ORBIT_TASKFLOW_TASKFLOW_FISSION_H
+#define ORBIT_TASKFLOW_TASKFLOW_FISSION_H
+
+#include "TaskflowDialect/TaskflowOps.h"
+
+#include "mlir/IR/BuiltinOps.h"
+#include "mlir/IR/Operation.h"
+#include "mlir/Support/LLVM.h"
+#include "mlir/Support/LogicalResult.h"
+
+#include "llvm/ADT/SmallVector.h"
+
+#include <cstdint>
+#include <memory>
+#include <string>
+
+namespace mlir {
+class Pass;
+}
+
+namespace orbit::taskflow {
+
+/// One source-owned fission action. Function and task names resolve the exact
+/// Taskflow task in the immutable canonical parent or a preceding replay step;
+/// leftNodes
+/// are increasing ordinals in its hyperblock's non-terminator operation list.
+struct TaskflowFissionAction {
+  std::string function;
+  std::string task;
+  llvm::SmallVector<unsigned> leftNodes;
+};
+
+/// Return up to maxCuts legal predecessor-closed cuts, ranked by structural
+/// resource pressure and unique live-value traffic. Small DFGs are enumerated
+/// exactly; larger DFGs use bounded frontier exploration. A nonempty diagnostic
+/// records truncation; it is never a claim of complete-domain enumeration.
+/// Unsupported tasks return a successful empty list with a diagnostic.
+mlir::FailureOr<llvm::SmallVector<llvm::SmallVector<unsigned>>>
+enumerateTaskflowFissionPartitions(mlir::taskflow::TaskflowTaskOp task,
+                                   uint64_t maxCuts, std::string &error);
+
+/// Materialize one validated source-side fission action in a module. The
+/// selected task must be unique in the named function.
+mlir::LogicalResult materializeTaskflowFission(
+    mlir::ModuleOp module, llvm::StringRef function, llvm::StringRef task,
+    llvm::ArrayRef<unsigned> leftNodes, std::string &error);
+
+/// Prove that `candidate` is exactly the deterministic replay of `actions`
+/// against the caller-pinned immutable canonical parent. Replay starts from a
+/// clone of the parent and uses the same legality checker/materializer as the
+/// public fission API; operation attributes are not accepted as authority.
+/// An action may target a child produced by an earlier action, enabling ordered
+/// multi-stage partitions while authenticating every derived source in replay.
+/// Module comparison ignores debug locations but includes all operation
+/// structure and attributes in generic MLIR form.
+mlir::LogicalResult verifyTaskflowFissionReplay(
+    mlir::ModuleOp canonicalParent, mlir::ModuleOp candidate,
+    llvm::ArrayRef<TaskflowFissionAction> actions, std::string &error);
+
+std::unique_ptr<mlir::Pass> createTaskflowFissionPass();
+
+} // namespace orbit::taskflow
+
+#endif // ORBIT_TASKFLOW_TASKFLOW_FISSION_H
