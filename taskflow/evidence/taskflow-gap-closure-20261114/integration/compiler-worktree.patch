+//===- TaskflowSpecialization.h - Runtime argument binding -------*- C++
+//-*-===//
+#ifndef ORBIT_TASKFLOW_SPECIALIZATION_H
+#define ORBIT_TASKFLOW_SPECIALIZATION_H
+#include "mlir/IR/BuiltinOps.h"
+#include "llvm/ADT/ArrayRef.h"
+#include "llvm/Support/JSON.h"
+#include <optional>
+#include <string>
+#include <vector>
+namespace orbit::taskflow {
+struct TaskflowArgumentBinding {
+  size_t argument = 0;
+  std::optional<int64_t> scalar;
+  std::vector<int64_t> shape;
+};
+struct TaskflowSpecializationWitness {
+  std::string function, sourceFingerprint, specializedFingerprint;
+  std::vector<TaskflowArgumentBinding> arguments;
+};
+/// Bind actual invocation parameters on a clone. Scalar arguments become
+/// constants, dynamic memrefs acquire their checked runtime shape, and memory
+/// identity is preserved through compatible casts. The caller must enforce
+/// the same argument guard before dispatching this specialized implementation.
+mlir::LogicalResult
+specializeTaskflowArguments(mlir::ModuleOp source, llvm::StringRef function,
+                            llvm::ArrayRef<TaskflowArgumentBinding>,
+                            mlir::OwningOpRef<mlir::ModuleOp> &specialized,
+                            TaskflowSpecializationWitness &,
+                            std::string &error);
+mlir::LogicalResult
+verifyTaskflowSpecialization(mlir::ModuleOp source, mlir::ModuleOp specialized,
+                             const TaskflowSpecializationWitness &,
+                             std::string &error);
+/// Authenticate actual runtime parameters before dispatching specialized code.
+bool checkTaskflowInvocationArguments(
+    const TaskflowSpecializationWitness &,
+    llvm::ArrayRef<TaskflowArgumentBinding> actual, std::string &error);
+bool parseTaskflowArgumentBindings(const llvm::json::Value &,
+                                   std::string &function,
+                                   std::vector<TaskflowArgumentBinding> &,
+                                   std::string &error);
+llvm::json::Value
+serializeTaskflowSpecialization(const TaskflowSpecializationWitness &);
+} // namespace orbit::taskflow
+#endif
