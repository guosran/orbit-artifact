+#include "Taskflow/ProgramMapping.h"
+#include "Taskflow/ProgramNativeProjection.h"
+#include "Taskflow/ProgramReplicaPlacement.h"
+#include "Taskflow/ProgramTargetBinding.h"
+#include "Taskflow/SourceMappingActions.h"
+#include "Taskflow/TaskflowReplica.h"
+#include "mlir/IR/BuiltinAttributes.h"
+#include <map>
+#include <set>
+using namespace orbit::taskflow;
+
+bool orbit::taskflow::checkProgramReplicaPlacements(
+    const GenericAnalysis &source, const StaticConfig &architecture,
+    llvm::ArrayRef<MappingTaskPlacement> placements, std::string &error) {
+  auto reject = [&](llvm::StringRef reason) {
+    error = ("physical program graph: " + reason).str();
+    return false;
+  };
+  bool hierarchical = false;
+  for (const auto &task : source.tasks) {
+    std::vector<TaskflowReplicaLevel> levels;
+    if (mlir::failed(
+            readTaskflowReplicaHierarchy(task.operation, levels, error)))
+      return false;
+    hierarchical |= levels.size() > 1;
+  }
+  if (hierarchical)
+    return checkProgramReplicaHierarchy(source, architecture, placements,
+                                        error);
+  bool hasReplicas = false;
+  for (const auto &task : source.tasks) {
+    if (mlir::failed(validateTaskflowReplicaContract(task.operation, error)))
+      return false;
+    hasReplicas |= task.operation->hasAttr("orbit.replica.group");
+  }
+  if (!hasReplicas)
+    return true;
+  if (placements.size() != source.tasks.size())
+    return reject("one concrete placement is required for every source task");
+  std::map<size_t, const MappingTaskPlacement *> byTask;
+  for (const auto &placement : placements)
+    if (placement.task >= source.tasks.size() ||
+        !byTask.emplace(placement.task, &placement).second)
+      return reject(
+          "concrete task placement indices are incomplete or repeated");
+  struct Instance {
+    std::string resource, memory, owner;
+  };
+  struct Group {
+    int64_t count = 0;
+    std::map<int64_t, Instance> instances;
+  };
+  std::map<std::string, Group> groups;
+  for (size_t task = 0; task < source.tasks.size(); ++task) {
+    auto *operation = source.tasks[task].operation;
+    if (mlir::failed(validateTaskflowReplicaContract(operation, error)))
+      return false;
+    auto groupName =
+        operation->getAttrOfType<mlir::StringAttr>("orbit.replica.group");
+    if (!groupName)
+      continue;
+    auto &group = groups[groupName.str()];
+    auto count =
+        operation->getAttrOfType<mlir::IntegerAttr>("orbit.replica.count")
+            .getInt();
+    auto instance =
+        operation->getAttrOfType<mlir::IntegerAttr>("orbit.replica.instance")
+            .getInt();
+    if (group.count && group.count != count)
+      return reject("replica group has inconsistent instance count");
+    group.count = count;
+    const auto &placement = *byTask.at(task);
+    // A concrete shard occupies one actual target compute resource. Source
+    // shape expansion must occur before this constructor, not be fabricated.
+    if (placement.resourceCount != 1 ||
+        (!placement.resourceShape.empty() &&
+         placement.resourceShape != std::vector<int64_t>{1, 1}))
+      return reject(
+          "replica stage must name one concretely expanded compute resource");
+    std::string owner, memoryOwner;
+    if (!programResourceOwner(architecture, placement.resource, owner, error) ||
+        !programMemoryOwner(architecture, placement.memory, memoryOwner, error))
+      return false;
+    if (owner.empty() || memoryOwner != owner)
+      return reject(
+          "replica local memory must belong to its actual compute owner");
+    auto [it, inserted] = group.instances.emplace(
+        instance, Instance{placement.resource, placement.memory, owner});
+    if (!inserted && (it->second.resource != placement.resource ||
+                      it->second.memory != placement.memory))
+      return reject("sequential stages of one replica instance changed "
+                    "physical placement");
+  }
+  for (const auto &[name, group] : groups) {
+    if (group.instances.size() != uint64_t(group.count))
+      return reject("replica group does not cover all declared instances");
+    for (auto first = group.instances.begin(); first != group.instances.end();
+         ++first) {
+      auto second = first;
+      for (++second; second != group.instances.end(); ++second) {
+        const auto &a = first->second, &b = second->second;
+        auto *ad = programDomain(architecture, a.owner);
+        auto *bd = programDomain(architecture, b.owner);
+        if (a.resource == b.resource || a.memory == b.memory ||
+            programDomainContains(architecture, a.owner, b.owner) ||
+            programDomainContains(architecture, b.owner, a.owner) ||
+            (ad && bd && ad->parent == bd->parent && ad->kind == bd->kind &&
+             !ad->coordinates.empty() && ad->coordinates == bd->coordinates))
+          return reject(
+              "independent replica instances overlap physical resources");
+      }
+    }
+  }
+  return true;
+}
+bool orbit::taskflow::buildPhysicalProgramGraph(
+    const GenericAnalysis &source, const StaticConfig &architecture,
+    llvm::ArrayRef<MappingTaskPlacement> placements, ProgramGraph &out,
+    std::string &error) {
+  return buildPhysicalProgramGraph(source, architecture, placements,
+                                   llvm::json::Object{}, out, error);
+}
+bool orbit::taskflow::buildPhysicalProgramGraph(
+    const GenericAnalysis &source, const StaticConfig &architecture,
+    llvm::ArrayRef<MappingTaskPlacement> placements,
+    const llvm::json::Value &mappingConfig, ProgramGraph &out,
+    std::string &error) {
+  out = {};
+  if (!source.function) {
+    error = "physical program graph requires an analyzed source function";
+    return false;
+  }
+  if (!checkProgramReplicaPlacements(source, architecture, placements, error))
+    return false;
+  auto module = source.function->getParentOfType<mlir::ModuleOp>();
+  auto function = source.function;
+  if (module->hasAttr("orbit.source_mapping_binding") &&
+      mlir::failed(checkSourceMappingActionBindings(
+          module, function.getSymName(), error)))
+    return false;
+  bool nativeChoices = hasNativeProgramMappingChoices(module);
+  if (auto *root = mappingConfig.getAsObject())
+    if (auto *air = root->getObject("generic_air"))
+      nativeChoices |= air->get("tile_sizes") || air->get("tiled");
+  for (const auto &placement : placements)
+    nativeChoices |= !placement.implementation.empty() &&
+                     placement.implementation != "scalar";
+  if (nativeChoices)
+    return planPhysicalNativeProgramMapping(source, architecture, placements,
+                                            mappingConfig, out, error);
+  ProgramDataOrganizationChoice choice;
+  choice.placements.assign(placements.begin(), placements.end());
+  for (auto &placement : choice.placements)
+    if (placement.implementation.empty())
+      placement.implementation = "scalar";
+  choice.partitionExactRegions = true;
+  choice.semanticDependenciesOnly = true;
+  std::string boundaryMemory;
+  for (const auto &memory : architecture.memories)
+    if (memory.kind == "system-bo") {
+      if (!boundaryMemory.empty()) {
+        error =
+            "physical program graph requires one unambiguous system BO memory";
+        return false;
+      }
+      boundaryMemory = memory.id;
+    }
+  if (boundaryMemory.empty()) {
+    error = "physical program graph requires a declared system BO boundary";
+    return false;
+  }
+  if (!planPhysicalBoundaryDataOrganization(source, architecture, choice,
+                                            boundaryMemory, out, error))
+    return false;
+  // Exact cells are views into one complete host BO per logical source root.
+  // Local allocations instead hold one exact cell at offset zero.
+  std::map<std::pair<size_t, std::string>, size_t> hostBuffers;
+  std::vector<MappingAllocation> allocations;
+  std::vector<size_t> remap;
+  for (auto allocation : out.allocations) {
+    const auto *memory = programMemory(architecture, allocation.memory);
+    if (memory && memory->kind == "system-bo") {
+      auto key = std::make_pair(allocation.storage, allocation.memory);
+      auto found = hostBuffers.find(key);
+      if (found != hostBuffers.end()) {
+        remap.push_back(found->second);
+        continue;
+      }
+      const auto &storage = source.storages[allocation.storage];
+      auto type = mlir::cast<mlir::MemRefType>(storage.root.getType());
+      int64_t bytes = (type.getElementType().getIntOrFloatBitWidth() + 7) / 8;
+      for (int64_t extent : storage.shape) {
+        if (extent <= 0 || bytes > INT64_MAX / extent) {
+          error = "physical program graph: host backing size overflows";
+          return false;
+        }
+        bytes *= extent;
+      }
+      int64_t alignment = memory->alignmentBytes;
+      if (alignment <= 0 || bytes > INT64_MAX - (alignment - 1)) {
+        error = "physical program graph: host backing alignment overflows";
+        return false;
+      }
+      allocation.bytes = ((bytes + alignment - 1) / alignment) * alignment;
+      allocation.addressing = "region-addressed";
+      allocation.spatialOwner = memory->domain;
+      allocation.key = "host-backing-" + std::to_string(allocation.storage) +
+                       "-" + allocation.memory;
+      hostBuffers.emplace(std::move(key), allocations.size());
+    } else if (memory && memory->kind == "local-sram") {
+      allocation.addressing = "reusable-slot";
+      allocation.spatialOwner = memory->domain;
+    }
+    remap.push_back(allocations.size());
+    allocations.push_back(std::move(allocation));
+  }
+  for (auto &copy : out.copies)
+    copy.allocation = remap[copy.allocation];
+  out.allocations = std::move(allocations);
+  return checkProgramGraph(out, error);
+}
diff --git a/lib/Taskflow/ProgramReplicaPlacement.cpp b/lib/Taskflow/ProgramReplicaPlacement.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..3e7469b720e16245580d6cd6a6ff85c00a53d513
--- /dev/null
+++ b/lib/Taskflow/ProgramReplicaPlacement.cpp
@@ -0,0 +1,140 @@
+#include "Taskflow/ProgramReplicaPlacement.h"
+#include "Taskflow/ProgramTargetBinding.h"
+#include "Taskflow/TaskflowReplica.h"
+#include <map>
+#include <set>
+using namespace orbit::taskflow;
+namespace {
+using Path = std::vector<std::pair<std::string, int64_t>>;
+struct Scope {
+  std::set<std::string> owners;
+  std::string stageOwner;
+};
+struct Family {
+  int64_t count = 0;
+  std::map<int64_t, Path> children;
+};
+bool reject(std::string &error, llvm::StringRef message) {
+  error = ("replica physical hierarchy: " + message).str();
+  return false;
+}
+// Coordinate identity includes real ancestor coordinates. Equal row numbers
+// under different physical columns are distinct; aliases with different domain
+// names but the same physical coordinate remain overlapping resources.
+bool coordinateAlias(const StaticConfig &target, const std::string &a,
+                     const std::string &b) {
+  const auto *ad = programDomain(target, a), *bd = programDomain(target, b);
+  if (!ad || !bd || ad->kind != bd->kind)
+    return false;
+  auto signature = [&](std::string name) {
+    std::pair<std::string, std::map<std::string, int64_t>> result;
+    std::set<std::string> visited;
+    while (!name.empty() && visited.insert(name).second) {
+      const auto *domain = programDomain(target, name);
+      if (!domain)
+        break;
+      result.first = name;
+      for (const auto &coordinate : domain->coordinates)
+        result.second.insert(coordinate);
+      name = domain->parent;
+    }
+    return result;
+  };
+  const auto ac = signature(a), bc = signature(b);
+  return !ac.second.empty() && ac == bc;
+}
+bool overlapsOwner(const StaticConfig &target, const std::string &a,
+                   const std::string &b) {
+  if (programDomainContains(target, a, b) ||
+      programDomainContains(target, b, a))
+    return true;
+  auto aliasesAncestor = [&](const std::string &owner, std::string descendant) {
+    std::set<std::string> visited;
+    while (!descendant.empty() && visited.insert(descendant).second) {
+      if (coordinateAlias(target, owner, descendant))
+        return true;
+      const auto *domain = programDomain(target, descendant);
+      if (!domain)
+        break;
+      descendant = domain->parent;
+    }
+    return false;
+  };
+  return aliasesAncestor(a, b) || aliasesAncestor(b, a);
+}
+} // namespace
+bool orbit::taskflow::checkProgramReplicaHierarchy(
+    const GenericAnalysis &source, const StaticConfig &target,
+    llvm::ArrayRef<MappingTaskPlacement> choices, std::string &error) {
+  std::map<size_t, const MappingTaskPlacement *> placements;
+  for (const auto &choice : choices)
+    if (choice.task >= source.tasks.size() ||
+        !placements.emplace(choice.task, &choice).second)
+      return reject(error, "repeated or invalid source placement");
+  std::map<Path, Scope> scopes;
+  std::map<std::pair<Path, std::string>, Family> families;
+  for (size_t task = 0; task < source.tasks.size(); ++task) {
+    std::vector<TaskflowReplicaLevel> levels;
+    if (mlir::failed(readTaskflowReplicaHierarchy(source.tasks[task].operation,
+                                                  levels, error)))
+      return false;
+    if (levels.empty())
+      continue;
+    auto found = placements.find(task);
+    if (found == placements.end())
+      return reject(error, "replica source stage has no concrete placement");
+    const auto &choice = *found->second;
+    if (choice.resourceCount != 1 ||
+        (!choice.resourceShape.empty() &&
+         choice.resourceShape != std::vector<int64_t>{1, 1}))
+      return reject(
+          error,
+          "hierarchy stage must bind one actual expanded compute resource");
+    std::string owner, memoryOwner;
+    if (!programResourceOwner(target, choice.resource, owner, error) ||
+        !programMemoryOwner(target, choice.memory, memoryOwner, error))
+      return false;
+    if (owner.empty() || owner != memoryOwner)
+      return reject(
+          error, "stage compute and local memory must have one actual owner");
+    Path path;
+    for (const auto &level : levels) {
+      auto &family = families[{path, level.owner}];
+      if (family.count && family.count != level.count)
+        return reject(error, "source sibling scope counts disagree");
+      family.count = level.count;
+      path.emplace_back(level.owner, level.instance);
+      family.children.emplace(level.instance, path);
+      scopes[path].owners.insert(owner);
+    }
+    // Multiple sequential stages at the same source path share one concrete
+    // resource. Splitting them across owners changes the source obligation.
+    auto &stageOwner = scopes[path].stageOwner;
+    if (!stageOwner.empty() && stageOwner != owner)
+      return reject(error,
+                    "one source instance has stages on different owners");
+    stageOwner = owner;
+  }
+  // Each scope is the union of the actual resource owners of its stages
+  // and descendants. Do not replace that set with its LCA: two disjoint
+  // subsets can legitimately share a chip/column ancestor.
+  for (const auto &[key, family] : families) {
+    if (family.count < 2 || family.children.size() != uint64_t(family.count))
+      return reject(error,
+                    "source hierarchy does not cover every sibling instance");
+    for (auto first = family.children.begin(); first != family.children.end();
+         ++first) {
+      auto second = first;
+      for (++second; second != family.children.end(); ++second) {
+        const auto &a = scopes.at(first->second).owners;
+        const auto &b = scopes.at(second->second).owners;
+        for (const auto &ownerA : a)
+          for (const auto &ownerB : b)
+            if (overlapsOwner(target, ownerA, ownerB))
+              return reject(error, "sibling source scopes overlap actual "
+                                   "compute/local-memory owners");
+      }
+    }
+  }
+  return true;
+}
diff --git a/lib/Taskflow/ProgramStateSequence.cpp b/lib/Taskflow/ProgramStateSequence.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..f6acfcc49d3fceba95af86335905d5384bb2d279
--- /dev/null
+++ b/lib/Taskflow/ProgramStateSequence.cpp
@@ -0,0 +1,362 @@
+#include "Taskflow/ProgramMapping.h"
+#include "llvm/Support/raw_ostream.h"
+#include <algorithm>
+#include <cmath>
+#include <set>
+#include <tuple>
+
+using namespace orbit::taskflow;
+namespace {
+bool reject(std::string &error, llvm::StringRef message) {
+  error = ("program invocation sequence: " + message).str();
+  return false;
+}
+std::optional<size_t> storageIndex(const ProgramGraph &graph,
+                                   llvm::StringRef name) {
+  for (size_t i = 0; i < graph.source.storages.size(); ++i)
+    if (graph.source.storages[i].id == name)
+      return i;
+  return std::nullopt;
+}
+// Select the final boundary copy for every exact logical cell. Initial states
+// remain one storage identity even if its final version was computed in place.
+bool stateCopies(const ProgramGraph &graph, size_t storage, bool initial,
+                 llvm::StringRef memory, std::vector<size_t> &out,
+                 std::string &error) {
+  out.clear();
+  for (size_t region = 0; region < graph.regions.size(); ++region) {
+    if (graph.regions[region].storage != storage)
+      continue;
+    int64_t latest = -2;
+    for (const auto &version : graph.versions)
+      if (version.region == region)
+        latest = std::max(latest, version.producer);
+    std::optional<size_t> found;
+    for (size_t i = 0; i < graph.copies.size(); ++i) {
+      const auto &copy = graph.copies[i];
+      const auto &version = graph.versions[copy.version];
+      if (version.region != region ||
+          (!memory.empty() &&
+           graph.allocations[copy.allocation].memory != memory))
+        continue;
+      bool boundary = initial ? copy.createdBy == -1
+                              : version.producer == latest &&
+                                    copy.releasedAfter == graph.events.size();
+      if (!boundary)
+        continue;
+      if (found)
+        return reject(error, "state boundary has ambiguous physical copies");
+      found = i;
+    }
+    if (!found)
+      return reject(error, "state boundary lacks a live copy of every cell");
+    out.push_back(*found);
+  }
+  return !out.empty() || reject(error, "state storage has no cells");
+}
+bool derive(const ProgramInvocationSequence &sequence,
+            std::vector<ProgramStateHandoff> &handoffs,
+            std::map<std::string, int64_t> &peak,
+            std::optional<double> &duration, std::string &error) {
+  const auto &range = sequence.range;
+  if (range.step <= 0 || range.lower < 0 || range.upper <= range.lower)
+    return reject(error,
+                  "runtime range must be nonempty, nonnegative and finite");
+  uint64_t count = uint64_t(range.upper - range.lower - 1) / range.step + 1;
+  if (count != sequence.steps.size())
+    return reject(error, "runtime invocation coverage is incomplete");
+  std::set<std::string> names, inputs, outputs;
+  for (const auto &state : sequence.states)
+    if (state.id.empty() || state.inputStorage.empty() ||
+        state.outputStorage.empty() || state.memory.empty() ||
+        !names.insert(state.id).second ||
+        !inputs.insert(state.inputStorage).second ||
+        !outputs.insert(state.outputStorage).second)
+      return reject(
+          error, "persistent state needs unique named input/output bindings");
+  handoffs.clear();
+  peak.clear();
+  duration = 0;
+  std::vector<std::vector<size_t>> finalCopies(sequence.states.size());
+  std::string target;
+  // Allocation equivalence across adjacent invocations authenticates physical
+  // aliasing. No invocation may acquire two formerly distinct live allocations
+  // as one buffer merely because their source shapes happen to match.
+  std::map<std::pair<size_t, size_t>, std::string> allocationKeys;
+  for (size_t invocation = 0; invocation < sequence.steps.size();
+       ++invocation) {
+    const auto &step = sequence.steps[invocation];
+    if (step.iteration != range.lower + int64_t(invocation) * range.step ||
+        !checkProgramGraph(step.graph, error))
+      return reject(
+          error,
+          "invocation does not implement its runtime-bound source graph: " +
+              error);
+    const auto &graph = step.graph;
+    StaticConfig architecture;
+    architecture.domains = graph.domains;
+    architecture.memories = graph.memories;
+    architecture.resources = graph.resources;
+    architecture.links = graph.links;
+    auto actualTarget =
+        graph.targetIdentity + ":" +
+        staticFingerprint(serializeMemoryArchitecture(architecture));
+    if (!invocation)
+      target = actualTarget;
+    else if (target != actualTarget)
+      return reject(error,
+                    "persistent calls must use one actual target architecture");
+    auto graphCost = summarizeProgramGraphCost(graph);
+    auto *actualPeak = graphCost.getAsObject()->getObject("peak_memory_bytes");
+    if (!actualPeak)
+      return reject(error, "checked graph has no derived allocation capacity");
+    for (const auto &[memory, value] : *actualPeak) {
+      auto bytes = value.getAsInteger();
+      if (!bytes || *bytes < 0)
+        return reject(error, "allocation lifetime sweep has unknown capacity");
+      peak[memory.str()] = std::max(peak[memory.str()], *bytes);
+    }
+    bool hasLaunch = std::any_of(
+        graph.executionRegions.begin(), graph.executionRegions.end(),
+        [](const auto &r) { return r.submissionCount != 0; });
+    if (duration && graph.schedule.estimatedMakespanMs && !hasLaunch) {
+      double sum = *duration + *graph.schedule.estimatedMakespanMs;
+      if (!std::isfinite(sum))
+        return reject(error, "call schedule duration overflows");
+      duration = sum;
+    } else
+      duration.reset();
+    for (size_t stateIndex = 0; stateIndex < sequence.states.size();
+         ++stateIndex) {
+      const auto &state = sequence.states[stateIndex];
+      auto input = storageIndex(graph, state.inputStorage);
+      auto output = storageIndex(graph, state.outputStorage);
+      if (!input || !output ||
+          !isInputStorageRole(graph.source.storages[*input].role) ||
+          !isOutputStorageRole(graph.source.storages[*output].role))
+        return reject(error, "state binding is not a real source input/output");
+      const auto &in = graph.source.storages[*input];
+      const auto &out = graph.source.storages[*output];
+      if (in.shape != out.shape || in.dtype != out.dtype)
+        return reject(error, "persistent input/output shape or dtype differs");
+      std::vector<size_t> initial, final;
+      // The first call's seed can be in host memory. Its checked graph must
+      // perform any real import needed to establish the retained final copy.
+      if (!stateCopies(graph, *input, true, invocation ? state.memory : "",
+                       initial, error) ||
+          !stateCopies(graph, *output, false, state.memory, final, error))
+        return false;
+      if (invocation) {
+        const auto &previous = sequence.steps[invocation - 1].graph;
+        for (size_t current : initial) {
+          const auto &copy = graph.copies[current];
+          const auto &region =
+              graph.regions[graph.versions[copy.version].region];
+          bool covered = false;
+          for (size_t source : finalCopies[stateIndex]) {
+            const auto &oldCopy = previous.copies[source];
+            const auto &oldRegion =
+                previous.regions[previous.versions[oldCopy.version].region];
+            if (oldRegion.sizes.size() != region.sizes.size())
+              return reject(error, "persistent region rank changes");
+            MappingRegion overlap;
+            overlap.storage = region.storage;
+            bool empty = false;
+            for (size_t axis = 0; axis < region.sizes.size(); ++axis) {
+              int64_t lower =
+                  std::max(region.offsets[axis], oldRegion.offsets[axis]);
+              int64_t upper =
+                  std::min(region.offsets[axis] + region.sizes[axis],
+                           oldRegion.offsets[axis] + oldRegion.sizes[axis]);
+              if (upper <= lower) {
+                empty = true;
+                break;
+              }
+              overlap.offsets.push_back(lower);
+              overlap.sizes.push_back(upper - lower);
+            }
+            if (empty)
+              continue;
+            covered = true;
+            const auto &before = previous.allocations[oldCopy.allocation];
+            const auto &after = graph.allocations[copy.allocation];
+            if (before.memory != after.memory || before.bytes != after.bytes ||
+                before.addressing != after.addressing ||
+                before.spatialOwner != after.spatialOwner)
+              return reject(error, "retained physical allocation ABI differs");
+            // Differently partitioned cells can only alias a complete backing
+            // allocation. A reusable tile slot is not a persistent full BO.
+            if ((oldRegion.offsets != region.offsets ||
+                 oldRegion.sizes != region.sizes) &&
+                before.addressing != "region-addressed")
+              return reject(
+                  error,
+                  "repartitioned state requires region-addressed backing");
+            const auto &previousStorage =
+                previous.source.storages[oldRegion.storage];
+            if (previousStorage.dtype != in.dtype ||
+                previousStorage.shape != in.shape)
+              return reject(error, "cross-call state type changes");
+            auto from = std::make_pair(invocation - 1, oldCopy.allocation);
+            auto to = std::make_pair(invocation, copy.allocation);
+            auto found = allocationKeys.find(from);
+            std::string key = found == allocationKeys.end()
+                                  ? "state-allocation-" +
+                                        std::to_string(from.first) + "-" +
+                                        std::to_string(from.second)
+                                  : found->second;
+            allocationKeys[from] = key;
+            auto existing = allocationKeys.find(to);
+            if (existing != allocationKeys.end() && existing->second != key)
+              return reject(error,
+                            "persistent handoff aliases distinct allocations");
+            for (const auto &[binding, assigned] : allocationKeys)
+              if (binding.first == invocation && binding.second != to.second &&
+                  assigned == key)
+                return reject(error,
+                              "handoff merges distinct buffers within a call");
+            allocationKeys[to] = key;
+            handoffs.push_back({stateIndex, invocation - 1, invocation, source,
+                                current, key, std::move(overlap)});
+          }
+          // Both checked graphs partition the entire same-shaped storage, so
+          // nonempty intersections cover this cell without gaps or duplicates.
+          if (!covered)
+            return reject(error, "persistent cells have no predecessor");
+        }
+      }
+      finalCopies[stateIndex] = std::move(final);
+    }
+  }
+  return true;
+}
+} // namespace
+bool orbit::taskflow::buildProgramInvocationSequence(
+    const ProgramInvocationRange &range,
+    llvm::ArrayRef<ProgramPersistentState> states,
+    const ProgramInvocationProvider &provider, ProgramInvocationSequence &out,
+    std::string &error) {
+  out = {};
+  if (!provider || range.step <= 0 || range.lower < 0 ||
+      range.upper <= range.lower)
+    return reject(error, "invalid runtime iteration provider/range");
+  uint64_t count = uint64_t(range.upper - range.lower - 1) / range.step + 1;
+  if (count > range.materializationBudget)
+    return reject(error, "materialization budget exhausted; runtime range is "
+                         "not expanded/validated, not proved infeasible");
+  if (count > std::vector<ProgramInvocationStep>().max_size())
+    return reject(error,
+                  "runtime expansion exceeds addressable vector storage");
+  ProgramInvocationSequence candidate;
+  candidate.range = range;
+  candidate.states.assign(states.begin(), states.end());
+  for (uint64_t index = 0; index < count; ++index) {
+    ProgramInvocationStep step;
+    step.iteration = range.lower + int64_t(index) * range.step;
+    if (!provider(step.iteration, step.graph, error))
+      return false;
+    candidate.steps.push_back(std::move(step));
+  }
+  if (!derive(candidate, candidate.handoffs, candidate.peakMemoryBytes,
+              candidate.estimatedMakespanMs, error))
+    return false;
+  out = std::move(candidate);
+  return true;
+}
+bool orbit::taskflow::checkProgramInvocationSequence(
+    const ProgramInvocationSequence &sequence, std::string &error) {
+  std::vector<ProgramStateHandoff> expected;
+  std::map<std::string, int64_t> peak;
+  std::optional<double> duration;
+  if (!derive(sequence, expected, peak, duration, error))
+    return false;
+  if (expected.size() != sequence.handoffs.size() ||
+      peak != sequence.peakMemoryBytes ||
+      duration != sequence.estimatedMakespanMs)
+    return reject(error, "state/capacity/call-schedule witness differs");
+  for (size_t i = 0; i < expected.size(); ++i) {
+    const auto &a = expected[i], &b = sequence.handoffs[i];
+    if (std::tie(a.state, a.producerInvocation, a.consumerInvocation,
+                 a.producerCopy, a.consumerCopy, a.allocationKey) !=
+            std::tie(b.state, b.producerInvocation, b.consumerInvocation,
+                     b.producerCopy, b.consumerCopy, b.allocationKey) ||
+        a.region.storage != b.region.storage ||
+        a.region.offsets != b.region.offsets ||
+        a.region.sizes != b.region.sizes)
+      return reject(error,
+                    "cross-call state/version/allocation binding differs");
+  }
+  return true;
+}
+bool orbit::taskflow::executeProgramInvocationSequence(
+    const ProgramInvocationSequence &sequence,
+    const ProgramInvocationExecutor &executor, std::string &error) {
+  if (!executor || !checkProgramInvocationSequence(sequence, error))
+    return reject(error,
+                  "execution needs an adapter and checked invocation graph");
+  for (size_t i = 0; i < sequence.steps.size(); ++i) {
+    std::vector<ProgramStateHandoff> incoming;
+    for (const auto &edge : sequence.handoffs)
+      if (edge.consumerInvocation == i)
+        incoming.push_back(edge);
+    const auto &step = sequence.steps[i];
+    if (!executor(i, step.iteration, step.graph, incoming, error))
+      return false;
+  }
+  return true;
+}
+llvm::json::Value orbit::taskflow::serializeProgramInvocationSequence(
+    const ProgramInvocationSequence &sequence) {
+  llvm::json::Array states, steps, edges;
+  for (const auto &state : sequence.states)
+    states.push_back(llvm::json::Object{{"id", state.id},
+                                        {"input_storage", state.inputStorage},
+                                        {"output_storage", state.outputStorage},
+                                        {"memory", state.memory}});
+  for (const auto &step : sequence.steps)
+    steps.push_back(
+        llvm::json::Object{{"iteration", step.iteration},
+                           {"graph", serializeProgramGraph(step.graph)}});
+  for (const auto &edge : sequence.handoffs)
+    edges.push_back(llvm::json::Object{
+        {"state", int64_t(edge.state)},
+        {"producer_invocation", int64_t(edge.producerInvocation)},
+        {"consumer_invocation", int64_t(edge.consumerInvocation)},
+        {"producer_copy", int64_t(edge.producerCopy)},
+        {"consumer_copy", int64_t(edge.consumerCopy)},
+        {"allocation_key", edge.allocationKey},
+        {"region_storage", int64_t(edge.region.storage)},
+        {"region_offsets",
+         [&] {
+           llvm::json::Array a;
+           for (auto v : edge.region.offsets)
+             a.push_back(v);
+           return a;
+         }()},
+        {"region_sizes",
+         [&] {
+           llvm::json::Array a;
+           for (auto v : edge.region.sizes)
+             a.push_back(v);
+           return a;
+         }()},
+        {"kind", "retain-allocation-no-copy"}});
+  llvm::json::Object peak;
+  for (const auto &[memory, bytes] : sequence.peakMemoryBytes)
+    peak[memory] = bytes;
+  return llvm::json::Object{
+      {"schema", "orbit.program-invocation-sequence.v1"},
+      {"lower", sequence.range.lower},
+      {"upper", sequence.range.upper},
+      {"step", sequence.range.step},
+      {"states", std::move(states)},
+      {"invocations", std::move(steps)},
+      {"state_handoffs", std::move(edges)},
+      {"peak_memory_bytes", std::move(peak)},
+      {"call_order", "serial-runtime-iteration; consume each checked graph's "
+                     "events and launch boundaries"},
+      {"estimated_makespan_ms",
+       sequence.estimatedMakespanMs
+           ? llvm::json::Value(*sequence.estimatedMakespanMs)
+           : llvm::json::Value(nullptr)}};
+}
