+//===- TaskflowSourceNormalization.cpp - Checked physical form --*- C++ -*-===//
+#include "Taskflow/TaskflowSourceNormalization.h"
+#include "Taskflow/SourceIterationDomain.h"
+#include "TaskflowDialect/TaskflowOps.h"
+#include "mlir/Dialect/Affine/IR/AffineOps.h"
+#include "mlir/Dialect/Arith/IR/Arith.h"
+#include "mlir/Dialect/Func/IR/FuncOps.h"
+#include "mlir/Dialect/MemRef/IR/MemRef.h"
+#include "mlir/Dialect/SCF/IR/SCF.h"
+#include "mlir/Dialect/UB/IR/UBOps.h"
+#include "mlir/IR/Diagnostics.h"
+#include "mlir/IR/IRMapping.h"
+#include "mlir/IR/Verifier.h"
+#include "mlir/Interfaces/SideEffectInterfaces.h"
+#include "llvm/ADT/DenseSet.h"
+#include "llvm/ADT/STLExtras.h"
+#include "llvm/ADT/StringExtras.h"
+#include "llvm/Support/SHA256.h"
+#include "llvm/Support/raw_ostream.h"
+#include <functional>
+using namespace mlir;
+using namespace mlir::taskflow;
+namespace orbit::taskflow {
+namespace {
+std::string bytes(ModuleOp module) {
+  std::string text;
+  llvm::raw_string_ostream stream(text);
+  module.print(stream, OpPrintingFlags().printGenericOpForm());
+  stream.flush();
+  return text;
+}
+std::string fingerprint(StringRef text) {
+  auto digest = llvm::SHA256::hash(llvm::arrayRefFromStringRef(text));
+  return llvm::toHex(digest, true);
+}
+struct Axis {
+  std::optional<int64_t> lower, upper;
+  int64_t step;
+};
+LogicalResult normalizeTask(TaskflowTaskOp task,
+                            TaskflowSourceNormalizationWitness &witness,
+                            std::string &error) {
+  SmallVector<TaskflowCounterOp> counters;
+  TaskflowHyperblockOp hyperblock;
+  for (Operation &operation : task.getBody().front()) {
+    if (auto counter = dyn_cast<TaskflowCounterOp>(operation))
+      counters.push_back(counter);
+    else if (auto body = dyn_cast<TaskflowHyperblockOp>(operation)) {
+      if (hyperblock) {
+        error = "normalization requires one canonical hyperblock per task";
+        return failure();
+      }
+      hyperblock = body;
+    }
+  }
+  if (counters.empty() && !hyperblock)
+    return success();
+  if (counters.empty() || !hyperblock || !hyperblock.getBody().hasOneBlock() ||
+      hyperblock.getIndices().size() != counters.size()) {
+    error = "normalization rejects noncanonical counter domains";
+    return failure();
+  }
+  for (Operation &operation : task.getBody().front()) {
+    if (!isa<TaskflowCounterOp, TaskflowHyperblockOp, TaskflowYieldOp>(
+            operation) &&
+        (operation.getNumRegions() || !isPure(&operation) ||
+         !isMemoryEffectFree(&operation))) {
+      error = "normalization rejects unsupported counter scaffolding/control";
+      return failure();
+    }
+    if (isa<TaskflowCounterOp>(operation) &&
+        !operation.isBeforeInBlock(hyperblock)) {
+      error = "normalization requires counters before their hyperblock";
+      return failure();
+    }
+  }
+  Block &body = hyperblock.getBody().front();
+  auto yield = dyn_cast<TaskflowHyperblockYieldOp>(body.getTerminator());
+  if (body.getNumArguments() !=
+          counters.size() + hyperblock.getIterArgs().size() ||
+      !yield ||
+      yield.getIterArgsNext().size() != hyperblock.getIterArgs().size() ||
+      hyperblock.getNumResults() != yield.getResults().size()) {
+    error =
+        "normalization requires complete next-state and last-iteration results";
+    return failure();
+  }
+  SmallVector<Axis> axes;
+  for (auto [index, counter] : llvm::enumerate(counters)) {
+    auto constant = [&](Value value) {
+      llvm::DenseSet<Value> active;
+      return mlir::taskflow::sourceStaticIndex(value, task, active);
+    };
+    auto lower = constant(counter.getLowerBound());
+    auto upper = constant(counter.getUpperBound());
+    auto step = constant(counter.getStep());
+    if (!step || *step <= 0 || (index == 0 && counter.getParentIndex()) ||
+        (index &&
+         counter.getParentIndex() != counters[index - 1].getCounterIndex()) ||
+        hyperblock.getIndices()[index] != counter.getCounterIndex()) {
+      error = "normalization requires an ordered counter chain and a proven "
+              "positive step";
+      return failure();
+    }
+    auto allowedUser = [&](Operation *user) {
+      return user == hyperblock || hyperblock->isProperAncestor(user) ||
+             (user->getBlock() == hyperblock->getBlock() &&
+              user->isBeforeInBlock(hyperblock) &&
+              (isa<TaskflowCounterOp>(user) ||
+               (!user->getNumRegions() && isPure(user) &&
+                isMemoryEffectFree(user))));
+    };
+    for (Operation *user : counter.getCounterIndex().getUsers())
+      if (!allowedUser(user)) {
+        error = "normalization rejects counter values escaping their iteration "
+                "scope";
+        return failure();
+      }
+    axes.push_back({lower, upper, *step});
+  }
+  bool validEffects = true;
+  body.walk([&](Operation *operation) {
+    if (isa<scf::IfOp, scf::ForOp, scf::YieldOp, affine::AffineForOp,
+            affine::AffineYieldOp, TaskflowHyperblockYieldOp, memref::LoadOp,
+            memref::StoreOp>(operation))
+      return;
+    if (operation->getNumRegions() || !isPure(operation) ||
+        !isMemoryEffectFree(operation))
+      validEffects = false;
+  });
+  if (!validEffects) {
+    error = "normalization rejects unknown effects or unsupported control "
+            "boundaries";
+    return failure();
+  }
+
+  // Static carry-free source retains affine loops for existing mapping. For
+  // dynamic domains or recurrence use real SCF iter_args through every loop
+  // depth. Inner final state becomes the next outer state, preserving the
+  // lexicographic execution order and every original scalar/control operation.
+  SmallVector<Operation *> scaffold;
+  for (Operation &operation : task.getBody().front()) {
+    if (&operation == hyperblock.getOperation())
+      break;
+    scaffold.push_back(&operation);
+  }
+  DenseSet<Value> scopedValues;
+  DenseSet<Operation *> scopedOperations;
+  for (Operation *operation : scaffold) {
+    bool scoped = isa<TaskflowCounterOp>(operation) ||
+                  llvm::any_of(operation->getOperands(), [&](Value value) {
+                    return scopedValues.contains(value);
+                  });
+    if (!scoped)
+      continue;
+    scopedOperations.insert(operation);
+    for (Value value : operation->getResults())
+      scopedValues.insert(value);
+  }
+  for (Operation *operation : scopedOperations)
+    for (Value value : operation->getResults())
+      for (Operation *user : value.getUsers())
+        if (!scopedOperations.contains(user) && user != hyperblock &&
+            !hyperblock->isProperAncestor(user)) {
+          error = "counter-dependent bound arithmetic escapes its source scope";
+          return failure();
+        }
+  if (llvm::any_of(hyperblock.getIterArgs(),
+                   [&](Value value) { return scopedValues.contains(value); })) {
+    error =
+        "source recurrence seed must be defined outside its iteration domain";
+    return failure();
+  }
+  OpBuilder builder(hyperblock);
+  IRMapping mapping;
+  bool reuseCarryResults =
+      hyperblock.getNumResults() == hyperblock.getIterArgs().size() &&
+      llvm::equal(yield.getResults(), yield.getIterArgsNext());
+  bool affine =
+      hyperblock.getIterArgs().empty() && hyperblock.getNumResults() == 0 &&
+      llvm::all_of(axes,
+                   [](const Axis &axis) { return axis.lower && axis.upper; });
+  SmallVector<scf::ForOp> recurrentLoops;
+  SmallVector<Value> carries(hyperblock.getIterArgs());
+  if (!reuseCarryResults)
+    for (Type type : hyperblock.getResultTypes())
+      carries.push_back(
+          builder.create<ub::PoisonOp>(hyperblock.getLoc(), type));
+  unsigned ordinal = 0;
+  for (Operation *operation : scaffold) {
+    auto counter = dyn_cast<TaskflowCounterOp>(operation);
+    if (!counter) {
+      if (scopedOperations.contains(operation))
+        builder.clone(*operation, mapping);
+      continue;
+    }
+    const Axis &axis = axes[ordinal];
+    if (affine) {
+      auto loop = builder.create<affine::AffineForOp>(
+          hyperblock.getLoc(), *axis.lower, *axis.upper, axis.step);
+      mapping.map(body.getArgument(ordinal), loop.getInductionVar());
+      mapping.map(counter.getCounterIndex(), loop.getInductionVar());
+      builder.setInsertionPoint(loop.getBody()->getTerminator());
+    } else {
+      auto loop = builder.create<scf::ForOp>(
+          hyperblock.getLoc(), mapping.lookupOrDefault(counter.getLowerBound()),
+          mapping.lookupOrDefault(counter.getUpperBound()),
+          mapping.lookupOrDefault(counter.getStep()), carries);
+      recurrentLoops.push_back(loop);
+      mapping.map(body.getArgument(ordinal), loop.getInductionVar());
+      mapping.map(counter.getCounterIndex(), loop.getInductionVar());
+      carries.assign(loop.getRegionIterArgs().begin(),
+                     loop.getRegionIterArgs().end());
+      builder.setInsertionPointToEnd(loop.getBody());
+      if (!loop.getBody()->empty())
+        if (auto terminator = dyn_cast<scf::YieldOp>(&loop.getBody()->back()))
+          builder.setInsertionPoint(terminator);
+    }
+    ++ordinal;
+  }
+  for (unsigned index = 0; index < hyperblock.getIterArgs().size(); ++index)
+    mapping.map(body.getArgument(counters.size() + index), carries[index]);
+  for (Operation &operation : body.without_terminator())
+    builder.clone(operation, mapping);
+  SmallVector<Value> next;
+  for (Value value : yield.getIterArgsNext())
+    next.push_back(mapping.lookupOrDefault(value));
+  if (!reuseCarryResults)
+    for (Value value : yield.getResults())
+      next.push_back(mapping.lookupOrDefault(value));
+  for (auto loop : llvm::reverse(recurrentLoops)) {
+    if (!loop.getBody()->empty() && isa<scf::YieldOp>(loop.getBody()->back()))
+      loop.getBody()->back().erase();
+    OpBuilder::atBlockEnd(loop.getBody())
+        .create<scf::YieldOp>(hyperblock.getLoc(), next);
+    next.assign(loop.getResults().begin(), loop.getResults().end());
+  }
+  if (!recurrentLoops.empty()) {
+    auto results = recurrentLoops.front().getResults();
+    hyperblock.replaceAllUsesWith(
+        reuseCarryResults
+            ? results
+            : results.drop_front(hyperblock.getIterArgs().size()));
+  }
+  hyperblock.erase();
+  for (Operation *operation : llvm::reverse(scaffold))
+    if (scopedOperations.contains(operation))
+      operation->erase();
+
+  // These captures describe source counters, not the normalized physical form.
+  // Their full content remains bound by sourceFingerprint in the witness.
+  for (StringRef name : {"amoeba.source_iteration_domain",
+                         "amoeba.source_iteration_capture_pending",
+                         "amoeba.source_iteration_control_binding",
+                         "amoeba.source_iteration_source_control_binding"})
+    task->removeAttr(name);
+  ++witness.normalizedTasks;
+  witness.normalizedCounters += counters.size();
+  return success();
+}
+// Turn actual cross-task scalar SSA into one-element dependence states. Each
+// value is computed once, stored after its producing loop, then loaded before
+// the consuming loop. A function with a host scalar ABI is left intact rather
+// than inventing an ABI conversion or a new initializer computation.
+LogicalResult materializeScalarDependencies(ModuleOp module,
+                                            std::string &error) {
+  for (auto function : module.getOps<func::FuncOp>()) {
+    SmallVector<TaskflowTaskOp> tasks;
+    function.walk([&](TaskflowTaskOp task) { tasks.push_back(task); });
+    bool eligible = true, needed = false;
+    for (auto task : tasks) {
+      needed |=
+          !task.getValueInputs().empty() || !task.getValueOutputs().empty();
+      for (Value input : task.getValueInputs())
+        eligible &=
+            input.getDefiningOp<arith::ConstantOp>() ||
+            (input.getDefiningOp<TaskflowTaskOp>() &&
+             llvm::is_contained(
+                 input.getDefiningOp<TaskflowTaskOp>().getValueOutputs(),
+                 input));
+      for (Value result : task.getValueOutputs()) {
+        eligible &= result.getType().isIntOrIndexOrFloat();
+        for (OpOperand &use : result.getUses()) {
+          auto consumer = dyn_cast<TaskflowTaskOp>(use.getOwner());
+          eligible &=
+              consumer && llvm::is_contained(consumer.getValueInputs(), result);
+        }
+      }
+    }
+    if (!eligible || !needed)
+      continue;
+    DenseMap<Value, std::pair<Value, Value>> slots;
+    for (auto task : tasks) {
+      OpBuilder builder(task);
+      SmallVector<Value> reads(task.getWillReads()),
+          writes(task.getWillWrites());
+      SmallVector<Value> originalReads(task.getOriginalReadMemrefs());
+      SmallVector<Value> originalWrites(task.getOriginalWriteMemrefs());
+      SmallVector<unsigned> readSlots, writeSlots;
+      for (auto [index, input] : llvm::enumerate(task.getValueInputs())) {
+        if (input.getDefiningOp<arith::ConstantOp>())
+          continue;
+        auto slot = slots.find(input);
+        if (slot == slots.end()) {
+          error =
+              "scalar normalization requires producer tasks before consumers";
+          return failure();
+        }
+        readSlots.push_back(index);
+        reads.push_back(slot->second.second);
+        originalReads.push_back(slot->second.first);
+      }
+      for (auto [index, result] : llvm::enumerate(task.getValueOutputs())) {
+        if (result.use_empty())
+          continue;
+        Value allocation = builder.create<memref::AllocOp>(
+            task.getLoc(), MemRefType::get({1}, result.getType()));
+        writeSlots.push_back(index);
+        writes.push_back(allocation);
+        originalWrites.push_back(allocation);
+      }
+      SmallVector<Type> writeTypes;
+      for (Value write : writes)
+        writeTypes.push_back(write.getType());
+      auto replacement = builder.create<TaskflowTaskOp>(
+          task.getLoc(), task.getDoneReads().getTypes(), writeTypes,
+          TypeRange{}, reads, writes, ValueRange{},
+          builder.getStringAttr(task.getTaskName()), originalReads,
+          originalWrites);
+      for (NamedAttribute attr : task->getAttrs()) {
+        StringRef name = attr.getName().strref();
+        if (name != "operandSegmentSizes" && name != "resultSegmentSizes" &&
+            name != "operand_segment_sizes" && name != "result_segment_sizes")
+          replacement->setAttr(attr.getName(), attr.getValue());
+      }
+      Block &source = task.getBody().front();
+      Block *body = new Block;
+      replacement.getBody().push_back(body);
+      for (Value operand : reads)
+        body->addArgument(operand.getType(), task.getLoc());
+      for (Value operand : writes)
+        body->addArgument(operand.getType(), task.getLoc());
+      IRMapping mapping;
+      for (unsigned index = 0; index < task.getWillReads().size(); ++index)
+        mapping.map(source.getArgument(index), body->getArgument(index));
+      for (unsigned index = 0; index < task.getWillWrites().size(); ++index)
+        mapping.map(source.getArgument(task.getWillReads().size() + index),
+                    body->getArgument(reads.size() + index));
+      OpBuilder inner = OpBuilder::atBlockEnd(body);
+      Value zero = inner.create<arith::ConstantIndexOp>(task.getLoc(), 0);
+      for (auto [index, input] : llvm::enumerate(task.getValueInputs())) {
+        Value value;
+        if (auto constant = input.getDefiningOp<arith::ConstantOp>())
+          value = inner.clone(*constant)->getResult(0);
+        else {
+          auto position = llvm::find(readSlots, index) - readSlots.begin();
+          value = inner.create<memref::LoadOp>(
+              task.getLoc(),
+              body->getArgument(task.getWillReads().size() + position),
+              ValueRange{zero});
+        }
+        mapping.map(source.getArgument(task.getWillReads().size() +
+                                       task.getWillWrites().size() + index),
+                    value);
+      }
+      for (Operation &operation : source.without_terminator())
+        inner.clone(operation, mapping);
+      auto sourceYield = cast<TaskflowYieldOp>(source.getTerminator());
+      for (auto [position, index] : llvm::enumerate(writeSlots)) {
+        Value destination = body->getArgument(
+            reads.size() + task.getWillWrites().size() + position);
+        inner.create<memref::StoreOp>(
+            task.getLoc(),
+            mapping.lookupOrDefault(sourceYield.getValueResults()[index]),
+            destination, ValueRange{zero});
+      }
+      SmallVector<Value> doneReads, doneWrites;
+      for (Value state : sourceYield.getDoneReads())
+        doneReads.push_back(mapping.lookupOrDefault(state));
+      for (Value state : sourceYield.getDoneWrites())
+        doneWrites.push_back(mapping.lookupOrDefault(state));
+      for (unsigned index = task.getWillWrites().size(); index < writes.size();
+           ++index)
+        doneWrites.push_back(body->getArgument(reads.size() + index));
+      inner.create<TaskflowYieldOp>(task.getLoc(), doneReads, doneWrites,
+                                    ValueRange{});
+      for (auto [old, fresh] :
+           llvm::zip(task.getDoneReads(), replacement.getDoneReads()))
+        old.replaceAllUsesWith(fresh);
+      for (auto [old, fresh] :
+           llvm::zip(task.getDoneWrites(), replacement.getDoneWrites()))
+        old.replaceAllUsesWith(fresh);
+      for (auto [position, index] : llvm::enumerate(writeSlots))
+        slots[task.getValueOutputs()[index]] = {
+            writes[task.getWillWrites().size() + position],
+            replacement
+                .getDoneWrites()[task.getWillWrites().size() + position]};
+    }
+    for (auto task : llvm::reverse(tasks))
+      task.erase();
+  }
+  return success();
+}
+} // namespace
+LogicalResult
+normalizeTaskflowSource(ModuleOp source, OwningOpRef<ModuleOp> &normalized,
+                        TaskflowSourceNormalizationWitness &witness,
+                        std::string &error) {
+  normalized = nullptr;
+  witness = {};
+  error.clear();
+  if (!source) {
+    error = "normalization requires an immutable source module";
+    return failure();
+  }
+  ScopedDiagnosticHandler diagnostics(source.getContext(),
+                                      [&](Diagnostic &diag) {
+                                        llvm::raw_string_ostream stream(error);
+                                        diag.print(stream);
+                                        return success();
+                                      });
+  if (failed(verify(source)))
+    return failure();
+  source.getContext()->getOrLoadDialect<affine::AffineDialect>();
+  source.getContext()->getOrLoadDialect<scf::SCFDialect>();
+  source.getContext()->getOrLoadDialect<ub::UBDialect>();
+  OwningOpRef<ModuleOp> trial = source.clone();
+  SmallVector<TaskflowTaskOp> tasks;
+  trial->walk([&](TaskflowTaskOp task) { tasks.push_back(task); });
+  TaskflowSourceNormalizationWitness result;
+  for (auto task : tasks)
+    if (failed(normalizeTask(task, result, error)))
+      return failure();
+  if (failed(materializeScalarDependencies(*trial, error)) ||
+      failed(verify(*trial)))
+    return failure();
+  result.sourceFingerprint = fingerprint(bytes(source));
+  result.normalizedFingerprint = fingerprint(bytes(*trial));
+  witness = std::move(result);
+  normalized = std::move(trial);
+  return success();
+}
+LogicalResult verifyTaskflowSourceNormalization(
+    ModuleOp source, ModuleOp normalized,
+    const TaskflowSourceNormalizationWitness &witness, std::string &error) {
+  OwningOpRef<ModuleOp> replay;
+  TaskflowSourceNormalizationWitness actual;
+  if (!normalized ||
+      failed(normalizeTaskflowSource(source, replay, actual, error)))
+    return failure();
+  if (actual.protocol != witness.protocol ||
+      actual.sourceFingerprint != witness.sourceFingerprint ||
+      actual.normalizedFingerprint != witness.normalizedFingerprint ||
+      actual.normalizedTasks != witness.normalizedTasks ||
+      actual.normalizedCounters != witness.normalizedCounters ||
+      bytes(*replay) != bytes(normalized)) {
+    error = "physical normalization does not match exact source replay";
+    return failure();
+  }
+  return success();
+}
+} // namespace orbit::taskflow
