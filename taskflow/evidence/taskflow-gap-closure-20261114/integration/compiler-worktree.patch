+  for (const auto &placement : graph.placements)
+    tasksByResource[placement.resource].push_back(int64_t(placement.task));
+  j::Array shards, placements;
+  for (auto &[resource, tasks] : tasksByResource) {
+    Coordinate coordinate;
+    if (!namedCoordinate(resource, "npu.tile.", coordinate))
+      return fail(error, "global graph lost concrete source replica binding");
+    shards.push_back(
+        j::Object{{"resource", resource}, {"tasks", std::move(tasks)}});
+    placements.push_back(j::Object{{"resource", resource},
+                                   {"column", coordinate.first},
+                                   {"row", coordinate.second}});
+  }
+  auto &record = *manifest.getAsObject();
+  record["schema"] = "orbit.npu-source-replicas.global.v2";
+  record["shards"] = std::move(shards);
+  record["placement"] = std::move(placements);
+  record["full_configuration_implementation"] = std::move(realization);
+  record["air_graph_binding"] = "exact global ProgramGraph emission";
+  return true;
+}
