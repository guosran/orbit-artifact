-static std::string genericModuleBytes(ModuleOp module) {
-  std::string bytes;
-  llvm::raw_string_ostream stream(bytes);
-  OpPrintingFlags flags;
-  flags.printGenericOpForm();
-  module.print(stream, flags);
-  stream.flush();
-  return bytes;
-}
