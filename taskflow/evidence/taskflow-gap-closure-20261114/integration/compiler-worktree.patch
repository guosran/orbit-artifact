+bool expandPlacedSource(ModuleOp source, const j::Value &config,
+                        OwningOpRef<ModuleOp> &expanded, j::Value &effective,
+                        j::Value &policyProjection, std::string &e) {
+  NPUIndependentTargetDomain domain;
+  if (!readNPUIndependentTargetDomain(config, domain, e))
+    return false;
+  auto functions = source.getOps<func::FuncOp>();
+  if (!llvm::hasSingleElement(functions))
+    return fail(e, "placed AIR requires exactly one source function");
+  auto function = *functions.begin();
+  std::vector<MappingTaskPlacement> choices;
+  if (!readTaskPlacementChoices(source, function.getSymName(), choices, e))
+    return false;
+  struct Request {
+    std::string name, implementation;
+    int64_t rows = 1, columns = 1;
+    std::optional<Coordinate> anchor;
+    std::vector<TaskflowReplicaLevel> hierarchy;
+  };
+  std::vector<Request> requests;
+  source.walk([&](mlir::taskflow::TaskflowTaskOp task) {
+    Request request;
+    request.name = task.getTaskName().str();
+    requests.push_back(std::move(request));
+  });
+  size_t ordinal = 0;
+  bool hierarchyValid = true;
+  source.walk([&](mlir::taskflow::TaskflowTaskOp task) {
+    hierarchyValid &= succeeded(
+        readTaskflowReplicaHierarchy(task, requests[ordinal++].hierarchy, e));
+  });
+  if (!hierarchyValid)
+    return false;
+  for (const auto &choice : choices) {
+    if (choice.task >= requests.size())
+      return fail(e, "stale source placement index");
+    auto &r = requests[choice.task];
+    if (!placementCoordinate(choice, domain, r.anchor, e))
+      return false;
+    r.implementation = choice.implementation;
+    if (!choice.resourceShape.empty()) {
+      if (choice.resourceShape.size() != 2 || choice.resourceShape[0] < 1 ||
+          choice.resourceShape[1] < 1 ||
+          choice.resourceShape[0] > domain.computeRows ||
+          choice.resourceShape[1] > domain.columns)
+        return fail(e, "task shape exceeds configured physical geometry");
+      r.rows = choice.resourceShape[0];
+      r.columns = choice.resourceShape[1];
+    }
+  }
+  expanded = source.clone();
+  effective = config;
+  if (llvm::none_of(requests, [](const auto &r) {
+        return r.rows != 1 || r.columns != 1;
+      }))
+    return true;
+  // Reserve a concrete rectangle per existing replica leaf. A parent-stage
+  // prefix uses the first descendant rectangle; actual owner-set checking
+  // subsequently proves all sibling scopes independent on the real fabric.
+  struct Family {
+    int64_t rows = 1, columns = 1;
+    std::vector<int64_t> counts;
+  };
+  std::map<std::string, Family> families;
+  for (const auto &r : requests)
+    if (!r.hierarchy.empty()) {
+      auto &f = families[r.hierarchy.front().owner];
+      f.rows = std::max(f.rows, r.rows);
+      f.columns = std::max(f.columns, r.columns);
+      for (size_t d = 0; d < r.hierarchy.size(); ++d) {
+        if (f.counts.size() <= d)
+          f.counts.push_back(r.hierarchy[d].count);
+        else
+          f.counts[d] = std::max(f.counts[d], r.hierarchy[d].count);
+      }
+    }
+  for (auto &r : requests) {
+    if (!r.anchor && !r.hierarchy.empty()) {
+      const auto &f = families.at(r.hierarchy.front().owner);
+      int64_t leaf = 0;
+      for (size_t d = 0; d < f.counts.size(); ++d) {
+        const int64_t digit =
+            d < r.hierarchy.size() ? r.hierarchy[d].instance : 0;
+        if (leaf > (INT64_MAX - digit) / f.counts[d])
+          return fail(e, "replica shape domain overflows");
+        leaf = leaf * f.counts[d] + digit;
+      }
+      const int64_t perRow = domain.columns / f.columns;
+      if (!perRow || leaf / perRow >= domain.computeRows / f.rows)
+        return fail(
+            e, "cannot pack replica shape rectangles in the configured target");
+      r.anchor = Coordinate{domain.firstColumn + (leaf % perRow) * f.columns,
+                            domain.firstComputeRow + (leaf / perRow) * f.rows};
+    }
+    if (!r.anchor)
+      r.anchor = Coordinate{domain.firstColumn, domain.firstComputeRow};
+    if (r.rows >
+            domain.firstComputeRow + domain.computeRows - r.anchor->second ||
+        r.columns > domain.firstColumn + domain.columns - r.anchor->first)
+      return fail(e, "anchored shape escapes configured fabric");
+  }
+  j::Array projections;
+  for (const auto &r : requests) {
+    if (r.rows == 1 && r.columns == 1)
+      continue;
+    auto parent = expanded->clone();
+    TaskflowReplicaAction action{function.getSymName().str(), r.name, 0,
+                                 r.rows * r.columns};
+    j::Value projection = nullptr;
+    if (failed(materializeTaskflowReplicas(*expanded, action, e)) ||
+        !projectNPUReplicaPolicies(parent, *expanded, action, projection, e)) {
+      parent.erase();
+      return false;
+    }
+    std::vector<MappingTaskPlacement> current;
+    if (!readTaskPlacementChoices(*expanded, function.getSymName(), current,
+                                  e)) {
+      parent.erase();
+      return false;
+    }
+    std::map<std::string, size_t> taskIndices;
+    size_t index = 0;
+    expanded->walk([&](mlir::taskflow::TaskflowTaskOp task) {
+      taskIndices.emplace(task.getTaskName().str(), index++);
+    });
+    for (int64_t child = 0; child < r.rows * r.columns; ++child) {
+      auto name = r.name + ".replica.0." + std::to_string(child);
+      auto found = taskIndices.find(name);
+      if (found == taskIndices.end()) {
+        parent.erase();
+        return fail(e, "missing authenticated shape descendant");
+      }
+      const std::string suffix =
+          std::to_string(r.anchor->first + child % r.columns) + "." +
+          std::to_string(r.anchor->second + child / r.columns);
+      auto old = llvm::find_if(
+          current, [&](const auto &p) { return p.task == found->second; });
+      MappingTaskPlacement placed{found->second,
+                                  "npu.tile." + suffix,
+                                  "npu.l1." + suffix,
+                                  r.implementation,
+                                  1,
+                                  {1, 1}};
+      if (old == current.end())
+        current.push_back(std::move(placed));
+      else
+        *old = std::move(placed);
+    }
+    if (!setTaskPlacementChoices(*expanded, function.getSymName(), current,
+                                 e) ||
+        failed(refreshSourceMappingActionBindings(parent, *expanded,
+                                                  function.getSymName(), e))) {
+      parent.erase();
+      return false;
+    }
+    parent.erase();
+    projections.push_back(std::move(projection));
+  }
+  // Unit parent stages retain their source identity but receive the same
+  // concrete prefix owner as their descendants, never a new repeated task.
+  std::map<std::string, size_t> finalNames;
+  size_t index = 0;
+  expanded->walk([&](mlir::taskflow::TaskflowTaskOp task) {
+    finalNames.emplace(task.getTaskName().str(), index++);
+  });
+  std::vector<MappingTaskPlacement> finalChoices;
+  if (!readTaskPlacementChoices(*expanded, function.getSymName(), finalChoices,
+                                e))
+    return false;
+  auto parent = expanded->clone();
+  for (const auto &r : requests)
+    if (r.rows == 1 && r.columns == 1) {
+      auto found = finalNames.find(r.name);
+      if (found == finalNames.end())
+        return fail(e, "unit source task disappeared");
+      const auto suffix = std::to_string(r.anchor->first) + "." +
+                          std::to_string(r.anchor->second);
+      MappingTaskPlacement placed{found->second,
+                                  "npu.tile." + suffix,
+                                  "npu.l1." + suffix,
+                                  r.implementation,
+                                  1,
+                                  {1, 1}};
+      auto old = llvm::find_if(
+          finalChoices, [&](const auto &p) { return p.task == found->second; });
+      if (old == finalChoices.end())
+        finalChoices.push_back(std::move(placed));
+      else
+        *old = std::move(placed);
+    }
+  bool okay = setTaskPlacementChoices(*expanded, function.getSymName(),
+                                      finalChoices, e) &&
+              succeeded(refreshSourceMappingActionBindings(
+                  parent, *expanded, function.getSymName(), e));
+  parent.erase();
+  if (!okay)
+    return false;
+  policyProjection = std::move(projections);
+  return true;
+}
