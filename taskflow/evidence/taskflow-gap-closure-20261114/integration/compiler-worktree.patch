+module {
+  func.func @pointwise(%input: memref<32x32xf32> {amoeba.noalias, orbit.role = "input"},
+                       %output: memref<32x32xf32> {amoeba.noalias, orbit.role = "output"}) attributes {orbit.noalias} {
+    %done = taskflow.task @Pointwise
+        will_reads(%input : memref<32x32xf32>)
+        will_writes(%output : memref<32x32xf32>)
+        [original_read_memrefs(%input : memref<32x32xf32>),
+         original_write_memrefs(%output : memref<32x32xf32>)]
+        : (memref<32x32xf32>, memref<32x32xf32>) -> memref<32x32xf32> {
+      ^bb0(%read: memref<32x32xf32>, %write: memref<32x32xf32>):
+        %zero = arith.constant 0 : index
+        %one = arith.constant 1 : index
+        %fifteen = arith.constant 32 : index
+        %ten = arith.constant 32 : index
+        %m = taskflow.counter from %zero to %fifteen step %one : index
+        %n = taskflow.counter parent(%m : index) from %zero to %ten step %one : index
+        "taskflow.hyperblock"(%m, %n)
+            <{operandSegmentSizes = array<i32: 2, 0>}> ({
+          ^bb0(%i: index, %j: index):
+            %value = memref.load %read[%i, %j] : memref<32x32xf32>
+            %twice = arith.addf %value, %value : f32
+            memref.store %twice, %write[%i, %j] : memref<32x32xf32>
+            "taskflow.hyperblock.yield"() : () -> ()
+        }) : (index, index) -> ()
+        taskflow.yield done_writes(%write : memref<32x32xf32>)
+    }
+    func.return
+  }
+}
