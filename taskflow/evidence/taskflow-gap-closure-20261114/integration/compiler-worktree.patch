+void canonical(std::vector<size_t> &v) {
+  std::sort(v.begin(), v.end());
+  v.erase(std::unique(v.begin(), v.end()), v.end());
+}
+} // namespace
+bool orbit::taskflow::hasNativeProgramMappingChoices(mlir::ModuleOp module) {
+  for (auto name :
+       {"orbit.mapping", "orbit.air_tile_sizes", "orbit.task_tiles",
+        "orbit.implementation", "orbit.vector_lanes",
+        "orbit.task_implementations", "orbit.generated_initializer_tasks"})
+    if (module->hasAttr(name))
+      return true;
+  return false;
+}
+bool orbit::taskflow::planPhysicalNativeProgramMapping(
+    const GenericAnalysis &original, const StaticConfig &target,
+    llvm::ArrayRef<MappingTaskPlacement> placements,
+    const llvm::json::Value &config, ProgramGraph &out, std::string &error) {
+  out = {};
+  if (!original.function || !validateMemoryArchitecture(target, error))
+    return reject(error, "valid source and target architecture are required");
+  if (placements.size() != original.tasks.size())
+    return reject(error, "every source task requires an actual placement");
+  std::vector<MappingTaskPlacement> choices(placements.size());
+  std::set<size_t> seen;
+  for (const auto &p : placements) {
+    if (p.task >= choices.size() || !seen.insert(p.task).second)
+      return reject(error, "invalid or duplicate placement ordinal");
+    choices[p.task] = p;
+  }
+  auto function = original.function;
+  auto module = function->getParentOfType<mlir::ModuleOp>();
+  if (module->hasAttr("orbit.source_mapping_binding") &&
+      mlir::failed(checkSourceMappingActionBindings(
+          module, function.getSymName(), error)))
+    return false;
+  mlir::OwningOpRef<mlir::ModuleOp> numeric = module.clone();
+  // This clone is never a physical certificate. Only resource obligations are
+  // deferred while the existing single-herd planner generates numeric work.
+  numeric->walk([&](mlir::Operation *operation) {
+    std::vector<mlir::StringAttr> remove;
+    for (auto attribute : operation->getAttrs())
+      if (attribute.getName().strref().starts_with("orbit.replica.") ||
+          attribute.getName().strref() == "orbit.placement")
+        remove.push_back(attribute.getName());
+    for (auto name : remove)
+      operation->removeAttr(name);
+  });
+  std::vector<NativeTaskImplementationChoice> explicitImplementations;
+  if (!readNativeTaskImplementations(*numeric, original.tasks.size(),
+                                     explicitImplementations, error))
+    return false;
+  std::vector<MappingTaskPlacement> sourceChoices;
+  if (!readTaskPlacementChoices(module, function.getSymName(), sourceChoices,
+                                error))
+    return false;
+  for (const auto &choice : sourceChoices) {
+    if (choice.implementation.empty())
+      continue;
+    auto existing =
+        llvm::find_if(explicitImplementations, [&](const auto &entry) {
+          return entry.task == choice.task;
+        });
+    if (existing != explicitImplementations.end()) {
+      if (existing->kind != choice.implementation)
+        return reject(
+            error, "task implementation choices contradict source placement");
+      continue;
+    }
+    int64_t lanes = 1;
+    if (choice.implementation != "scalar" &&
+        choice.implementation != programMatrixImplementation)
+      if (auto value =
+              numeric->getOperation()->getAttrOfType<mlir::IntegerAttr>(
+                  "orbit.vector_lanes")) {
+        if (!value.getType().isInteger(64))
+          return reject(error, "vector lane choice requires an i64 integer");
+        lanes = value.getInt();
+      }
+    explicitImplementations.push_back(
+        {choice.task, choice.implementation, lanes});
+  }
+  if (!setNativeTaskImplementations(*numeric, original.tasks.size(),
+                                    explicitImplementations, error))
+    return false;
+  ProgramMappingChoice policy;
+  if (!readNativeMappingChoice(*numeric, policy, error))
+    return false;
+  auto scopes = genericResidencyGroups(policy);
+  if (!scopes.empty()) {
+    std::vector<ProgramResidencyGroup> concreteScopes;
+    for (const auto &scope : scopes) {
+      std::map<std::pair<std::string, std::string>, std::vector<size_t>>
+          byOwner;
+      for (size_t task : scope.tasks) {
+        if (task >= choices.size())
+          return reject(error, "stale residency task index");
+        byOwner[{choices[task].resource, choices[task].memory}].push_back(task);
+      }
+      for (const auto &[owner, tasks] : byOwner) {
+        ProgramResidencyGroup concrete;
+        concrete.tasks = tasks;
+        for (size_t storage : scope.retainedStorages) {
+          if (storage >= original.storages.size())
+            return reject(error, "stale retained storage index");
+          bool touched = false;
+          for (size_t task : tasks)
+            for (const auto &access : original.tasks[task].accesses)
+              touched |= access.storage == storage;
+          if (touched)
+            concrete.retainedStorages.push_back(storage);
+        }
+        if (concrete.retainedStorages.empty())
+          continue;
+        if (tasks.size() < 2)
+          return reject(error, "retained source scope separates "
+                               "producer/consumer across physical cores");
+        concreteScopes.push_back(std::move(concrete));
+      }
+    }
+    std::stable_sort(concreteScopes.begin(), concreteScopes.end(),
+                     [](const auto &a, const auto &b) {
+                       return a.tasks.front() < b.tasks.front();
+                     });
+    policy.taskGroup.clear();
+    policy.retainedStorages.clear();
+    policy.residencyGroups = std::move(concreteScopes);
+    if (!setNativeMappingChoice(*numeric, policy, error))
+      return false;
+  }
+  GenericAnalysis source;
+  GenericMappingPlan native;
+  if (!analyzeGenericProgram(*numeric, source, error) ||
+      !planGenericMapping(source, config, native, error) ||
+      !checkGenericMapping(source, native, error))
+    return false;
+  if (source.tasks.size() != original.tasks.size() ||
+      source.storages.size() != original.storages.size())
+    return reject(error, "numeric clone changed source identities");
+  for (const auto &implementation : native.taskImplementations) {
+    auto &choice = choices[implementation.task];
+    if (!choice.implementation.empty() &&
+        choice.implementation != implementation.kind)
+      return reject(error, "physical placement conflicts with the selected "
+                           "native implementation");
+    choice.implementation = implementation.kind;
+  }
+  for (const auto &scope : native.residencyScopes) {
+    std::string memory;
+    for (auto task : scope.tasks) {
+      if (memory.empty())
+        memory = choices[task].memory;
+      if (memory != choices[task].memory)
+        return reject(error, "one explicitly retained local scope cannot "
+                             "reside on different physical cores");
+    }
+  }
+  const auto &reference = native.communication;
+  ProgramGraph graph = reference;
+  graph.source = original;
+  graph.bodyFingerprint = original.bodyFingerprint;
+  graph.targetIdentity = staticFingerprint(serializeMemoryArchitecture(target));
+  graph.domains = target.domains;
+  graph.resources = target.resources;
+  graph.memories = target.memories;
+  graph.links = target.links;
+  graph.placements = choices;
+  graph.schedule = {};
+  graph.schedule.policy = "dependency-order-witness";
+  graph.events.clear();
+  graph.instances.clear();
+  graph.dataEdges.clear();
+  graph.orderEdges.clear();
+  graph.executionGroups.clear();
+  graph.executionRegions.clear();
+  graph.regionEvents.clear();
+  graph.allocations.clear();
+  graph.computeEstimates.clear();
+  graph.estimatedMakespanMs.reset();
+  graph.peakMemoryBytes.clear();
+  graph.transferBytes = 0;
+  graph.inputLocations.clear();
+  graph.outputLocations.clear();
+  std::vector<std::string> copyMemory(reference.copies.size());
+  auto bind = [&](size_t copy, const std::string &memory) {
+    if (!copyMemory[copy].empty() && copyMemory[copy] != memory)
+      return reject(error, "one retained local copy is demanded by different "
+                           "physical cores without a transfer");
+    copyMemory[copy] = memory;
+    return true;
+  };
+  for (const auto &event : reference.events)
+    if (event.kind != "transfer")
+      for (const auto *copies : {&event.reads, &event.writes})
+        for (auto copy : *copies)
+          if (reference.allocations[reference.copies[copy].allocation].memory ==
+                  native.memoryBinding.localMemory &&
+              !bind(copy, choices[event.task].memory))
+            return false;
+  for (size_t copy = 0; copy < reference.copies.size(); ++copy) {
+    const auto &value = reference.copies[copy];
+    const auto &allocation = reference.allocations[value.allocation];
+    if (allocation.memory == native.memoryBinding.hostMemory) {
+      const auto &storage = original.storages[allocation.storage];
+      auto input = target.assumptions.initialLocations.find(storage.id),
+           output = target.assumptions.outputLocations.find(storage.id);
+      if (input != target.assumptions.initialLocations.end() &&
+          output != target.assumptions.outputLocations.end() &&
+          input->second != output->second)
+        return reject(error, "one host root cannot bind different input/output "
+                             "physical memories");
+      if (input != target.assumptions.initialLocations.end())
+        copyMemory[copy] = input->second;
+      else if (output != target.assumptions.outputLocations.end())
+        copyMemory[copy] = output->second;
+      else {
+        const StaticMemory *host = nullptr;
+        for (const auto &memory : target.memories)
+          if (memory.kind == "system-bo") {
+            if (host)
+              return reject(
+                  error,
+                  "private host cut buffer needs an unambiguous BO memory");
+            host = &memory;
+          }
+        if (!host)
+          return reject(error, "host cut buffer has no physical BO memory");
+        copyMemory[copy] = host->id;
+      }
+    }
+    if (copyMemory[copy].empty())
+      return reject(error, "local copy lacks an actual source-instance owner");
+  }
+  std::map<std::pair<size_t, std::string>, size_t> allocationMap;
+  graph.copies = reference.copies;
+  for (size_t copy = 0; copy < reference.copies.size(); ++copy) {
+    auto key =
+        std::make_pair(reference.copies[copy].allocation, copyMemory[copy]);
+    auto [it, inserted] = allocationMap.emplace(key, graph.allocations.size());
+    if (inserted) {
+      auto allocation = reference.allocations[key.first];
+      allocation.memory = key.second;
+      auto *memory = programMemory(target, allocation.memory);
+      if (!memory)
+        return reject(error, "actual copy memory is absent");
+      allocation.spatialOwner = memory->domain;
+      allocation.key += ".physical." + allocation.memory;
+      int64_t alignment = memory->alignmentBytes;
+      if (alignment < 1 || allocation.bytes > INT64_MAX - (alignment - 1))
+        return reject(error, "physical allocation alignment overflows");
+      allocation.bytes =
+          ((allocation.bytes + alignment - 1) / alignment) * alignment;
+      graph.allocations.push_back(std::move(allocation));
+    }
+    auto &value = graph.copies[copy];
+    value.allocation = it->second;
+    value.users.clear();
+    value.lastUsers.clear();
+    value.consumerEdges.clear();
+  }
+  std::vector<std::vector<size_t>> eventMap(reference.events.size());
+  std::vector<size_t> boundary(reference.events.size() + 1);
+  std::vector<std::string> eventOwners;
+  auto owner = [&](size_t copy) -> std::string {
+    auto *memory = programMemory(target, copyMemory[copy]);
+    return memory->kind == "system-bo" ? std::string{} : memory->domain;
+  };
+  auto append = [&](MappingEvent event, size_t old,
+                    const std::string &actualOwner) {
+    event.dependencies.clear();
+    event.dataEdges.clear();
+    event.orderEdges.clear();
+    for (auto parent : reference.events[old].dependencies)
+      for (auto mapped : eventMap[parent])
+        event.dependencies.push_back(mapped);
+    for (auto copy : event.reads)
+      if (graph.copies[copy].createdBy >= 0)
+        event.dependencies.push_back(graph.copies[copy].createdBy);
+    canonical(event.dependencies);
+    size_t index = graph.events.size();
+    graph.events.push_back(std::move(event));
+    eventOwners.push_back(actualOwner);
+    eventMap[old].push_back(index);
+    for (auto copy : graph.events.back().writes) {
+      graph.copies[copy].createdBy = index;
+      graph.copies[copy].availableFrom = index;
+    }
+    return index;
+  };
+  std::vector<size_t> instanceAt(reference.events.size(), SIZE_MAX);
+  for (size_t i = 0; i < reference.instances.size(); ++i)
+    instanceAt[reference.instances[i].event] = i;
+  for (size_t old = 0; old < reference.events.size(); ++old) {
+    boundary[old] = graph.events.size();
+    const auto &event = reference.events[old];
+    if (event.kind == "transfer") {
+      for (auto targetCopy : event.writes) {
+        const auto &targetValue = reference.copies[targetCopy];
+        auto input =
+            std::find_if(event.reads.begin(), event.reads.end(), [&](size_t c) {
+              return reference.copies[c].version == targetValue.version;
+            });
+        if (input == event.reads.end())
+          return reject(error,
+                        "native DMA cell lacks its actual source version");
+        const StaticTransfer *selected = nullptr;
+        for (const auto &link : target.links)
+          if (link.source == copyMemory[*input] &&
+              link.target == copyMemory[targetCopy]) {
+            if (selected)
+              return reject(error, "physical DMA route is ambiguous");
+            selected = &link;
+          }
+        if (!selected)
+          return reject(error, "native transfer has no actual physical route");
+        auto mapped = event;
+        mapped.reads = {*input};
+        mapped.writes = {targetCopy};
+        mapped.link = selected->id;
+        mapped.resource = selected->resource;
+        mapped.memory = selected->target;
+        mapped.transferRegion =
+            reference.regions[reference.versions[targetValue.version].region];
+        auto type = mlir::cast<mlir::MemRefType>(
+            original.storages[mapped.transferRegion->storage].root.getType());
+        int64_t bytes = (type.getElementType().getIntOrFloatBitWidth() + 7) / 8;
+        for (auto size : mapped.transferRegion->sizes) {
+          if (size < 1 || bytes > INT64_MAX / size)
+            return reject(error, "DMA cell size overflows");
+          bytes *= size;
+        }
+        mapped.transferBytes = bytes;
+        std::string actualOwner = owner(targetCopy);
+        if (actualOwner.empty())
+          actualOwner = owner(*input);
+        append(std::move(mapped), old, actualOwner);
+        if (graph.transferBytes > INT64_MAX - bytes)
+          return reject(error, "DMA traffic overflows");
+        graph.transferBytes += bytes;
+      }
+    } else {
+      if (instanceAt[old] == SIZE_MAX)
+        return reject(error, "native compute lacks a source instance");
+      auto mapped = event;
+      mapped.resource = choices[event.task].resource;
+      mapped.memory = choices[event.task].memory;
+      auto *resource = programResource(target, mapped.resource);
+      if (!resource)
+        return reject(error, "physical compute resource is absent");
+      size_t index = append(std::move(mapped), old, resource->domain);
+      auto instance = reference.instances[instanceAt[old]];
+      instance.event = index;
+      instance.resourceCount = choices[event.task].resourceCount;
+      instance.resourceShape = choices[event.task].resourceShape;
+      graph.instances.push_back(instance);
+    }
+  }
+  boundary.back() = graph.events.size();
+  for (auto &version : graph.versions)
+    if (version.producer >= 0) {
+      const auto &events = eventMap[version.producer];
+      if (events.size() != 1)
+        return reject(
+            error,
+            "source version producer is not one actual compute instance");
+      version.producer = events.front();
+    }
+  for (const auto &edge : reference.dataEdges) {
+    auto value = edge;
+    value.requirement.memory =
+        graph.allocations[graph.copies[value.copy].allocation].memory;
+    value.producer = graph.versions[value.version].producer;
+    if (eventMap[edge.consumer].size() != 1)
+      return reject(error,
+                    "data consumer is not one actual source compute instance");
+    value.consumer = eventMap[edge.consumer].front();
+    size_t index = graph.dataEdges.size();
+    graph.dataEdges.push_back(value);
+    graph.events[value.consumer].dataEdges.push_back(index);
+    graph.copies[value.copy].consumerEdges.push_back(index);
+  }
+  for (const auto &edge : reference.orderEdges)
+    for (auto from : eventMap[edge.producer])
+      for (auto to : eventMap[edge.consumer]) {
+        size_t index = graph.orderEdges.size();
+        graph.orderEdges.push_back({from, to, edge.reason});
+        graph.events[to].orderEdges.push_back(index);
+        graph.events[to].dependencies.push_back(from);
+      }
+  for (size_t event = 0; event < graph.events.size(); ++event) {
+    canonical(graph.events[event].dependencies);
+    for (auto copy : graph.events[event].reads)
+      graph.copies[copy].users.push_back(event);
+  }
+  for (size_t copy = 0; copy < graph.copies.size(); ++copy) {
+    auto &value = graph.copies[copy];
+    value.releasedAfter = boundary[reference.copies[copy].releasedAfter];
+    if (value.createdBy < 0)
+      value.availableFrom = 0;
+    if (!value.users.empty())
+      value.lastUsers = {value.users.back()};
+  }
+  // Preserve native scope membership, refining its physical realization into
+  // actual topological segments. An owner can appear again later (A -> B -> A)
+  // without inventing a cyclic coarse owner-group dependency. Transfers can
+  // form their own segments; these groups are not executable invocations.
+  std::vector<size_t> oldGroupAt(reference.events.size(), SIZE_MAX);
+  for (size_t group = 0; group < reference.executionGroups.size(); ++group)
+    for (size_t event : reference.executionGroups[group].memberEvents)
+      oldGroupAt[event] = group;
+  std::vector<size_t> projectedOldGroup(graph.events.size(), SIZE_MAX);
+  for (size_t old = 0; old < eventMap.size(); ++old)
+    for (size_t event : eventMap[old])
+      projectedOldGroup[event] = oldGroupAt[old];
+  std::vector<size_t> eventGroup(graph.events.size(), SIZE_MAX);
+  size_t previousOldGroup = SIZE_MAX;
+  for (size_t event = 0; event < graph.events.size(); ++event) {
+    const auto &value = graph.events[event];
+    std::string resource, memory;
+    if (value.kind != "transfer") {
+      resource = value.resource;
+      memory = value.memory;
+    } else {
+      for (const auto &choice : choices) {
+        auto *candidate = programResource(target, choice.resource);
+        if (candidate && candidate->domain == eventOwners[event]) {
+          resource = choice.resource;
+          memory = choice.memory;
+          break;
+        }
+      }
+    }
+    if (resource.empty())
+      return reject(error,
+                    "physical event segment has no actual compute owner");
+    bool split =
+        graph.executionGroups.empty() ||
+        projectedOldGroup[event] != previousOldGroup ||
+        graph.executionGroups.back().spatialOwner != eventOwners[event] ||
+        graph.executionGroups.back().resource != resource ||
+        graph.executionGroups.back().memory != memory;
+    if (split) {
+      ProgramExecutionGroup group;
+      group.beginPhase = value.phase;
+      group.endPhase = value.phase + 1;
+      group.resource = resource;
+      group.memory = memory;
+      group.spatialOwner = eventOwners[event];
+      graph.executionGroups.push_back(std::move(group));
+    }
+    auto &group = graph.executionGroups.back();
+    group.memberEvents.push_back(event);
+    group.beginPhase = std::min(group.beginPhase, value.phase);
+    group.endPhase = std::max(group.endPhase, value.phase + 1);
+    eventGroup[event] = graph.executionGroups.size() - 1;
+    previousOldGroup = projectedOldGroup[event];
+  }
+  for (size_t event = 0; event < graph.events.size(); ++event)
+    for (size_t parent : graph.events[event].dependencies) {
+      size_t from = eventGroup[parent], to = eventGroup[event];
+      if (from == to)
+        continue;
+      bool semantic = false;
+      for (size_t edge : graph.events[event].dataEdges)
+        semantic |= graph.dataEdges[edge].producer == int64_t(parent);
+      for (size_t edge : graph.events[event].orderEdges)
+        semantic |= graph.orderEdges[edge].producer == parent;
+      auto &parents =
+          semantic ? graph.executionGroups[to].dependencies
+                   : graph.executionGroups[to].implementationDependencies;
+      parents.push_back(from);
+    }
+  for (auto &group : graph.executionGroups) {
+    canonical(group.dependencies);
+    canonical(group.implementationDependencies);
+  }
+  for (const auto &[storage, memory] : reference.inputLocations) {
+    auto found = std::find_if(
+        reference.copies.begin(), reference.copies.end(),
+        [&](const auto &copy) {
+          return copy.createdBy < 0 &&
+                 reference.regions[reference.versions[copy.version].region]
+                         .storage == storage;
+        });
+    if (found == reference.copies.end())
+      return reject(error, "source input has no actual initial copy");
+    graph.inputLocations[storage] =
+        copyMemory[found - reference.copies.begin()];
+  }
+  for (const auto &[storage, memory] : reference.outputLocations) {
+    auto found =
+        target.assumptions.outputLocations.find(original.storages[storage].id);
+    if (found == target.assumptions.outputLocations.end())
+      return reject(error, "source output has no physical boundary memory");
+    graph.outputLocations[storage] = found->second;
+  }
+  MappingExecutionRegion host;
+  host.id = "unbound-physical-native";
+  host.placement = "host";
+  host.endEvent = graph.events.size();
+  host.submissionCount = 0;
+  graph.executionRegions = {host};
+  if (!refreshProgramGraphSchedule(graph, error) ||
+      !checkProgramGraph(graph, error))
+    return false;
+  out = std::move(graph);
+  return true;
+}
