+#include "Taskflow/GenericAnalysis.h"
+#include "Taskflow/GenericMapping.h"
+#include "Taskflow/TaskflowFission.h"
+#include "Taskflow/TaskflowSourceNormalization.h"
+#include "Taskflow/TaskflowTiling.h"
+#include "TaskflowDialect/TaskflowDialect.h"
+#include "mlir/Dialect/Affine/IR/AffineOps.h"
+#include "mlir/Dialect/Arith/IR/Arith.h"
+#include "mlir/Dialect/Func/IR/FuncOps.h"
+#include "mlir/Dialect/MemRef/IR/MemRef.h"
+#include "mlir/Dialect/SCF/IR/SCF.h"
+#include "mlir/IR/Builders.h"
+#include "mlir/IR/Diagnostics.h"
+#include "mlir/IR/Verifier.h"
+#include "mlir/Parser/Parser.h"
+#include "llvm/Support/raw_ostream.h"
+using namespace mlir;
+using namespace orbit::taskflow;
+int main(int argc, char **argv) {
+  if (argc != 3)
+    return 2;
+  DialectRegistry registry;
+  registry.insert<taskflow::TaskflowDialect, affine::AffineDialect,
+                  arith::ArithDialect, func::FuncDialect, memref::MemRefDialect,
+                  scf::SCFDialect>();
+  MLIRContext context(registry);
+  auto parent = parseSourceFile<ModuleOp>(argv[1], &context);
+  if (!parent)
+    return 3;
+  std::string error;
+  auto check = [&](ModuleOp source, size_t tasks) {
+    OwningOpRef<ModuleOp> normalized;
+    TaskflowSourceNormalizationWitness witness;
+    if (failed(normalizeTaskflowSource(source, normalized, witness, error)) ||
+        failed(verifyTaskflowSourceNormalization(source, *normalized, witness,
+                                                 error)))
+      return false;
+    GenericAnalysis analysis;
+    if (!analyzeGenericProgram(*normalized, analysis, error) ||
+        analysis.tasks.size() != tasks || witness.normalizedTasks != tasks ||
+        witness.normalizedCounters != tasks * 2)
+      return false;
+    for (const auto &task : analysis.tasks)
+      if (task.loops.size() != 2)
+        return false;
+    // A forged certificate and a mutated physical module are independent
+    // failures; a matching producer-supplied digest is never sufficient.
+    auto forged = witness;
+    ++forged.normalizedTasks;
+    if (succeeded(verifyTaskflowSourceNormalization(source, *normalized, forged,
+                                                    error)))
+      return false;
+    if (tasks == 3) {
+      // Disjoint partial writers share one resident allocation by logical
+      // region. They must not be modeled as a single repeatedly overwritten
+      // physical slot; the final export consumes all three output regions.
+      GenericMappingPlan mapping;
+      llvm::json::Value target = llvm::json::Object{
+          {"generic_air", llvm::json::Object{{"capacity_bytes", 24576}}}};
+      if (!planGenericMapping(analysis, target, mapping, error) ||
+          !checkGenericMapping(analysis, mapping, error))
+        return false;
+      auto forgedMapping = mapping;
+      bool forgedAllocation = false;
+      for (auto &allocation : forgedMapping.communication.allocations)
+        if (allocation.memory == mapping.memoryBinding.localMemory &&
+            analysis.storages[allocation.storage].role == "output") {
+          allocation.addressing = "reusable-slot";
+          forgedAllocation = true;
+        }
+      if (!forgedAllocation ||
+          checkGenericMapping(analysis, forgedMapping, error))
+        return false;
+      // Returning a different same-typed input handle must not authenticate
+      // an output completion just because the indexed stores are correct.
+      auto badYield = normalized->clone();
+      bool forgedYield = false;
+      badYield.walk([&](taskflow::TaskflowTaskOp task) {
+        if (!forgedYield) {
+          auto yield = cast<taskflow::TaskflowYieldOp>(
+              task.getBody().front().getTerminator());
+          yield.getDoneWritesMutable().slice(0, 1).assign(
+              task.getBody().front().getArgument(0));
+          forgedYield = true;
+        }
+      });
+      {
+        ScopedDiagnosticHandler diagnostics(
+            &context, [](Diagnostic &) { return success(); });
+        if (!forgedYield || succeeded(verify(badYield)))
+          return false;
+      }
+      badYield.erase();
+      // Preserve a compatible cast of the actual output handle. Storage
+      // identity, rather than literal SSA equality, is the required invariant.
+      auto castYield = normalized->clone();
+      castYield.walk([&](taskflow::TaskflowTaskOp task) {
+        auto yield = cast<taskflow::TaskflowYieldOp>(
+            task.getBody().front().getTerminator());
+        Value output =
+            task.getBody().front().getArgument(task.getWillReads().size());
+        OpBuilder builder(yield);
+        auto alias = builder.create<memref::CastOp>(task.getLoc(),
+                                                    output.getType(), output);
+        yield.getDoneWritesMutable().slice(0, 1).assign(alias.getResult());
+      });
+      if (failed(verify(castYield)))
+        return false;
+      castYield.erase();
+      // Coordinate forgery invalidates the normalized join independently of
+      // the replay witness. Change an actual store index, not metadata.
+      auto badIndex = normalized->clone();
+      bool changed = false;
+      badIndex.walk([&](memref::StoreOp store) {
+        if (!changed) {
+          store.getIndicesMutable().slice(0, 1).assign(store.getIndices()[1]);
+          changed = true;
+        }
+      });
+      {
+        ScopedDiagnosticHandler diagnostics(
+            &context, [](Diagnostic &) { return success(); });
+        if (!changed || succeeded(verify(badIndex)))
+          return false;
+      }
+      badIndex.erase();
+    }
+    normalized.get()->setAttr("orbit.mutated", UnitAttr::get(&context));
+    if (succeeded(verifyTaskflowSourceNormalization(source, *normalized,
+                                                    witness, error)))
+      return false;
+    return true;
+  };
+  if (!check(*parent, 1)) {
+    llvm::errs() << error;
+    return 4;
+  }
+  auto tiled = parent->clone();
+  if (failed(materializeTaskflowTiling(tiled, {"pointwise", "Pointwise", 0, 3},
+                                       error)) ||
+      !check(tiled, 3)) {
+    llvm::errs() << error;
+    return 5;
+  }
+  tiled.erase();
+  auto split = parent->clone();
+  if (failed(materializeTaskflowFission(split, "pointwise", "Pointwise", {0, 1},
+                                        error)) ||
+      !check(split, 2)) {
+    llvm::errs() << error;
+    return 6;
+  }
+  split.erase();
+  auto recurrence = parseSourceFile<ModuleOp>(argv[2], &context);
+  if (!recurrence)
+    return 7;
+  OwningOpRef<ModuleOp> recurrentPhysical;
+  TaskflowSourceNormalizationWitness witness;
+  if (failed(normalizeTaskflowSource(*recurrence, recurrentPhysical, witness,
+                                     error)) ||
+      failed(verifyTaskflowSourceNormalization(*recurrence, *recurrentPhysical,
+                                               witness, error))) {
+    llvm::errs() << error;
+    return 8;
+  }
+  unsigned carriedLoops = 0;
+  recurrentPhysical->walk([&](scf::ForOp loop) {
+    if (loop.getNumRegionIterArgs() == 1) {
+      auto yield = cast<scf::YieldOp>(loop.getBody()->getTerminator());
+      auto next = yield.getOperand(0).getDefiningOp<arith::AddIOp>();
+      if (next && next.getLhs() == loop.getRegionIterArgs().front())
+        ++carriedLoops;
+    }
+  });
+  if (carriedLoops != 1)
+    return 9;
+  // A real shared recurrence cannot cross a cut. Once an independent branch
+  // uses only the original loaded input, the complete recurrence SCC may stay
+  // in the prefix while its ordinary data output crosses to the suffix.
+  auto legalCycle = recurrence->clone();
+  legalCycle.walk([&](arith::MulIOp product) {
+    memref::LoadOp load;
+    product->getParentOp()->walk([&](memref::LoadOp found) { load = found; });
+    product.getLhsMutable().assign(load.getResult());
+    product.getRhsMutable().assign(load.getResult());
+  });
+  auto cycleParent = legalCycle.clone();
+  const std::vector<TaskflowFissionAction> cycleActions{
+      {"cycle", "Cycle", {0, 1, 2}}};
+  if (succeeded(materializeTaskflowFission(*recurrence, "cycle", "Cycle",
+                                           {0, 1, 2}, error)) ||
+      failed(materializeTaskflowFission(legalCycle, "cycle", "Cycle", {0, 1, 2},
+                                        error)) ||
+      failed(verifyTaskflowFissionReplay(cycleParent, legalCycle, cycleActions,
+                                         error))) {
+    llvm::errs() << error;
+    return 10;
+  }
+  OwningOpRef<ModuleOp> splitPhysical;
+  if (failed(
+          normalizeTaskflowSource(legalCycle, splitPhysical, witness, error)))
+    return 11;
+  cycleParent.erase();
+  legalCycle.erase();
+  const char *dynamicText = R"mlir(
+module {
+ func.func @dynamic(%a: memref<?xi32>, %b: memref<?xi32>, %n: index) {
+  %out = taskflow.task @Dynamic will_reads(%a : memref<?xi32>)
+    will_writes(%b : memref<?xi32>) value_inputs(%n : index)
+    [original_read_memrefs(%a : memref<?xi32>), original_write_memrefs(%b : memref<?xi32>)]
+    : (memref<?xi32>, memref<?xi32>, index) -> memref<?xi32> {
+   ^bb0(%read: memref<?xi32>, %write: memref<?xi32>, %limit: index):
+    %zero = arith.constant 0 : index
+    %one = arith.constant 1 : index
+    %i = taskflow.counter from %zero to %limit step %one : index
+    "taskflow.hyperblock"(%i) <{operandSegmentSizes = array<i32: 1, 0>}> ({
+     ^bb0(%index: index):
+      %value = memref.load %read[%index] : memref<?xi32>
+      %positive = arith.cmpi sgt, %index, %zero : index
+      scf.if %positive {
+        memref.store %value, %write[%index] : memref<?xi32>
+      }
+      "taskflow.hyperblock.yield"() : () -> ()
+    }) : (index) -> ()
+    taskflow.yield done_writes(%write : memref<?xi32>)
+  }
+  return
+ }
+})mlir";
+  auto dynamic = parseSourceString<ModuleOp>(dynamicText, &context);
+  OwningOpRef<ModuleOp> dynamicPhysical;
+  if (!dynamic ||
+      failed(
+          normalizeTaskflowSource(*dynamic, dynamicPhysical, witness, error)) ||
+      failed(verifyTaskflowSourceNormalization(*dynamic, *dynamicPhysical,
+                                               witness, error))) {
+    llvm::errs() << error;
+    return 12;
+  }
+  unsigned dynamicLoops = 0, conditionals = 0;
+  dynamicPhysical->walk([&](scf::ForOp loop) {
+    auto task = loop->getParentOfType<taskflow::TaskflowTaskOp>();
+    if (loop.getUpperBound() == task.getBody().front().getArgument(2))
+      ++dynamicLoops;
+  });
+  dynamicPhysical->walk([&](scf::IfOp) { ++conditionals; });
+  if (dynamicLoops != 1 || conditionals != 1)
+    return 13;
+  dynamic->walk([&](taskflow::TaskflowCounterOp counter) {
+    auto task = counter->getParentOfType<taskflow::TaskflowTaskOp>();
+    counter.getStepMutable().assign(task.getBody().front().getArgument(2));
+  });
+  OwningOpRef<ModuleOp> rejected;
+  if (succeeded(normalizeTaskflowSource(*dynamic, rejected, witness, error)) ||
+      rejected)
+    return 14;
+  llvm::outs()
+      << "source normalization, generic analysis and replay checks passed\n";
+  return 0;
+}
diff --git a/test/TaskflowGeneric/taskflow-source-replica.cpp b/test/TaskflowGeneric/taskflow-source-replica.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..370eccd16700f17d0d2d566cb91faf4022a971f2
--- /dev/null
+++ b/test/TaskflowGeneric/taskflow-source-replica.cpp
@@ -0,0 +1,222 @@
+// Independent source partition proof, not evidence of physical concurrency.
+#include "Taskflow/GenericAnalysis.h"
+#include "Taskflow/TaskflowFission.h"
+#include "Taskflow/TaskflowReplica.h"
+#include "Taskflow/TaskflowSourceNormalization.h"
+#include "TaskflowDialect/TaskflowDialect.h"
+#include "TaskflowDialect/TaskflowOps.h"
+#include "mlir/Dialect/Affine/IR/AffineOps.h"
+#include "mlir/Dialect/Arith/IR/Arith.h"
+#include "mlir/Dialect/Func/IR/FuncOps.h"
+#include "mlir/Dialect/MemRef/IR/MemRef.h"
+#include "mlir/IR/Builders.h"
+#include "mlir/IR/IRMapping.h"
+#include "mlir/IR/Verifier.h"
+#include "mlir/Parser/Parser.h"
+#include "llvm/Support/raw_ostream.h"
+#include <set>
+using namespace mlir;
+using namespace orbit::taskflow;
+int main(int argc, char **argv) {
+  if (argc != 2)
+    return 2;
+  DialectRegistry registry;
+  registry
+      .insert<taskflow::TaskflowDialect, affine::AffineDialect,
+              arith::ArithDialect, func::FuncDialect, memref::MemRefDialect>();
+  MLIRContext context(registry);
+  auto source = parseSourceFile<ModuleOp>(argv[1], &context);
+  if (!source)
+    return 3;
+  std::string error;
+  for (int64_t count : {3, 5, 6, 9}) {
+    auto candidate = source->clone();
+    TaskflowReplicaAction action{"pointwise", "Pointwise", 0, count};
+    if (failed(materializeTaskflowReplicas(candidate, action, error)) ||
+        !hasTaskflowReplicaGroups(candidate) ||
+        failed(
+            verifyTaskflowReplicaReplay(*source, candidate, {action}, error))) {
+      llvm::errs() << error;
+      return 4;
+    }
+    std::set<int64_t> instances;
+    bool valid = true;
+    candidate.walk([&](taskflow::TaskflowTaskOp task) {
+      auto group = task->getAttrOfType<StringAttr>("orbit.replica.group");
+      auto ordinal = task->getAttrOfType<IntegerAttr>("orbit.replica.instance");
+      auto declared = task->getAttrOfType<IntegerAttr>("orbit.replica.count");
+      valid &= group && group.getValue() == "pointwise/Pointwise" && ordinal &&
+               declared && declared.getInt() == count &&
+               instances.insert(ordinal.getInt()).second &&
+               task->hasAttr("orbit.replica.requires_independent_resources");
+    });
+    if (!valid || instances.size() != static_cast<size_t>(count))
+      return 5;
+    OwningOpRef<ModuleOp> physical;
+    TaskflowSourceNormalizationWitness witness;
+    GenericAnalysis analysis;
+    if (failed(normalizeTaskflowSource(candidate, physical, witness, error)) ||
+        !hasTaskflowReplicaGroups(*physical) ||
+        !analyzeGenericProgram(*physical, analysis, error)) {
+      llvm::errs() << error;
+      return 6;
+    }
+    int64_t iterations = 0;
+    for (const auto &task : analysis.tasks) {
+      int64_t work = 1;
+      for (const auto &loop : task.loops)
+        work *= loop.upper - loop.lower;
+      iterations += work;
+    }
+    if (iterations != 150)
+      return 7;
+    bool changed = false;
+    candidate.walk([&](taskflow::TaskflowTaskOp task) {
+      if (!changed) {
+        task->setAttr("orbit.replica.count",
+                      IntegerAttr::get(IntegerType::get(&context, 64), 99));
+        changed = true;
+      }
+    });
+    if (succeeded(
+            verifyTaskflowReplicaReplay(*source, candidate, {action}, error)))
+      return 8;
+    candidate.erase();
+  }
+  // An independent partition within an instance creates child ownership
+  // domains. It never overwrites the original outer group/count/instance.
+  OwningOpRef<ModuleOp> nested = source->clone();
+  const std::vector<TaskflowReplicaAction> nestedActions{
+      {"pointwise", "Pointwise", 0, 3},
+      {"pointwise", "Pointwise.replica.0.0", 1, 2}};
+  for (const auto &action : nestedActions)
+    if (failed(materializeTaskflowReplicas(*nested, action, error)))
+      return 15;
+  if (failed(
+          verifyTaskflowReplicaReplay(*source, *nested, nestedActions, error)))
+    return 16;
+  unsigned inner = 0, outer = 0;
+  bool hierarchy = true;
+  nested->walk([&](taskflow::TaskflowTaskOp task) {
+    std::vector<TaskflowReplicaLevel> levels;
+    hierarchy &= succeeded(readTaskflowReplicaHierarchy(task, levels, error)) &&
+                 !levels.empty();
+    if (levels.empty())
+      return;
+    hierarchy &= levels.front().owner == "pointwise/Pointwise" &&
+                 levels.front().count == 3;
+    if (levels.size() == 2) {
+      ++inner;
+      hierarchy &= levels.front().instance == 0 && levels.back().count == 2 &&
+                   levels.back().owner == "pointwise/Pointwise.replica.0.0";
+    } else
+      ++outer;
+  });
+  if (!hierarchy || inner != 2 || outer != 2)
+    return 17;
+  // Checking the parent alone must authenticate its nested child's actual
+  // leaves. Region attrs are not a certificate of the claimed child cover.
+  auto forgedCoverage = nested->clone();
+  taskflow::TaskflowJoinOp outerJoin, innerJoin;
+  forgedCoverage.walk([&](taskflow::TaskflowJoinOp join) {
+    for (Value state : join.getTileStates())
+      if (auto inner = state.getDefiningOp<taskflow::TaskflowJoinOp>()) {
+        outerJoin = join;
+        innerJoin = inner;
+      }
+  });
+  if (!outerJoin || !innerJoin || failed(outerJoin.verify()))
+    return 21;
+  auto childUpper = SmallVector<int64_t>(innerJoin.getRegionUpper());
+  --childUpper[innerJoin.getAxis()];
+  innerJoin->setAttr("region_upper",
+                     DenseI64ArrayAttr::get(&context, childUpper));
+  if (succeeded(outerJoin.verify()))
+    return 22;
+  forgedCoverage.erase();
+  auto beforeSplit = nested->clone();
+  const std::vector<TaskflowFissionAction> nestedCut{
+      {"pointwise", "Pointwise.replica.0.0.replica.1.0", {0}}};
+  if (failed(materializeTaskflowFission(*nested, "pointwise",
+                                        nestedCut.front().task, {0}, error)) ||
+      failed(
+          verifyTaskflowFissionReplay(beforeSplit, *nested, nestedCut, error)))
+    return 18;
+  OwningOpRef<ModuleOp> nestedPhysical;
+  TaskflowSourceNormalizationWitness nestedWitness;
+  if (failed(normalizeTaskflowSource(*nested, nestedPhysical, nestedWitness,
+                                     error)))
+    return 19;
+  bool changedHierarchy = false;
+  nested->walk([&](taskflow::TaskflowTaskOp task) {
+    if (!changedHierarchy && task->hasAttr("orbit.replica.path")) {
+      task->setAttr("orbit.replica.path",
+                    DenseI64ArrayAttr::get(&context, {1, 0}));
+      changedHierarchy = true;
+      hierarchy = failed(validateTaskflowReplicaContract(task, error));
+    }
+  });
+  if (!changedHierarchy || !hierarchy ||
+      succeeded(
+          verifyTaskflowFissionReplay(beforeSplit, *nested, nestedCut, error)))
+    return 20;
+  beforeSplit.erase();
+  // Exact same-coordinate in-place RMW has no cross-iteration dependency.
+  // Bind both execution/provenance operands to one actual function argument;
+  // no second host allocation or speculative no-alias witness is introduced.
+  OwningOpRef<ModuleOp> inplace = source->clone();
+  auto function = inplace->lookupSymbol<func::FuncOp>("pointwise");
+  function.getArgument(1).replaceAllUsesWith(function.getArgument(0));
+  OwningOpRef<ModuleOp> inplaceParent = inplace->clone();
+  const std::vector<TaskflowReplicaAction> inplaceActions{
+      {"pointwise", "Pointwise", 0, 3}};
+  if (failed(materializeTaskflowReplicas(*inplace, inplaceActions.front(),
+                                         error)) ||
+      failed(verifyTaskflowReplicaReplay(*inplaceParent, *inplace,
+                                         inplaceActions, error)))
+    return 11;
+  OwningOpRef<ModuleOp> inplacePhysical;
+  TaskflowSourceNormalizationWitness inplaceWitness;
+  if (failed(normalizeTaskflowSource(*inplace, inplacePhysical, inplaceWitness,
+                                     error)))
+    return 12;
+  auto shifted = inplaceParent->clone();
+  shifted.walk([&](memref::LoadOp load) {
+    load.getIndicesMutable().slice(0, 1).assign(load.getIndices()[1]);
+  });
+  if (succeeded(
+          materializeTaskflowReplicas(shifted, inplaceActions.front(), error)))
+    return 13;
+  shifted.erase();
+  // Public resource schema rejects oversized integer fields before getInt;
+  // malformed external IR must produce a diagnostic, never an assertion.
+  auto wide = inplaceParent->clone();
+  bool wideRejected = true;
+  wide.walk([&](taskflow::TaskflowTaskOp task) {
+    OpBuilder builder(&context);
+    task->setAttr("orbit.replica.group", builder.getStringAttr("wide"));
+    task->setAttr("orbit.replica.instance", builder.getI64IntegerAttr(0));
+    task->setAttr(
+        "orbit.replica.count",
+        IntegerAttr::get(IntegerType::get(&context, 128), APInt(128, 3)));
+    task->setAttr("orbit.replica.requires_independent_resources",
+                  builder.getUnitAttr());
+    wideRejected &= failed(validateTaskflowReplicaContract(task, error));
+  });
+  if (!wideRejected || succeeded(materializeTaskflowReplicas(
+                           wide, inplaceActions.front(), error)))
+    return 14;
+  wide.erase();
+  auto invalid = source->clone();
+  if (succeeded(materializeTaskflowReplicas(
+          invalid, {"pointwise", "Pointwise", 0, 16}, error)))
+    return 9;
+  unsigned tasks = 0;
+  invalid.walk([&](taskflow::TaskflowTaskOp) { ++tasks; });
+  if (tasks != 1 || hasTaskflowReplicaGroups(invalid))
+    return 10;
+  invalid.erase();
+  llvm::outs()
+      << "independent source replica coverage, work and replay checks passed\n";
+  return 0;
+}
diff --git a/test/TaskflowGeneric/taskflow-source-tiling.cpp b/test/TaskflowGeneric/taskflow-source-tiling.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..92db656975c855312906ba05c46fdaeac7997be4
--- /dev/null
+++ b/test/TaskflowGeneric/taskflow-source-tiling.cpp
@@ -0,0 +1,194 @@
+#include "Taskflow/GenericAnalysis.h"
+#include "Taskflow/TaskflowReplica.h"
+#include "Taskflow/TaskflowSourceNormalization.h"
+#include "Taskflow/TaskflowTiling.h"
+#include "TaskflowDialect/TaskflowDialect.h"
+#include "TaskflowDialect/TaskflowOps.h"
+#include "mlir/Dialect/Affine/IR/AffineOps.h"
+#include "mlir/Dialect/Arith/IR/Arith.h"
+#include "mlir/Dialect/Func/IR/FuncOps.h"
+#include "mlir/Dialect/MemRef/IR/MemRef.h"
+#include "mlir/IR/Builders.h"
+#include "mlir/IR/Verifier.h"
+#include "mlir/Parser/Parser.h"
+#include "llvm/Support/raw_ostream.h"
+using namespace mlir;
+using namespace orbit::taskflow;
+static std::string text(ModuleOp module) {
+  std::string bytes;
+  llvm::raw_string_ostream stream(bytes);
+  module.print(stream, OpPrintingFlags().printGenericOpForm());
+  stream.flush();
+  return bytes;
+}
+// Both effects are source outputs: an in-place state update and a distinct
+// ordinary output. Every output must retain its actual child store and join.
+static bool checkMultipleOutputs(MLIRContext &context, std::string &error) {
+  auto source = parseSourceString<ModuleOp>(R"mlir(module {
+  func.func @update(%state: memref<8xf32> {orbit.role="state"},
+                    %output: memref<8xf32> {orbit.role="output"}) attributes {orbit.noalias} {
+    %read, %state_done, %output_done = taskflow.task @Update
+      will_reads(%state : memref<8xf32>)
+      will_writes(%state, %output : memref<8xf32>, memref<8xf32>)
+      [original_read_memrefs(%state : memref<8xf32>),
+       original_write_memrefs(%state, %output : memref<8xf32>, memref<8xf32>)]
+      : (memref<8xf32>, memref<8xf32>, memref<8xf32>) -> (memref<8xf32>, memref<8xf32>, memref<8xf32>) {
+    ^bb0(%input: memref<8xf32>, %state_out: memref<8xf32>, %normal_out: memref<8xf32>):
+      %c0 = arith.constant 0 : index
+      %c1 = arith.constant 1 : index
+      %c8 = arith.constant 8 : index
+      %i = taskflow.counter from %c0 to %c8 step %c1 : index
+      "taskflow.hyperblock"(%i) <{operandSegmentSizes = array<i32: 1, 0>}> ({
+      ^bb0(%index: index):
+        %value = memref.load %input[%index] : memref<8xf32>
+        %one = arith.constant 1.0 : f32
+        %next = arith.addf %value, %one : f32
+        memref.store %next, %state_out[%index] : memref<8xf32>
+        %twice = arith.addf %next, %next : f32
+        memref.store %twice, %normal_out[%index] : memref<8xf32>
+        "taskflow.hyperblock.yield"() : () -> ()
+      }) : (index) -> ()
+      taskflow.yield done_reads(%input : memref<8xf32>)
+        done_writes(%state_out, %normal_out : memref<8xf32>, memref<8xf32>)
+    }
+    %observe = memref.cast %read : memref<8xf32> to memref<8xf32>
+    return
+  }
+})mlir",
+                                            &context);
+  if (!source)
+    return false;
+  for (bool replica : {false, true}) {
+    auto candidate = source->clone();
+    if (failed(replica ? materializeTaskflowReplicas(
+                             candidate, {"update", "Update", 0, 3}, error)
+                       : materializeTaskflowTiling(
+                             candidate, {"update", "Update", 0, 3}, error))) {
+      candidate.erase();
+      return false;
+    }
+    unsigned joins = 0, barriers = 0;
+    candidate.walk([&](taskflow::TaskflowJoinOp) { ++joins; });
+    candidate.walk([&](taskflow::TaskflowReadCompletionJoinOp) { ++barriers; });
+    OwningOpRef<ModuleOp> normalized;
+    TaskflowSourceNormalizationWitness witness;
+    GenericAnalysis analysis;
+    if (joins != 2 || barriers != 1 ||
+        failed(replica
+                   ? verifyTaskflowReplicaReplay(*source, candidate,
+                                                 {{"update", "Update", 0, 3}},
+                                                 error)
+                   : verifyTaskflowTilingReplay(*source, candidate,
+                                                {{"update", "Update", 0, 3}},
+                                                error)) ||
+        failed(
+            normalizeTaskflowSource(candidate, normalized, witness, error)) ||
+        !analyzeGenericProgram(*normalized, analysis, error)) {
+      candidate.erase();
+      return false;
+    }
+    std::vector<int64_t> written(analysis.storages.size());
+    for (const auto &task : analysis.tasks)
+      for (const auto &access : task.accesses)
+        if (access.write && access.exactRegion)
+          written[access.storage] +=
+              access.region.front().upper - access.region.front().lower;
+    if (written.size() != 2 || written[0] != 8 || written[1] != 8) {
+      candidate.erase();
+      return false;
+    }
+    // Optional legacy region witnesses must agree with actual stores even on
+    // the backend-neutral path. They cannot override or bypass that proof.
+    candidate.walk([&](taskflow::TaskflowTaskOp task) {
+      Builder builder(&context);
+      auto wrong = builder.getDenseI64ArrayAttr({7});
+      task->setAttr("amoeba.tiling.output_region_lowers",
+                    builder.getArrayAttr({wrong, wrong}));
+      task->setAttr("amoeba.tiling.output_region_uppers",
+                    builder.getArrayAttr({wrong, wrong}));
+    });
+    if (succeeded(verify(candidate))) {
+      candidate.erase();
+      return false;
+    }
+    candidate.erase();
+  }
+  auto aliasedABI = source->clone();
+  aliasedABI.lookupSymbol<func::FuncOp>("update")->setAttr(
+      "orbit.noalias", BoolAttr::get(&context, false));
+  bool aliasRejected = failed(
+      materializeTaskflowTiling(aliasedABI, {"update", "Update", 0, 3}, error));
+  aliasedABI.erase();
+  if (!aliasRejected)
+    return false;
+  auto malformed = source->clone();
+  malformed.walk([&](taskflow::TaskflowYieldOp yield) {
+    yield.getDoneWritesMutable().slice(1, 1).assign(yield.getDoneWrites()[0]);
+  });
+  bool rejected = failed(
+      materializeTaskflowTiling(malformed, {"update", "Update", 0, 3}, error));
+  malformed.erase();
+  return rejected;
+}
+int main(int argc, char **argv) {
+  if (argc != 2)
+    return 2;
+  DialectRegistry registry;
+  registry
+      .insert<taskflow::TaskflowDialect, affine::AffineDialect,
+              arith::ArithDialect, func::FuncDialect, memref::MemRefDialect>();
+  MLIRContext context(registry);
+  auto parent = parseSourceFile<ModuleOp>(argv[1], &context);
+  if (!parent || failed(verify(*parent)))
+    return 3;
+  std::string error;
+  for (int64_t factor : {3, 5, 6, 9}) {
+    auto candidate = parent->clone();
+    TaskflowTilingAction action{"pointwise", "Pointwise", 0, factor};
+    if (failed(materializeTaskflowTiling(candidate, action, error)) ||
+        failed(
+            verifyTaskflowTilingReplay(*parent, candidate, {action}, error))) {
+      llvm::errs() << error;
+      return 4;
+    }
+    unsigned count = 0;
+    candidate.walk([&](taskflow::TaskflowTaskOp) { ++count; });
+    if (count != static_cast<unsigned>(factor))
+      return 5;
+    candidate.erase();
+  }
+  auto candidate = parent->clone();
+  SmallVector<TaskflowTilingAction> actions = {
+      {"pointwise", "Pointwise", 0, 3},
+      {"pointwise", "Pointwise.tile.0.0", 1, 5}};
+  for (const auto &action : actions)
+    if (failed(materializeTaskflowTiling(candidate, action, error)))
+      return 6;
+  if (failed(verifyTaskflowTilingReplay(*parent, candidate, actions, error)))
+    return 7;
+  candidate->setAttr("orbit.forged", UnitAttr::get(&context));
+  if (succeeded(verifyTaskflowTilingReplay(*parent, candidate, actions, error)))
+    return 8;
+  candidate.erase();
+
+  // Output feedback is not an independent interval partition. Rejection must
+  // happen without mutating the caller's module, even when it verifies as IR.
+  auto feedback = parent->clone();
+  feedback.walk([&](memref::LoadOp load) {
+    auto task = load->getParentOfType<taskflow::TaskflowTaskOp>();
+    load.getMemrefMutable().assign(task.getBody().front().getArgument(1));
+  });
+  auto before = text(feedback);
+  if (succeeded(materializeTaskflowTiling(
+          feedback, {"pointwise", "Pointwise", 0, 3}, error)) ||
+      text(feedback) != before)
+    return 9;
+  feedback.erase();
+  if (!checkMultipleOutputs(context, error)) {
+    llvm::errs() << "multi-output coverage: " << error;
+    return 10;
+  }
+  llvm::outs()
+      << "public source tiling factors, replay and feedback checks passed\n";
+  return 0;
+}
diff --git a/test/TaskflowGeneric/taskflow-specialization.cpp b/test/TaskflowGeneric/taskflow-specialization.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..b3001c217c6f4d85cf7c0d45af71539b164f79ad
--- /dev/null
+++ b/test/TaskflowGeneric/taskflow-specialization.cpp
@@ -0,0 +1,176 @@
+// Runtime bounds must describe the actual invocation, not a tuning hint.
+#include "Taskflow/GenericMapping.h"
+#include "Taskflow/TaskflowInvocation.h"
+#include "Taskflow/TaskflowSourceNormalization.h"
+#include "Taskflow/TaskflowSpecialization.h"
+#include "TaskflowDialect/TaskflowDialect.h"
+#include "mlir/Dialect/Affine/IR/AffineOps.h"
+#include "mlir/Dialect/Arith/IR/Arith.h"
+#include "mlir/Dialect/MemRef/IR/MemRef.h"
+#include "mlir/Dialect/SCF/IR/SCF.h"
+#include "mlir/Parser/Parser.h"
+#include "llvm/Support/raw_ostream.h"
+using namespace mlir;
+using namespace orbit::taskflow;
+static const char *source = R"mlir(module {
+ func.func @step(%kv: memref<?xf32> {orbit.role="state", orbit.name="KV"}, %n: index) attributes {orbit.noalias} {
+  %result = taskflow.task @update will_reads(%kv : memref<?xf32>)
+   will_writes(%kv : memref<?xf32>) value_inputs(%n : index)
+   [original_read_memrefs(%kv : memref<?xf32>), original_write_memrefs(%kv : memref<?xf32>)]
+   : (memref<?xf32>, memref<?xf32>, index) -> memref<?xf32> {
+  ^bb0(%read: memref<?xf32>, %write: memref<?xf32>, %limit: index):
+   %zero = arith.constant 0 : index
+   %one = arith.constant 1 : index
+   %i = taskflow.counter from %zero to %limit step %one : index
+   "taskflow.hyperblock"(%i) <{operandSegmentSizes=array<i32: 1, 0>}> ({
+    ^bb0(%index: index):
+     %old = memref.load %read[%index] : memref<?xf32>
+     %two = arith.constant 2.0 : f32
+     %next = arith.mulf %old, %two : f32
+     memref.store %next, %write[%index] : memref<?xf32>
+     "taskflow.hyperblock.yield"() : () -> ()
+   }) : (index) -> ()
+   taskflow.yield done_writes(%write : memref<?xf32>)
+  }
+  return
+ }
+})mlir";
+int main() {
+  DialectRegistry registry;
+  registry.insert<mlir::taskflow::TaskflowDialect, affine::AffineDialect,
+                  arith::ArithDialect, memref::MemRefDialect, scf::SCFDialect,
+                  func::FuncDialect>();
+  MLIRContext context(registry);
+  auto original = parseSourceString<ModuleOp>(source, &context);
+  if (!original)
+    return 1;
+  std::string error;
+  unsigned checks = 0;
+  auto require = [&](bool condition, const char *label) {
+    if (condition) {
+      ++checks;
+      return true;
+    }
+    llvm::errs() << label << ": " << error << '\n';
+    return false;
+  };
+  for (int64_t length : {4, 8}) {
+    std::vector<TaskflowArgumentBinding> arguments{{0, std::nullopt, {length}},
+                                                   {1, length, {}}};
+    OwningOpRef<ModuleOp> specialized, normalized;
+    TaskflowSpecializationWitness witness;
+    TaskflowSourceNormalizationWitness normalization;
+    if (!require(
+            succeeded(specializeTaskflowArguments(*original, "step", arguments,
+                                                  specialized, witness, error)),
+            "specialize") ||
+        !require(succeeded(verifyTaskflowSpecialization(*original, *specialized,
+                                                        witness, error)),
+                 "replay") ||
+        !require(checkTaskflowInvocationArguments(witness, arguments, error),
+                 "actual runtime dispatch guard") ||
+        !require(succeeded(normalizeTaskflowSource(*specialized, normalized,
+                                                   normalization, error)),
+                 "normalize actual extent"))
+      return 2;
+    GenericAnalysis facts;
+    GenericMappingPlan plan;
+    llvm::json::Value target = llvm::json::Object{
+        {"generic_air", llvm::json::Object{{"capacity_bytes", 24576}}}};
+    if (!require(analyzeGenericProgram(*normalized, facts, error), "analyze") ||
+        !require(facts.function.getNumArguments() == 1 &&
+                     facts.storages.size() == 1 &&
+                     facts.storages[0].role == "state" &&
+                     facts.storages[0].shape == std::vector<int64_t>{length},
+                 "one concrete state storage retains identity") ||
+        !require(planGenericMapping(facts, target, plan, error) &&
+                     checkGenericMapping(facts, plan, error),
+                 "actual state plan"))
+      return 3;
+    auto wrong = arguments;
+    wrong[1].scalar = length + 1;
+    if (!require(!checkTaskflowInvocationArguments(witness, wrong, error),
+                 "different runtime bound rejects cached code"))
+      return 4;
+    auto forged = witness;
+    forged.specializedFingerprint = "forged";
+    if (!require(failed(verifyTaskflowSpecialization(*original, *specialized,
+                                                     forged, error)),
+                 "forged result rejects"))
+      return 5;
+    wrong = arguments;
+    wrong.push_back(arguments[0]);
+    OwningOpRef<ModuleOp> rejected;
+    if (!require(failed(specializeTaskflowArguments(*original, "step", wrong,
+                                                    rejected, forged, error)) &&
+                     !rejected,
+                 "duplicate binding fails transactionally"))
+      return 6;
+  }
+  TaskflowInvocationSequence sequence;
+  std::vector<TaskflowArgumentBinding> actual{{0, std::nullopt, {8}},
+                                              {1, 8, {}}};
+  if (!require(
+          materializeTaskflowInvocationSequence(
+              *original, {0, 3, 1, 3}, {{"kv", "KV", "KV", "system_memory_bo"}},
+              [&](int64_t, TaskflowDeferredPlan &plan, std::string &) {
+                plan.function = "step";
+                plan.arguments = actual;
+                plan.shapeDomain = {4, 4};
+                return true;
+              },
+              [&](ModuleOp module, ProgramGraph &graph, std::string &error) {
+                GenericAnalysis facts;
+                GenericMappingPlan plan;
+                if (!analyzeGenericProgram(module, facts, error) ||
+                    !planGenericMapping(facts, llvm::json::Object{}, plan,
+                                        error) ||
+                    !checkGenericMapping(facts, plan, error))
+                  return false;
+                graph = std::move(plan.communication);
+                return true;
+              },
+              sequence, error),
+          "runtime provider owns all actual call modules"))
+    return 7;
+  unsigned submitted = 0;
+  auto executor =
+      [&](size_t index, int64_t iteration, const ProgramGraph &graph,
+          llvm::ArrayRef<ProgramStateHandoff> handoffs, std::string &) {
+        ++submitted;
+        return index == size_t(iteration) && !graph.events.empty() &&
+               handoffs.size() == (index ? 1 : 0);
+      };
+  if (!require(
+          executeTaskflowInvocationSequence(
+              *original, sequence,
+              [&](int64_t iteration, std::vector<TaskflowArgumentBinding> &out,
+                  std::string &) {
+                out = actual;
+                if (iteration == 2)
+                  out[1].scalar = 7;
+                return true;
+              },
+              executor, error) == false &&
+              submitted == 0,
+          "validate every actual call before any backend submission") ||
+      !require(executeTaskflowInvocationSequence(
+                   *original, sequence,
+                   [&](int64_t, std::vector<TaskflowArgumentBinding> &out,
+                       std::string &) {
+                     out = actual;
+                     return true;
+                   },
+                   executor, error) &&
+                   submitted == 3,
+               "actual source graphs and persistent allocation handoffs reach "
+               "backend"))
+    return 8;
+  auto record = serializeTaskflowInvocationSequence(sequence);
+  if (!require(record.getAsObject()->getArray("calls")->size() == 3,
+               "guarded invocation evidence is serializable"))
+    return 9;
+  llvm::outs() << checks
+               << " actual-bound specialization/state checks passed\n";
+  return 0;
+}
