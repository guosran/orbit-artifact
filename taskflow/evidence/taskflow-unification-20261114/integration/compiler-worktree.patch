+//===- TileTaskPass.cpp - Static counter-domain task tiling -----*- C++ -*-===//
+//
+// Splits a canonical pre-lowering Taskflow task into exactly k tasks along
+// one counter axis. Each part retains the counter chain and hyperblock. The
+// selected intervals are disjoint and a taskflow.join combines their states.
+//
+//===----------------------------------------------------------------------===//
+
+#include "Taskflow/TaskflowTiling.h"
+#include "Taskflow/GraphRewriteLegality.h"
+#include "TaskflowDialect/TaskflowDialect.h"
+#include "TaskflowDialect/TaskflowOps.h"
+
+#include "mlir/Dialect/Arith/IR/Arith.h"
+#include "mlir/Dialect/Func/IR/FuncOps.h"
+#include "mlir/Dialect/MemRef/IR/MemRef.h"
+#include "mlir/IR/Diagnostics.h"
+#include "mlir/IR/IRMapping.h"
+#include "mlir/IR/SymbolTable.h"
+#include "mlir/IR/Verifier.h"
+#include "mlir/Interfaces/SideEffectInterfaces.h"
+#include "mlir/Pass/Pass.h"
+
+#include "llvm/ADT/STLExtras.h"
+#include "llvm/ADT/SmallVector.h"
+#include "llvm/ADT/Twine.h"
+#include "llvm/Support/raw_ostream.h"
+
+#include <cstdint>
+#include <optional>
+#include <string>
+
+using namespace mlir;
+using namespace mlir::taskflow;
+
+namespace {
+
+constexpr StringLiteral kParentTaskAttr = "amoeba.tiling.parent_task";
+constexpr StringLiteral kAxisAttr = "amoeba.tiling.axis";
+constexpr StringLiteral kFactorAttr = "amoeba.tiling.factor";
+constexpr StringLiteral kPartIndexAttr = "amoeba.tiling.part_index";
+constexpr StringLiteral kOriginalRangeAttr = "amoeba.tiling.original_range";
+constexpr StringLiteral kDerivedRangeAttr = "amoeba.tiling.derived_range";
+
+struct TilePlan {
+  TaskflowTaskOp task;
+  SmallVector<TaskflowCounterOp> counters;
+  TaskflowHyperblockOp hyperblock;
+  int64_t axis = 0;
+  int64_t factor = 0;
+  int64_t lower = 0;
+  int64_t upper = 0;
+  orbit::taskflow::TaskflowDomainPartitionKind kind =
+      orbit::taskflow::TaskflowDomainPartitionKind::Tiling;
+};
+
+static LogicalResult reject(Operation *operation, const Twine &message) {
+  operation->emitError(message);
+  return failure();
+}
+
+static bool isStructuralOrLineageAttribute(StringRef name) {
+  return name == "operandSegmentSizes" || name == "resultSegmentSizes" ||
+         name == "operand_segment_sizes" || name == "result_segment_sizes" ||
+         name == "task_name" || name.starts_with("amoeba.tiling.") ||
+         name.starts_with("amoeba.fission.");
+}
+
+static std::optional<int64_t> constantIndex(Value value) {
+  if (auto constant = value.getDefiningOp<arith::ConstantIndexOp>())
+    return constant.value();
+  return std::nullopt;
+}
+
+static bool isNoAliasFunctionArgument(Value value) {
+  auto argument = dyn_cast<BlockArgument>(value);
+  if (!argument)
+    return false;
+  auto function =
+      dyn_cast_or_null<func::FuncOp>(argument.getOwner()->getParentOp());
+  return function && argument.getOwner() == &function.getBody().front() &&
+         mlir::taskflow::hasNoAliasTaskFunctionArgument(
+             function, argument.getArgNumber());
+}
+
+static bool provesDistinctStorage(Value lhs, Value rhs) {
+  if (lhs == rhs)
+    return false;
+  Operation *lhsDefinition = lhs.getDefiningOp();
+  Operation *rhsDefinition = rhs.getDefiningOp();
+  bool lhsAllocation =
+      lhsDefinition && isa<memref::AllocOp, memref::AllocaOp>(lhsDefinition);
+  bool rhsAllocation =
+      rhsDefinition && isa<memref::AllocOp, memref::AllocaOp>(rhsDefinition);
+  if (lhsAllocation && rhsAllocation)
+    return lhsDefinition != rhsDefinition;
+  if (lhsAllocation && isNoAliasFunctionArgument(rhs))
+    return true;
+  if (rhsAllocation && isNoAliasFunctionArgument(lhs))
+    return true;
+  return isNoAliasFunctionArgument(lhs) && isNoAliasFunctionArgument(rhs);
+}
+
+static FailureOr<TilePlan> analyzeTask(TaskflowTaskOp task, int64_t axis,
+                                       int64_t factor) {
+  if (!task || !task.getBody().hasOneBlock())
+    return failure();
+  for (NamedAttribute attribute : task->getAttrs()) {
+    StringRef name = attribute.getName().strref();
+    if ((name == "dlp_replicable" || name == "runtime_managable") &&
+        isa<BoolAttr>(attribute.getValue()))
+      continue;
+    if (!isStructuralOrLineageAttribute(name))
+      return reject(task, Twine("tiling rejects unsupported task state '") +
+                              attribute.getName().getValue() + "'");
+  }
+  if (task.getWillWrites().size() != 1 || task.getDoneWrites().size() != 1 ||
+      task.getOriginalWriteMemrefs().size() != 1 ||
+      llvm::any_of(task.getDoneReads(),
+                   [](Value result) { return !result.use_empty(); }) ||
+      task.getDoneReads().size() > task.getWillReads().size() ||
+      !task.getValueOutputs().empty() ||
+      task.getOriginalReadMemrefs().size() != task.getWillReads().size())
+    return reject(task, "tiling requires one output state, unused canonical "
+                        "read completions and no value result");
+
+  if (mlir::taskflow::isNamedControlPredecessor(task))
+    return reject(task,
+                  "tiling rejects tasks named by unsupported control edges");
+
+  TilePlan plan;
+  plan.task = task;
+  plan.axis = axis;
+  plan.factor = factor;
+  for (Operation &operation : task.getBody().front()) {
+    if (auto counter = dyn_cast<TaskflowCounterOp>(&operation)) {
+      plan.counters.push_back(counter);
+      continue;
+    }
+    if (auto hyperblock = dyn_cast<TaskflowHyperblockOp>(&operation)) {
+      if (plan.hyperblock)
+        return reject(task, "tiling requires exactly one hyperblock");
+      plan.hyperblock = hyperblock;
+      continue;
+    }
+    if (isa<TaskflowYieldOp, arith::ConstantOp>(&operation))
+      continue;
+    return reject(task,
+                  "tiling requires canonical counters and one hyperblock");
+  }
+  if (!plan.hyperblock || plan.counters.empty() || axis < 0 ||
+      axis >= static_cast<int64_t>(plan.counters.size()) || factor < 2)
+    return reject(
+        task, "tiling requires a valid static counter axis and factor >= 2");
+
+  for (auto [index, counter] : llvm::enumerate(plan.counters)) {
+    std::optional<int64_t> lower = constantIndex(counter.getLowerBound());
+    std::optional<int64_t> upper = constantIndex(counter.getUpperBound());
+    std::optional<int64_t> step = constantIndex(counter.getStep());
+    if (!lower || !upper || !step || *step != 1 || *upper <= *lower)
+      return reject(counter, "tiling requires constant unit-step counters");
+    if ((index == 0 && counter.getParentIndex()) ||
+        (index != 0 && counter.getParentIndex() !=
+                           plan.counters[index - 1].getCounterIndex()))
+      return reject(counter, "tiling requires one ordered counter chain");
+  }
+  if (plan.hyperblock.getIndices().size() != plan.counters.size())
+    return reject(plan.hyperblock,
+                  "hyperblock indices must match the counter chain");
+  for (auto [index, value] : llvm::enumerate(plan.hyperblock.getIndices()))
+    if (value != plan.counters[index].getCounterIndex())
+      return reject(plan.hyperblock,
+                    "hyperblock indices must match the counter chain");
+  if (!plan.hyperblock.getIterArgs().empty() ||
+      plan.hyperblock.getNumResults() != 0)
+    return reject(plan.hyperblock, "tiling rejects loop-carried recurrence");
+
+  // The interval join represents output coordinates. Prove those coordinates
+  // from the actual body, rather than trusting counter ranges or lineage attrs.
+  // This initial public materializer covers pointwise counter domains; a
+  // permutation/reduction requires its own explicit coordinate proof/lowering.
+  Block &taskBody = task.getBody().front();
+  Block &kernel = plan.hyperblock.getBody().front();
+  unsigned expectedArguments = task.getWillReads().size() +
+                               task.getWillWrites().size() +
+                               task.getValueInputs().size();
+  auto yield = dyn_cast<TaskflowYieldOp>(taskBody.getTerminator());
+  auto kernelYield =
+      dyn_cast<TaskflowHyperblockYieldOp>(kernel.getTerminator());
+  if (taskBody.getNumArguments() != expectedArguments ||
+      kernel.getNumArguments() != plan.counters.size() || !yield ||
+      yield.getDoneReads().size() != task.getDoneReads().size() ||
+      !llvm::equal(yield.getDoneReads(), taskBody.getArguments().take_front(
+                                             task.getDoneReads().size())) ||
+      !yield.getValueResults().empty() || yield.getDoneWrites().size() != 1 ||
+      yield.getDoneWrites().front() !=
+          taskBody.getArgument(task.getWillReads().size()) ||
+      !kernelYield || kernelYield->getNumOperands() != 0)
+    return reject(task,
+                  "tiling requires direct output state and counter yields");
+  bool hasStore = false;
+  for (Operation &operation : kernel.without_terminator()) {
+    if (operation.getNumRegions())
+      return reject(task, "tiling rejects nested regions and unknown effects");
+    if (auto load = dyn_cast<memref::LoadOp>(&operation)) {
+      auto source = dyn_cast<BlockArgument>(load.getMemRef());
+      if (!source || source.getOwner() != &taskBody ||
+          source.getArgNumber() >= task.getWillReads().size() ||
+          !llvm::equal(load.getIndices(), kernel.getArguments()))
+        return reject(task,
+                      "tiling requires pointwise loads from declared inputs");
+    } else if (auto store = dyn_cast<memref::StoreOp>(&operation)) {
+      if (store.getMemRef() !=
+              taskBody.getArgument(task.getWillReads().size()) ||
+          !llvm::equal(store.getIndices(), kernel.getArguments()))
+        return reject(
+            task, "tiling requires stores at the exact counter coordinates");
+      hasStore = true;
+    } else if (!isPure(&operation) || !isMemoryEffectFree(&operation)) {
+      return reject(task, "tiling rejects nested regions and unknown effects");
+    }
+    // Do not let a pure address producer hide a read/write through another
+    // storage handle or capture an undeclared side channel.
+    for (Value operand : operation.getOperands())
+      if (isa<BaseMemRefType>(operand.getType()) &&
+          !isa<memref::LoadOp, memref::StoreOp>(&operation))
+        return reject(task, "tiling rejects unsupported memory aliases");
+  }
+  if (!hasStore)
+    return reject(task, "tiling requires an actual store to its output");
+
+  SmallVector<Value> states(task.getWillReads());
+  states.push_back(task.getWillWrites().front());
+  for (Value state : states) {
+    auto type = dyn_cast<MemRefType>(state.getType());
+    if (!type || !type.hasStaticShape() || !type.getLayout().isIdentity() ||
+        type.getRank() != static_cast<int64_t>(plan.counters.size()))
+      return reject(
+          task,
+          "tiling requires static identity memrefs matching counter rank");
+    for (auto [counterAxis, counter] : llvm::enumerate(plan.counters)) {
+      int64_t lower = *constantIndex(counter.getLowerBound());
+      int64_t upper = *constantIndex(counter.getUpperBound());
+      if (lower < 0 || upper <= lower || upper > type.getShape()[counterAxis])
+        return reject(
+            task, "counter domain must select a non-empty tensor subdomain");
+    }
+  }
+  SmallVector<Value> roots(task.getOriginalReadMemrefs());
+  roots.push_back(task.getOriginalWriteMemrefs().front());
+  for (auto [state, root] : llvm::zip(states, roots))
+    if (state.getType() != root.getType())
+      return reject(task, "tiling state and original storage types differ");
+  for (size_t first = 0; first < roots.size(); ++first)
+    for (size_t second = first + 1; second < roots.size(); ++second)
+      if (!provesDistinctStorage(roots[first], roots[second]))
+        return reject(task, "tiling requires distinct allocations or "
+                            "amoeba.noalias function arguments");
+
+  TaskflowCounterOp selected = plan.counters[axis];
+  plan.lower = *constantIndex(selected.getLowerBound());
+  plan.upper = *constantIndex(selected.getUpperBound());
+  if (factor > plan.upper - plan.lower)
+    return reject(task, "tiling factor must not exceed the selected extent");
+  return plan;
+}
+
+static std::string partName(const TilePlan &plan, int64_t index) {
+  bool replica =
+      plan.kind ==
+      orbit::taskflow::TaskflowDomainPartitionKind::IndependentReplicas;
+  TaskflowTaskOp task = plan.task;
+  return (Twine(task.getTaskName()) + (replica ? ".replica." : ".tile.") +
+          Twine(plan.axis) + "." + Twine(index))
+      .str();
+}
+
+static TaskflowTaskOp createPart(OpBuilder &builder, TilePlan &plan,
+                                 int64_t partIndex, int64_t partLower,
+                                 int64_t partUpper) {
+  TaskflowTaskOp source = plan.task;
+  std::string name = partName(plan, partIndex);
+  TaskflowTaskOp part = builder.create<TaskflowTaskOp>(
+      source.getLoc(), TypeRange{}, source.getDoneWrites().getTypes(),
+      TypeRange{}, source.getWillReads(), source.getWillWrites(),
+      source.getValueInputs(), builder.getStringAttr(name),
+      source.getOriginalReadMemrefs(), source.getOriginalWriteMemrefs());
+  Block *body = new Block();
+  part.getBody().push_back(body);
+  IRMapping mapping;
+  Block &sourceBody = source.getBody().front();
+  for (auto [index, operand] : llvm::enumerate(source->getOperands())) {
+    if (index >= sourceBody.getNumArguments())
+      break;
+    BlockArgument argument =
+        body->addArgument(operand.getType(), source.getLoc());
+    mapping.map(sourceBody.getArgument(index), argument);
+  }
+  OpBuilder bodyBuilder = OpBuilder::atBlockEnd(body);
+  for (Operation &operation : sourceBody) {
+    if (!isa<TaskflowYieldOp>(&operation))
+      bodyBuilder.clone(operation, mapping);
+  }
+  SmallVector<TaskflowCounterOp> clonedCounters;
+  for (Operation &operation : *body)
+    if (auto counter = dyn_cast<TaskflowCounterOp>(&operation))
+      clonedCounters.push_back(counter);
+  if (clonedCounters.size() != plan.counters.size())
+    llvm_unreachable("validated counter chain changed while cloning");
+  bodyBuilder.setInsertionPoint(clonedCounters[plan.axis]);
+  Value lower =
+      bodyBuilder.create<arith::ConstantIndexOp>(source.getLoc(), partLower);
+  Value upper =
+      bodyBuilder.create<arith::ConstantIndexOp>(source.getLoc(), partUpper);
+  clonedCounters[plan.axis].getLowerBoundMutable().assign(lower);
+  clonedCounters[plan.axis].getUpperBoundMutable().assign(upper);
+  bodyBuilder.setInsertionPointToEnd(body);
+  bodyBuilder.create<TaskflowYieldOp>(
+      source.getLoc(), ValueRange{},
+      ValueRange{body->getArgument(source.getWillReads().size())},
+      ValueRange{});
+  for (StringRef name : {"dlp_replicable", "runtime_managable"})
+    if (Attribute value = source->getAttr(name))
+      part->setAttr(name, value);
+  part->setAttr(kParentTaskAttr, builder.getStringAttr(source.getTaskName()));
+  part->setAttr(kAxisAttr, builder.getI64IntegerAttr(plan.axis));
+  part->setAttr(kFactorAttr, builder.getI64IntegerAttr(plan.factor));
+  part->setAttr(kPartIndexAttr, builder.getI64IntegerAttr(partIndex));
+  part->setAttr(kOriginalRangeAttr,
+                builder.getDenseI64ArrayAttr({plan.lower, plan.upper}));
+  part->setAttr(kDerivedRangeAttr,
+                builder.getDenseI64ArrayAttr({partLower, partUpper}));
+  if (plan.kind ==
+      orbit::taskflow::TaskflowDomainPartitionKind::IndependentReplicas) {
+    auto function = source->getParentOfType<func::FuncOp>();
+    part->setAttr(
+        "orbit.replica.group",
+        builder.getStringAttr(
+            (Twine(function.getSymName()) + "/" + source.getTaskName()).str()));
+    part->setAttr("orbit.replica.instance",
+                  builder.getI64IntegerAttr(partIndex));
+    part->setAttr("orbit.replica.count",
+                  builder.getI64IntegerAttr(plan.factor));
+    part->setAttr("orbit.replica.requires_independent_resources",
+                  builder.getUnitAttr());
+  }
+  return part;
+}
+
+static LogicalResult rewriteTask(TilePlan &plan, func::FuncOp function) {
+  for (int64_t part = 0; part < plan.factor; ++part) {
+    std::string name = partName(plan, part);
+    bool collision = false;
+    function.walk([&](TaskflowTaskOp task) {
+      collision |= task != plan.task && task.getTaskName() == name;
+    });
+    if (collision)
+      return reject(plan.task,
+                    "tiling-derived task name collides with an existing task");
+  }
+  OpBuilder builder(plan.task);
+  SmallVector<Value> tileStates;
+  int64_t extent = plan.upper - plan.lower;
+  int64_t base = extent / plan.factor;
+  int64_t remainder = extent % plan.factor;
+  int64_t cursor = plan.lower;
+  for (int64_t part = 0; part < plan.factor; ++part) {
+    int64_t width = base + (part < remainder ? 1 : 0);
+    TaskflowTaskOp tile =
+        createPart(builder, plan, part, cursor, cursor + width);
+    tileStates.push_back(tile.getDoneWrites().front());
+    cursor += width;
+  }
+  SmallVector<int64_t> regionLower;
+  SmallVector<int64_t> regionUpper;
+  for (TaskflowCounterOp counter : plan.counters) {
+    regionLower.push_back(*constantIndex(counter.getLowerBound()));
+    regionUpper.push_back(*constantIndex(counter.getUpperBound()));
+  }
+  auto join = builder.create<TaskflowJoinOp>(
+      plan.task.getLoc(), plan.task.getDoneWrites().front().getType(),
+      tileStates, plan.task.getWillWrites().front(),
+      builder.getI64IntegerAttr(plan.axis),
+      builder.getDenseI64ArrayAttr(regionLower),
+      builder.getDenseI64ArrayAttr(regionUpper));
+  plan.task.getDoneWrites().front().replaceAllUsesWith(join.getJoined());
+  plan.task.erase();
+  return success();
+}
+
+struct TileTaskPass
+    : public PassWrapper<TileTaskPass, OperationPass<func::FuncOp>> {
+  MLIR_DEFINE_EXPLICIT_INTERNAL_INLINE_TYPE_ID(TileTaskPass)
+  TileTaskPass() = default;
+  TileTaskPass(const TileTaskPass &other) : PassWrapper(other) {}
+  StringRef getArgument() const override { return "tile-task"; }
+  StringRef getDescription() const override {
+    return "Partition a static Taskflow counter domain into disjoint tasks";
+  }
+  void getDependentDialects(DialectRegistry &registry) const override {
+    registry.insert<arith::ArithDialect, func::FuncDialect,
+                    memref::MemRefDialect, TaskflowDialect>();
+  }
+  Option<std::string> taskName{*this, "task-name",
+                               llvm::cl::desc("Exact Taskflow task name"),
+                               llvm::cl::init("")};
+  Option<int64_t> axis{*this, "axis", llvm::cl::desc("Counter axis"),
+                       llvm::cl::init(-1)};
+  Option<int64_t> factor{*this, "factor",
+                         llvm::cl::desc("Number of disjoint domain parts"),
+                         llvm::cl::init(0)};
+
+  void runOnOperation() override {
+    func::FuncOp function = getOperation();
+    SmallVector<TaskflowTaskOp> matches;
+    function.walk([&](TaskflowTaskOp task) {
+      if (task.getTaskName() == taskName)
+        matches.push_back(task);
+    });
+    if (taskName.empty() || matches.size() != 1) {
+      function.emitError()
+          << "tile task name must select exactly one task (found "
+          << matches.size() << ")";
+      return signalPassFailure();
+    }
+    FailureOr<TilePlan> plan = analyzeTask(matches.front(), axis, factor);
+    if (failed(plan))
+      return signalPassFailure();
+    if (failed(rewriteTask(*plan, function)))
+      signalPassFailure();
+  }
+};
+
+} // namespace
+
+namespace orbit::taskflow {
+namespace {
+std::string moduleWitness(ModuleOp module) {
+  std::string text;
+  llvm::raw_string_ostream stream(text);
+  module.print(stream, OpPrintingFlags().printGenericOpForm());
+  stream.flush();
+  return text;
+}
+} // namespace
+
+LogicalResult materializeTaskflowDomainPartition(
+    ModuleOp module, const TaskflowTilingAction &action,
+    TaskflowDomainPartitionKind kind, std::string &error) {
+  error.clear();
+  if (!module || action.function.empty() || action.task.empty() ||
+      (kind != TaskflowDomainPartitionKind::Tiling &&
+       kind != TaskflowDomainPartitionKind::IndependentReplicas)) {
+    error = "tiling requires a module, function and task";
+    return failure();
+  }
+  ScopedDiagnosticHandler diagnostics(module.getContext(),
+                                      [&](Diagnostic &diag) {
+                                        llvm::raw_string_ostream stream(error);
+                                        diag.print(stream);
+                                        return success();
+                                      });
+  if (failed(verify(module)))
+    return failure();
+  OwningOpRef<ModuleOp> trial = module.clone();
+  auto function = dyn_cast_or_null<func::FuncOp>(
+      SymbolTable::lookupSymbolIn(*trial, action.function));
+  if (!function) {
+    error = "tiling requires an exact function symbol";
+    return failure();
+  }
+  SmallVector<TaskflowTaskOp> matches;
+  function.walk([&](TaskflowTaskOp task) {
+    if (task.getTaskName() == action.task)
+      matches.push_back(task);
+  });
+  if (matches.size() != 1) {
+    error = "tiling requires one exact task name";
+    return failure();
+  }
+  auto plan = analyzeTask(matches.front(), action.axis, action.factor);
+  if (failed(plan))
+    return failure();
+  plan->kind = kind;
+  if (failed(rewriteTask(*plan, function)) || failed(verify(*trial)))
+    return failure();
+  module.getBodyRegion().takeBody(trial->getBodyRegion());
+  return success();
+}
+
+LogicalResult materializeTaskflowTiling(ModuleOp module,
+                                        const TaskflowTilingAction &action,
+                                        std::string &error) {
+  return materializeTaskflowDomainPartition(
+      module, action, TaskflowDomainPartitionKind::Tiling, error);
+}
+
+LogicalResult verifyTaskflowTilingReplay(ModuleOp parent, ModuleOp candidate,
+                                         ArrayRef<TaskflowTilingAction> actions,
+                                         std::string &error) {
+  error.clear();
+  if (!parent || !candidate || failed(verify(parent)) ||
+      failed(verify(candidate))) {
+    error = "tiling replay requires verified parent and candidate modules";
+    return failure();
+  }
+  OwningOpRef<ModuleOp> replay = parent.clone();
+  for (const auto &action : actions)
+    if (failed(materializeTaskflowTiling(*replay, action, error)))
+      return failure();
+  if (moduleWitness(*replay) != moduleWitness(candidate)) {
+    error = "candidate module is not the exact source tiling replay";
+    return failure();
+  }
+  return success();
+}
+
+std::unique_ptr<Pass> createTaskflowTilingPass() {
+  return std::make_unique<TileTaskPass>();
+}
+} // namespace orbit::taskflow
diff --git a/test/TaskflowAIR/aie_runtime_repeats.py b/test/TaskflowAIR/aie_runtime_repeats.py
new file mode 100644
index 00000000..8566ac59
--- /dev/null
+++ b/test/TaskflowAIR/aie_runtime_repeats.py
@@ -0,0 +1,100 @@
+#!/usr/bin/env python3
+"""Check actual repeated runtime BDs and reject forged transfer proofs.
+
+Inputs are a real compiled static four-dimensional AIE descriptor and its
+normalized source. No graph search, recompilation or NPU execution occurs.
+
+Local AIEX implementation evidence (aie-toy/vendor/mlir-aie):
+- lib/Dialect/AIEX/Transforms/AIESplitLongRepeats.cpp:92-101 computes
+  ``runs = repeat_count + 1`` and writes the residual count as ``runs - 1``.
+- lib/Dialect/AIEX/Utils/BdLowering.cpp:498-538 proves explicit descriptor
+  length equals the inner d0*d1*d2 extent; :554-562 encodes the outer size
+  as the biased queue repeat count (N - 1). Input dimension order is reversed
+  at :365-375, so the public four-dimensional array's first axis is outer.
+These source semantics explain why adding static_len once was insufficient;
+the byte count and the complete strided address multiset must both agree.
+"""
+import argparse
+import json
+from pathlib import Path
+import re
+import subprocess
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    for arg in ("tool", "source", "aie", "target", "output"):
+        parser.add_argument("--" + arg, type=Path, required=True)
+    args = parser.parse_args()
+    args.output.mkdir(parents=True, exist_ok=False)
+    original = args.aie.read_text()
+    configure = re.search(
+        r'"aiex.dma_configure_task_for"[^\n]+repeat_count = ([1-9]\d*) : i32',
+        original)
+    if not configure:
+        raise ValueError("fixture needs an actual repeated runtime DMA task")
+    descriptor = re.search(
+        r'"aie.dma_bd"\(%arg\d+\)[^\n]*static_len = (\d+) : i32[^\n]*'
+        r'static_sizes = array<i64: ([^>]+)>[^\n]*'
+        r'static_strides = array<i64: ([^>]+)>', original[configure.end():])
+    if not descriptor:
+        raise ValueError("fixture needs an actual static host-buffer descriptor")
+    # Convert the descriptor's local offsets to offsets in the original file.
+    base = configure.end()
+    spans = {i: (base + descriptor.start(i), base + descriptor.end(i))
+             for i in (1, 2, 3)}
+    sizes = [int(x.strip()) for x in descriptor[2].split(",")]
+    assert len(sizes) == 4 and sizes[0] == int(configure[1]) + 1
+    checks = []
+
+    def replace(span, value):
+        return original[:span[0]] + str(value) + original[span[1]:]
+
+    def check(name, text, expected):
+        source = args.output / (name + ".mlir")
+        receipt = args.output / (name + ".json")
+        source.write_text(text)
+        command = [str(args.tool.resolve()), str(args.source.resolve()),
+                   "--target-config=" + str(args.target.resolve()),
+                   "--check-aie=" + str(source.resolve()),
+                   "--implementation-output=" + str(receipt.resolve()),
+                   "--analysis-output=" + str(args.output / (name + "-analysis.json")),
+                   "--implementation-facts-output=" + str(args.output / (name + "-facts.json"))]
+        result = subprocess.run(command, text=True, capture_output=True, timeout=60)
+        (args.output / (name + ".stderr")).write_text(result.stderr)
+        assert (result.returncode == 0) == expected, (name, result.returncode, result.stderr)
+        assert json.loads(receipt.read_text())["valid"] == expected
+        checks.append(name)
+
+    check("actual-repeated-descriptor", original, True)
+    repeat_span = configure.span(1)
+    for name, value in (("missing-runs", 0), ("extra-runs", int(configure[1]) + 1),
+                        ("negative-repeat", -1)):
+        check(name, replace(repeat_span, value), False)
+    overflow = replace(repeat_span, 9223372036854775807).replace(
+        "repeat_count = 9223372036854775807 : i32",
+        "repeat_count = 9223372036854775807 : i64", 1)
+    check("repeat-overflow", overflow, False)
+    # The old checker accepted this length because it matched requested bytes
+    # while sizes still claimed the full repeated region. Actual BD inner
+    # length must agree with the independently checked outer run count.
+    check("forged-full-length", replace(spans[1], int(descriptor[1]) * sizes[0]), False)
+    changed = sizes.copy()
+    changed[0] += 1
+    check("forged-outer-dimension", replace(spans[2], ", ".join(map(str, changed))), False)
+    changed[0] = sizes[0]
+    changed[-1] = -1
+    check("negative-dimension", replace(spans[2], ", ".join(map(str, changed))), False)
+    strides = [int(x.strip()) for x in descriptor[3].split(",")]
+    strides[0] = 9223372036854775807
+    check("address-overflow", replace(spans[3], ", ".join(map(str, strides))), False)
+    strides[0] = 0
+    check("overlapping-repetitions", replace(spans[3], ", ".join(map(str, strides))), False)
+    save = {"status": "passed", "checks": checks, "device_submissions": 0,
+            "scope": "actual AIE static runtime descriptor byte/address proof"}
+    (args.output / "summary.json").write_text(json.dumps(save, indent=2) + "\n")
+    print(json.dumps(save))
+
+
+if __name__ == "__main__":
+    main()
diff --git a/test/TaskflowGeneric/proof-services.cpp b/test/TaskflowGeneric/proof-services.cpp
new file mode 100644
index 00000000..8d91c6fb
--- /dev/null
+++ b/test/TaskflowGeneric/proof-services.cpp
@@ -0,0 +1,154 @@
+#include "Taskflow/OutputCoordinateProof.h"
+#include "Taskflow/SourceIterationDomain.h"
+#include "TaskflowDialect/TaskflowDialect.h"
+#include "mlir/IR/BuiltinOps.h"
+#include "mlir/Parser/Parser.h"
+#include "llvm/Support/raw_ostream.h"
+using namespace mlir;
+using namespace mlir::taskflow;
+
+static OutputCoordinateProof first(TaskflowTaskOp, int64_t axis,
+                                   unsigned output) {
+  OutputCoordinateProof result;
+  result.proven = axis == 3 && output == 2;
+  result.reason = "first";
+  return result;
+}
+static OutputCoordinateProof second(TaskflowTaskOp, int64_t, unsigned) {
+  OutputCoordinateProof result;
+  result.proven = true;
+  result.reason = "second";
+  return result;
+}
+
+int main() {
+  bool ok = true;
+  unsigned checks = 0;
+  auto require = [&](bool condition, const char *label) {
+    if (condition)
+      ++checks;
+    else {
+      ok = false;
+      llvm::errs() << "proof-services: " << label << '\n';
+    }
+  };
+  DialectRegistry registry;
+  registry.insert<TaskflowDialect, affine::AffineDialect, arith::ArithDialect,
+                  func::FuncDialect, memref::MemRefDialect, scf::SCFDialect>();
+  MLIRContext left(registry), right(registry);
+  left.loadAllAvailableDialects();
+  right.loadAllAvailableDialects();
+  auto makeTask = [](MLIRContext &context) {
+    OperationState state(UnknownLoc::get(&context),
+                         TaskflowTaskOp::getOperationName());
+    return cast<TaskflowTaskOp>(Operation::create(state));
+  };
+  auto leftTask = makeTask(left), rightTask = makeTask(right);
+  auto cleanup = llvm::make_scope_exit([&] {
+    leftTask->destroy();
+    rightTask->destroy();
+  });
+  require(!analyzeOutputCoordinates(leftTask, 3, 2).proven,
+          "unregistered context fails closed");
+  require(registerOutputCoordinateProofProvider(left, "npu", first) ==
+              ProofProviderRegistration::Registered,
+          "first target registers");
+  require(registerOutputCoordinateProofProvider(left, "npu", first) ==
+              ProofProviderRegistration::AlreadyRegistered,
+          "identical duplicate is idempotent");
+  require(registerOutputCoordinateProofProvider(left, "npu", second) ==
+              ProofProviderRegistration::Conflict,
+          "different duplicate cannot replace proof");
+  require(registerOutputCoordinateProofProvider(left, "", first) ==
+                  ProofProviderRegistration::Invalid &&
+              registerOutputCoordinateProofProvider(left, "null", nullptr) ==
+                  ProofProviderRegistration::Invalid,
+          "empty target and null callback rejected");
+  require(analyzeOutputCoordinates(leftTask, 3, 2).reason == "first" &&
+              analyzeOutputCoordinates(leftTask, 3, 2).proven &&
+              !analyzeOutputCoordinates(leftTask, 4, 2).proven,
+          "sole provider receives original axis and output");
+  require(!analyzeOutputCoordinates(rightTask, 3, 2).proven,
+          "context registration does not leak");
+  require(registerOutputCoordinateProofProvider(right, "npu", second) ==
+                  ProofProviderRegistration::Registered &&
+              analyzeOutputCoordinates(rightTask, "npu", 3, 2).reason ==
+                  "second" &&
+              analyzeOutputCoordinates(leftTask, "npu", 3, 2).reason == "first",
+          "same target can use independent context services");
+  require(registerOutputCoordinateProofProvider(left, "neura", second) ==
+                  ProofProviderRegistration::Registered &&
+              !analyzeOutputCoordinates(leftTask, 3, 2).proven,
+          "ambiguous implicit target fails closed");
+  require(analyzeOutputCoordinates(leftTask, "npu", 3, 2).reason == "first" &&
+              analyzeOutputCoordinates(leftTask, "neura", 3, 2).reason ==
+                  "second" &&
+              !analyzeOutputCoordinates(leftTask, "missing", 3, 2).proven,
+          "explicit target selection and unknown target");
+
+  // Source-domain certification must be recomputed from current source values;
+  // neither an old witness nor the function-bound hint freezes the source IR.
+  const char *source = R"mlir(module {
+    func.func @source(%bound: index) attributes {amoeba.static_bound.arg.0 = 6 : i64} {
+      taskflow.task @loop value_inputs(%bound : index) : (index) -> () {
+      ^bb0(%n: index):
+        affine.for %i = 0 to %n {
+        }
+        taskflow.yield
+      }
+      return
+    }
+  })mlir";
+  auto module = parseSourceString<ModuleOp>(source, &right);
+  require(bool(module), "source-domain fixture parses without Neura");
+  if (module) {
+    TaskflowTaskOp task;
+    affine::AffineForOp loop;
+    module->walk([&](TaskflowTaskOp value) { task = value; });
+    module->walk([&](affine::AffineForOp value) { loop = value; });
+    auto initial = certifySourceIterationDomain(task, {loop});
+    require(initial.complete && initial.sourceMultiplicity == 6,
+            "source function bound resolves through task input");
+    Builder builder(&right);
+    task->setAttr(kSourceIterationDomainAttr,
+                  makeSourceIterationDomainAttr(builder, initial));
+    std::string error;
+    require(succeeded(parseSourceIterationDomain(task, error)),
+            "consistent source certificate parses");
+    auto function = task->getParentOfType<func::FuncOp>();
+    function->setAttr("amoeba.static_bound.arg.0",
+                      builder.getI64IntegerAttr(9));
+    auto changed = certifySourceIterationDomain(task, {loop});
+    require(changed.complete && changed.sourceMultiplicity == 9 &&
+                sourceIterationDomainCanonicalWitness(changed) !=
+                    sourceIterationDomainCanonicalWitness(initial),
+            "changed source bound requires a new certificate");
+    auto forged = initial;
+    forged.axes.front().extent = 5;
+    task->setAttr(kSourceIterationDomainAttr,
+                  makeSourceIterationDomainAttr(builder, forged));
+    require(failed(parseSourceIterationDomain(task, error)),
+            "self-consistent text cannot conceal invalid extent");
+    function->setAttr("amoeba.static_bound.arg.0",
+                      builder.getI64IntegerAttr(-1));
+    require(!certifySourceIterationDomain(task, {loop}).complete,
+            "invalid changed source bound fails certification");
+  }
+
+  // Exercise legacy compatibility last, after checking truly empty contexts.
+  require(registerOutputCoordinateProofProvider(first) ==
+                  ProofProviderRegistration::Registered &&
+              registerOutputCoordinateProofProvider(second) ==
+                  ProofProviderRegistration::Conflict,
+          "legacy compatibility never overwrites first provider");
+  MLIRContext fallback(registry);
+  fallback.loadAllAvailableDialects();
+  auto fallbackTask = makeTask(fallback);
+  require(analyzeOutputCoordinates(fallbackTask, 3, 2).reason == "first" &&
+              !analyzeOutputCoordinates(fallbackTask, "missing", 3, 2).proven &&
+              !analyzeOutputCoordinates(leftTask, 3, 2).proven,
+          "legacy fallback cannot satisfy unknown or ambiguous target");
+  fallbackTask->destroy();
+  llvm::outs() << "proof services: " << checks << " checks\n";
+  return ok ? 0 : 1;
+}
diff --git a/test/TaskflowGeneric/source-actions.cpp b/test/TaskflowGeneric/source-actions.cpp
new file mode 100644
index 00000000..494d42e1
--- /dev/null
+++ b/test/TaskflowGeneric/source-actions.cpp
@@ -0,0 +1,115 @@
+// Public search actions must be executable without the Neura backend.
+#include "Taskflow/SourceActions.h"
+#include "TaskflowDialect/TaskflowDialect.h"
+#include "mlir/Dialect/Affine/IR/AffineOps.h"
+#include "mlir/Dialect/Arith/IR/Arith.h"
+#include "mlir/Dialect/Func/IR/FuncOps.h"
+#include "mlir/Dialect/MemRef/IR/MemRef.h"
+#include "mlir/Dialect/SCF/IR/SCF.h"
+#include "mlir/Parser/Parser.h"
+#include "llvm/Support/raw_ostream.h"
+using namespace mlir;
+using namespace orbit::taskflow;
+static std::string text(ModuleOp module) {
+  std::string result;
+  llvm::raw_string_ostream stream(result);
+  module.print(stream, OpPrintingFlags().printGenericOpForm());
+  return result;
+}
+int main(int argc, char **argv) {
+  if (argc != 3)
+    return 2;
+  DialectRegistry registry;
+  registry.insert<taskflow::TaskflowDialect, arith::ArithDialect,
+                  affine::AffineDialect, func::FuncDialect,
+                  memref::MemRefDialect, scf::SCFDialect>();
+  MLIRContext context(registry);
+  auto parent = parseSourceFile<ModuleOp>(argv[1], &context);
+  auto fissionParent = parseSourceFile<ModuleOp>(argv[2], &context);
+  if (!parent || !fissionParent)
+    return 3;
+  std::string original = text(*parent), error;
+  NeighborhoodPrimitive tile{"tile", "Pointwise", "", "", 0, 3};
+  NeighborhoodAction compound{"tiling-plus-shape",  "compound", {tile},
+                              "Pointwise.tile.0.0", 3,          3};
+  auto result =
+      applySourceAction(*parent, "pointwise", compound, {}, {4, 4}, error);
+  if (failed(result) || text(*parent) != original ||
+      failed(verifySourceActionReplay(*parent, *result->module, "pointwise",
+                                      {compound}, {}, result->shapes, {4, 4},
+                                      error))) {
+    llvm::errs() << error;
+    return 4;
+  }
+  result->module.get()->setAttr("orbit.forged", UnitAttr::get(&context));
+  if (succeeded(verifySourceActionReplay(*parent, *result->module, "pointwise",
+                                         {compound}, {}, result->shapes, {4, 4},
+                                         error)))
+    return 5;
+  // A later failing primitive must roll back an already materialized prefix.
+  NeighborhoodPrimitive invalid{"tile", "Pointwise.tile.0.0", "", "", 0, 999};
+  NeighborhoodAction bad{"compound", "rollback", {tile, invalid}};
+  if (succeeded(
+          applySourceAction(*parent, "pointwise", bad, {}, {4, 4}, error)) ||
+      text(*parent) != original)
+    return 6;
+  NeighborhoodAction reduction{"reduction",
+                               "needs-target",
+                               {{"k-partition", "Pointwise", "", "", 0, 3}}};
+  if (succeeded(applySourceAction(*parent, "pointwise", reduction, {}, {4, 4},
+                                  error)) ||
+      error.find("target extension") == std::string::npos)
+    return 7;
+  NeighborhoodAction probe{"target", "extension", {{"target-probe"}}};
+  bool called = false;
+  auto extension = [&](ModuleOp trial, llvm::StringRef,
+                       const NeighborhoodPrimitive &, std::string &) {
+    called = true;
+    trial->setAttr("orbit.target_probe", UnitAttr::get(&context));
+    return success();
+  };
+  auto extended = applySourceAction(*parent, "pointwise", probe, {}, {4, 4},
+                                    error, extension);
+  if (!called || failed(extended) ||
+      !extended->module.get()->hasAttr("orbit.target_probe") ||
+      text(*parent) != original)
+    return 8;
+  SourceActionOptions options;
+  options.round = 7;
+  options.shapeDomain = {4, 4};
+  options.fission = options.fusion = false;
+  std::vector<NeighborhoodAction> actions;
+  std::vector<std::string> diagnostics;
+  if (failed(enumerateSourceActions(*parent, "pointwise", options, actions,
+                                    diagnostics, error)))
+    return 9;
+  bool odd = false, large = false, area9 = false;
+  for (const auto &action : actions) {
+    area9 |= action.shapeRows == 3 && action.shapeCols == 3;
+    for (const auto &primitive : action.primitives) {
+      odd |= primitive.kind == "tile" && primitive.factor == 5;
+      large |= primitive.kind == "tile" && primitive.factor == 9;
+    }
+  }
+  if (!odd || !large || !area9)
+    return 10;
+  options.tiling = false;
+  options.fission = true;
+  actions.clear();
+  if (failed(enumerateSourceActions(*fissionParent, "source_fission", options,
+                                    actions, diagnostics, error)))
+    return 11;
+  bool split = false;
+  for (const auto &action : actions)
+    if (action.family == "fission") {
+      split = succeeded(applySourceAction(*fissionParent, "source_fission",
+                                          action, {}, {4, 4}, error));
+      if (split)
+        break;
+    }
+  if (!split)
+    return 12;
+  llvm::outs() << "public source actions, compound rollback, replay and target "
+                  "extensions passed\n";
+  return 0;
+}
diff --git a/test/TaskflowGeneric/source-fusion.cpp b/test/TaskflowGeneric/source-fusion.cpp
new file mode 100644
index 00000000..48211a28
--- /dev/null
+++ b/test/TaskflowGeneric/source-fusion.cpp
@@ -0,0 +1,304 @@
+#include "Taskflow/SourceActions.h"
+#include "Taskflow/TaskflowFission.h"
+#include "Taskflow/TaskflowFusion.h"
+#include "Taskflow/TaskflowReplica.h"
+#include "Taskflow/TaskflowTiling.h"
+#include "TaskflowDialect/TaskflowDialect.h"
+#include "mlir/Dialect/Arith/IR/Arith.h"
+#include "mlir/Dialect/MemRef/IR/MemRef.h"
+#include "mlir/Dialect/SCF/IR/SCF.h"
+#include "mlir/IR/Verifier.h"
+#include "mlir/Parser/Parser.h"
+#include "llvm/Support/raw_ostream.h"
+using namespace mlir;
+using namespace orbit::taskflow;
+static const char *fixture = R"mlir(module {
+ func.func @source(%a: memref<2x2xi32> {amoeba.noalias}, %d: memref<2x2xi32> {amoeba.noalias}) -> memref<2x2xi32> {
+ %t = memref.alloc() : memref<2x2xi32>
+ %p = taskflow.task @producer will_reads(%a : memref<2x2xi32>) will_writes(%t : memref<2x2xi32>) [original_read_memrefs(%a : memref<2x2xi32>), original_write_memrefs(%t : memref<2x2xi32>)] : (memref<2x2xi32>, memref<2x2xi32>) -> memref<2x2xi32> {
+ ^bb0(%read: memref<2x2xi32>, %write: memref<2x2xi32>):
+ %z = arith.constant 0 : index
+ %o = arith.constant 1 : index
+ %b = arith.constant 2 : index
+ %m = taskflow.counter from %z to %b step %o : index
+ %n = taskflow.counter parent(%m : index) from %z to %b step %o : index
+ "taskflow.hyperblock"(%m, %n) <{operandSegmentSizes = array<i32: 2, 0>}> ({
+ ^bb0(%i: index, %j: index):
+ %v = memref.load %read[%i, %j] : memref<2x2xi32>
+ memref.store %v, %write[%i, %j] : memref<2x2xi32>
+ "taskflow.hyperblock.yield"() <{operandSegmentSizes = array<i32: 0, 0>}> : () -> ()
+ }) : (index, index) -> ()
+ taskflow.yield done_writes(%write : memref<2x2xi32>)
+ }
+ %q = taskflow.task @consumer will_reads(%p : memref<2x2xi32>) will_writes(%d : memref<2x2xi32>) [original_read_memrefs(%t : memref<2x2xi32>), original_write_memrefs(%d : memref<2x2xi32>)] : (memref<2x2xi32>, memref<2x2xi32>) -> memref<2x2xi32> {
+ ^bb0(%read: memref<2x2xi32>, %write: memref<2x2xi32>):
+ %z = arith.constant 0 : index
+ %o = arith.constant 1 : index
+ %b = arith.constant 2 : index
+ %m = taskflow.counter from %z to %b step %o : index
+ %n = taskflow.counter parent(%m : index) from %z to %b step %o : index
+ "taskflow.hyperblock"(%m, %n) <{operandSegmentSizes = array<i32: 2, 0>}> ({
+ ^bb0(%i: index, %j: index):
+ %v = memref.load %read[%i, %j] : memref<2x2xi32>
+ memref.store %v, %write[%i, %j] : memref<2x2xi32>
+ "taskflow.hyperblock.yield"() <{operandSegmentSizes = array<i32: 0, 0>}> : () -> ()
+ }) : (index, index) -> ()
+ taskflow.yield done_writes(%write : memref<2x2xi32>)
+ }
+return %q : memref<2x2xi32>
+ }
+}
+)mlir";
+static std::string replace(std::string text, StringRef old, StringRef value) {
+  size_t position = text.find(old.str());
+  if (position != std::string::npos)
+    text.replace(position, old.size(), value.str());
+  return text;
+}
+static std::string print(ModuleOp module) {
+  std::string text;
+  llvm::raw_string_ostream stream(text);
+  module.print(stream, OpPrintingFlags().printGenericOpForm());
+  return text;
+}
+int main() {
+  DialectRegistry registry;
+  registry.insert<mlir::taskflow::TaskflowDialect, arith::ArithDialect,
+                  memref::MemRefDialect, func::FuncDialect, scf::SCFDialect>();
+  MLIRContext context(registry);
+  bool ok = true;
+  unsigned checks = 0;
+  std::string error;
+  auto require = [&](bool condition, const char *label) {
+    if (condition)
+      ++checks;
+    else {
+      ok = false;
+      llvm::errs() << label << ": " << error << '\n';
+    }
+  };
+  auto parent = parseSourceString<ModuleOp>(fixture, &context);
+  require(bool(parent), "source fusion fixture parses without Neura");
+  if (!parent)
+    return 1;
+  OwningOpRef<ModuleOp> candidate = parent->clone();
+  auto fused = materializeTaskflowFusion(
+      candidate->lookupSymbol<func::FuncOp>("source"), "producer", "consumer",
+      TaskflowFusionKind::ProducerConsumer, error);
+  require(succeeded(fused), "private elementwise producer-consumer fuses");
+  if (succeeded(fused)) {
+    require(succeeded(verify(*candidate)), "fused source verifies");
+    unsigned loads = 0, stores = 0;
+    (*fused).walk([&](memref::LoadOp) { ++loads; });
+    (*fused).walk([&](memref::StoreOp) { ++stores; });
+    require(loads == 1 && stores == 1, "intermediate store/load eliminated");
+    require((*fused).getWillWrites().size() == 1 &&
+                (*fused).getOriginalWriteMemrefs().size() == 1 &&
+                (*fused).getWillReads().size() == 1 &&
+                (*fused).getOriginalReadMemrefs().size() == 1,
+            "state and memory summaries exclude eliminated intermediate");
+    TaskflowFusionAction action{"source", "producer", "consumer",
+                                TaskflowFusionKind::ProducerConsumer};
+    require(succeeded(verifyTaskflowFusionReplay(*parent, *candidate, {action},
+                                                 error)),
+            "independent canonical source replay matches");
+    // Fusion produces WAR completion results even when the source has no
+    // readers of those states. Unused canonical completions must not prevent
+    // a later DFG fission from making a large fused graph map-able.
+    NeighborhoodPrimitive fusePrimitive;
+    fusePrimitive.kind = "fusion";
+    fusePrimitive.firstTask = "producer";
+    fusePrimitive.secondTask = "consumer";
+    fusePrimitive.mode = "producer-consumer";
+    NeighborhoodAction fuseAction{"fusion", "fuse-source", {fusePrimitive}};
+    auto fusedAction =
+        applySourceAction(*parent, "source", fuseAction, {}, {1, 1}, error);
+    require(succeeded(fusedAction), "joint fusion action materializes");
+    if (succeeded(fusedAction)) {
+      NeighborhoodPrimitive splitPrimitive;
+      splitPrimitive.kind = "fission";
+      splitPrimitive.firstTask = (*fused).getTaskName().str();
+      splitPrimitive.leftNodes = {0};
+      NeighborhoodAction splitAction{
+          "fission", "split-fused-source", {splitPrimitive}};
+      auto split =
+          applySourceAction(*fusedAction->module, "source", splitAction,
+                            fusedAction->shapes, {1, 1}, error);
+      require(succeeded(split),
+              "unused fused read completions allow DFG fission");
+      if (succeeded(split)) {
+        const std::vector<NeighborhoodShape> initial{{"producer", 1, 1},
+                                                     {"consumer", 1, 1}};
+        const std::vector<NeighborhoodAction> history{fuseAction, splitAction};
+        require(succeeded(verifySourceActionReplay(
+                    *parent, *split->module, "source", history, initial,
+                    split->shapes, {1, 1}, error)),
+                "fusion then fission replays from immutable original source");
+      }
+      for (const auto &kind : {"tile", "replica"}) {
+        NeighborhoodPrimitive partition;
+        partition.kind = kind;
+        partition.firstTask = (*fused).getTaskName().str();
+        partition.axis = 0;
+        partition.factor = 2;
+        NeighborhoodAction partitionAction{kind, kind, {partition}};
+        auto parts =
+            applySourceAction(*fusedAction->module, "source", partitionAction,
+                              fusedAction->shapes, {1, 1}, error);
+        require(succeeded(parts),
+                "unused fused completions permit domain partition");
+        if (succeeded(parts)) {
+          const std::vector<NeighborhoodShape> initial{{"producer", 1, 1},
+                                                       {"consumer", 1, 1}};
+          const std::vector<NeighborhoodAction> history{fuseAction,
+                                                        partitionAction};
+          require(succeeded(verifySourceActionReplay(
+                      *parent, *parts->module, "source", history, initial,
+                      parts->shapes, {1, 1}, error)),
+                  "fusion then tile/replica replays from immutable original");
+          unsigned tasks = 0;
+          int64_t work = 0;
+          parts->module->walk([&](taskflow::TaskflowTaskOp child) {
+            ++tasks;
+            int64_t iterations = 1;
+            for (Operation &operation : child.getBody().front())
+              if (auto counter =
+                      dyn_cast<taskflow::TaskflowCounterOp>(operation)) {
+                auto lower = counter.getLowerBound()
+                                 .getDefiningOp<arith::ConstantIndexOp>();
+                auto upper = counter.getUpperBound()
+                                 .getDefiningOp<arith::ConstantIndexOp>();
+                iterations *= upper.value() - lower.value();
+              }
+            work += iterations;
+          });
+          require(tasks == 2 && work == 4,
+                  "partition executes original four iterations exactly once");
+          require(hasTaskflowReplicaGroups(*parts->module) ==
+                      (StringRef(kind) == "replica"),
+                  "replica keeps independent resource obligation distinct from "
+                  "tiling");
+        }
+      }
+      OwningOpRef<ModuleOp> used = fusedAction->module->clone();
+      auto function = used->lookupSymbol<func::FuncOp>("source");
+      taskflow::TaskflowTaskOp task;
+      function.walk([&](taskflow::TaskflowTaskOp found) { task = found; });
+      cast<func::ReturnOp>(function.getBody().front().getTerminator())
+          ->setOperand(0, task.getDoneReads().front());
+      require(failed(materializeTaskflowFission(
+                  *used, "source", task.getTaskName(), {0}, error)),
+              "externally used fused read completions still reject fission");
+      const std::string usedBefore = print(*used);
+      require(
+          failed(materializeTaskflowTiling(
+              *used, {"source", task.getTaskName().str(), 0, 2}, error)) &&
+              failed(materializeTaskflowReplicas(
+                  *used, {"source", task.getTaskName().str(), 0, 2}, error)) &&
+              print(*used) == usedBefore,
+          "used read completions reject tile/replica without mutation");
+      OwningOpRef<ModuleOp> wrong = fusedAction->module->clone();
+      wrong->walk([&](taskflow::TaskflowTaskOp found) { task = found; });
+      auto yield = cast<taskflow::TaskflowYieldOp>(
+          task.getBody().front().getTerminator());
+      yield.getDoneReadsMutable().slice(0, 1).assign(
+          task.getBody().front().getArgument(task.getWillReads().size()));
+      require(
+          failed(materializeTaskflowFission(*wrong, "source",
+                                            task.getTaskName(), {0}, error)),
+          "unused read completions still require exact source read binding");
+      require(
+          failed(materializeTaskflowTiling(
+              *wrong, {"source", task.getTaskName().str(), 0, 2}, error)) &&
+              failed(materializeTaskflowReplicas(
+                  *wrong, {"source", task.getTaskName().str(), 0, 2}, error)),
+          "tile/replica reject unused completions with wrong source binding");
+    }
+    (*fused)->setAttr("orbit.fake_source", UnitAttr::get(&context));
+    require(failed(verifyTaskflowFusionReplay(*parent, *candidate, {action},
+                                              error)),
+            "replay rejects candidate metadata drift");
+  }
+  auto rejected = [&](const std::string &text, TaskflowFusionKind kind,
+                      const char *label) {
+    auto module = parseSourceString<ModuleOp>(text, &context);
+    require(bool(module), "negative fixture parses");
+    if (!module)
+      return;
+    std::string before = print(*module);
+    auto result =
+        materializeTaskflowFusion(module->lookupSymbol<func::FuncOp>("source"),
+                                  "producer", "consumer", kind, error);
+    require(failed(result), label);
+    require(before == print(*module), "failed fusion leaves source unchanged");
+  };
+  std::string transpose = fixture;
+  // Replace only the consumer occurrence, after its task marker.
+  size_t consumer = transpose.find("taskflow.task @consumer");
+  std::string prefix = transpose.substr(0, consumer);
+  transpose = prefix + replace(transpose.substr(consumer),
+                               "%v = memref.load %read[%i, %j]",
+                               "%v = memref.load %read[%j, %i]");
+  rejected(transpose, TaskflowFusionKind::ProducerConsumer,
+           "transpose cannot forward current producer element");
+  std::string noninjective = replace(fixture, "memref.store %v, %write[%i, %j]",
+                                     "memref.store %v, %write[%z, %z]");
+  consumer = noninjective.find("taskflow.task @consumer");
+  noninjective =
+      noninjective.substr(0, consumer) +
+      replace(noninjective.substr(consumer), "%v = memref.load %read[%i, %j]",
+              "%v = memref.load %read[%z, %z]");
+  rejected(noninjective, TaskflowFusionKind::ProducerConsumer,
+           "equal but noninjective indices cannot forward across firings");
+  std::string exposed =
+      replace(fixture, "%t = memref.alloc() : memref<2x2xi32>", "");
+  exposed = replace(exposed, "func.func @source(",
+                    "func.func @source(%t: memref<2x2xi32> {amoeba.noalias}, ");
+  rejected(exposed, TaskflowFusionKind::ProducerConsumer,
+           "externally visible intermediate store cannot disappear");
+  std::string observed =
+      replace(fixture, "return %q",
+              "%zero = arith.constant 0 : index\n %observe = memref.load "
+              "%t[%zero, %zero] : memref<2x2xi32>\n return %q");
+  rejected(observed, TaskflowFusionKind::ProducerConsumer,
+           "private allocation with external observer cannot forward");
+  std::string alias = replace(fixture, "%a: memref<2x2xi32> {amoeba.noalias}",
+                              "%a: memref<2x2xi32>");
+  rejected(alias, TaskflowFusionKind::ProducerConsumer,
+           "distinct function arguments without alias proof cannot reorder");
+  std::string sibling = fixture;
+  sibling =
+      replace(sibling, "@consumer will_reads(%p", "@consumer will_reads(%a");
+  consumer = sibling.find("taskflow.task @consumer");
+  sibling = sibling.substr(0, consumer) + replace(sibling.substr(consumer),
+                                                  "original_read_memrefs(%t",
+                                                  "original_read_memrefs(%a");
+  auto siblingModule = parseSourceString<ModuleOp>(sibling, &context);
+  require(bool(siblingModule), "sibling fixture parses");
+  if (siblingModule) {
+    auto result = materializeTaskflowFusion(
+        siblingModule->lookupSymbol<func::FuncOp>("source"), "producer",
+        "consumer", TaskflowFusionKind::Sibling, error);
+    require(succeeded(result) && succeeded(verify(*siblingModule)),
+            "independent shared-input siblings fuse");
+    if (succeeded(result))
+      require((*result).getDoneWrites().size() == 2 &&
+                  (*result).getWillReads().size() == 1 &&
+                  (*result).getOriginalReadMemrefs().size() == 1 &&
+                  (*result).getOriginalReadMemrefs().front() ==
+                      (*result).getWillReads().front(),
+              "sibling outputs and deduplicated source summaries align");
+  }
+  std::string conflict = replace(
+      sibling, "@consumer will_reads(%a : memref<2x2xi32>) will_writes(%d",
+      "@consumer will_reads(%a : memref<2x2xi32>) will_writes(%t");
+  consumer = conflict.find("taskflow.task @consumer");
+  conflict = conflict.substr(0, consumer) +
+             replace(conflict.substr(consumer), "original_write_memrefs(%d",
+                     "original_write_memrefs(%t");
+  rejected(conflict, TaskflowFusionKind::Sibling,
+           "sibling write aliases rejected");
+  require(!parseTaskflowFusionKind("invalid"), "unknown fusion kind rejected");
+  llvm::outs() << "source fusion: " << checks << " checks\n";
+  return ok ? 0 : 1;
+}
diff --git a/test/TaskflowGeneric/source-mapping-actions.cpp b/test/TaskflowGeneric/source-mapping-actions.cpp
new file mode 100644
index 00000000..05ccd6fd
--- /dev/null
+++ b/test/TaskflowGeneric/source-mapping-actions.cpp
@@ -0,0 +1,106 @@
+// Native tile/residency choices must use the same source action/replay API.
+#include "Taskflow/SourceMappingActions.h"
+#include "Taskflow/TaskTiling.h"
+#include "TaskflowDialect/TaskflowDialect.h"
+#include "TaskflowDialect/TaskflowOps.h"
+#include "mlir/Dialect/Affine/IR/AffineOps.h"
+#include "mlir/Dialect/Arith/IR/Arith.h"
+#include "mlir/Dialect/Func/IR/FuncOps.h"
+#include "mlir/Dialect/MemRef/IR/MemRef.h"
+#include "mlir/Dialect/SCF/IR/SCF.h"
+#include "mlir/IR/Builders.h"
+#include "mlir/Parser/Parser.h"
+#include "llvm/ADT/STLExtras.h"
+#include "llvm/Support/raw_ostream.h"
+using namespace mlir;
+using namespace orbit::taskflow;
+int main(int argc, char **argv) {
+  if (argc != 2)
+    return 2;
+  DialectRegistry registry;
+  registry.insert<taskflow::TaskflowDialect, affine::AffineDialect,
+                  arith::ArithDialect, func::FuncDialect, memref::MemRefDialect,
+                  scf::SCFDialect>();
+  MLIRContext context(registry);
+  auto parent = parseSourceFile<ModuleOp>(argv[1], &context);
+  if (!parent)
+    return 3;
+  SourceMappingActionOptions options;
+  options.capabilities.identity = "source-policy-test-target";
+  options.tilePageSlots = 16;
+  SourceActionOptions search;
+  search.round = 0;
+  auto enumerate = makeSourceMappingActionEnumerator(options);
+  auto materialize = makeSourceMappingActionMaterializer(options);
+  std::string error;
+  std::vector<NeighborhoodAction> actions;
+  if (failed(enumerate(*parent, "pointwise", search, actions, error))) {
+    llvm::errs() << error;
+    return 4;
+  }
+  auto found = llvm::find_if(actions, [](const auto &action) {
+    return action.family == "native-task-tile";
+  });
+  if (found == actions.end())
+    return 5;
+  NeighborhoodAction selected = *found;
+  auto tiled = applySourceAction(*parent, "pointwise", selected, {}, {}, error,
+                                 materialize);
+  if (failed(tiled) ||
+      failed(checkSourceMappingActionBindings(*tiled->module, "pointwise",
+                                              error)) ||
+      failed(verifySourceActionReplay(*parent, *tiled->module, "pointwise",
+                                      {selected}, {}, tiled->shapes, {}, error,
+                                      materialize))) {
+    llvm::errs() << error;
+    return 6;
+  }
+  std::vector<TaskTileChoice> entries;
+  if (!readTaskTileChoices(*tiled->module, 1, entries, error) ||
+      entries.size() != 1 || entries[0].sizes.size() != 2 ||
+      parent.get()->hasAttr("orbit.task_tiles"))
+    return 7;
+  // A physically supported policy is not a proof of ordinal ownership after
+  // a graph rewrite. The next materializer/capability check must reject drift.
+  auto renamed = tiled->module->clone();
+  renamed.walk([&](taskflow::TaskflowTaskOp task) {
+    task->setAttr("task_name",
+                  StringAttr::get(&context, "DifferentSourceTask"));
+  });
+  if (succeeded(
+          checkSourceMappingActionBindings(renamed, "pointwise", error)) ||
+      succeeded(applySourceAction(renamed, "pointwise", selected, {}, {}, error,
+                                  materialize)))
+    return 8;
+  std::vector<NeighborhoodAction> staleMenu;
+  if (failed(enumerate(renamed, "pointwise", search, staleMenu, error)) ||
+      staleMenu.size() != 1 || staleMenu[0].family != "native-policy-reset")
+    return 9;
+  auto withdrawn = applySourceAction(renamed, "pointwise", staleMenu[0], {}, {},
+                                     error, materialize);
+  if (failed(withdrawn) ||
+      withdrawn->module.get()->hasAttr("orbit.task_tiles") ||
+      failed(checkSourceMappingActionBindings(*withdrawn->module, "pointwise",
+                                              error)))
+    return 10;
+  renamed.erase();
+  options.capabilities.identity = "different-target";
+  auto otherTarget = makeSourceMappingActionMaterializer(options);
+  if (succeeded(applySourceAction(*parent, "pointwise", selected, {}, {}, error,
+                                  otherTarget)))
+    return 11;
+  bool mappingFound = false;
+  for (const auto &action : actions)
+    if (action.family == "native-mapping") {
+      auto result = applySourceAction(*parent, "pointwise", action, {}, {},
+                                      error, materialize);
+      if (failed(result))
+        return 12;
+      mappingFound = true;
+    }
+  if (!mappingFound)
+    return 13;
+  llvm::outs() << "source/native joint actions, named tile ownership, "
+                  "withdrawal and replay passed\n";
+  return 0;
+}
diff --git a/test/TaskflowGeneric/source-search.cpp b/test/TaskflowGeneric/source-search.cpp
new file mode 100644
index 00000000..948f50cc
--- /dev/null
+++ b/test/TaskflowGeneric/source-search.cpp
@@ -0,0 +1,223 @@
+// Synthetic evaluator tests the search contract, not hardware speedup.
+#include "Taskflow/GenericAnalysis.h"
+#include "Taskflow/SourceSearch.h"
+#include "Taskflow/TaskflowFission.h"
+#include "TaskflowDialect/TaskflowDialect.h"
+#include "mlir/Dialect/Affine/IR/AffineOps.h"
+#include "mlir/Dialect/Arith/IR/Arith.h"
+#include "mlir/Dialect/Func/IR/FuncOps.h"
+#include "mlir/Dialect/MemRef/IR/MemRef.h"
+#include "mlir/Dialect/SCF/IR/SCF.h"
+#include "mlir/Parser/Parser.h"
+#include "llvm/Support/raw_ostream.h"
+#include <set>
+using namespace mlir;
+using namespace orbit::taskflow;
+int main(int argc, char **argv) {
+  if (argc != 2)
+    return 2;
+  DialectRegistry registry;
+  registry.insert<taskflow::TaskflowDialect, affine::AffineDialect,
+                  arith::ArithDialect, func::FuncDialect, memref::MemRefDialect,
+                  scf::SCFDialect>();
+  MLIRContext context(registry);
+  auto parent = parseSourceFile<ModuleOp>(argv[1], &context);
+  if (!parent)
+    return 3;
+  unsigned calls = 0;
+  SourceSearchBackend backend;
+  backend.identity = "synthetic-contract-v1";
+  backend.capabilityIdentity = "source-normalization-unit-shape-v1";
+  backend.capability = [](ModuleOp, ArrayRef<NeighborhoodShape> shapes,
+                          std::string &reason) {
+    for (const auto &shape : shapes)
+      if (shape.rows != 1 || shape.cols != 1) {
+        reason = "synthetic evaluator implements unit resource shape only";
+        return false;
+      }
+    return true;
+  };
+  backend.evaluate = [&](ModuleOp source, ModuleOp physical,
+                         ArrayRef<NeighborhoodShape> shapes,
+                         const TaskflowSourceNormalizationWitness &witness) {
+    ++calls;
+    ProgramSearchEvaluation result;
+    std::string error;
+    GenericAnalysis analysis;
+    if (failed(verifyTaskflowSourceNormalization(source, physical, witness,
+                                                 error)) ||
+        !analyzeGenericProgram(physical, analysis, error)) {
+      result.feasibilityKnown = false;
+      result.message = error;
+      return result;
+    }
+    int64_t largest = 0;
+    for (const auto &task : analysis.tasks)
+      largest = std::max(largest,
+                         task.loops.front().upper - task.loops.front().lower);
+    result.feasible = true;
+    result.costMs = largest + analysis.tasks.size() * 0.2;
+    result.result = llvm::json::Object{{"synthetic_contract_only", true},
+                                       {"physical_speedup_claim", false}};
+    return result;
+  };
+  SourceSearchOptions options;
+  options.maxRounds = 2;
+  options.beamWidth = 2;
+  options.actions.shapeDomain = {2, 2};
+  options.actions.maxFissionActionsPerTask = 4;
+  SourceSearchResult result;
+  std::string error;
+  const std::vector<NeighborhoodShape> invalidShapes{{"unknown", 1, 1}};
+  const std::vector<NeighborhoodShape> initialShapes{{"Pointwise", 1, 1}};
+  if (succeeded(searchTaskflowSource(*parent, "pointwise", invalidShapes,
+                                     backend, options, result, error)) ||
+      calls)
+    return 9;
+  if (failed(searchTaskflowSource(*parent, "pointwise", {}, backend, options,
+                                  result, error)) ||
+      !result.bestCostMs || *result.bestCostMs >= 15.2 ||
+      result.bestActions.empty() || !calls ||
+      !result.report.getInteger("unknown").value_or(0) ||
+      result.report.getBoolean("global_optimality_claim").value_or(true)) {
+    llvm::errs() << error;
+    return 4;
+  }
+  auto record = serializeSourceSearchReplay(
+      "pointwise", backend.identity, backend.capabilityIdentity,
+      result.bestActions, result.bestShapes);
+  std::string function, identity, capability;
+  std::vector<NeighborhoodAction> history;
+  std::vector<NeighborhoodShape> shapes;
+  if (failed(parseSourceSearchReplay(record, function, identity, capability,
+                                     history, shapes, error)) ||
+      identity != backend.identity ||
+      capability != backend.capabilityIdentity ||
+      failed(verifySourceActionReplay(*parent, *result.bestSource, function,
+                                      history, initialShapes, shapes,
+                                      options.actions.shapeDomain, error)))
+    return 5;
+
+  // A limited evaluation quota must sample both target families and both
+  // actual source task scopes before taking a second option for one scope.
+  auto fairSource = parent->clone();
+  if (failed(materializeTaskflowFission(fairSource, "pointwise", "Pointwise",
+                                        {0, 1}, error)))
+    return 10;
+  auto fairBackend = backend;
+  fairBackend.materialize = [](ModuleOp trial, StringRef,
+                               const NeighborhoodPrimitive &primitive,
+                               std::string &) {
+    trial->setAttr("orbit.synthetic_probe",
+                   StringAttr::get(trial.getContext(), primitive.mode));
+    return success();
+  };
+  fairBackend.enumerate =
+      [](ModuleOp trial, StringRef, const SourceActionOptions &,
+         std::vector<NeighborhoodAction> &actions, std::string &) {
+        std::vector<std::string> tasks;
+        trial.walk([&](taskflow::TaskflowTaskOp task) {
+          tasks.push_back(task.getTaskName().str());
+        });
+        for (const auto &family : {"native-mapping", "native-task-tile"})
+          for (const auto &task : tasks)
+            for (unsigned option = 0; option < 8; ++option) {
+              NeighborhoodPrimitive primitive;
+              primitive.kind = "synthetic-probe";
+              primitive.firstTask = task;
+              primitive.mode = std::string(family) + ":" + task + ":" +
+                               std::to_string(option);
+              actions.push_back({family, primitive.mode, {primitive}});
+            }
+        return success();
+      };
+  auto fairOptions = options;
+  fairOptions.maxRounds = 1;
+  fairOptions.maxEvaluations = 5;
+  fairOptions.actions.shapeDomain = {1, 1};
+  fairOptions.actions.fission = fairOptions.actions.fusion = false;
+  fairOptions.actions.tiling = fairOptions.actions.replica = false;
+  SourceSearchResult fairResult;
+  if (failed(searchTaskflowSource(fairSource, "pointwise", {}, fairBackend,
+                                  fairOptions, fairResult, error)))
+    return 11;
+  std::set<std::string> sampled;
+  for (const auto &observation : *fairResult.report.getArray("observations")) {
+    auto *row = observation.getAsObject();
+    auto action = row->getString("action");
+    if (action && *action != "baseline")
+      sampled.insert(action->str());
+  }
+  for (const auto &family : {"native-mapping", "native-task-tile"})
+    for (const auto &task : {"Pointwise.split.0", "Pointwise.split.1"})
+      if (!sampled.count(std::string(family) + ":" + task + ":0"))
+        return 12;
+  auto *timings = fairResult.report.getObject("phase_ms");
+  if (!timings || timings->size() != 6 ||
+      timings->getNumber("evaluation").value_or(-1) < 0)
+    return 13;
+  fairSource.erase();
+
+  // Resume a compound action by replaying its actual ordered primitives. An
+  // evaluation quota of two evaluates only baseline and this authenticated
+  // seed.
+  NeighborhoodAction compound;
+  compound.family = "compound";
+  compound.label = "tile-two-axes";
+  compound.primitives = {{"tile", "Pointwise", "", "", 0, 3, {}},
+                         {"tile", "Pointwise.tile.0.0", "", "", 1, 5, {}}};
+  options.seedActions = {compound};
+  options.maxEvaluations = 2;
+  if (failed(searchTaskflowSource(*parent, "pointwise", {}, backend, options,
+                                  result, error)) ||
+      !result.bestCostMs || result.bestActions.size() != 1 ||
+      result.bestActions.front().primitives.size() != 2 ||
+      result.report.getString("termination") != "evaluation-budget")
+    return 6;
+
+  // Unknown/timeout-like observations and absent prices never enter the beam.
+  options.seedActions.clear();
+  options.maxEvaluations = 2;
+  backend.evaluate = [](ModuleOp source, ModuleOp, ArrayRef<NeighborhoodShape>,
+                        const TaskflowSourceNormalizationWitness &) {
+    ProgramSearchEvaluation evaluation;
+    evaluation.feasible = true;
+    unsigned tasks = 0;
+    source.walk([&](taskflow::TaskflowTaskOp) { ++tasks; });
+    if (tasks > 1)
+      evaluation.costMs = 10.0;
+    return evaluation;
+  };
+  if (failed(searchTaskflowSource(*parent, "pointwise", {}, backend, options,
+                                  result, error)) ||
+      !result.bestCostMs || result.bestActions.empty())
+    return 14; // Unpriced original did not block supported, priced neighbors.
+  backend.evaluate = [](ModuleOp, ModuleOp, ArrayRef<NeighborhoodShape>,
+                        const TaskflowSourceNormalizationWitness &) {
+    ProgramSearchEvaluation evaluation;
+    evaluation.feasible = true;
+    evaluation.feasibilityKnown = false;
+    evaluation.costMs = 0.0; // An unknown zero may never become the winner.
+    evaluation.message = "synthetic timeout; no infeasibility proof";
+    return evaluation;
+  };
+  if (failed(searchTaskflowSource(*parent, "pointwise", {}, backend, options,
+                                  result, error)) ||
+      result.bestCostMs ||
+      result.report.getInteger("backend_rejected").value_or(-1) != 0)
+    return 7;
+  backend.evaluate = [](ModuleOp, ModuleOp physical,
+                        ArrayRef<NeighborhoodShape>,
+                        const TaskflowSourceNormalizationWitness &) {
+    physical->setAttr("orbit.illegal_mutation",
+                      UnitAttr::get(physical.getContext()));
+    return ProgramSearchEvaluation{};
+  };
+  if (succeeded(searchTaskflowSource(*parent, "pointwise", {}, backend, options,
+                                     result, error)) ||
+      error.find("mutated") == std::string::npos)
+    return 8;
+  llvm::outs() << "public beam search, synthetic pricing, replay and unknown "
+                  "checks passed\n";
+  return 0;
+}
diff --git a/test/TaskflowGeneric/source_pipeline_v33.py b/test/TaskflowGeneric/source_pipeline_v33.py
new file mode 100644
index 00000000..229ddb86
--- /dev/null
+++ b/test/TaskflowGeneric/source_pipeline_v33.py
@@ -0,0 +1,96 @@
+#!/usr/bin/env python3
+"""Exercise public source actions through normalization, search and AIR.
+
+The explicit theoretical coefficients only make this a deterministic contract
+test. They are never a measured speedup or an NPU calibration.
+"""
+import argparse
+import json
+from pathlib import Path
+import subprocess
+import tempfile
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--tool", type=Path, required=True)
+    parser.add_argument("--output", type=Path)
+    parser.add_argument("--air", action="store_true")
+    args = parser.parse_args()
+    output = args.output or Path(tempfile.mkdtemp(prefix="orbit-source-v33-"))
+    output.mkdir(parents=True, exist_ok=True)
+    root = Path(__file__).resolve().parents[2]
+    fixture = root / "test/multi-cgra/taskflow/joint-scheduling/tiling-task-public-factors.mlir"
+    source = output / "pointwise.mlir"
+    source.write_text(fixture.read_text().split("// THREE-COUNT")[0]
+                      .replace("xi32", "xf32").replace(" : i32", " : f32")
+                      .replace("arith.addi", "arith.addf"))
+    config = {
+        "generic_air": {
+            "capacity_bytes": 1048576,
+            "capabilities": {"tile_alignment": [1, 1, 1],
+                             "implementations": [{"kind": "scalar", "lanes": 1}]},
+            "theoretical": {"launch_ms": 0.1,
+                            "per_scalar_operation_ms": 0.000001,
+                            "per_transfer_byte_ms": 0.0000001},
+        }
+    }
+    target = output / "target.json"
+    target.write_text(json.dumps(config))
+    checks = []
+
+    def run(name, extra, diagnostic=None):
+        command = [str(args.tool.resolve()), str(source), *extra]
+        result = subprocess.run(command, capture_output=True, text=True, timeout=120)
+        (output / (name + ".command.json")).write_text(json.dumps(command, indent=2))
+        (output / (name + ".stderr")).write_text(result.stderr)
+        assert (result.returncode == 0) if diagnostic is None else (
+            result.returncode != 0 and diagnostic in result.stderr
+        ), (name, result.returncode, result.stderr)
+        checks.append(name)
+
+    pipeline = "builtin.module(func.func(tile-task{task-name=Pointwise axis=0 factor=3}))"
+    common = [f"--source-pass-pipeline={pipeline}", "--normalize-taskflow-source",
+              f"--source-normalization-witness={output / 'normalization.json'}",
+              f"--target-config={target}"]
+    run("tile-normalize-map", common + ["--generic-map",
+        f"--mapping-output={output / 'mapping.json'}",
+        f"--emit-mlir={output / 'normalized.mlir'}"])
+    witness = json.loads((output / "normalization.json").read_text())
+    assert witness["source_replay_verified"] and witness["normalized_tasks"] == 3
+    assert witness["source_fingerprint"] != witness["normalized_fingerprint"]
+    mapping = json.loads((output / "mapping.json").read_text())
+    assert len(mapping["tasks"]) == 3
+    if args.air:
+        air = output / "lowered.air.mlir"
+        run("tile-normalize-air", common + ["--lower-to-air", f"--air-output={air}"])
+        run("tile-check-air", common + [f"--check-air={air}"])
+    config["source_auto_candidates"] = {
+        "function": "pointwise", "rows": 2, "cols": 2,
+        "max_fission_actions": 8,
+    }
+    target.write_text(json.dumps(config))
+    search = output / "search"
+    run("source-search", ["--search", "--backend=air", f"--target-config={target}",
+                          f"--search-output={search}", "--max-rounds=2",
+                          "--max-candidates=24", "--beam-width=3"])
+    report = json.loads((search / "search.json").read_text())
+    assert report["has_best"] and report["physical_execution"] is False
+    assert report["complete_domain"] is False and report["global_optimality_claim"] is False
+    observations = report["observations"]
+    assert any(x["status"] == "scored" for x in observations)
+    assert any(x["status"] == "unsupported-capability" for x in observations)
+    assert all(x["source_replay_verified"] for x in observations)
+    assert {"native-mapping", "native-task-tile", "fission", "tiling"} <= {
+        x["family"] for x in observations
+    }
+    replay = json.loads((search / "replay.json").read_text())
+    assert replay["source_fingerprint"] == report["source_fingerprint"]
+    run("existing-output", ["--search", "--backend=air", f"--target-config={target}",
+                           f"--search-output={search}"], "must be new")
+    print(json.dumps({"status": "passed", "checks": checks,
+                      "device_submissions": 0, "costs": "theoretical contract only"}))
+
+
+if __name__ == "__main__":
+    main()
diff --git a/test/TaskflowGeneric/task-tiles.cpp b/test/TaskflowGeneric/task-tiles.cpp
new file mode 100644
index 00000000..5da9f596
--- /dev/null
+++ b/test/TaskflowGeneric/task-tiles.cpp
@@ -0,0 +1,120 @@
+#include "Taskflow/GenericMapping.h"
+#include "Taskflow/HeterogeneousMapping.h"
+#include "Taskflow/NativeTransforms.h"
+#include "Taskflow/TaskTiling.h"
+#include "TaskflowDialect/TaskflowDialect.h"
+#include "mlir/Dialect/Affine/IR/AffineOps.h"
+#include "mlir/Dialect/Arith/IR/Arith.h"
+#include "mlir/Dialect/Math/IR/Math.h"
+#include "mlir/Dialect/MemRef/IR/MemRef.h"
+#include "mlir/Dialect/SCF/IR/SCF.h"
+#include "mlir/Parser/Parser.h"
+#include "llvm/Support/raw_ostream.h"
+
+using namespace orbit::taskflow;
+int main(int argc, char **argv) {
+  if (argc != 2)
+    return 2;
+  mlir::DialectRegistry registry;
+  registry.insert<mlir::taskflow::TaskflowDialect, mlir::affine::AffineDialect,
+                  mlir::arith::ArithDialect, mlir::func::FuncDialect,
+                  mlir::math::MathDialect, mlir::memref::MemRefDialect,
+                  mlir::scf::SCFDialect>();
+  mlir::MLIRContext context(registry);
+  auto module = mlir::parseSourceFile<mlir::ModuleOp>(argv[1], &context);
+  if (!module)
+    return 2;
+  std::string error;
+  unsigned checks = 0;
+  auto require = [&](bool condition, const char *name) {
+    if (condition) {
+      ++checks;
+      return true;
+    }
+    llvm::errs() << name << ": " << error << "\n";
+    return false;
+  };
+  // Real source tasks have different ranks. Choices use source iterations,
+  // not a shared global M/N/K triple, and survive initializer insertion.
+  if (!require(
+          setTaskTileChoices(*module, 2, {{0, {3, 5, 16}}, {1, {7, 6}}}, error),
+          "set local choices") ||
+      !require(distributeNativeInitialization(*module, error),
+               "distribute initializer"))
+    return 1;
+  GenericAnalysis source;
+  if (!require(analyzeGenericProgram(*module, source, error), "analyze") ||
+      !require(source.tasks.size() == 3, "initializer source lineage"))
+    return 1;
+  std::vector<TaskTileChoice> choices;
+  if (!require(readTaskTileChoices(*module, 3, choices, error), "read") ||
+      !require(choices.size() == 2 && choices[0].task == 1 &&
+                   choices[1].task == 2,
+               "reindexed choices"))
+    return 1;
+  if (!require(setNativeAIRTileSizes(*module, 16, 16, 16, error),
+               "set module fallback"))
+    return 1;
+  GenericMappingPlan plan;
+  if (!require(planGenericMapping(source, llvm::json::Object{}, plan, error),
+               "plan local tiles"))
+    return 1;
+  size_t matrixPhases = 0, reluPhases = 0;
+  for (const auto &phase : plan.phases) {
+    matrixPhases += phase.task == 1;
+    reluPhases += phase.task == 2;
+  }
+  if (!require(matrixPhases == 24 && reluPhases == 9,
+               "independent non-divisor tiles with tails") ||
+      !require(checkGenericMapping(source, plan, error), "checked plan"))
+    return 1;
+  auto forged = plan;
+  forged.taskTileSizes[1][0] = 4;
+  if (!require(!checkGenericMapping(source, forged, error),
+               "reject forged local selection"))
+    return 1;
+  if (!require(!setTaskTileChoices(*module, 3, {{1, {0, 5, 16}}}, error),
+               "reject zero") ||
+      !require(!setTaskTileChoices(*module, 3, {{3, {3}}}, error),
+               "reject out of range") ||
+      !require(!setTaskTileChoices(*module, 3, {{1, {3}}, {1, {5}}}, error),
+               "reject duplicate"))
+    return 1;
+  if (!require(setTaskTileChoices(*module, 3, {{1, {3}}}, error),
+               "syntactic axis request") ||
+      !require(!planGenericMapping(source, llvm::json::Object{}, forged, error),
+               "reject incomplete source axes") ||
+      !require(setTaskTileChoices(*module, 3, choices, error), "restore"))
+    return 1;
+  HeterogeneousMappingChoice devices;
+  // Keep initializer and accumulator together: splitting their in-place
+  // storage across devices is unsupported by the current distinct-ABI bridge.
+  devices.taskDevices = {"cpu", "cpu", "npu"};
+  devices.implementationOwned = true;
+  HeterogeneousMappingPlan parent;
+  if (!require(buildHeterogeneousMapping(source, devices, parent, error),
+               "heterogeneous parent"))
+    return 1;
+  for (size_t region = 0; region < parent.slices.size(); ++region) {
+    mlir::OwningOpRef<mlir::ModuleOp> child;
+    HeterogeneousRegionProjection projection;
+    if (!require(materializeHeterogeneousRegion(parent, region, child,
+                                                projection, error),
+                 "materialize region"))
+      return 1;
+    std::vector<TaskTileChoice> selected;
+    if (!require(readTaskTileChoices(*child, projection.parentTasks.size(),
+                                     selected, error),
+                 "read projected tile choices"))
+      return 1;
+    if (parent.slices[region].device == "cpu") {
+      if (!require(selected.empty(), "CPU selectors inactive"))
+        return 1;
+    } else if (!require(selected.size() == 1 && selected[0].task == 0 &&
+                            selected[0].sizes == choices[1].sizes,
+                        "nonzero parent task reindexed to child zero"))
+      return 1;
+  }
+  llvm::outs() << "Task-local source tiling: " << checks << " checks passed\n";
+  return 0;
+}
diff --git a/test/TaskflowGeneric/task_local_search.py b/test/TaskflowGeneric/task_local_search.py
new file mode 100644
index 00000000..95bd3f53
--- /dev/null
+++ b/test/TaskflowGeneric/task_local_search.py
@@ -0,0 +1,89 @@
+#!/usr/bin/env python3
+"""Run the native search driver: task/axis pages, local choices and replay."""
+import argparse
+import copy
+import hashlib
+import json
+from pathlib import Path
+import subprocess
+
+p = argparse.ArgumentParser()
+p.add_argument('--tool', type=Path, required=True)
+p.add_argument('--output', type=Path, required=True)
+a = p.parse_args()
+a.output.mkdir(parents=True, exist_ok=False)
+root = Path(__file__).resolve().parents[2]
+source = a.output / 'source.mlir'
+text = (root / 'test/TaskflowGeneric/fixtures/heterogeneous-matrix-relu.mlir').read_text()
+source.write_text(text.replace('16x16', '12x12').replace('to 16', 'to 12'))
+config = {
+    'target_version': 'task-local-search-domain-v1',
+    'generic_air': {
+        'capacity_bytes': 1048576,
+        'capabilities': {'tile_alignment': [1, 1, 1],
+                         'implementations': [{'kind': 'scalar', 'lanes': 1}]},
+        'theoretical': {'launch_ms': .1, 'per_scalar_operation_ms': .000001,
+                        'per_transfer_byte_ms': .0000001},
+    },
+    'native_auto_candidates': {'mode': 'tiling-only', 'tile_scope': 'task',
+                               'max_tile_proposals': 5},
+}
+path = a.output / 'target.json'
+path.write_text(json.dumps(config))
+directory = a.output / 'search'
+command = [str(a.tool), str(source), '--search', '--backend=air',
+           '--tile-m=12', '--tile-n=12', '--tile-k=12',
+           f'--target-config={path}', f'--search-output={directory}',
+           '--max-rounds=11', '--max-candidates=128', '--beam-width=1']
+
+def run(name, cmd, success=True):
+    result = subprocess.run(cmd, text=True, capture_output=True)
+    (a.output / f'{name}.stderr').write_text(result.stderr)
+    assert (result.returncode == 0) == success, (name, result.stderr)
+
+run('search', command)
+report = json.loads((directory / 'search.json').read_text())
+# Round one contains only unchanged whole extents. That empty page must not
+# terminate the search before the other sizes and tasks become visible.
+assert len(report['selections']) == 11
+rows = {row['search_key']: row for row in report['archive']}
+assert any(row['round'] >= 10 for row in rows.values())
+assert all(not row['parent'] or row['action'].startswith('auto_task_tiles_')
+           for row in rows.values())
+ranks, nonpowers = set(), set()
+for row in rows.values():
+    location = directory / 'candidates' / row['search_key']
+    assert hashlib.sha256((location / 'taskflow.mlir').read_bytes()).hexdigest() == row['search_key']
+    if row['status'] != 'passed' or not row['parent']:
+        continue
+    mapping = json.loads((location / 'mapping-result.json').read_text())['best_plan']
+    choices = {item['task']: item['sizes'] for item in mapping['task_tile_sizes']}
+    parent_location = directory / 'candidates' / row['parent']
+    parent_mapping = json.loads((parent_location / 'mapping-result.json').read_text())['best_plan']
+    previous = {item['task']: item['sizes']
+                for item in parent_mapping.get('task_tile_sizes', [])}
+    selected = int(row['action'].split('_')[3])
+    # Accumulated actions may leave entries for both tasks. Only the selected
+    # entry changes; inherited choices must survive byte-for-byte as values.
+    for task in set(choices) | set(previous):
+        if task != selected:
+            assert choices.get(task) == previous.get(task), (row['action'], previous, choices)
+    choice = choices[selected]
+    ranks.add(len(choice))
+    nonpowers.update(set(choice) & {3, 5, 6, 9})
+assert ranks == {2, 3}, ranks
+assert nonpowers == {3, 5, 6, 9}, nonpowers
+proposals = json.loads((directory / 'automatic-proposals.json').read_text())
+task_rows = [row for page in proposals['parents'].values() for row in page
+             if row.get('kind') == 'task-tiling']
+assert task_rows and all(row['enumeration_complete'] is False for row in task_rows)
+assert {row['round'] for row in task_rows} >= {2, 6, 10}
+before = (directory / 'search.json').read_bytes()
+run('resume', command + ['--resume'])
+assert json.loads(before)['ranking'] == json.loads((directory / 'search.json').read_text())['ranking']
+# Changing the domain cannot resume an old checkpoint under widened semantics.
+changed = copy.deepcopy(config)
+changed['native_auto_candidates']['tile_scope'] = 'module'
+path.write_text(json.dumps(changed))
+run('changed-domain', command + ['--resume'], False)
+print('native task-local search paging, ranks, source choices and replay passed')
diff --git a/test/TaskflowGeneric/taskflow-fission.cpp b/test/TaskflowGeneric/taskflow-fission.cpp
new file mode 100644
index 00000000..012b8f9b
--- /dev/null
+++ b/test/TaskflowGeneric/taskflow-fission.cpp
@@ -0,0 +1,102 @@
+// Public source-owned fission must work without including or linking Neura.
+#include "Taskflow/TaskflowFission.h"
+#include "TaskflowDialect/TaskflowDialect.h"
+#include "mlir/Dialect/Affine/IR/AffineOps.h"
+#include "mlir/Dialect/Arith/IR/Arith.h"
+#include "mlir/Dialect/Func/IR/FuncOps.h"
+#include "mlir/Dialect/MemRef/IR/MemRef.h"
+#include "mlir/Dialect/SCF/IR/SCF.h"
+#include "mlir/IR/Builders.h"
+#include "mlir/IR/Verifier.h"
+#include "mlir/Parser/Parser.h"
+#include "llvm/Support/raw_ostream.h"
+using namespace mlir;
+using namespace orbit::taskflow;
+
+int main(int argc, char **argv) {
+  if (argc != 2)
+    return 2;
+  DialectRegistry registry;
+  registry.insert<taskflow::TaskflowDialect, affine::AffineDialect,
+                  arith::ArithDialect, func::FuncDialect, memref::MemRefDialect,
+                  scf::SCFDialect>();
+  MLIRContext context(registry);
+  auto parent = parseSourceFile<ModuleOp>(argv[1], &context);
+  if (!parent || failed(verify(*parent)))
+    return 3;
+  taskflow::TaskflowTaskOp task;
+  parent->walk([&](taskflow::TaskflowTaskOp found) { task = found; });
+  std::string error;
+  auto all = enumerateTaskflowFissionPartitions(task, 1000, error);
+  if (failed(all) || all->empty() || !error.empty())
+    return 4;
+  auto bounded = enumerateTaskflowFissionPartitions(task, 1, error);
+  if (failed(bounded) || bounded->size() != 1 || error.empty() ||
+      bounded->front() != all->front())
+    return 5;
+
+  auto candidate = parent->clone();
+  SmallVector<TaskflowFissionAction> actions = {
+      {"source_fission", "Task_0", {0, 1}},
+      {"source_fission", "Task_0.split.1", {0, 1}}};
+  for (const auto &action : actions)
+    if (failed(materializeTaskflowFission(candidate, action.function,
+                                          action.task, action.leftNodes,
+                                          error))) {
+      llvm::errs() << error;
+      return 6;
+    }
+  if (failed(verify(candidate)) ||
+      failed(verifyTaskflowFissionReplay(*parent, candidate, actions, error))) {
+    llvm::errs() << error;
+    return 7;
+  }
+  unsigned stages = 0;
+  bool pruned = true;
+  candidate.walk([&](taskflow::TaskflowTaskOp derived) {
+    ++stages;
+    // All three stages need one input: original input or the previous cut.
+    pruned &= derived.getWillReads().size() == 1;
+  });
+  if (stages != 3 || !pruned)
+    return 8;
+  candidate->setAttr("orbit.unrelated_change", UnitAttr::get(&context));
+  if (succeeded(
+          verifyTaskflowFissionReplay(*parent, candidate, actions, error)))
+    return 9;
+  candidate.erase();
+
+  // Exercise bounded exploration on a DFG larger than the exact-enumeration
+  // threshold. All parameters here are exploration budgets, not legal factors.
+  auto large = parent->clone();
+  memref::StoreOp store;
+  large.walk([&](memref::StoreOp found) { store = found; });
+  OpBuilder builder(store);
+  Value chain = store.getValueToStore();
+  for (unsigned index = 0; index < 20; ++index)
+    chain = builder.create<arith::AddIOp>(store.getLoc(), chain, chain);
+  store.getValueMutable().assign(chain);
+  taskflow::TaskflowTaskOp largeTask;
+  large.walk([&](taskflow::TaskflowTaskOp found) { largeTask = found; });
+  auto largeCuts = enumerateTaskflowFissionPartitions(largeTask, 8, error);
+  if (failed(largeCuts) || largeCuts->size() != 8 || error.empty())
+    return 12;
+  large.erase();
+
+  // Metadata is never authority to start a replay from a purported derived
+  // task that was not produced by an earlier verified action.
+  task->setAttr("amoeba.fission.parent_task",
+                StringAttr::get(&context, "fake"));
+  auto forged = parent->clone();
+  if (failed(materializeTaskflowFission(forged, actions[0].function,
+                                        actions[0].task, actions[0].leftNodes,
+                                        error)))
+    return 10;
+  if (succeeded(verifyTaskflowFissionReplay(
+          *parent, forged, ArrayRef(actions).take_front(1), error)))
+    return 11;
+  forged.erase();
+  llvm::outs() << "public fission ranking, multi-stage replay and lineage "
+                  "checks passed\n";
+  return 0;
+}
diff --git a/test/TaskflowGeneric/taskflow-source-normalization.cpp b/test/TaskflowGeneric/taskflow-source-normalization.cpp
new file mode 100644
index 00000000..0c7e5288
--- /dev/null
+++ b/test/TaskflowGeneric/taskflow-source-normalization.cpp
@@ -0,0 +1,166 @@
+#include "Taskflow/GenericAnalysis.h"
+#include "Taskflow/GenericMapping.h"
+#include "Taskflow/TaskflowFission.h"
+#include "Taskflow/TaskflowSourceNormalization.h"
+#include "Taskflow/TaskflowTiling.h"
+#include "TaskflowDialect/TaskflowDialect.h"
+#include "mlir/Dialect/Affine/IR/AffineOps.h"
+#include "mlir/Dialect/Arith/IR/Arith.h"
+#include "mlir/Dialect/Func/IR/FuncOps.h"
+#include "mlir/Dialect/MemRef/IR/MemRef.h"
+#include "mlir/Dialect/SCF/IR/SCF.h"
+#include "mlir/IR/Builders.h"
+#include "mlir/IR/Diagnostics.h"
+#include "mlir/IR/Verifier.h"
+#include "mlir/Parser/Parser.h"
+#include "llvm/Support/raw_ostream.h"
+using namespace mlir;
+using namespace orbit::taskflow;
+int main(int argc, char **argv) {
+  if (argc != 3)
+    return 2;
+  DialectRegistry registry;
+  registry.insert<taskflow::TaskflowDialect, affine::AffineDialect,
+                  arith::ArithDialect, func::FuncDialect, memref::MemRefDialect,
+                  scf::SCFDialect>();
+  MLIRContext context(registry);
+  auto parent = parseSourceFile<ModuleOp>(argv[1], &context);
+  if (!parent)
+    return 3;
+  std::string error;
+  auto check = [&](ModuleOp source, size_t tasks) {
+    OwningOpRef<ModuleOp> normalized;
+    TaskflowSourceNormalizationWitness witness;
+    if (failed(normalizeTaskflowSource(source, normalized, witness, error)) ||
+        failed(verifyTaskflowSourceNormalization(source, *normalized, witness,
+                                                 error)))
+      return false;
+    GenericAnalysis analysis;
+    if (!analyzeGenericProgram(*normalized, analysis, error) ||
+        analysis.tasks.size() != tasks || witness.normalizedTasks != tasks ||
+        witness.normalizedCounters != tasks * 2)
+      return false;
+    for (const auto &task : analysis.tasks)
+      if (task.loops.size() != 2)
+        return false;
+    // A forged certificate and a mutated physical module are independent
+    // failures; a matching producer-supplied digest is never sufficient.
+    auto forged = witness;
+    ++forged.normalizedTasks;
+    if (succeeded(verifyTaskflowSourceNormalization(source, *normalized, forged,
+                                                    error)))
+      return false;
+    if (tasks == 3) {
+      // Disjoint partial writers share one resident allocation by logical
+      // region. They must not be modeled as a single repeatedly overwritten
+      // physical slot; the final export consumes all three output regions.
+      GenericMappingPlan mapping;
+      llvm::json::Value target = llvm::json::Object{
+          {"generic_air", llvm::json::Object{{"capacity_bytes", 24576}}}};
+      if (!planGenericMapping(analysis, target, mapping, error) ||
+          !checkGenericMapping(analysis, mapping, error))
+        return false;
+      auto forgedMapping = mapping;
+      bool forgedAllocation = false;
+      for (auto &allocation : forgedMapping.communication.allocations)
+        if (allocation.memory == mapping.memoryBinding.localMemory &&
+            analysis.storages[allocation.storage].role == "output") {
+          allocation.addressing = "reusable-slot";
+          forgedAllocation = true;
+        }
+      if (!forgedAllocation ||
+          checkGenericMapping(analysis, forgedMapping, error))
+        return false;
+      // Returning a different same-typed input handle must not authenticate
+      // an output completion just because the indexed stores are correct.
+      auto badYield = normalized->clone();
+      bool forgedYield = false;
+      badYield.walk([&](taskflow::TaskflowTaskOp task) {
+        if (!forgedYield) {
+          auto yield = cast<taskflow::TaskflowYieldOp>(
+              task.getBody().front().getTerminator());
+          yield.getDoneWritesMutable().slice(0, 1).assign(
+              task.getBody().front().getArgument(0));
+          forgedYield = true;
+        }
+      });
+      {
+        ScopedDiagnosticHandler diagnostics(
+            &context, [](Diagnostic &) { return success(); });
+        if (!forgedYield || succeeded(verify(badYield)))
+          return false;
+      }
+      badYield.erase();
+      // Preserve a compatible cast of the actual output handle. Storage
+      // identity, rather than literal SSA equality, is the required invariant.
+      auto castYield = normalized->clone();
+      castYield.walk([&](taskflow::TaskflowTaskOp task) {
+        auto yield = cast<taskflow::TaskflowYieldOp>(
+            task.getBody().front().getTerminator());
+        Value output =
+            task.getBody().front().getArgument(task.getWillReads().size());
+        OpBuilder builder(yield);
+        auto alias = builder.create<memref::CastOp>(task.getLoc(),
+                                                    output.getType(), output);
+        yield.getDoneWritesMutable().slice(0, 1).assign(alias.getResult());
+      });
+      if (failed(verify(castYield)))
+        return false;
+      castYield.erase();
+      // Coordinate forgery invalidates the normalized join independently of
+      // the replay witness. Change an actual store index, not metadata.
+      auto badIndex = normalized->clone();
+      bool changed = false;
+      badIndex.walk([&](memref::StoreOp store) {
+        if (!changed) {
+          store.getIndicesMutable().slice(0, 1).assign(store.getIndices()[1]);
+          changed = true;
+        }
+      });
+      {
+        ScopedDiagnosticHandler diagnostics(
+            &context, [](Diagnostic &) { return success(); });
+        if (!changed || succeeded(verify(badIndex)))
+          return false;
+      }
+      badIndex.erase();
+    }
+    normalized.get()->setAttr("orbit.mutated", UnitAttr::get(&context));
+    if (succeeded(verifyTaskflowSourceNormalization(source, *normalized,
+                                                    witness, error)))
+      return false;
+    return true;
+  };
+  if (!check(*parent, 1)) {
+    llvm::errs() << error;
+    return 4;
+  }
+  auto tiled = parent->clone();
+  if (failed(materializeTaskflowTiling(tiled, {"pointwise", "Pointwise", 0, 3},
+                                       error)) ||
+      !check(tiled, 3)) {
+    llvm::errs() << error;
+    return 5;
+  }
+  tiled.erase();
+  auto split = parent->clone();
+  if (failed(materializeTaskflowFission(split, "pointwise", "Pointwise", {0, 1},
+                                        error)) ||
+      !check(split, 2)) {
+    llvm::errs() << error;
+    return 6;
+  }
+  split.erase();
+  auto recurrence = parseSourceFile<ModuleOp>(argv[2], &context);
+  if (!recurrence)
+    return 7;
+  OwningOpRef<ModuleOp> rejected;
+  TaskflowSourceNormalizationWitness witness;
+  if (succeeded(
+          normalizeTaskflowSource(*recurrence, rejected, witness, error)) ||
+      rejected || error.find("recurrence") == std::string::npos)
+    return 8;
+  llvm::outs()
+      << "source normalization, generic analysis and replay checks passed\n";
+  return 0;
+}
diff --git a/test/TaskflowGeneric/taskflow-source-replica.cpp b/test/TaskflowGeneric/taskflow-source-replica.cpp
new file mode 100644
index 00000000..121a57dd
--- /dev/null
+++ b/test/TaskflowGeneric/taskflow-source-replica.cpp
@@ -0,0 +1,95 @@
+// Independent source partition proof, not evidence of physical concurrency.
+#include "Taskflow/GenericAnalysis.h"
+#include "Taskflow/TaskflowReplica.h"
+#include "Taskflow/TaskflowSourceNormalization.h"
+#include "TaskflowDialect/TaskflowDialect.h"
+#include "TaskflowDialect/TaskflowOps.h"
+#include "mlir/Dialect/Affine/IR/AffineOps.h"
+#include "mlir/Dialect/Arith/IR/Arith.h"
+#include "mlir/Dialect/Func/IR/FuncOps.h"
+#include "mlir/Dialect/MemRef/IR/MemRef.h"
+#include "mlir/IR/Verifier.h"
+#include "mlir/Parser/Parser.h"
+#include "llvm/Support/raw_ostream.h"
+#include <set>
+using namespace mlir;
+using namespace orbit::taskflow;
+int main(int argc, char **argv) {
+  if (argc != 2)
+    return 2;
+  DialectRegistry registry;
+  registry
+      .insert<taskflow::TaskflowDialect, affine::AffineDialect,
+              arith::ArithDialect, func::FuncDialect, memref::MemRefDialect>();
+  MLIRContext context(registry);
+  auto source = parseSourceFile<ModuleOp>(argv[1], &context);
+  if (!source)
+    return 3;
+  std::string error;
+  for (int64_t count : {3, 5, 6, 9}) {
+    auto candidate = source->clone();
+    TaskflowReplicaAction action{"pointwise", "Pointwise", 0, count};
+    if (failed(materializeTaskflowReplicas(candidate, action, error)) ||
+        !hasTaskflowReplicaGroups(candidate) ||
+        failed(
+            verifyTaskflowReplicaReplay(*source, candidate, {action}, error))) {
+      llvm::errs() << error;
+      return 4;
+    }
+    std::set<int64_t> instances;
+    bool valid = true;
+    candidate.walk([&](taskflow::TaskflowTaskOp task) {
+      auto group = task->getAttrOfType<StringAttr>("orbit.replica.group");
+      auto ordinal = task->getAttrOfType<IntegerAttr>("orbit.replica.instance");
+      auto declared = task->getAttrOfType<IntegerAttr>("orbit.replica.count");
+      valid &= group && group.getValue() == "pointwise/Pointwise" && ordinal &&
+               declared && declared.getInt() == count &&
+               instances.insert(ordinal.getInt()).second &&
+               task->hasAttr("orbit.replica.requires_independent_resources");
+    });
+    if (!valid || instances.size() != static_cast<size_t>(count))
+      return 5;
+    OwningOpRef<ModuleOp> physical;
+    TaskflowSourceNormalizationWitness witness;
+    GenericAnalysis analysis;
+    if (failed(normalizeTaskflowSource(candidate, physical, witness, error)) ||
+        !hasTaskflowReplicaGroups(*physical) ||
+        !analyzeGenericProgram(*physical, analysis, error)) {
+      llvm::errs() << error;
+      return 6;
+    }
+    int64_t iterations = 0;
+    for (const auto &task : analysis.tasks) {
+      int64_t work = 1;
+      for (const auto &loop : task.loops)
+        work *= loop.upper - loop.lower;
+      iterations += work;
+    }
+    if (iterations != 150)
+      return 7;
+    bool changed = false;
+    candidate.walk([&](taskflow::TaskflowTaskOp task) {
+      if (!changed) {
+        task->setAttr("orbit.replica.count",
+                      IntegerAttr::get(IntegerType::get(&context, 64), 99));
+        changed = true;
+      }
+    });
+    if (succeeded(
+            verifyTaskflowReplicaReplay(*source, candidate, {action}, error)))
+      return 8;
+    candidate.erase();
+  }
+  auto invalid = source->clone();
+  if (succeeded(materializeTaskflowReplicas(
+          invalid, {"pointwise", "Pointwise", 0, 16}, error)))
+    return 9;
+  unsigned tasks = 0;
+  invalid.walk([&](taskflow::TaskflowTaskOp) { ++tasks; });
+  if (tasks != 1 || hasTaskflowReplicaGroups(invalid))
+    return 10;
+  invalid.erase();
+  llvm::outs()
+      << "independent source replica coverage, work and replay checks passed\n";
+  return 0;
+}
diff --git a/test/TaskflowGeneric/taskflow-source-tiling.cpp b/test/TaskflowGeneric/taskflow-source-tiling.cpp
new file mode 100644
index 00000000..9699c8e7
--- /dev/null
+++ b/test/TaskflowGeneric/taskflow-source-tiling.cpp
@@ -0,0 +1,76 @@
+#include "Taskflow/TaskflowTiling.h"
+#include "TaskflowDialect/TaskflowDialect.h"
+#include "TaskflowDialect/TaskflowOps.h"
+#include "mlir/Dialect/Arith/IR/Arith.h"
+#include "mlir/Dialect/Func/IR/FuncOps.h"
+#include "mlir/Dialect/MemRef/IR/MemRef.h"
+#include "mlir/IR/Builders.h"
+#include "mlir/IR/Verifier.h"
+#include "mlir/Parser/Parser.h"
+#include "llvm/Support/raw_ostream.h"
+using namespace mlir;
+using namespace orbit::taskflow;
+static std::string text(ModuleOp module) {
+  std::string bytes;
+  llvm::raw_string_ostream stream(bytes);
+  module.print(stream, OpPrintingFlags().printGenericOpForm());
+  stream.flush();
+  return bytes;
+}
+int main(int argc, char **argv) {
+  if (argc != 2)
+    return 2;
+  DialectRegistry registry;
+  registry.insert<taskflow::TaskflowDialect, arith::ArithDialect,
+                  func::FuncDialect, memref::MemRefDialect>();
+  MLIRContext context(registry);
+  auto parent = parseSourceFile<ModuleOp>(argv[1], &context);
+  if (!parent || failed(verify(*parent)))
+    return 3;
+  std::string error;
+  for (int64_t factor : {3, 5, 6, 9}) {
+    auto candidate = parent->clone();
+    TaskflowTilingAction action{"pointwise", "Pointwise", 0, factor};
+    if (failed(materializeTaskflowTiling(candidate, action, error)) ||
+        failed(
+            verifyTaskflowTilingReplay(*parent, candidate, {action}, error))) {
+      llvm::errs() << error;
+      return 4;
+    }
+    unsigned count = 0;
+    candidate.walk([&](taskflow::TaskflowTaskOp) { ++count; });
+    if (count != static_cast<unsigned>(factor))
+      return 5;
+    candidate.erase();
+  }
+  auto candidate = parent->clone();
+  SmallVector<TaskflowTilingAction> actions = {
+      {"pointwise", "Pointwise", 0, 3},
+      {"pointwise", "Pointwise.tile.0.0", 1, 5}};
+  for (const auto &action : actions)
+    if (failed(materializeTaskflowTiling(candidate, action, error)))
+      return 6;
+  if (failed(verifyTaskflowTilingReplay(*parent, candidate, actions, error)))
+    return 7;
+  candidate->setAttr("orbit.forged", UnitAttr::get(&context));
+  if (succeeded(verifyTaskflowTilingReplay(*parent, candidate, actions, error)))
+    return 8;
+  candidate.erase();
+
+  // Output feedback is not an independent interval partition. Rejection must
+  // happen without mutating the caller's module, even when it verifies as IR.
+  auto feedback = parent->clone();
+  feedback.walk([&](memref::LoadOp load) {
+    auto task = load->getParentOfType<taskflow::TaskflowTaskOp>();
+    load.getMemrefMutable().assign(task.getBody().front().getArgument(1));
+  });
+  auto before = text(feedback);
+  if (succeeded(materializeTaskflowTiling(
+          feedback, {"pointwise", "Pointwise", 0, 3}, error)) ||
+      text(feedback) != before)
+    return 9;
+  feedback.erase();
+  llvm::outs()
+      << "public source tiling factors, replay and feedback checks passed\n";
+  return 0;
+}
diff --git a/test/multi-cgra/taskflow/joint-scheduling/fission-task-fanout.mlir b/test/multi-cgra/taskflow/joint-scheduling/fission-task-fanout.mlir
new file mode 100644
index 00000000..366acf1b
--- /dev/null
+++ b/test/multi-cgra/taskflow/joint-scheduling/fission-task-fanout.mlir
@@ -0,0 +1,51 @@
+// RUN: mlir-amoeba-opt %s '--pass-pipeline=builtin.module(func.func(fission-task{task-name=Task_0 left-nodes=0:1}))' --verify-each | FileCheck %s
+// One live SSA value, even with repeated operands and multiple consumers,
+// requires exactly one temporary tensor and one load in the consuming stage.
+module {
+  func.func @source_fission(
+      %bound_arg: i32,
+      %input: memref<4xi32> {amoeba.noalias},
+      %output: memref<4xi32> {amoeba.noalias})
+      attributes {amoeba.static_bound.arg.0 = 4 : i64} {
+    %bound = arith.index_cast %bound_arg : i32 to index
+    // expected-error @+1 {{left-nodes must be predecessor closed}}
+    %done_writes = taskflow.task @Task_0
+        will_reads(%input : memref<4xi32>)
+        will_writes(%output : memref<4xi32>)
+        value_inputs(%bound : index)
+        [original_read_memrefs(%input : memref<4xi32>),
+         original_write_memrefs(%output : memref<4xi32>)]
+        {dlp_replicable = true, runtime_managable = true}
+        : (memref<4xi32>, memref<4xi32>, index) -> (memref<4xi32>) {
+      ^bb0(%read: memref<4xi32>, %write: memref<4xi32>, %task_bound: index):
+        %zero = arith.constant 0 : index
+        %one = arith.constant 1 : index
+        %counter = taskflow.counter from %zero to %task_bound step %one
+            : index
+        "taskflow.hyperblock"(%counter)
+            <{operandSegmentSizes = array<i32: 1, 0>}> ({
+          ^bb0(%i: index):
+            %value = memref.load %read[%i] : memref<4xi32>
+            %twice = arith.addi %value, %value : i32
+            %square = arith.muli %twice, %twice : i32
+            %sum = arith.addi %twice, %square : i32
+            memref.store %sum, %write[%i] : memref<4xi32>
+            "taskflow.hyperblock.yield"() : () -> ()
+        }) : (index) -> ()
+        taskflow.yield done_writes(%write : memref<4xi32>)
+    }
+    func.return
+  }
+}
+
+
+// CHECK-COUNT-1: memref.alloc() : memref<4xi32>
+// CHECK: taskflow.task @Task_0.split.0
+// CHECK: arith.addi
+// CHECK: memref.store
+// CHECK-NOT: memref.store
+// CHECK: taskflow.task @Task_0.split.1
+// CHECK: %[[CUT:.*]] = memref.load
+// CHECK-NOT: memref.load
+// CHECK: %[[SQUARE:.*]] = arith.muli %[[CUT]], %[[CUT]]
+// CHECK: arith.addi %[[CUT]], %[[SQUARE]]
diff --git a/test/multi-cgra/taskflow/joint-scheduling/run-source-domain-neighborhood-checks.py b/test/multi-cgra/taskflow/joint-scheduling/run-source-domain-neighborhood-checks.py
new file mode 100644
index 00000000..f522ac61
--- /dev/null
+++ b/test/multi-cgra/taskflow/joint-scheduling/run-source-domain-neighborhood-checks.py
@@ -0,0 +1,101 @@
+#!/usr/bin/env python3
+"""Exercise non-whitelisted source partitions and target-bound replay."""
+from __future__ import annotations
+
+import importlib.util
+import json
+import pathlib
+import re
+import subprocess
+import sys
+import tempfile
+
+
+def main() -> None:
+    fixture, optimizer, architecture = sys.argv[1:]
+    fixture = pathlib.Path(fixture).resolve()
+    architecture = pathlib.Path(architecture).resolve()
+    spec = importlib.util.spec_from_file_location(
+        "replay_checks", fixture.with_name("run-joint-neighborhood-action-replay-checks.py")
+    )
+    helpers = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(helpers)
+    with tempfile.TemporaryDirectory(prefix="source-domain-neighborhood-") as tmp:
+        directory = pathlib.Path(tmp)
+        source = directory / "source.mlir"
+        # The existing fixture is a simple two-axis copy; 360 permits both
+        # odd and composite partitions without changing its dependency graph.
+        text = re.sub(r"(?<![A-Za-z0-9])4(?![A-Za-z0-9])", "360", fixture.read_text().replace("4x1", "360x1"))
+        text = text.replace(
+            "    %c0 =", "    %input_alias = memref.cast %input : memref<360x1xi32> to memref<360x1xi32>\n    %c0 =", 1
+        ).replace("original_read_memrefs(%input :", "original_read_memrefs(%input_alias :")
+        source.write_text(text)
+        canonical = directory / "canonical.mlir"
+        helpers.run([
+            optimizer, str(source),
+            "--pass-pipeline=builtin.module(bind-source-iteration-domain)",
+            "-o", str(canonical),
+        ], True)
+
+        def replay(label, actions, success=True, change=None):
+            output = directory / label
+            action_file = directory / f"{label}.json"
+            helpers.write_action_file(action_file, canonical, canonical, actions, 0)
+            document = json.loads(action_file.read_text())
+            document.update({
+                "schema": "orbit-joint-neighborhood-typed-actions-v2-source-domain",
+                "rewriteImplementationContract":
+                    "orbit-joint-graph-rewrite-contract-v10-source-domain",
+                "targetShapeDomain": {
+                    "target": "neura", "architectureInput": str(architecture),
+                    "architectureExactBytes": architecture.read_text(),
+                    "rows": 4, "cols": 4,
+                },
+            })
+            if change:
+                change(document)
+            action_file.write_text(json.dumps(document))
+            options = " ".join([
+                f"action-file={action_file}", f"canonical-input={canonical}",
+                f"candidate-input={canonical}", f"function={helpers.FUNCTION}",
+                "stage=full-joint", "max-partition-factor=0",
+                f"output-dir={output}",
+            ])
+            result = helpers.run([
+                optimizer, str(canonical),
+                f"--neura-architecture-spec={architecture}",
+                "--pass-pipeline=builtin.module(replay-joint-neighborhood-actions{"
+                + options + "})", "-o", "/dev/null",
+            ], success)
+            if success:
+                facts = helpers.assert_complete(output, len(actions))
+                if facts["rewrite_implementation_contract"] != document["rewriteImplementationContract"]:
+                    raise SystemExit("replay omitted the source-domain identity")
+            elif output.exists():
+                raise SystemExit("failed replay published a partial result")
+            return result
+
+        for factor in (3, 5, 6, 9, 13):
+            replay(f"tile-{factor}", [helpers.tile("Task", factor)])
+        for factor in (3, 5, 6, 9, 13):
+            action = helpers.tile("Task", factor)
+            action.update(family="replica", label=f"replica:Task:axis=0:factor={factor}")
+            action["primitives"][0]["kind"] = "replica"
+            replay(f"replica-{factor}", [action])
+        replay("multi-step", [helpers.tile("Task", 6), helpers.tile("Task.tile.0.0", 5)])
+        replay("shape-area-nine", [helpers.shape("Task", 3, 3)])
+        replay("shape-outside-target", [helpers.shape("Task", 5, 1)], False)
+        replay("too-many-parts", [helpers.tile("Task", 361)], False)
+        replay("huge-factor", [helpers.tile("Task", (1 << 63) - 1)], False)
+        replay("non-positive", [helpers.tile("Task", 0)], False)
+        replay("legacy-schema-auto-rejected", [helpers.identity()], False,
+               lambda d: d.update(schema=helpers.SCHEMA))
+        replay("target-byte-drift", [helpers.identity()], False,
+               lambda d: d["targetShapeDomain"].update(architectureExactBytes="different"))
+        replay("target-geometry-drift", [helpers.identity()], False,
+               lambda d: d["targetShapeDomain"].update(rows=8))
+    print("source-domain neighborhood replay checks passed")
+
+
+if __name__ == "__main__":
+    main()
diff --git a/test/multi-cgra/taskflow/joint-scheduling/tiling-task-public-factors.mlir b/test/multi-cgra/taskflow/joint-scheduling/tiling-task-public-factors.mlir
new file mode 100644
index 00000000..34366589
--- /dev/null
+++ b/test/multi-cgra/taskflow/joint-scheduling/tiling-task-public-factors.mlir
@@ -0,0 +1,49 @@
+// RUN: mlir-amoeba-opt %s '--tile-task=task-name=Pointwise axis=0 factor=3' --verify-each | FileCheck %s --check-prefix=THREE
+// RUN: mlir-amoeba-opt %s '--tile-task=task-name=Pointwise axis=0 factor=5' --verify-each | FileCheck %s --check-prefix=FIVE
+// RUN: mlir-amoeba-opt %s '--tile-task=task-name=Pointwise axis=0 factor=6' --verify-each | FileCheck %s --check-prefix=SIX
+// RUN: mlir-amoeba-opt %s '--tile-task=task-name=Pointwise axis=0 factor=9' --verify-each | FileCheck %s --check-prefix=NINE
+// RUN: mlir-amoeba-opt %s '--pass-pipeline=builtin.module(func.func(tile-task{task-name=Pointwise axis=0 factor=3},tile-task{task-name=Pointwise.tile.0.0 axis=1 factor=5}))' --verify-each | FileCheck %s --check-prefix=MULTI
+// No power-of-two whitelist or accumulated factor cap: uneven intervals cover
+// the exact domain, and a second action may tile a derived child on another axis.
+module {
+  func.func @pointwise(%input: memref<15x10xi32> {amoeba.noalias, orbit.role = "input"},
+                       %output: memref<15x10xi32> {amoeba.noalias, orbit.role = "output"}) attributes {orbit.noalias} {
+    %done = taskflow.task @Pointwise
+        will_reads(%input : memref<15x10xi32>)
+        will_writes(%output : memref<15x10xi32>)
+        [original_read_memrefs(%input : memref<15x10xi32>),
+         original_write_memrefs(%output : memref<15x10xi32>)]
+        : (memref<15x10xi32>, memref<15x10xi32>) -> memref<15x10xi32> {
+      ^bb0(%read: memref<15x10xi32>, %write: memref<15x10xi32>):
+        %zero = arith.constant 0 : index
+        %one = arith.constant 1 : index
+        %fifteen = arith.constant 15 : index
+        %ten = arith.constant 10 : index
+        %m = taskflow.counter from %zero to %fifteen step %one : index
+        %n = taskflow.counter parent(%m : index) from %zero to %ten step %one : index
+        "taskflow.hyperblock"(%m, %n)
+            <{operandSegmentSizes = array<i32: 2, 0>}> ({
+          ^bb0(%i: index, %j: index):
+            %value = memref.load %read[%i, %j] : memref<15x10xi32>
+            %twice = arith.addi %value, %value : i32
+            memref.store %twice, %write[%i, %j] : memref<15x10xi32>
+            "taskflow.hyperblock.yield"() : () -> ()
+        }) : (index, index) -> ()
+        taskflow.yield done_writes(%write : memref<15x10xi32>)
+    }
+    func.return
+  }
+}
+// THREE-COUNT-3: taskflow.task @Pointwise.tile.0.
+// THREE: taskflow.join
+// FIVE-COUNT-5: taskflow.task @Pointwise.tile.0.
+// FIVE: taskflow.join
+// SIX-COUNT-6: taskflow.task @Pointwise.tile.0.
+// SIX: taskflow.join
+// NINE-COUNT-9: taskflow.task @Pointwise.tile.0.
+// NINE: taskflow.join
+// MULTI-COUNT-5: taskflow.task @Pointwise.tile.0.0.tile.1.
+// MULTI: taskflow.join
+// MULTI: taskflow.task @Pointwise.tile.0.1
+// MULTI: taskflow.task @Pointwise.tile.0.2
+// MULTI: taskflow.join
