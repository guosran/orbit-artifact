+std::vector<SearchAction> orbit::taskflow::generateNativeTaskTileActions(
+    const GenericAnalysis &analysis, llvm::ArrayRef<TaskTileChoice> current,
+    const GenericTargetCapabilities &capabilities, uint64_t round,
+    size_t pageSlots) {
+  struct Stream {
+    size_t task, axis;
+    int64_t extent, alignment;
+  };
+  std::vector<Stream> streams;
+  std::vector<std::vector<int64_t>> sizes(analysis.tasks.size());
+  for (size_t task = 0; task < analysis.tasks.size(); ++task) {
+    for (const auto &loop : analysis.tasks[task].loops) {
+      if (loop.upper <= loop.lower || loop.step <= 0 ||
+          (loop.lower < 0 && loop.upper > INT64_MAX + loop.lower))
+        return {};
+      sizes[task].push_back((loop.upper - loop.lower - 1) / loop.step + 1);
+    }
+    for (const auto &choice : current)
+      if (choice.task == task && choice.sizes.size() == sizes[task].size())
+        sizes[task] = choice.sizes;
+    for (size_t axis = 0; axis < analysis.tasks[task].loops.size(); ++axis) {
+      const auto &loop = analysis.tasks[task].loops[axis];
+      int64_t extent = (loop.upper - loop.lower - 1) / loop.step + 1;
+      int64_t alignment = axis < capabilities.tileAlignment.size()
+                              ? capabilities.tileAlignment[axis]
+                              : 1;
+      if (alignment > 0)
+        streams.push_back({task, axis, extent, std::min(extent, alignment)});
+    }
+  }
+  if (streams.empty() || !round || !pageSlots ||
+      round - 1 > (UINT64_MAX - pageSlots) / pageSlots)
+    return {};
+  // A fixed page spans task/axis streams round-robin. Each stream advances
+  // even when its proposal is a duplicate, invalid or already the current
+  // choice. Small axes cannot consume the larger axes' generation budget.
+  uint64_t first = (round - 1) * pageSlots;
+  std::vector<SearchAction> actions;
+  for (size_t slot = 0; slot < pageSlots; ++slot) {
+    uint64_t position = first + slot;
+    const auto &stream = streams[position % streams.size()];
+    uint64_t visit = position / streams.size();
+    if (visit >= static_cast<uint64_t>(stream.extent))
+      continue;
+    std::vector<int64_t> prefix{stream.extent};
+    if (stream.alignment != stream.extent)
+      prefix.push_back(stream.alignment);
+    int64_t value;
+    if (visit < prefix.size())
+      value = prefix[visit];
+    else {
+      value = static_cast<int64_t>(visit - prefix.size()) + 1;
+      auto excluded = prefix;
+      std::sort(excluded.begin(), excluded.end());
+      for (int64_t reserved : excluded)
+        if (value >= reserved)
+          ++value;
+    }
+    auto requested = sizes[stream.task];
+    requested[stream.axis] = value;
+    if (requested == sizes[stream.task])
+      continue;
+    SearchAction action{"auto_task_tiles_" + std::to_string(stream.task), {}};
+    for (int64_t extent : requested)
+      action.name += "_" + std::to_string(extent);
+    action.taskTile = TaskTileChoice{stream.task, std::move(requested)};
+    actions.push_back(std::move(action));
+  }
+  return actions;
+}
