+//===- TaskflowTiling.h - Source counter-domain partitions ------*- C++ -*-===//
+#ifndef ORBIT_TASKFLOW_TASKFLOW_TILING_H
+#define ORBIT_TASKFLOW_TASKFLOW_TILING_H
+#include "mlir/IR/BuiltinOps.h"
+#include "mlir/Support/LogicalResult.h"
+#include "llvm/ADT/ArrayRef.h"
+#include <cstdint>
+#include <memory>
+#include <string>
+namespace mlir {
+class Pass;
+}
+namespace orbit::taskflow {
+struct TaskflowTilingAction {
+  std::string function, task;
+  int64_t axis = 0;
+  int64_t factor = 2;
+};
+enum class TaskflowDomainPartitionKind { Tiling, IndependentReplicas };
+/// Shared checked interval partition used by tiling and independent replicas.
+mlir::LogicalResult materializeTaskflowDomainPartition(
+    mlir::ModuleOp module, const TaskflowTilingAction &action,
+    TaskflowDomainPartitionKind kind, std::string &error);
+/// Partition a verified source task into factor nonempty contiguous intervals.
+/// All integer factors >=2 within the extent are admitted. Uneven remainders
+/// go to earlier intervals. Failure leaves the caller's module unchanged.
+mlir::LogicalResult
+materializeTaskflowTiling(mlir::ModuleOp module,
+                          const TaskflowTilingAction &action,
+                          std::string &error);
+/// Rebuild ordered actions from the pinned parent, including actions on prior
+/// derived children, and compare exact generic MLIR without debug locations.
+mlir::LogicalResult
+verifyTaskflowTilingReplay(mlir::ModuleOp parent, mlir::ModuleOp candidate,
+                           llvm::ArrayRef<TaskflowTilingAction> actions,
+                           std::string &error);
+std::unique_ptr<mlir::Pass> createTaskflowTilingPass();
+} // namespace orbit::taskflow
+#endif
diff --git a/lib/Taskflow/SourceActions.cpp b/lib/Taskflow/SourceActions.cpp
new file mode 100644
index 00000000..c43da850
--- /dev/null
+++ b/lib/Taskflow/SourceActions.cpp
@@ -0,0 +1,328 @@
+//===- SourceActions.cpp - Source action materialization and proposals
+//-----===//
+#include "Taskflow/SourceActions.h"
+#include "Taskflow/SourceIterationDomain.h"
+#include "Taskflow/TaskflowFission.h"
+#include "Taskflow/TaskflowFusion.h"
+#include "Taskflow/TaskflowReplica.h"
+#include "Taskflow/TaskflowTiling.h"
+#include "TaskflowDialect/TaskflowOps.h"
+#include "mlir/Dialect/Func/IR/FuncOps.h"
+#include "mlir/IR/Diagnostics.h"
+#include "mlir/IR/OperationSupport.h"
+#include "mlir/IR/SymbolTable.h"
+#include "mlir/IR/Verifier.h"
+#include "llvm/ADT/STLExtras.h"
+#include "llvm/ADT/Twine.h"
+#include "llvm/Support/raw_ostream.h"
+#include <algorithm>
+#include <set>
+
+using namespace mlir;
+using namespace mlir::taskflow;
+namespace orbit::taskflow {
+namespace {
+func::FuncOp findFunction(ModuleOp module, StringRef name) {
+  return dyn_cast_or_null<func::FuncOp>(
+      SymbolTable::lookupSymbolIn(module, name));
+}
+LogicalResult applyPrimitive(ModuleOp trial, StringRef function,
+                             const NeighborhoodPrimitive &primitive,
+                             std::string &error,
+                             const SourceActionExtension &extension) {
+  StringRef kind = primitive.kind;
+  if (kind == "noop" || kind == "identity")
+    return success();
+  if (kind == "fission")
+    return materializeTaskflowFission(trial, function, primitive.firstTask,
+                                      primitive.leftNodes, error);
+  if (kind == "replica")
+    return materializeTaskflowReplicas(
+        trial,
+        {function.str(), primitive.firstTask, primitive.axis, primitive.factor},
+        error);
+  if (kind == "tile" || kind == "tiling") {
+    if (primitive.factor == 1)
+      return success();
+    return materializeTaskflowTiling(
+        trial,
+        {function.str(), primitive.firstTask, primitive.axis, primitive.factor},
+        error);
+  }
+  if (kind == "fusion" || kind == "sibling-fusion") {
+    auto mode = parseTaskflowFusionKind(
+        kind == "sibling-fusion" ? "sibling" : primitive.mode);
+    auto selected = findFunction(trial, function);
+    if (!mode || !selected) {
+      error = "source fusion requires an explicit supported mode and function";
+      return failure();
+    }
+    return success(succeeded(materializeTaskflowFusion(
+        selected, primitive.firstTask, primitive.secondTask, *mode, error)));
+  }
+  if (extension)
+    return extension(trial, function, primitive, error);
+  error = "unsupported source primitive requires a target extension: " +
+          primitive.kind;
+  return failure();
+}
+} // namespace
+
+FailureOr<SourceActionResult> applySourceAction(
+    ModuleOp source, StringRef function, const NeighborhoodAction &action,
+    ArrayRef<NeighborhoodShape> shapes, NeighborhoodShapeDomain shapeDomain,
+    std::string &error, const SourceActionExtension &extension) {
+  error.clear();
+  if (!source || !findFunction(source, function) || action.canonicalReset) {
+    error = "source action requires a function and an explicit predecessor; "
+            "canonical reset must be resolved by the search controller";
+    return failure();
+  }
+  std::set<std::string> sourceNames, selectedNames;
+  bool ambiguous = false;
+  findFunction(source, function).walk([&](TaskflowTaskOp task) {
+    ambiguous |= !sourceNames.insert(task.getTaskName().str()).second;
+  });
+  if (ambiguous) {
+    error = "source action requires unique task names";
+    return failure();
+  }
+  for (const auto &shape : shapes)
+    if (!sourceNames.count(shape.task) ||
+        !selectedNames.insert(shape.task).second ||
+        !shapeDomain.contains(shape.rows, shape.cols)) {
+      error = "source shape names must be known and unique with valid geometry";
+      return failure();
+    }
+  ScopedDiagnosticHandler handler(source.getContext(), [&](Diagnostic &diag) {
+    llvm::raw_string_ostream stream(error);
+    diag.print(stream);
+    return success();
+  });
+  if (failed(verify(source)))
+    return failure();
+  OwningOpRef<ModuleOp> trial = source.clone();
+  for (const auto &primitive : action.primitives)
+    if (failed(applyPrimitive(*trial, function, primitive, error, extension)))
+      return failure();
+  auto selected = findFunction(*trial, function);
+  if (!selected || failed(verify(*trial)))
+    return failure();
+  SourceActionResult result;
+  std::set<std::string> names;
+  bool valid = true;
+  selected.walk([&](TaskflowTaskOp task) {
+    std::string name = task.getTaskName().str();
+    if (!names.insert(name).second) {
+      error = "source action produced ambiguous task names";
+      valid = false;
+    }
+    NeighborhoodShape shape{name, 1, 1};
+    for (const auto &old : shapes)
+      if (old.task == name)
+        shape = old;
+    result.shapes.push_back(shape);
+  });
+  if (!valid)
+    return failure();
+  if (!action.shapeTask.empty()) {
+    if (!shapeDomain.contains(action.shapeRows, action.shapeCols) ||
+        !names.count(action.shapeTask)) {
+      error =
+          "source action shape is outside the target or its task is missing";
+      return failure();
+    }
+    for (auto &shape : result.shapes)
+      if (shape.task == action.shapeTask) {
+        shape.rows = action.shapeRows;
+        shape.cols = action.shapeCols;
+      }
+  }
+  // Resource selections remain proposals until the target checks physical
+  // realization. They cannot authorize source rewrites or prove placement.
+  result.module = std::move(trial);
+  return std::move(result);
+}
+
+LogicalResult verifySourceActionReplay(
+    ModuleOp parent, ModuleOp candidate, StringRef function,
+    ArrayRef<NeighborhoodAction> actions,
+    ArrayRef<NeighborhoodShape> initialShapes,
+    ArrayRef<NeighborhoodShape> candidateShapes,
+    NeighborhoodShapeDomain shapeDomain, std::string &error,
+    const SourceActionExtension &extension) {
+  error.clear();
+  if (!parent || !candidate || !findFunction(parent, function) ||
+      !findFunction(candidate, function) || failed(verify(parent)) ||
+      failed(verify(candidate))) {
+    error = "source replay requires verified parent and candidate modules";
+    return failure();
+  }
+  OwningOpRef<ModuleOp> replay = parent.clone();
+  std::vector<NeighborhoodShape> shapes(initialShapes.begin(),
+                                        initialShapes.end());
+  for (const auto &action : actions) {
+    auto next = applySourceAction(*replay, function, action, shapes,
+                                  shapeDomain, error, extension);
+    if (failed(next))
+      return failure();
+    replay = std::move(next->module);
+    shapes = std::move(next->shapes);
+  }
+  bool sameShapes = shapes.size() == candidateShapes.size();
+  for (size_t i = 0; sameShapes && i < shapes.size(); ++i)
+    sameShapes = shapes[i].task == candidateShapes[i].task &&
+                 shapes[i].rows == candidateShapes[i].rows &&
+                 shapes[i].cols == candidateShapes[i].cols;
+  if (!sameShapes || !OperationEquivalence::isEquivalentTo(
+                         replay->getOperation(), candidate.getOperation(),
+                         OperationEquivalence::Flags::IgnoreLocations)) {
+    error =
+        "candidate source or resource choices differ from exact action replay";
+    return failure();
+  }
+  return success();
+}
+
+LogicalResult enumerateSourceActions(
+    ModuleOp source, StringRef functionName, const SourceActionOptions &options,
+    std::vector<NeighborhoodAction> &actions,
+    std::vector<std::string> &diagnostics, std::string &error,
+    const SourceActionEnumerationExtension &extension) {
+  actions.clear();
+  diagnostics.clear();
+  error.clear();
+  auto function = source ? findFunction(source, functionName) : func::FuncOp{};
+  if (!function || failed(verify(source)) ||
+      options.maxFissionActionsPerTask == 0) {
+    error =
+        "source action enumeration requires a verified function and cut budget";
+    return failure();
+  }
+  ScopedDiagnosticHandler handler(source.getContext(),
+                                  [&](Diagnostic &) { return success(); });
+  SmallVector<TaskflowTaskOp> tasks;
+  std::set<std::string> names;
+  bool duplicate = false;
+  function.walk([&](TaskflowTaskOp task) {
+    duplicate |= !names.insert(task.getTaskName().str()).second;
+    tasks.push_back(task);
+  });
+  if (duplicate) {
+    error = "source action enumeration requires unique task names";
+    return failure();
+  }
+  std::vector<NeighborhoodAction> generated;
+  generated.push_back({"identity", "identity"});
+  int64_t prefix = static_cast<int64_t>(options.round) + 2;
+  for (TaskflowTaskOp task : tasks) {
+    const std::string name = task.getTaskName().str();
+    if (options.fission) {
+      std::string diagnostic;
+      auto cuts = enumerateTaskflowFissionPartitions(
+          task, options.maxFissionActionsPerTask, diagnostic);
+      if (!diagnostic.empty())
+        diagnostics.push_back(name + ": " + diagnostic);
+      if (succeeded(cuts))
+        for (const auto &cut : *cuts) {
+          NeighborhoodPrimitive primitive;
+          primitive.kind = "fission";
+          primitive.firstTask = name;
+          primitive.leftNodes.assign(cut.begin(), cut.end());
+          std::string label = "fission:" + name + ":left=";
+          for (unsigned node : cut)
+            label += std::to_string(node) + ",";
+          generated.push_back({"fission", label, {primitive}});
+        }
+    }
+    if (options.tiling || options.replica) {
+      SmallVector<TaskflowCounterOp> counters;
+      if (task.getBody().hasOneBlock())
+        for (Operation &operation : task.getBody().front())
+          if (auto counter = dyn_cast<TaskflowCounterOp>(operation))
+            counters.push_back(counter);
+      for (auto [axis, counter] : llvm::enumerate(counters)) {
+        llvm::DenseSet<Value> active;
+        auto low = sourceStaticIndex(counter.getLowerBound(), task, active);
+        auto high = sourceStaticIndex(counter.getUpperBound(), task, active);
+        auto step = sourceStaticIndex(counter.getStep(), task, active);
+        if (!low || !high || !step || *low < 0 || *high <= *low || *step != 1)
+          continue;
+        for (int64_t factor = 2; factor <= std::min(*high - *low, prefix);
+             ++factor) {
+          NeighborhoodPrimitive primitive;
+          primitive.kind = "tile";
+          primitive.firstTask = name;
+          primitive.axis = axis;
+          primitive.factor = factor;
+          if (options.tiling)
+            generated.push_back({"tiling",
+                                 "tile:" + name +
+                                     ":axis=" + std::to_string(axis) +
+                                     ":factor=" + std::to_string(factor),
+                                 {primitive}});
+          if (options.replica) {
+            primitive.kind = "replica";
+            generated.push_back({"replica",
+                                 "replica:" + name +
+                                     ":axis=" + std::to_string(axis) +
+                                     ":count=" + std::to_string(factor),
+                                 {primitive}});
+          }
+        }
+      }
+    }
+    for (int64_t rows = 1; rows <= std::min(prefix, options.shapeDomain.rows);
+         ++rows)
+      for (int64_t cols = 1; cols <= std::min(prefix, options.shapeDomain.cols);
+           ++cols)
+        generated.push_back({"shape",
+                             "shape:" + name + ":" + std::to_string(rows) +
+                                 "x" + std::to_string(cols),
+                             {},
+                             name,
+                             rows,
+                             cols});
+  }
+  if (options.fusion)
+    for (TaskflowTaskOp first : tasks)
+      for (TaskflowTaskOp second : tasks) {
+        if (first == second)
+          continue;
+        for (auto kind : {TaskflowFusionKind::ProducerConsumer,
+                          TaskflowFusionKind::Sibling}) {
+          std::string diagnostic;
+          if (failed(checkTaskflowFusion(first, second, kind, diagnostic)))
+            continue;
+          NeighborhoodPrimitive primitive;
+          primitive.kind = "fusion";
+          primitive.firstTask = first.getTaskName().str();
+          primitive.secondTask = second.getTaskName().str();
+          primitive.mode = kind == TaskflowFusionKind::Sibling
+                               ? "sibling"
+                               : "producer-consumer";
+          generated.push_back({"fusion",
+                               "fusion:" + primitive.firstTask + ":" +
+                                   primitive.secondTask + ":" + primitive.mode,
+                               {primitive}});
+        }
+      }
+  // Do not advertise a syntactic factor as an implemented source action.
+  // The exact public materializers decide legality on private trial modules.
+  for (auto &action : generated) {
+    std::string diagnostic;
+    if (succeeded(applySourceAction(source, functionName, action, {},
+                                    options.shapeDomain, diagnostic)))
+      actions.push_back(std::move(action));
+    else
+      diagnostics.push_back(action.label + ": " + diagnostic);
+  }
+  if (extension) {
+    OwningOpRef<ModuleOp> extensionSource = source.clone();
+    if (failed(
+            extension(*extensionSource, functionName, options, actions, error)))
+      return failure();
+  }
+  return success();
+}
+} // namespace orbit::taskflow
diff --git a/lib/Taskflow/SourceMappingActions.cpp b/lib/Taskflow/SourceMappingActions.cpp
new file mode 100644
index 00000000..e84be336
--- /dev/null
+++ b/lib/Taskflow/SourceMappingActions.cpp
@@ -0,0 +1,312 @@
+//===- SourceMappingActions.cpp - Native policies in source action search
+//---===//
+#include "Taskflow/SourceMappingActions.h"
+#include "Taskflow/NativeTransforms.h"
+#include "Taskflow/Search.h"
+#include "Taskflow/TaskTiling.h"
+#include "Taskflow/TaskflowSourceNormalization.h"
+#include "mlir/AsmParser/AsmParser.h"
+#include "mlir/IR/Builders.h"
+#include "mlir/Parser/Parser.h"
+#include "llvm/ADT/STLExtras.h"
+#include "llvm/Support/raw_ostream.h"
+#include <algorithm>
+#include <set>
+
+using namespace mlir;
+namespace orbit::taskflow {
+namespace {
+constexpr llvm::StringLiteral kBinding = "orbit.source_mapping_binding";
+constexpr llvm::StringLiteral kSchema =
+    "orbit-taskflow-native-source-choice-v1";
+std::string print(Attribute attribute) {
+  std::string result;
+  llvm::raw_string_ostream stream(result);
+  attribute.print(stream);
+  return result;
+}
+bool normalize(ModuleOp source, llvm::StringRef function,
+               OwningOpRef<ModuleOp> &normalized, GenericAnalysis &analysis,
+               std::string &error) {
+  TaskflowSourceNormalizationWitness witness;
+  if (failed(normalizeTaskflowSource(source, normalized, witness, error)) ||
+      !analyzeGenericProgram(*normalized, analysis, error))
+    return false;
+  if (analysis.function.getSymName() != function) {
+    error = "native source action function differs from normalized analysis";
+    return false;
+  }
+  return true;
+}
+DictionaryAttr sourceBinding(const GenericAnalysis &analysis) {
+  auto function = analysis.function;
+  Builder b(function.getContext());
+  SmallVector<Attribute> tasks, storages;
+  for (const auto &task : analysis.tasks)
+    tasks.push_back(b.getStringAttr(task.id));
+  for (const auto &storage : analysis.storages)
+    storages.push_back(b.getStringAttr(storage.id));
+  return b.getDictionaryAttr(
+      {b.getNamedAttr("body", b.getStringAttr(analysis.bodyFingerprint)),
+       b.getNamedAttr("function", b.getStringAttr(function.getSymName())),
+       b.getNamedAttr("tasks", b.getArrayAttr(tasks)),
+       b.getNamedAttr("storages", b.getArrayAttr(storages))});
+}
+DictionaryAttr envelope(const GenericAnalysis &analysis,
+                        const SourceMappingActionOptions &options,
+                        llvm::StringRef field, Attribute value) {
+  auto function = analysis.function;
+  Builder b(function.getContext());
+  return b.getDictionaryAttr(
+      {b.getNamedAttr("schema", b.getStringAttr(kSchema)),
+       b.getNamedAttr("source", sourceBinding(analysis)),
+       b.getNamedAttr("target", b.getStringAttr(options.capabilities.identity)),
+       b.getNamedAttr(field, value)});
+}
+bool decode(const NeighborhoodPrimitive &primitive,
+            const GenericAnalysis &analysis,
+            const SourceMappingActionOptions &options, llvm::StringRef field,
+            DictionaryAttr &payload, std::string &error) {
+  auto function = analysis.function;
+  payload = dyn_cast_or_null<DictionaryAttr>(
+      parseAttribute(primitive.mode, function.getContext()));
+  auto schema = payload ? payload.getAs<StringAttr>("schema") : StringAttr{};
+  auto source =
+      payload ? payload.getAs<DictionaryAttr>("source") : DictionaryAttr{};
+  auto target = payload ? payload.getAs<StringAttr>("target") : StringAttr{};
+  if (!payload || payload.size() != 4 || !schema ||
+      schema.getValue() != kSchema || !source ||
+      source != sourceBinding(analysis) || !target ||
+      target.getValue() != options.capabilities.identity ||
+      !payload.get(field)) {
+    error = "native source action has stale source/target binding or malformed "
+            "fields";
+    return false;
+  }
+  return true;
+}
+bool hasNativeChoices(ModuleOp source) {
+  return source->hasAttr("orbit.mapping") ||
+         source->hasAttr("orbit.task_tiles");
+}
+} // namespace
+
+LogicalResult checkSourceMappingActionBindings(ModuleOp source,
+                                               llvm::StringRef function,
+                                               std::string &error) {
+  error.clear();
+  Attribute raw = source->getAttr(kBinding);
+  if (!hasNativeChoices(source) && !raw)
+    return success();
+  auto bound = dyn_cast_or_null<DictionaryAttr>(raw);
+  OwningOpRef<ModuleOp> normalized;
+  GenericAnalysis analysis;
+  if (!bound || !normalize(source, function, normalized, analysis, error) ||
+      bound != sourceBinding(analysis)) {
+    if (error.empty())
+      error = "native mapping/task tiles refer to a different source graph; "
+              "withdraw and regenerate choices";
+    return failure();
+  }
+  return success();
+}
+
+SourceActionExtension
+makeSourceMappingActionMaterializer(const SourceMappingActionOptions &options) {
+  return [options](ModuleOp source, llvm::StringRef function,
+                   const NeighborhoodPrimitive &primitive,
+                   std::string &error) -> LogicalResult {
+    error.clear();
+    if (primitive.kind != "native-mapping" &&
+        primitive.kind != "native-task-tile" &&
+        primitive.kind != "native-policy-reset") {
+      error = "unsupported native source mapping extension: " + primitive.kind;
+      return failure();
+    }
+    OwningOpRef<ModuleOp> normalized;
+    GenericAnalysis analysis;
+    if (options.capabilities.identity.empty() ||
+        !normalize(source, function, normalized, analysis, error)) {
+      if (error.empty())
+        error = "native source extension requires a target capability identity";
+      return failure();
+    }
+    if (primitive.kind == "native-policy-reset") {
+      // A withdrawal itself is source-bound; never silently drop choices when
+      // a structural edit makes their ordinal interpretation stale.
+      DictionaryAttr payload;
+      if (primitive.firstTask != function ||
+          !decode(primitive, analysis, options, "reset", payload, error) ||
+          !isa<UnitAttr>(payload.get("reset")))
+        return failure();
+      source->removeAttr("orbit.mapping");
+      source->removeAttr("orbit.task_tiles");
+      source->removeAttr(kBinding);
+      return success();
+    }
+    if (failed(checkSourceMappingActionBindings(source, function, error)))
+      return failure();
+    if (primitive.kind == "native-mapping") {
+      DictionaryAttr payload;
+      if (!options.mapping || primitive.firstTask != function ||
+          !decode(primitive, analysis, options, "policy", payload, error))
+        return failure();
+      auto policy = dyn_cast<DictionaryAttr>(payload.get("policy"));
+      if (!policy) {
+        error = "native mapping action policy must be a dictionary";
+        return failure();
+      }
+      normalized.get()->setAttr("orbit.mapping", policy);
+      ProgramMappingChoice choice;
+      if (!readNativeMappingChoice(*normalized, choice, error) ||
+          !setNativeMappingChoice(*normalized, choice, error))
+        return failure();
+      // Canonicalization may also remove the module-wide tile default for a
+      // whole-program realization. Copy the actual public policy effects.
+      if (auto selected = normalized.get()->getAttr("orbit.mapping"))
+        source->setAttr("orbit.mapping", selected);
+      else
+        source->removeAttr("orbit.mapping");
+      if (!normalized.get()->hasAttr("orbit.air_tile_sizes"))
+        source->removeAttr("orbit.air_tile_sizes");
+    } else {
+      DictionaryAttr payload;
+      if (!options.taskTiling ||
+          !decode(primitive, analysis, options, "sizes", payload, error))
+        return failure();
+      auto sizes = dyn_cast<DenseI64ArrayAttr>(payload.get("sizes"));
+      auto found = llvm::find_if(analysis.tasks, [&](const auto &task) {
+        return task.id == primitive.firstTask;
+      });
+      if (found == analysis.tasks.end() || !sizes ||
+          sizes.size() != found->loops.size() || sizes.size() == 0) {
+        error = "native task tile requires the exact named task and all its "
+                "source axes";
+        return failure();
+      }
+      size_t task = static_cast<size_t>(found - analysis.tasks.begin());
+      std::vector<TaskTileChoice> choices;
+      if (!readTaskTileChoices(source, analysis.tasks.size(), choices, error))
+        return failure();
+      auto old = llvm::find_if(
+          choices, [&](const auto &choice) { return choice.task == task; });
+      TaskTileChoice choice{task,
+                            std::vector<int64_t>(sizes.asArrayRef().begin(),
+                                                 sizes.asArrayRef().end())};
+      if (old == choices.end())
+        choices.push_back(std::move(choice));
+      else
+        *old = std::move(choice);
+      if (!setTaskTileChoices(source, analysis.tasks.size(), choices, error))
+        return failure();
+    }
+    if (hasNativeChoices(source))
+      source->setAttr(kBinding, sourceBinding(analysis));
+    else
+      source->removeAttr(kBinding);
+    return success();
+  };
+}
+
+SourceActionEnumerationExtension
+makeSourceMappingActionEnumerator(const SourceMappingActionOptions &options) {
+  return [options](ModuleOp source, llvm::StringRef function,
+                   const SourceActionOptions &search,
+                   std::vector<NeighborhoodAction> &actions,
+                   std::string &error) -> LogicalResult {
+    error.clear();
+    OwningOpRef<ModuleOp> normalized;
+    GenericAnalysis analysis;
+    if (options.capabilities.identity.empty() ||
+        !normalize(source, function, normalized, analysis, error)) {
+      if (error.empty())
+        error = "native source proposals require a target capability identity";
+      return failure();
+    }
+    Builder b(source.getContext());
+    if (hasNativeChoices(source) || source->hasAttr(kBinding)) {
+      NeighborhoodPrimitive reset;
+      reset.kind = "native-policy-reset";
+      reset.firstTask = function.str();
+      reset.mode = print(envelope(analysis, options, "reset", b.getUnitAttr()));
+      // A policy withdrawal alone may revisit an archived root and therefore
+      // disappear under deduplication. Compose it with structural neighbors
+      // so a good residency choice cannot trap the beam on that source graph.
+      for (auto &action : actions)
+        if (llvm::any_of(action.primitives, [](const auto &primitive) {
+              return primitive.kind == "tile" || primitive.kind == "tiling" ||
+                     primitive.kind == "fusion" || primitive.kind == "fission";
+            })) {
+          action.primitives.insert(action.primitives.begin(), reset);
+          action.family = "withdraw-policy+" + action.family;
+          action.label = "withdraw-policy+" + action.label;
+        }
+      actions.push_back(
+          {"native-policy-reset", "native-policy-reset", {reset}});
+    }
+    // A stale imported policy can only be explicitly withdrawn. Regeneration
+    // must not canonically retarget its old numeric task/storage ordinals.
+    std::string bindingError;
+    if (failed(
+            checkSourceMappingActionBindings(source, function, bindingError)))
+      return success();
+    if (options.mapping) {
+      auto choices = discoverGenericMappingChoices(
+          analysis, options.maxResidencyProposals, options.maxResidencyGroups);
+      for (const auto &choice : choices) {
+        OwningOpRef<ModuleOp> trial = normalized->clone();
+        if (!setNativeMappingChoice(*trial, choice, error))
+          return failure();
+        Attribute policy = trial.get()->getAttr("orbit.mapping");
+        if (!policy)
+          policy = b.getDictionaryAttr({});
+        NeighborhoodPrimitive primitive;
+        primitive.kind = "native-mapping";
+        primitive.firstTask = function.str();
+        primitive.mode = print(envelope(analysis, options, "policy", policy));
+        std::string label =
+            "native-mapping:" +
+            staticFingerprint(llvm::json::Value(primitive.mode));
+        actions.push_back({"native-mapping", std::move(label), {primitive}});
+      }
+    }
+    if (options.taskTiling) {
+      std::vector<TaskTileChoice> current;
+      if (!readTaskTileChoices(source, analysis.tasks.size(), current, error))
+        return failure();
+      if (auto global = source->getAttrOfType<DenseI64ArrayAttr>(
+              "orbit.air_tile_sizes")) {
+        for (size_t task = 0; task < analysis.tasks.size(); ++task) {
+          if (llvm::any_of(current, [&](const auto &entry) {
+                return entry.task == task;
+              }))
+            continue;
+          TaskTileChoice choice{task, {}};
+          for (size_t axis = 0; axis < analysis.tasks[task].loops.size();
+               ++axis) {
+            const auto &loop = analysis.tasks[task].loops[axis];
+            int64_t extent = (loop.upper - loop.lower - 1) / loop.step + 1;
+            choice.sizes.push_back(
+                axis < global.size() ? std::min(extent, global[axis]) : extent);
+          }
+          current.push_back(std::move(choice));
+        }
+      }
+      for (const auto &candidate : generateNativeTaskTileActions(
+               analysis, current, options.capabilities,
+               uint64_t(search.round) + 1, options.tilePageSlots)) {
+        const auto &choice = *candidate.taskTile;
+        NeighborhoodPrimitive primitive;
+        primitive.kind = "native-task-tile";
+        primitive.firstTask = analysis.tasks[choice.task].id;
+        primitive.mode = print(envelope(analysis, options, "sizes",
+                                        b.getDenseI64ArrayAttr(choice.sizes)));
+        actions.push_back({"native-task-tile",
+                           candidate.name + ":" + primitive.firstTask,
+                           {primitive}});
+      }
+    }
+    return success();
+  };
+}
