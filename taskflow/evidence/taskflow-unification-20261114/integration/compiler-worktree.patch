--- /dev/null
+++ b/lib/Taskflow/TaskflowReplica.cpp
@@ -0,0 +1,54 @@
+//===- TaskflowReplica.cpp - Independent source-domain replicas -----------===//
+#include "Taskflow/TaskflowReplica.h"
+#include "Taskflow/TaskflowTiling.h"
+#include "TaskflowDialect/TaskflowOps.h"
+#include "mlir/IR/OwningOpRef.h"
+#include "mlir/IR/Verifier.h"
+#include "llvm/Support/raw_ostream.h"
+using namespace mlir;
+namespace orbit::taskflow {
+namespace {
+std::string witness(ModuleOp module) {
+  std::string text;
+  llvm::raw_string_ostream stream(text);
+  module.print(stream, OpPrintingFlags().printGenericOpForm());
+  stream.flush();
+  return text;
+}
+} // namespace
+LogicalResult materializeTaskflowReplicas(ModuleOp module,
+                                          const TaskflowReplicaAction &action,
+                                          std::string &error) {
+  return materializeTaskflowDomainPartition(
+      module, {action.function, action.task, action.axis, action.count},
+      TaskflowDomainPartitionKind::IndependentReplicas, error);
+}
+LogicalResult
+verifyTaskflowReplicaReplay(ModuleOp parent, ModuleOp candidate,
+                            ArrayRef<TaskflowReplicaAction> actions,
+                            std::string &error) {
+  error.clear();
+  if (!parent || !candidate || failed(verify(parent)) ||
+      failed(verify(candidate))) {
+    error = "replica replay requires verified parent and candidate modules";
+    return failure();
+  }
+  OwningOpRef<ModuleOp> replay = parent.clone();
+  for (const auto &action : actions)
+    if (failed(materializeTaskflowReplicas(*replay, action, error)))
+      return failure();
+  if (witness(*replay) != witness(candidate)) {
+    error = "candidate is not the exact independent-replica source replay";
+    return failure();
+  }
+  return success();
+}
+bool hasTaskflowReplicaGroups(ModuleOp module) {
+  bool found = false;
+  if (module)
+    module.walk([&](mlir::taskflow::TaskflowTaskOp task) {
+      found |= task->hasAttr("orbit.replica.group");
+    });
+  return found;
+}
+} // namespace orbit::taskflow
diff --git a/lib/Taskflow/TaskflowSourceNormalization.cpp b/lib/Taskflow/TaskflowSourceNormalization.cpp
new file mode 100644
index 00000000..d16f21a2
--- /dev/null
+++ b/lib/Taskflow/TaskflowSourceNormalization.cpp
@@ -0,0 +1,196 @@
+//===- TaskflowSourceNormalization.cpp - Checked physical form --*- C++ -*-===//
+#include "Taskflow/TaskflowSourceNormalization.h"
+#include "Taskflow/SourceIterationDomain.h"
+#include "TaskflowDialect/TaskflowOps.h"
+#include "mlir/Dialect/Affine/IR/AffineOps.h"
+#include "mlir/Dialect/Arith/IR/Arith.h"
+#include "mlir/Dialect/MemRef/IR/MemRef.h"
+#include "mlir/IR/Diagnostics.h"
+#include "mlir/IR/IRMapping.h"
+#include "mlir/IR/Verifier.h"
+#include "mlir/Interfaces/SideEffectInterfaces.h"
+#include "llvm/ADT/DenseSet.h"
+#include "llvm/ADT/STLExtras.h"
+#include "llvm/ADT/StringExtras.h"
+#include "llvm/Support/SHA256.h"
+#include "llvm/Support/raw_ostream.h"
+using namespace mlir;
+using namespace mlir::taskflow;
+namespace orbit::taskflow {
+namespace {
+std::string bytes(ModuleOp module) {
+  std::string text;
+  llvm::raw_string_ostream stream(text);
+  module.print(stream, OpPrintingFlags().printGenericOpForm());
+  stream.flush();
+  return text;
+}
+std::string fingerprint(StringRef text) {
+  auto digest = llvm::SHA256::hash(llvm::arrayRefFromStringRef(text));
+  return llvm::toHex(digest, true);
+}
+struct Axis {
+  int64_t lower, upper, step;
+};
+LogicalResult normalizeTask(TaskflowTaskOp task,
+                            TaskflowSourceNormalizationWitness &witness,
+                            std::string &error) {
+  SmallVector<TaskflowCounterOp> counters;
+  TaskflowHyperblockOp hyperblock;
+  for (Operation &operation : task.getBody().front()) {
+    if (auto counter = dyn_cast<TaskflowCounterOp>(operation))
+      counters.push_back(counter);
+    else if (auto body = dyn_cast<TaskflowHyperblockOp>(operation)) {
+      if (hyperblock) {
+        error = "normalization requires one canonical hyperblock per task";
+        return failure();
+      }
+      hyperblock = body;
+    }
+  }
+  if (counters.empty() && !hyperblock)
+    return success();
+  if (counters.empty() || !hyperblock || !hyperblock.getBody().hasOneBlock() ||
+      hyperblock.getIndices().size() != counters.size() ||
+      hyperblock.getNumResults() || !hyperblock.getIterArgs().empty()) {
+    error =
+        "normalization rejects noncanonical domains or loop-carried recurrence";
+    return failure();
+  }
+  for (Operation &operation : task.getBody().front()) {
+    if (!isa<TaskflowCounterOp, TaskflowHyperblockOp, TaskflowYieldOp,
+             arith::ConstantOp>(operation)) {
+      error = "normalization rejects unsupported counter scaffolding/control";
+      return failure();
+    }
+    if (isa<TaskflowCounterOp>(operation) &&
+        !operation.isBeforeInBlock(hyperblock)) {
+      error = "normalization requires counters before their hyperblock";
+      return failure();
+    }
+  }
+  Block &body = hyperblock.getBody().front();
+  auto yield = dyn_cast<TaskflowHyperblockYieldOp>(body.getTerminator());
+  if (body.getNumArguments() != counters.size() || !yield ||
+      yield->getNumOperands()) {
+    error = "normalization rejects recurrence or noncanonical hyperblock yield";
+    return failure();
+  }
+  SmallVector<Axis> axes;
+  for (auto [index, counter] : llvm::enumerate(counters)) {
+    auto constant = [&](Value value) {
+      llvm::DenseSet<Value> active;
+      return mlir::taskflow::sourceStaticIndex(value, task, active);
+    };
+    auto lower = constant(counter.getLowerBound());
+    auto upper = constant(counter.getUpperBound());
+    auto step = constant(counter.getStep());
+    if (!lower || !upper || !step || *step <= 0 || *upper <= *lower ||
+        (index == 0 && counter.getParentIndex()) ||
+        (index &&
+         counter.getParentIndex() != counters[index - 1].getCounterIndex()) ||
+        hyperblock.getIndices()[index] != counter.getCounterIndex()) {
+      error = "normalization requires a static ordered counter chain";
+      return failure();
+    }
+    for (Operation *user : counter.getCounterIndex().getUsers())
+      if (user != hyperblock &&
+          (index + 1 >= counters.size() || user != counters[index + 1])) {
+        error = "normalization rejects counter values escaping the canonical "
+                "domain";
+        return failure();
+      }
+    axes.push_back({*lower, *upper, *step});
+  }
+  for (Operation &operation : body.without_terminator())
+    if (operation.getNumRegions() ||
+        (!isa<memref::LoadOp, memref::StoreOp>(operation) &&
+         (!isPure(&operation) || !isMemoryEffectFree(&operation)))) {
+      error =
+          "normalization rejects unproved nested control or unknown effects";
+      return failure();
+    }
+
+  // Loop nesting follows the exact parent-counter order. Clone source scalar
+  // SSA and original indices verbatim through the induction-variable mapping.
+  OpBuilder builder(hyperblock);
+  IRMapping mapping;
+  for (auto [index, axis] : llvm::enumerate(axes)) {
+    auto loop = builder.create<affine::AffineForOp>(
+        hyperblock.getLoc(), axis.lower, axis.upper, axis.step);
+    mapping.map(body.getArgument(index), loop.getInductionVar());
+    builder.setInsertionPoint(loop.getBody()->getTerminator());
+  }
+  for (Operation &operation : body.without_terminator())
+    builder.clone(operation, mapping);
+  hyperblock.erase();
+  for (auto counter : llvm::reverse(counters))
+    counter.erase();
+
+  // These captures describe source counters, not the normalized physical form.
+  // Their full content remains bound by sourceFingerprint in the witness.
+  for (StringRef name : {"amoeba.source_iteration_domain",
+                         "amoeba.source_iteration_capture_pending",
+                         "amoeba.source_iteration_control_binding",
+                         "amoeba.source_iteration_source_control_binding"})
+    task->removeAttr(name);
+  ++witness.normalizedTasks;
+  witness.normalizedCounters += counters.size();
+  return success();
+}
+} // namespace
+LogicalResult
+normalizeTaskflowSource(ModuleOp source, OwningOpRef<ModuleOp> &normalized,
+                        TaskflowSourceNormalizationWitness &witness,
+                        std::string &error) {
+  normalized = nullptr;
+  witness = {};
+  error.clear();
+  if (!source) {
+    error = "normalization requires an immutable source module";
+    return failure();
+  }
+  ScopedDiagnosticHandler diagnostics(source.getContext(),
+                                      [&](Diagnostic &diag) {
+                                        llvm::raw_string_ostream stream(error);
+                                        diag.print(stream);
+                                        return success();
+                                      });
+  if (failed(verify(source)))
+    return failure();
+  source.getContext()->getOrLoadDialect<affine::AffineDialect>();
+  OwningOpRef<ModuleOp> trial = source.clone();
+  SmallVector<TaskflowTaskOp> tasks;
+  trial->walk([&](TaskflowTaskOp task) { tasks.push_back(task); });
+  TaskflowSourceNormalizationWitness result;
+  for (auto task : tasks)
+    if (failed(normalizeTask(task, result, error)))
+      return failure();
+  if (failed(verify(*trial)))
+    return failure();
+  result.sourceFingerprint = fingerprint(bytes(source));
+  result.normalizedFingerprint = fingerprint(bytes(*trial));
+  witness = std::move(result);
+  normalized = std::move(trial);
+  return success();
+}
+LogicalResult verifyTaskflowSourceNormalization(
+    ModuleOp source, ModuleOp normalized,
+    const TaskflowSourceNormalizationWitness &witness, std::string &error) {
+  OwningOpRef<ModuleOp> replay;
+  TaskflowSourceNormalizationWitness actual;
+  if (!normalized ||
+      failed(normalizeTaskflowSource(source, replay, actual, error)))
+    return failure();
+  if (actual.protocol != witness.protocol ||
+      actual.sourceFingerprint != witness.sourceFingerprint ||
+      actual.normalizedFingerprint != witness.normalizedFingerprint ||
+      actual.normalizedTasks != witness.normalizedTasks ||
+      actual.normalizedCounters != witness.normalizedCounters ||
+      bytes(*replay) != bytes(normalized)) {
+    error = "physical normalization does not match exact source replay";
+    return failure();
+  }
+  return success();
+}
+} // namespace orbit::taskflow
