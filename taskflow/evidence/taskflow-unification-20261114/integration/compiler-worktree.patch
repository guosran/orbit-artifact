+//===- TaskflowReplica.h - Independent source-domain replicas ---*- C++ -*-===//
+#ifndef ORBIT_TASKFLOW_TASKFLOW_REPLICA_H
+#define ORBIT_TASKFLOW_TASKFLOW_REPLICA_H
+#include "mlir/IR/BuiltinOps.h"
+#include "mlir/Support/LogicalResult.h"
+#include "llvm/ADT/ArrayRef.h"
+#include <cstdint>
+#include <string>
+namespace orbit::taskflow {
+struct TaskflowReplicaAction {
+  std::string function, task;
+  int64_t axis = 0, count = 2;
+};
+/// Partition independent source instances using the common checked interval
+/// materializer. Unlike ordinary domain tiling, every instance carries an
+/// explicit independent-replica group contract. The physical backend must
+/// realize its resources/concurrency or reject the proposal as unsupported.
+/// This does not prove concurrent placement or multiply executed source work.
+mlir::LogicalResult
+materializeTaskflowReplicas(mlir::ModuleOp module,
+                            const TaskflowReplicaAction &action,
+                            std::string &error);
+mlir::LogicalResult
+verifyTaskflowReplicaReplay(mlir::ModuleOp parent, mlir::ModuleOp candidate,
+                            llvm::ArrayRef<TaskflowReplicaAction> actions,
+                            std::string &error);
+/// Report a resource obligation, not a proof that the target implements it.
+bool hasTaskflowReplicaGroups(mlir::ModuleOp module);
+} // namespace orbit::taskflow
+#endif
