+++ b/include/Taskflow/SourceSearch.h
@@ -0,0 +1,66 @@
+//===- SourceSearch.h - Public source action beam search --------*- C++ -*-===//
+#ifndef ORBIT_TASKFLOW_SOURCE_SEARCH_H
+#define ORBIT_TASKFLOW_SOURCE_SEARCH_H
+#include "Taskflow/ProgramSearch.h"
+#include "Taskflow/SourceActions.h"
+#include "Taskflow/TaskflowSourceNormalization.h"
+#include "llvm/Support/JSON.h"
+#include <optional>
+namespace orbit::taskflow {
+struct SourceSearchOptions {
+  uint64_t maxRounds = 8, maxEvaluations = 0, beamWidth = 16;
+  double wallSeconds =
+      0; // No wall quota by default; callbacks are synchronous.
+  SourceActionOptions actions;
+  std::vector<NeighborhoodAction> seedActions;
+  std::function<bool()> stopRequested;
+};
+struct SourceSearchBackend {
+  std::string identity, capabilityIdentity;
+  // False means deterministic unsupported for capabilityIdentity, never
+  // proved infeasible. Runtime unknown/timeout belongs in evaluate instead.
+  // Explicitly check every resource choice that the evaluator consumes.
+  std::function<bool(mlir::ModuleOp, llvm::ArrayRef<NeighborhoodShape>,
+                     std::string &)>
+      capability;
+  // Both modules are read-only views for the duration of the call. The
+  // normalized module is replay-checked actual source, not an operator recipe.
+  std::function<ProgramSearchEvaluation(
+      mlir::ModuleOp, mlir::ModuleOp, llvm::ArrayRef<NeighborhoodShape>,
+      const TaskflowSourceNormalizationWitness &)>
+      evaluate;
+  SourceActionExtension materialize;
+  SourceActionEnumerationExtension enumerate;
+};
+struct SourceSearchResult {
+  mlir::OwningOpRef<mlir::ModuleOp> bestSource, bestNormalized;
+  std::vector<NeighborhoodAction> bestActions;
+  std::vector<NeighborhoodShape> bestShapes;
+  TaskflowSourceNormalizationWitness bestNormalization;
+  std::optional<double> bestCostMs;
+  llvm::json::Object report;
+};
+/// Explore actual source actions. All candidates are authenticated by replay
+/// from parent before capability/evaluation. Only finite nonnegative scored
+/// feasible states survive. Unknown/timeout observations remain explicit.
+mlir::LogicalResult
+searchTaskflowSource(mlir::ModuleOp parent, llvm::StringRef function,
+                     llvm::ArrayRef<NeighborhoodShape> initialShapes,
+                     const SourceSearchBackend &backend,
+                     const SourceSearchOptions &options,
+                     SourceSearchResult &result, std::string &error);
+/// Versioned ordered history and choices; sufficient for immutable-source
+/// replay.
+llvm::json::Value
+serializeSourceSearchReplay(llvm::StringRef function,
+                            llvm::StringRef backendIdentity,
+                            llvm::StringRef capabilityIdentity,
+                            llvm::ArrayRef<NeighborhoodAction> actions,
+                            llvm::ArrayRef<NeighborhoodShape> shapes);
+mlir::LogicalResult parseSourceSearchReplay(
+    const llvm::json::Value &record, std::string &function,
+    std::string &backendIdentity, std::string &capabilityIdentity,
+    std::vector<NeighborhoodAction> &actions,
+    std::vector<NeighborhoodShape> &shapes, std::string &error);
+} // namespace orbit::taskflow
+#endif
