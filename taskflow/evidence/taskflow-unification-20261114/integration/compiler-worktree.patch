+//===- SourceActions.h - Backend-neutral Taskflow search actions -*- C++
+//-*-===//
+#ifndef ORBIT_TASKFLOW_SOURCE_ACTIONS_H
+#define ORBIT_TASKFLOW_SOURCE_ACTIONS_H
+
+#include "mlir/IR/BuiltinOps.h"
+#include "mlir/IR/OwningOpRef.h"
+#include "mlir/Support/LogicalResult.h"
+#include "llvm/ADT/ArrayRef.h"
+#include "llvm/ADT/StringRef.h"
+#include <cstdint>
+#include <functional>
+#include <string>
+#include <vector>
+
+namespace orbit::taskflow {
+// Rectangular resource bounds from a target contract. Geometry only; physical
+// routing, occupancy and storage checks remain the target evaluator's job.
+struct NeighborhoodShapeDomain {
+  int64_t rows = 0, cols = 0;
+  bool contains(int64_t r, int64_t c) const {
+    return r > 0 && c > 0 && r <= rows && c <= cols;
+  }
+};
+struct NeighborhoodShape {
+  std::string task;
+  int64_t rows = 1, cols = 1;
+};
+// The existing serialized names/fields are retained for historical replay.
+// Source primitives use fission, tiling, fusion, noop; backends may extend the
+// vocabulary through an explicit implementation callback.
+struct NeighborhoodPrimitive {
+  std::string kind, firstTask, secondTask, mode;
+  int64_t axis = 0, factor = 1;
+  std::vector<unsigned> leftNodes;
+};
+struct NeighborhoodAction {
+  std::string family, label;
+  std::vector<NeighborhoodPrimitive> primitives;
+  std::string shapeTask;
+  int64_t shapeRows = 0, shapeCols = 0;
+  bool canonicalReset = false;
+};
+struct SourceActionOptions {
+  unsigned round = 0;
+  uint64_t maxFissionActionsPerTask = 64;
+  NeighborhoodShapeDomain shapeDomain;
+  bool tiling = true, fusion = true, fission = true, replica = true;
+};
+using SourceActionExtension = std::function<mlir::LogicalResult(
+    mlir::ModuleOp, llvm::StringRef, const NeighborhoodPrimitive &,
+    std::string &)>;
+using SourceActionEnumerationExtension = std::function<mlir::LogicalResult(
+    mlir::ModuleOp, llvm::StringRef, const SourceActionOptions &,
+    std::vector<NeighborhoodAction> &, std::string &)>;
+struct SourceActionResult {
+  mlir::OwningOpRef<mlir::ModuleOp> module;
+  std::vector<NeighborhoodShape> shapes;
+};
+// Materialize on an owned clone and publish only after all primitives and the
+// verifier succeed. A backend extension receives that clone, never the input.
+mlir::FailureOr<SourceActionResult>
+applySourceAction(mlir::ModuleOp source, llvm::StringRef function,
+                  const NeighborhoodAction &action,
+                  llvm::ArrayRef<NeighborhoodShape> shapes,
+                  NeighborhoodShapeDomain shapeDomain, std::string &error,
+                  const SourceActionExtension &extension = {});
+// Authenticate a mixed ordered path using the same materializers and compare
+// the numeric source plus explicit resource choices with the claimed result.
+mlir::LogicalResult verifySourceActionReplay(
+    mlir::ModuleOp parent, mlir::ModuleOp candidate, llvm::StringRef function,
+    llvm::ArrayRef<NeighborhoodAction> actions,
+    llvm::ArrayRef<NeighborhoodShape> initialShapes,
+    llvm::ArrayRef<NeighborhoodShape> candidateShapes,
+    NeighborhoodShapeDomain shapeDomain, std::string &error,
+    const SourceActionExtension &extension = {});
+// Source-only proposals use the actual source counter extents. Round controls
+// a progressively extended exploration prefix, not semantic factor legality.
+// diagnostics disclose unsupported source patterns and bounded cut generation.
+mlir::LogicalResult
+enumerateSourceActions(mlir::ModuleOp source, llvm::StringRef function,
+                       const SourceActionOptions &options,
+                       std::vector<NeighborhoodAction> &actions,
+                       std::vector<std::string> &diagnostics,
+                       std::string &error,
+                       const SourceActionEnumerationExtension &extension = {});
+} // namespace orbit::taskflow
+#endif
