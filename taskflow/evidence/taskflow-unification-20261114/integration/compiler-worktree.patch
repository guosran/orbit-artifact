+namespace {
+std::string moduleBytes(ModuleOp module) {
+  std::string text;
+  llvm::raw_string_ostream stream(text);
+  module.print(stream, OpPrintingFlags().printGenericOpForm());
+  stream.flush();
+  return text;
+}
+std::string digest(StringRef text) {
+  return llvm::toHex(llvm::SHA256::hash(llvm::arrayRefFromStringRef(text)),
+                     true);
+}
+llvm::json::Array shapesJSON(ArrayRef<NeighborhoodShape> shapes) {
+  llvm::json::Array rows;
+  for (const auto &shape : shapes)
+    rows.push_back(llvm::json::Object{
+        {"task", shape.task}, {"rows", shape.rows}, {"cols", shape.cols}});
+  return rows;
+}
+std::string candidateKey(ModuleOp module, ArrayRef<NeighborhoodShape> shapes,
+                         const SourceSearchBackend &backend) {
+  // Keep every semantic attribute. Removing only source rewrite witnesses
+  // avoids evaluating identity actions repeatedly without erasing target facts.
+  OwningOpRef<ModuleOp> canonical = module.clone();
+  canonical->walk([&](Operation *op) {
+    SmallVector<StringAttr> removed;
+    for (auto attribute : op->getAttrs()) {
+      StringRef name = attribute.getName().strref();
+      if (name.starts_with("amoeba.fission.") ||
+          name.starts_with("amoeba.tiling.") ||
+          name.starts_with("amoeba.fusion."))
+        removed.push_back(attribute.getName());
+    }
+    for (auto name : removed)
+      op->removeAttr(name);
+  });
+  std::string text = moduleBytes(*canonical);
+  auto ordered = std::vector<NeighborhoodShape>(shapes.begin(), shapes.end());
+  std::sort(ordered.begin(), ordered.end(),
+            [](const auto &a, const auto &b) { return a.task < b.task; });
+  llvm::raw_string_ostream stream(text);
+  // Length-prefixed identities prevent delimiter-dependent collisions.
+  stream << '\n'
+         << backend.identity.size() << ':' << backend.identity << '\n'
+         << backend.capabilityIdentity.size() << ':'
+         << backend.capabilityIdentity << '\n'
+         << llvm::json::Value(shapesJSON(ordered));
+  stream.flush();
+  return digest(text);
+}
+// Round-robin families and their task scopes before applying a finite
+// evaluation quota. The full menu remains available; ordering is not legality.
+void fairProposals(std::vector<NeighborhoodAction> &actions, uint64_t round) {
+  std::map<std::string, std::map<std::string, std::vector<NeighborhoodAction>>>
+      groups;
+  const size_t count = actions.size();
+  for (auto &action : actions) {
+    std::string scope = action.shapeTask;
+    if (scope.empty() && !action.primitives.empty())
+      scope = action.primitives.front().firstTask;
+    groups[action.family][scope].push_back(std::move(action));
+  }
+  struct Queue {
+    std::vector<std::vector<NeighborhoodAction>> scopes;
+    std::vector<size_t> positions;
+    size_t cursor = 0;
+  };
+  std::vector<Queue> families;
+  for (auto &family : groups) {
+    Queue queue;
+    for (auto &scope : family.second)
+      queue.scopes.push_back(std::move(scope.second));
+    queue.positions.resize(queue.scopes.size());
+    queue.cursor = round % queue.scopes.size();
+    families.push_back(std::move(queue));
+  }
+  if (families.empty())
+    return;
+  std::rotate(families.begin(), families.begin() + round % families.size(),
+              families.end());
+  actions.clear();
+  actions.reserve(count);
+  while (actions.size() < count)
+    for (auto &family : families)
+      for (size_t tries = 0; tries < family.scopes.size(); ++tries) {
+        size_t scope = family.cursor;
+        family.cursor = (scope + 1) % family.scopes.size();
+        if (family.positions[scope] < family.scopes[scope].size()) {
+          actions.push_back(
+              std::move(family.scopes[scope][family.positions[scope]++]));
+          break;
+        }
+      }
+}
+struct State {
+  OwningOpRef<ModuleOp> module;
+  std::vector<NeighborhoodShape> shapes;
+  std::vector<NeighborhoodAction> history;
+  double cost = 0;
+  std::string key;
+};
+} // namespace
+
+llvm::json::Value serializeSourceSearchReplay(
+    StringRef function, StringRef backendIdentity, StringRef capabilityIdentity,
+    ArrayRef<NeighborhoodAction> actions, ArrayRef<NeighborhoodShape> shapes) {
+  llvm::json::Array rows;
+  for (const auto &action : actions) {
+    llvm::json::Array primitives;
+    for (const auto &primitive : action.primitives) {
+      llvm::json::Array nodes;
+      for (unsigned node : primitive.leftNodes)
+        nodes.push_back(static_cast<int64_t>(node));
+      primitives.push_back(
+          llvm::json::Object{{"kind", primitive.kind},
+                             {"first_task", primitive.firstTask},
+                             {"second_task", primitive.secondTask},
+                             {"mode", primitive.mode},
+                             {"axis", primitive.axis},
+                             {"factor", primitive.factor},
+                             {"left_nodes", std::move(nodes)}});
+    }
+    rows.push_back(
+        llvm::json::Object{{"family", action.family},
+                           {"label", action.label},
+                           {"primitives", std::move(primitives)},
+                           {"shape_task", action.shapeTask},
+                           {"shape_rows", action.shapeRows},
+                           {"shape_cols", action.shapeCols},
+                           {"canonical_reset", action.canonicalReset}});
+  }
+  return llvm::json::Object{
+      {"schema", "orbit-taskflow-source-search-replay-v1"},
+      {"function", function.str()},
+      {"backend", backendIdentity.str()},
+      {"capability", capabilityIdentity.str()},
+      {"actions", std::move(rows)},
+      {"shapes", shapesJSON(shapes)}};
+}
+
+LogicalResult parseSourceSearchReplay(const llvm::json::Value &record,
+                                      std::string &function,
+                                      std::string &backendIdentity,
+                                      std::string &capabilityIdentity,
+                                      std::vector<NeighborhoodAction> &actions,
+                                      std::vector<NeighborhoodShape> &shapes,
+                                      std::string &error) {
+  error.clear();
+  auto fail = [&] {
+    error = "malformed source search replay record";
+    return failure();
+  };
+  auto *root = record.getAsObject();
+  if (!root || (root->size() != 6 && root->size() != 7) ||
+      root->getString("schema") != "orbit-taskflow-source-search-replay-v1")
+    return fail();
+  if (root->size() == 7) {
+    auto binding = root->getString("source_fingerprint");
+    if (!binding || binding->size() != 64 ||
+        !llvm::all_of(*binding, [](char c) { return llvm::isHexDigit(c); }))
+      return fail();
+  }
+  auto fn = root->getString("function"), backend = root->getString("backend"),
+       capability = root->getString("capability");
+  auto *rows = root->getArray("actions"), *resources = root->getArray("shapes");
+  if (!fn || fn->empty() || !backend || backend->empty() || !capability ||
+      capability->empty() || !rows || !resources)
+    return fail();
+  std::vector<NeighborhoodAction> parsedActions;
+  std::vector<NeighborhoodShape> parsedShapes;
+  for (const auto &value : *rows) {
+    auto *row = value.getAsObject();
+    if (!row || row->size() != 7)
+      return fail();
+    auto family = row->getString("family"), label = row->getString("label"),
+         shapeTask = row->getString("shape_task");
+    auto shapeRows = row->getInteger("shape_rows"),
+         shapeCols = row->getInteger("shape_cols");
+    auto reset = row->getBoolean("canonical_reset");
+    auto *primitives = row->getArray("primitives");
+    if (!family || !label || !shapeTask || !shapeRows || !shapeCols || !reset ||
+        !primitives || *reset)
+      return fail();
+    NeighborhoodAction action;
+    action.family = family->str();
+    action.label = label->str();
+    action.shapeTask = shapeTask->str();
+    action.shapeRows = *shapeRows;
+    action.shapeCols = *shapeCols;
+    for (const auto &primitiveValue : *primitives) {
+      auto *primitive = primitiveValue.getAsObject();
+      if (!primitive || primitive->size() != 7)
+        return fail();
+      auto kind = primitive->getString("kind"),
+           first = primitive->getString("first_task"),
+           second = primitive->getString("second_task"),
+           mode = primitive->getString("mode");
+      auto axis = primitive->getInteger("axis"),
+           factor = primitive->getInteger("factor");
+      auto *nodes = primitive->getArray("left_nodes");
+      if (!kind || kind->empty() || !first || !second || !mode || !axis ||
+          !factor || !nodes)
+        return fail();
+      NeighborhoodPrimitive parsed;
+      parsed.kind = kind->str();
+      parsed.firstTask = first->str();
+      parsed.secondTask = second->str();
+      parsed.mode = mode->str();
+      parsed.axis = *axis;
+      parsed.factor = *factor;
+      for (const auto &node : *nodes) {
+        auto ordinal = node.getAsInteger();
+        if (!ordinal || *ordinal < 0 ||
+            static_cast<uint64_t>(*ordinal) >
+                std::numeric_limits<unsigned>::max())
+          return fail();
+        parsed.leftNodes.push_back(*ordinal);
+      }
+      action.primitives.push_back(std::move(parsed));
+    }
+    parsedActions.push_back(std::move(action));
+  }
+  std::set<std::string> names;
+  for (const auto &resource : *resources) {
+    auto *row = resource.getAsObject();
+    if (!row || row->size() != 3)
+      return fail();
+    auto task = row->getString("task");
+    auto rows = row->getInteger("rows"), cols = row->getInteger("cols");
+    if (!task || task->empty() || !rows || !cols || *rows <= 0 || *cols <= 0 ||
+        !names.insert(task->str()).second)
+      return fail();
+    parsedShapes.push_back({task->str(), *rows, *cols});
+  }
+  function = fn->str();
+  backendIdentity = backend->str();
+  capabilityIdentity = capability->str();
+  actions = std::move(parsedActions);
+  shapes = std::move(parsedShapes);
+  return success();
+}
+
+LogicalResult searchTaskflowSource(ModuleOp parent, StringRef function,
+                                   ArrayRef<NeighborhoodShape> initialShapes,
+                                   const SourceSearchBackend &backend,
+                                   const SourceSearchOptions &options,
+                                   SourceSearchResult &result,
+                                   std::string &error) {
+  result = {};
+  error.clear();
+  using Clock = std::chrono::steady_clock;
+  auto started = Clock::now();
+  auto milliseconds = [](Clock::time_point begin) {
+    return std::chrono::duration<double, std::milli>(Clock::now() - begin)
+        .count();
+  };
+  double enumerationMs = 0, materializationMs = 0, replayMs = 0,
+         normalizationMs = 0, capabilityMs = 0, evaluationMs = 0;
+  if (!parent || failed(verify(parent)) || backend.identity.empty() ||
+      backend.capabilityIdentity.empty() || !backend.capability ||
+      !backend.evaluate || !options.beamWidth ||
+      !options.actions.shapeDomain.contains(1, 1) ||
+      !std::isfinite(options.wallSeconds) || options.wallSeconds < 0) {
+    error = "source search requires verified source, backend "
+            "capability/evaluator and beam";
+    return failure();
+  }
+  NeighborhoodAction identity{"identity", "identity"};
+  auto phaseStart = Clock::now();
+  auto seed = applySourceAction(parent, function, identity, initialShapes,
+                                options.actions.shapeDomain, error,
+                                backend.materialize);
+  materializationMs += milliseconds(phaseStart);
+  if (failed(seed))
+    return failure();
+  if (!initialShapes.empty()) {
+    if (initialShapes.size() != seed->shapes.size()) {
+      error = "initial source shapes must cover each task exactly once";
+      return failure();
+    }
+    std::set<std::string> names, sourceNames;
+    for (const auto &shape : seed->shapes)
+      sourceNames.insert(shape.task);
+    for (const auto &shape : initialShapes)
+      if (!sourceNames.count(shape.task) || !names.insert(shape.task).second ||
+          !options.actions.shapeDomain.contains(shape.rows, shape.cols)) {
+        error = "initial source shape is duplicated or outside target geometry";
+        return failure();
+      }
+  }
+  const auto baseShapes = seed->shapes;
+  std::vector<State> beam;
+  std::set<std::string> decided;
+  std::map<std::string, uint64_t> lastAttempt;
+  llvm::json::Array records, diagnostics;
+  uint64_t evaluations = 0, unknown = 0, rejected = 0, duplicates = 0,
+           generated = 0, rounds = 0;
+  auto elapsed = [&] {
+    return std::chrono::duration<double>(std::chrono::steady_clock::now() -
+                                         started)
+        .count();
+  };
+  std::string termination = "round-budget";
+  auto stopped = [&] {
+    if (options.stopRequested && options.stopRequested()) {
+      termination = "requested-stop";
+      return true;
+    }
+    if (options.maxEvaluations && evaluations >= options.maxEvaluations) {
+      termination = "evaluation-budget";
+      return true;
+    }
+    if (options.wallSeconds && elapsed() >= options.wallSeconds) {
+      termination = "wall-budget";
+      return true;
+    }
+    return false;
+  };
+  auto evaluate = [&](State &state, uint64_t round) -> bool {
+    state.key = candidateKey(*state.module, state.shapes, backend);
+    if (decided.count(state.key) ||
+        (lastAttempt.count(state.key) && lastAttempt[state.key] == round)) {
+      ++duplicates;
+      return false;
+    }
+    lastAttempt[state.key] = round;
+    auto begin = Clock::now();
+    auto replayStatus = verifySourceActionReplay(
+        parent, *state.module, function, state.history, baseShapes,
+        state.shapes, options.actions.shapeDomain, error, backend.materialize);
+    replayMs += milliseconds(begin);
+    if (failed(replayStatus))
+      return false;
+    llvm::json::Object record{
+        {"key", state.key},
+        {"round", static_cast<int64_t>(round)},
+        {"actions", static_cast<int64_t>(state.history.size())},
+        {"source_replay_verified", true},
+        {"family",
+         state.history.empty() ? "baseline" : state.history.back().family},
+        {"action",
+         state.history.empty() ? "baseline" : state.history.back().label}};
+    std::string reason;
+    auto capabilitySource = moduleBytes(*state.module);
+    begin = Clock::now();
+    bool capable = backend.capability(*state.module, state.shapes, reason);
+    capabilityMs += milliseconds(begin);
+    if (capabilitySource != moduleBytes(*state.module)) {
+      error = "source capability callback mutated a read-only candidate";
+      return false;
+    }
+    if (!capable) {
+      ++unknown;
+      decided.insert(state.key); // Deterministic for this capability identity.
+      record["status"] = "unsupported-capability";
+      record["message"] = reason;
+      records.push_back(std::move(record));
+      return false;
+    }
+    OwningOpRef<ModuleOp> normalized;
+    TaskflowSourceNormalizationWitness witness;
+    begin = Clock::now();
+    bool normalizedOK = succeeded(
+        normalizeTaskflowSource(*state.module, normalized, witness, reason));
+    if (normalizedOK)
+      normalizedOK = succeeded(verifyTaskflowSourceNormalization(
+          *state.module, *normalized, witness, reason));
+    normalizationMs += milliseconds(begin);
+    if (!normalizedOK) {
+      ++unknown;
+      decided.insert(state.key); // Source/normalizer identity is unchanged.
+      record["status"] = "unsupported-normalization";
+      record["message"] = reason;
+      records.push_back(std::move(record));
+      return false;
+    }
+    auto before = moduleBytes(*state.module);
+    auto physicalBefore = moduleBytes(*normalized);
+    ++evaluations;
+    begin = Clock::now();
+    ProgramSearchEvaluation evaluation =
+        backend.evaluate(*state.module, *normalized, state.shapes, witness);
+    evaluationMs += milliseconds(begin);
+    if (before != moduleBytes(*state.module) ||
+        physicalBefore != moduleBytes(*normalized)) {
+      error = "source evaluator mutated a read-only candidate";
+      return false;
+    }
+    record["message"] = evaluation.message;
+    record["evaluation"] = std::move(evaluation.result);
+    if (!evaluation.feasibilityKnown) {
+      ++unknown;
+      record["status"] = "unknown";
+      records.push_back(std::move(record));
+      return false;
+    }
+    if (!evaluation.feasible) {
+      ++rejected;
+      decided.insert(state.key);
+      record["status"] = "backend-rejected";
+      records.push_back(std::move(record));
+      return false;
+    }
+    if (!evaluation.costMs || !std::isfinite(*evaluation.costMs) ||
+        *evaluation.costMs < 0) {
+      ++unknown;
+      record["status"] = "unpriced";
+      records.push_back(std::move(record));
+      return false;
+    }
+    state.cost = *evaluation.costMs;
+    decided.insert(state.key);
+    record["status"] = "scored";
+    record["cost_ms"] = state.cost;
+    records.push_back(std::move(record));
+    if (!result.bestCostMs || state.cost < *result.bestCostMs) {
+      result.bestSource = state.module->clone();
+      result.bestNormalized = normalized->clone();
+      result.bestActions = state.history;
+      result.bestShapes = state.shapes;
+      result.bestNormalization = witness;
+      result.bestCostMs = state.cost;
+    }
+    return true;
+  };
+
+  State baseline;
+  baseline.module = std::move(seed->module);
+  baseline.shapes = baseShapes;
+  if (evaluate(baseline, 0))
+    beam.push_back(std::move(baseline));
+  if (!error.empty())
+    return failure();
+  if (!options.seedActions.empty() && !stopped()) {
+    State resumed;
+    resumed.module = parent.clone();
+    resumed.shapes = baseShapes;
+    for (const auto &action : options.seedActions) {
+      auto begin = Clock::now();
+      auto next = applySourceAction(*resumed.module, function, action,
+                                    resumed.shapes, options.actions.shapeDomain,
+                                    error, backend.materialize);
+      materializationMs += milliseconds(begin);
+      if (failed(next))
+        return failure();
+      resumed.module = std::move(next->module);
+      resumed.shapes = std::move(next->shapes);
+      resumed.history.push_back(action);
+    }
+    if (evaluate(resumed, 0))
+      beam.push_back(std::move(resumed));
+    if (!error.empty())
+      return failure();
+  }
+  auto order = [](const State &a, const State &b) {
+    return a.cost != b.cost ? a.cost < b.cost : a.key < b.key;
+  };
+  for (uint64_t round = 0;
+       (!options.maxRounds || round < options.maxRounds) && !stopped();
+       ++round) {
+    ++rounds;
+    std::vector<State> next;
+    auto retain = [&](State &&state) {
+      next.push_back(std::move(state));
+      // Bound owned IR while exploring, not only after constructing an entire
+      // neighborhood of a potentially large model.
+      if (next.size() > options.beamWidth &&
+          next.size() - options.beamWidth > options.beamWidth) {
+        std::sort(next.begin(), next.end(), order);
+        next.resize(options.beamWidth);
+      }
+    };
+    // An unpriced original is only an input proposal root, never a survivor.
+    // This allows e.g. fusion to make an otherwise unsupported source
+    // lowerable.
+    if (beam.empty()) {
+      State root;
+      root.module = parent.clone();
+      root.shapes = baseShapes;
+      beam.push_back(std::move(root));
+    }
+    for (auto &state : beam) {
+      std::vector<NeighborhoodAction> actions;
+      std::vector<std::string> notes;
+      auto actionOptions = options.actions;
+      actionOptions.round = static_cast<unsigned>(
+          std::min<uint64_t>(round, std::numeric_limits<unsigned>::max()));
+      auto begin = Clock::now();
+      auto enumerated =
+          enumerateSourceActions(*state.module, function, actionOptions,
+                                 actions, notes, error, backend.enumerate);
+      fairProposals(actions, round);
+      enumerationMs += milliseconds(begin);
+      if (failed(enumerated))
+        return failure();
+      for (const auto &note : notes)
+        diagnostics.push_back(note);
+      for (const auto &action : actions) {
+        if (stopped())
+          break;
+        ++generated;
+        std::string diagnostic;
+        begin = Clock::now();
+        auto materialized = applySourceAction(
+            *state.module, function, action, state.shapes,
+            options.actions.shapeDomain, diagnostic, backend.materialize);
+        materializationMs += milliseconds(begin);
+        if (failed(materialized)) {
+          diagnostics.push_back(action.label + ": " + diagnostic);
+          continue;
+        }
+        State candidate;
+        candidate.module = std::move(materialized->module);
+        candidate.shapes = std::move(materialized->shapes);
+        candidate.history = state.history;
+        candidate.history.push_back(action);
+        if (evaluate(candidate, round + 1))
+          retain(std::move(candidate));
+        if (!error.empty())
+          return failure();
+      }
+      // Keep every scored predecessor eligible, including the baseline.
+      if (!state.key.empty() && decided.count(state.key))
+        retain(std::move(state));
+      if (stopped())
+        break;
+    }
+    std::sort(next.begin(), next.end(), order);
+    std::set<std::string> kept;
+    std::vector<State> survivors;
+    for (auto &state : next)
+      if (survivors.size() < options.beamWidth && kept.insert(state.key).second)
+        survivors.push_back(std::move(state));
+    beam = std::move(survivors);
+  }
+  result.report = llvm::json::Object{
+      {"schema", "orbit-taskflow-source-search-v1"},
+      {"backend", backend.identity},
+      {"capability", backend.capabilityIdentity},
+      {"source_fingerprint", digest(moduleBytes(parent))},
+      {"termination", termination},
+      {"complete_domain", false},
+      {"global_optimality_claim", false},
+      {"deterministic_unsupported_cached", true},
+      {"runtime_unknown_retry_policy", "at-most-once-per-round"},
+      {"has_best", bool(result.bestCostMs)},
+      {"rounds", static_cast<int64_t>(rounds)},
+      {"generated", static_cast<int64_t>(generated)},
+      {"evaluations", static_cast<int64_t>(evaluations)},
+      {"unknown", static_cast<int64_t>(unknown)},
+      {"backend_rejected", static_cast<int64_t>(rejected)},
+      {"deduplicated", static_cast<int64_t>(duplicates)},
+      {"elapsed_seconds", elapsed()},
+      {"proposal_order", "round-robin-family-and-task; rotated-by-round"},
+      {"phase_ms", llvm::json::Object{{"enumeration", enumerationMs},
+                                      {"materialization", materializationMs},
+                                      {"replay", replayMs},
+                                      {"normalization", normalizationMs},
+                                      {"capability", capabilityMs},
+                                      {"evaluation", evaluationMs}}},
+      {"observations", std::move(records)},
+      {"diagnostics", std::move(diagnostics)},
+      {"initial_shapes", shapesJSON(baseShapes)},
+      {"replay", serializeSourceSearchReplay(
+                     function, backend.identity, backend.capabilityIdentity,
+                     result.bestActions, result.bestShapes)}};
+  if (result.bestCostMs)
+    result.report["best_cost_ms"] = *result.bestCostMs;
+  return success();
+}
+} // namespace orbit::taskflow
diff --git a/lib/Taskflow/SourceSearchDriver.cpp b/lib/Taskflow/SourceSearchDriver.cpp
new file mode 100644
index 00000000..36c81787
--- /dev/null
+++ b/lib/Taskflow/SourceSearchDriver.cpp
@@ -0,0 +1,341 @@
+//===- SourceSearchDriver.cpp - Common source-search integration
+//------------===//
+#include "Taskflow/SourceSearchDriver.h"
+#include "Taskflow/GenericMapping.h"
+#include "Taskflow/Search.h"
+#include "Taskflow/SourceMappingActions.h"
+#include "Taskflow/SourceSearch.h"
+#include "Taskflow/TaskflowReplica.h"
+#include "TaskflowDialect/TaskflowDialect.h"
+#include "mlir/Dialect/Affine/IR/AffineOps.h"
+#include "mlir/Dialect/Arith/IR/Arith.h"
+#include "mlir/Dialect/Func/IR/FuncOps.h"
+#include "mlir/Dialect/Math/IR/Math.h"
+#include "mlir/Dialect/MemRef/IR/MemRef.h"
+#include "mlir/Dialect/SCF/IR/SCF.h"
+#include "mlir/Parser/Parser.h"
+#include "llvm/ADT/StringExtras.h"
+#include "llvm/Support/FileSystem.h"
+#include "llvm/Support/FormatVariadic.h"
+#include "llvm/Support/MemoryBuffer.h"
+#include "llvm/Support/Path.h"
+#include "llvm/Support/SHA256.h"
+#include "llvm/Support/raw_ostream.h"
+#include <array>
+#include <cmath>
+
+using namespace mlir;
+namespace orbit::taskflow {
+namespace {
+std::string moduleText(ModuleOp module) {
+  std::string text;
+  llvm::raw_string_ostream stream(text);
+  module.print(stream, OpPrintingFlags().printGenericOpForm());
+  stream.flush();
+  return text;
+}
+std::string digest(llvm::StringRef bytes) {
+  return llvm::toHex(llvm::SHA256::hash(llvm::arrayRefFromStringRef(bytes)),
+                     true);
+}
+bool writeFile(llvm::StringRef path, llvm::StringRef text, std::string &error) {
+  std::error_code ec;
+  llvm::raw_fd_ostream stream(path, ec);
+  if (ec) {
+    error = ec.message();
+    return false;
+  }
+  stream << text;
+  stream.close();
+  if (stream.has_error()) {
+    error = stream.error().message();
+    stream.clear_error();
+    return false;
+  }
+  return true;
+}
+// Match the existing native search's conservative file binding. Referenced
+// model/calibration bytes matter even when the JSON pathname is unchanged.
+bool bindDependencies(const llvm::json::Value &value, std::string &binding,
+                      std::string &error) {
+  if (auto text = value.getAsString()) {
+    if (llvm::sys::fs::is_regular_file(*text)) {
+      auto bytes = llvm::MemoryBuffer::getFile(*text);
+      if (!bytes) {
+        error = "cannot bind source-search dependency: " + text->str();
+        return false;
+      }
+      binding += text->str() + ":" + digest((*bytes)->getBuffer()) + "\n";
+    }
+  } else if (auto array = value.getAsArray()) {
+    for (const auto &element : *array)
+      if (!bindDependencies(element, binding, error))
+        return false;
+  } else if (auto object = value.getAsObject()) {
+    for (const auto &entry : *object)
+      if (!bindDependencies(entry.second, binding, error))
+        return false;
+  }
+  return true;
+}
+} // namespace
+
+bool tryRunSourceSearch(const SearchOptions &request, bool &handled,
+                        std::string &error) {
+  handled = false;
+  if (request.targetConfigFile.empty())
+    return true;
+  auto bytes = llvm::MemoryBuffer::getFile(request.targetConfigFile);
+  if (!bytes) {
+    error = bytes.getError().message();
+    return false;
+  }
+  auto parsed = llvm::json::parse((*bytes)->getBuffer());
+  if (!parsed) {
+    error = llvm::toString(parsed.takeError());
+    return false;
+  }
+  auto *config = parsed->getAsObject();
+  if (!config || !config->get("source_auto_candidates"))
+    return true;
+  handled = true;
+  auto *automatic = config->getObject("source_auto_candidates");
+  if (!automatic || request.nativeSourceMLIR.empty() ||
+      request.backend != "air" || request.resume ||
+      !request.checkpoint.empty() || request.outputDir.empty() ||
+      request.maxRounds < 0 || request.maxCandidates < 1 ||
+      request.beamWidth < 1 || request.nativeEvaluator ||
+      (!request.evaluator.empty() && request.evaluator != "native")) {
+    error = "source_auto_candidates requires actual source, backend=air, "
+            "positive candidate/beam budgets, native evaluator and a fresh "
+            "output directory";
+    return false;
+  }
+  // Other adapters must supply a shape-aware physical evaluator before this
+  // path may claim their support. A generic AIR plan does not place a CGRA.
+  for (const auto &entry : *automatic)
+    if (entry.first != "function" && entry.first != "rows" &&
+        entry.first != "cols" && entry.first != "max_fission_actions" &&
+        entry.first != "tiling" && entry.first != "fusion" &&
+        entry.first != "fission" && entry.first != "replica" &&
+        entry.first != "wall_seconds" && entry.first != "mapping" &&
+        entry.first != "task_tiling" && entry.first != "tile_page_slots" &&
+        entry.first != "max_residency_proposals" &&
+        entry.first != "max_residency_groups") {
+      error = "unknown source_auto_candidates field: " + entry.first.str();
+      return false;
+    }
+  auto function = automatic->getString("function");
+  const std::string functionName = function ? function->str() : "";
+  SourceSearchOptions options;
+  SourceMappingActionOptions mappingOptions;
+  options.maxRounds = request.maxRounds;
+  options.maxEvaluations = request.maxCandidates;
+  options.beamWidth = request.beamWidth;
+  options.actions.shapeDomain = {1, 1};
+  auto integer = [&](llvm::StringRef key, int64_t &value) {
+    if (!automatic->get(key))
+      return true;
+    auto number = automatic->getInteger(key);
+    if (!number || *number < 1) {
+      error =
+          "source_auto_candidates." + key.str() + " must be a positive integer";
+      return false;
+    }
+    value = *number;
+    return true;
+  };
+  int64_t cuts = options.actions.maxFissionActionsPerTask;
+  if (!function || function->empty() ||
+      !integer("rows", options.actions.shapeDomain.rows) ||
+      !integer("cols", options.actions.shapeDomain.cols) ||
+      !integer("max_fission_actions", cuts)) {
+    if (error.empty())
+      error = "source_auto_candidates.function is required";
+    return false;
+  }
+  options.actions.maxFissionActionsPerTask = cuts;
+  int64_t tileSlots = mappingOptions.tilePageSlots;
+  int64_t mappingProposals = mappingOptions.maxResidencyProposals;
+  int64_t mappingGroups = mappingOptions.maxResidencyGroups;
+  if (!integer("tile_page_slots", tileSlots) ||
+      !integer("max_residency_proposals", mappingProposals) ||
+      !integer("max_residency_groups", mappingGroups))
+    return false;
+  mappingOptions.tilePageSlots = tileSlots;
+  mappingOptions.maxResidencyProposals = mappingProposals;
+  mappingOptions.maxResidencyGroups = mappingGroups;
+  const std::array<std::pair<const char *, bool *>, 6> booleanFields{
+      {{"tiling", &options.actions.tiling},
+       {"fusion", &options.actions.fusion},
+       {"fission", &options.actions.fission},
+       {"replica", &options.actions.replica},
+       {"mapping", &mappingOptions.mapping},
+       {"task_tiling", &mappingOptions.taskTiling}}};
+  for (const auto &entry : booleanFields) {
+    if (!automatic->get(entry.first))
+      continue;
+    auto value = automatic->getBoolean(entry.first);
+    if (!value) {
+      error = std::string("source_auto_candidates.") + entry.first +
+              " must be boolean";
+      return false;
+    }
+    *entry.second = *value;
+  }
+  if (automatic->get("wall_seconds")) {
+    auto seconds = automatic->getNumber("wall_seconds");
+    if (!seconds || !std::isfinite(*seconds) || *seconds < 0) {
+      error = "source_auto_candidates.wall_seconds must be finite and >=0";
+      return false;
+    }
+    options.wallSeconds = *seconds;
+  }
+  if (llvm::sys::fs::exists(request.outputDir)) {
+    error = "source search output directory must be new";
+    return false;
+  }
+  DialectRegistry registry;
+  registry.insert<mlir::taskflow::TaskflowDialect, affine::AffineDialect,
+                  arith::ArithDialect, math::MathDialect, memref::MemRefDialect,
+                  func::FuncDialect, scf::SCFDialect>();
+  MLIRContext context(registry);
+  auto source = parseSourceString<ModuleOp>(request.nativeSourceMLIR, &context);
+  if (!source) {
+    error = "source search requires parseable Taskflow MLIR";
+    return false;
+  }
+  const std::string configurationBytes = (*bytes)->getBuffer().str();
+  const std::string sourceIdentity = digest(moduleText(*source));
+  std::string dependencyBytes;
+  if (!bindDependencies(*parsed, dependencyBytes, error))
+    return false;
+  auto compiler = llvm::MemoryBuffer::getFile(llvm::sys::fs::getMainExecutable(
+      nullptr, reinterpret_cast<void *>(&tryRunSourceSearch)));
+  if (!compiler) {
+    error = "cannot bind source-search compiler bytes";
+    return false;
+  }
+  SourceSearchBackend backend;
+  backend.identity =
+      "taskflow-generic-air-source-v1:" + digest((*compiler)->getBuffer());
+  backend.capabilityIdentity = digest(configurationBytes + dependencyBytes);
+  if (!getGenericTargetCapabilities(*parsed, mappingOptions.capabilities,
+                                    error))
+    return false;
+  backend.materialize = makeSourceMappingActionMaterializer(mappingOptions);
+  backend.enumerate = makeSourceMappingActionEnumerator(mappingOptions);
+  backend.capability = [&](ModuleOp source,
+                           llvm::ArrayRef<NeighborhoodShape> shapes,
+                           std::string &reason) {
+    if (failed(checkSourceMappingActionBindings(source, functionName, reason)))
+      return false;
+    if (hasTaskflowReplicaGroups(source)) {
+      reason = "generic AIR adapter has no checked independent concurrent "
+               "replica realization";
+      return false;
+    }
+    for (const auto &shape : shapes)
+      if (shape.rows != 1 || shape.cols != 1) {
+        reason = "generic AIR adapter has no checked multi-resource shape "
+                 "realization; resource proposal remains unknown";
+        return false;
+      }
+    return true;
+  };
+  // The proposal declaration is not an evaluator option. Keep its original
+  // bytes in the binding, while passing only target/cost fields downstream.
+  config->erase("source_auto_candidates");
+  backend.evaluate = [&](ModuleOp, ModuleOp normalized,
+                         llvm::ArrayRef<NeighborhoodShape>,
+                         const TaskflowSourceNormalizationWitness &) {
+    ProgramSearchEvaluation observation;
+    std::string reason;
+    auto value = evaluateGenericMLIR(moduleText(normalized), *parsed, reason);
+    auto *object = value.getAsObject();
+    auto *plan = object ? object->getObject("best_plan") : nullptr;
+    const auto status = object ? object->getString("status") : std::nullopt;
+    observation.feasible =
+        plan && (status == "passed" || status == "uncalibrated");
+    // Unsupported mapping/numerics is absence of proof, not infeasibility.
+    observation.feasibilityKnown = observation.feasible;
+    observation.message = reason;
+    if (object && object->getString("reason"))
+      observation.message = object->getString("reason")->str();
+    if (plan)
+      if (auto cost = plan->getNumber("estimated_ms"))
+        observation.costMs = *cost;
+    observation.result = std::move(value);
+    return observation;
+  };
+  SourceSearchResult result;
+  if (failed(searchTaskflowSource(*source, functionName, {}, backend, options,
+                                  result, error)))
+    return false;
+  // Rebinding catches changed, deleted or newly created referenced files.
+  // Such a campaign cannot publish costs under its original cache identity.
+  auto currentConfig = llvm::MemoryBuffer::getFile(request.targetConfigFile);
+  auto sealedConfig = llvm::json::parse(configurationBytes);
+  if (!sealedConfig) {
+    error = llvm::toString(sealedConfig.takeError());
+    return false;
+  }
+  std::string currentDependencies;
+  if (!currentConfig || (*currentConfig)->getBuffer() != configurationBytes ||
+      !bindDependencies(*sealedConfig, currentDependencies, error) ||
+      currentDependencies != dependencyBytes) {
+    error =
+        "source-search configuration or dependencies changed during evaluation";
+    return false;
+  }
+  auto parentPath = llvm::sys::path::parent_path(request.outputDir);
+  if (!parentPath.empty())
+    if (auto ec = llvm::sys::fs::create_directories(parentPath)) {
+      error = ec.message();
+      return false;
+    }
+  // Exclusive creation prevents a long-running search from overwriting a
+  // directory that another campaign created after the initial check.
+  if (auto ec = llvm::sys::fs::create_directory(request.outputDir, false)) {
+    error = ec.message();
+    return false;
+  }
+  result.report["source_fingerprint"] = sourceIdentity;
+  result.report["target_fingerprint"] = backend.capabilityIdentity;
+  result.report["physical_execution"] = false;
+  result.report["cost_scope"] = "configured generic AIR cost provider";
+  if (result.bestSource)
+    result.report["best_normalization"] = llvm::json::Object{
+        {"schema", result.bestNormalization.protocol},
+        {"source_fingerprint", result.bestNormalization.sourceFingerprint},
+        {"normalized_fingerprint",
+         result.bestNormalization.normalizedFingerprint},
+        {"normalized_tasks",
+         static_cast<int64_t>(result.bestNormalization.normalizedTasks)},
+        {"normalized_counters",
+         static_cast<int64_t>(result.bestNormalization.normalizedCounters)},
+        {"replay_verified", true}};
+  const auto prefix = request.outputDir + "/";
+  if (!writeFile(prefix + "source.mlir", request.nativeSourceMLIR, error) ||
+      !writeFile(prefix + "target.json", configurationBytes, error))
+    return false;
+  if (result.bestSource) {
+    auto replay = serializeSourceSearchReplay(
+        functionName, backend.identity, backend.capabilityIdentity,
+        result.bestActions, result.bestShapes);
+    (*replay.getAsObject())["source_fingerprint"] = sourceIdentity;
+    if (!writeFile(prefix + "best.source.mlir", moduleText(*result.bestSource),
+                   error) ||
+        !writeFile(prefix + "best.normalized.mlir",
+                   moduleText(*result.bestNormalized), error) ||
+        !writeFile(prefix + "replay.json",
+                   llvm::formatv("{0:2}\n", replay).str(), error))
+      return false;
+  }
+  return writeFile(
+      prefix + "search.json",
+      llvm::formatv("{0:2}\n", llvm::json::Value(std::move(result.report)))
+          .str(),
+      error);
+}
+} // namespace orbit::taskflow
diff --git a/lib/Taskflow/TaskTiling.cpp b/lib/Taskflow/TaskTiling.cpp
new file mode 100644
index 00000000..2b8f1cb1
--- /dev/null
+++ b/lib/Taskflow/TaskTiling.cpp
@@ -0,0 +1,76 @@
+#include "Taskflow/TaskTiling.h"
+#include "mlir/IR/Builders.h"
+#include <algorithm>
+
+using namespace mlir;
+namespace orbit::taskflow {
+namespace {
+bool validate(size_t count, const std::vector<TaskTileChoice> &choices,
+              std::string &error) {
+  for (size_t i = 0; i < choices.size(); ++i) {
+    const auto &choice = choices[i];
+    if (choice.task >= count || (i && choices[i - 1].task >= choice.task)) {
+      error = "task tiles require unique, in-range task indices";
+      return false;
+    }
+    if (choice.sizes.empty() ||
+        std::any_of(choice.sizes.begin(), choice.sizes.end(),
+                    [](int64_t n) { return n <= 0; })) {
+      error = "task tiles require a nonempty list of positive iteration sizes";
+      return false;
+    }
+  }
+  return true;
+}
+} // namespace
+bool readTaskTileChoices(ModuleOp module, size_t count,
+                         std::vector<TaskTileChoice> &out, std::string &error) {
+  out.clear();
+  auto raw = module->getAttr("orbit.task_tiles");
+  if (!raw)
+    return true;
+  auto table = dyn_cast<ArrayAttr>(raw);
+  if (!table) {
+    error = "orbit.task_tiles requires an array";
+    return false;
+  }
+  for (auto rawEntry : table) {
+    auto entry = dyn_cast<DictionaryAttr>(rawEntry);
+    auto task = entry ? entry.getAs<IntegerAttr>("task") : IntegerAttr{};
+    auto sizes =
+        entry ? entry.getAs<DenseI64ArrayAttr>("sizes") : DenseI64ArrayAttr{};
+    if (!entry || entry.size() != 2 || !task || !task.getType().isInteger(64) ||
+        task.getInt() < 0 || !sizes) {
+      error = "task tile entry requires i64 task and dense i64 sizes";
+      return false;
+    }
+    out.push_back({size_t(task.getInt()),
+                   std::vector<int64_t>(sizes.asArrayRef().begin(),
+                                        sizes.asArrayRef().end())});
+  }
+  std::sort(out.begin(), out.end(),
+            [](const auto &a, const auto &b) { return a.task < b.task; });
+  return validate(count, out, error);
+}
+bool setTaskTileChoices(ModuleOp module, size_t count,
+                        const std::vector<TaskTileChoice> &input,
+                        std::string &error) {
+  auto choices = input;
+  std::sort(choices.begin(), choices.end(),
+            [](const auto &a, const auto &b) { return a.task < b.task; });
+  if (!validate(count, choices, error))
+    return false;
+  Builder builder(module.getContext());
+  SmallVector<Attribute> entries;
+  for (const auto &choice : choices)
+    entries.push_back(builder.getDictionaryAttr(
+        {builder.getNamedAttr("task", builder.getI64IntegerAttr(choice.task)),
+         builder.getNamedAttr("sizes",
+                              builder.getDenseI64ArrayAttr(choice.sizes))}));
+  if (entries.empty())
+    module->removeAttr("orbit.task_tiles");
+  else
+    module->setAttr("orbit.task_tiles", builder.getArrayAttr(entries));
+  return true;
+}
+} // namespace orbit::taskflow
diff --git a/lib/Taskflow/TaskflowFission.cpp b/lib/Taskflow/TaskflowFission.cpp
new file mode 100644
index 00000000..73a93996
--- /dev/null
+++ b/lib/Taskflow/TaskflowFission.cpp
@@ -0,0 +1,1280 @@
+//===- TaskflowFission.cpp - Source-owned DFG fission -----------*- C++ -*-===//
+//
+// Splits a hyperblock DFG at a stable predecessor-closed node partition and
+// materializes every live scalar cut edge in a static tensor indexed by the
+// unchanged counter domain.
+// The two derived tasks therefore retain canonical counter/hyperblock form,
+// and their temporary write/read state is an explicit Taskflow RAW edge.
+//
+//===----------------------------------------------------------------------===//
+
+#include "Taskflow/TaskflowFission.h"
+#include "Taskflow/SourceIterationDomain.h"
+#include "TaskflowDialect/TaskflowOps.h"
+
+#include "mlir/Dialect/Affine/IR/AffineOps.h"
+#include "mlir/Dialect/Arith/IR/Arith.h"
+#include "mlir/Dialect/Func/IR/FuncOps.h"
+#include "mlir/Dialect/MemRef/IR/MemRef.h"
+#include "mlir/Dialect/SCF/IR/SCF.h"
+#include "mlir/IR/BuiltinOps.h"
+#include "mlir/IR/IRMapping.h"
+#include "mlir/IR/SymbolTable.h"
+#include "mlir/IR/Verifier.h"
+#include "mlir/Interfaces/SideEffectInterfaces.h"
+#include "mlir/Pass/Pass.h"
+
+#include "llvm/ADT/DenseMap.h"
