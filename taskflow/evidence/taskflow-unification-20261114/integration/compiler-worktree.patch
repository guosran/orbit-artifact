--- /dev/null
+++ b/include/Taskflow/TaskflowSourceNormalization.h
@@ -0,0 +1,30 @@
+//===- TaskflowSourceNormalization.h - Checked physical form ----*- C++ -*-===//
+#ifndef ORBIT_TASKFLOW_SOURCE_NORMALIZATION_H
+#define ORBIT_TASKFLOW_SOURCE_NORMALIZATION_H
+#include "mlir/IR/BuiltinOps.h"
+#include "mlir/IR/OwningOpRef.h"
+#include "mlir/Support/LogicalResult.h"
+#include <cstdint>
+#include <string>
+namespace orbit::taskflow {
+/// Separate source and physical-normalization identities. Neither fingerprint
+/// is a replacement for the caller's immutable source-semantic identity.
+struct TaskflowSourceNormalizationWitness {
+  std::string protocol = "orbit-taskflow-source-normalization-v1";
+  std::string sourceFingerprint;
+  std::string normalizedFingerprint;
+  uint64_t normalizedTasks = 0;
+  uint64_t normalizedCounters = 0;
+};
+/// Clone and lower canonical static counter/hyperblock bodies to affine loop
+/// nests. Preserve actual scalar operations, accesses and task dependencies.
+/// Unsupported recurrence/control fails explicitly; source is never mutated.
+mlir::LogicalResult normalizeTaskflowSource(
+    mlir::ModuleOp source, mlir::OwningOpRef<mlir::ModuleOp> &normalized,
+    TaskflowSourceNormalizationWitness &witness, std::string &error);
+/// Re-derive from immutable source; do not trust a producer's claimed witness.
+mlir::LogicalResult verifyTaskflowSourceNormalization(
+    mlir::ModuleOp source, mlir::ModuleOp normalized,
+    const TaskflowSourceNormalizationWitness &witness, std::string &error);
+} // namespace orbit::taskflow
+#endif
