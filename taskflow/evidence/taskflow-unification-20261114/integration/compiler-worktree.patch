+//===- TaskflowFusion.h - Source-owned Taskflow graph fusion ----*- C++ -*-===//
+#ifndef ORBIT_TASKFLOW_TASKFLOW_FUSION_H
+#define ORBIT_TASKFLOW_TASKFLOW_FUSION_H
+
+#include "TaskflowDialect/TaskflowOps.h"
+#include "mlir/Dialect/Func/IR/FuncOps.h"
+#include "mlir/IR/BuiltinOps.h"
+#include <memory>
+#include <optional>
+#include <string>
+namespace mlir {
+class Pass;
+}
+namespace orbit::taskflow {
+enum class TaskflowFusionKind { ProducerConsumer, Sibling };
+std::optional<TaskflowFusionKind> parseTaskflowFusionKind(llvm::StringRef kind);
+
+// Check the actual Taskflow counter/hyperblock source, not backend metadata.
+// Producer-consumer forwarding requires a private intermediate and matching,
+// injective element coordinates. Unsupported control/alias patterns fail
+// closed.
+mlir::LogicalResult checkTaskflowFusion(mlir::taskflow::TaskflowTaskOp first,
+                                        mlir::taskflow::TaskflowTaskOp second,
+                                        TaskflowFusionKind kind,
+                                        std::string &error);
+// Resolve unique names, check legality, then replace the pair at the second
+// task's position. No profitability policy or backend pipeline is invoked.
+mlir::FailureOr<mlir::taskflow::TaskflowTaskOp>
+materializeTaskflowFusion(mlir::func::FuncOp function, llvm::StringRef first,
+                          llvm::StringRef second, TaskflowFusionKind kind,
+                          std::string &error);
+struct TaskflowFusionAction {
+  std::string function, first, second;
+  TaskflowFusionKind kind = TaskflowFusionKind::ProducerConsumer;
+};
+mlir::LogicalResult verifyTaskflowFusionReplay(
+    mlir::ModuleOp canonicalParent, mlir::ModuleOp candidate,
+    llvm::ArrayRef<TaskflowFusionAction> actions, std::string &error);
+std::unique_ptr<mlir::Pass> createTaskflowFusionPass();
+} // namespace orbit::taskflow
+#endif
