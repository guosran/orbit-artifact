+namespace {
+// Owning this table in the dialect avoids retaining raw context addresses after
+// context destruction, including when a later context reuses the same address.
+class ProofServices : public DialectInterface::Base<ProofServices> {
+public:
+  MLIR_DEFINE_EXPLICIT_INTERNAL_INLINE_TYPE_ID(ProofServices)
+  explicit ProofServices(Dialect *dialect) : Base(dialect) {}
+  std::map<std::string, OutputCoordinateProofProvider> providers;
+};
+std::mutex servicesMutex;
+OutputCoordinateProofProvider legacyProvider = nullptr;
+
+OutputCoordinateProof unavailable(llvm::StringRef reason) {
+  OutputCoordinateProof result;
+  result.reason = reason.str();
+  return result;
+}
+} // namespace
+
+ProofProviderRegistration
+registerOutputCoordinateProofProvider(MLIRContext &context,
+                                      llvm::StringRef target,
+                                      OutputCoordinateProofProvider provider) {
+  if (target.empty() || !provider)
+    return ProofProviderRegistration::Invalid;
+  // Loading a dialect can execute registry extensions that register services.
+  // Do not hold the service mutex while loading it.
+  auto *dialect = context.getOrLoadDialect<TaskflowDialect>();
+  std::lock_guard<std::mutex> lock(servicesMutex);
+  auto *services = dialect->getRegisteredInterface<ProofServices>();
+  if (!services)
+    services = &dialect->addInterface<ProofServices>();
+  auto [entry, inserted] = services->providers.emplace(target.str(), provider);
+  if (inserted)
+    return ProofProviderRegistration::Registered;
+  return entry->second == provider
+             ? ProofProviderRegistration::AlreadyRegistered
+             : ProofProviderRegistration::Conflict;
 }
+
+ProofProviderRegistration
+registerOutputCoordinateProofProvider(OutputCoordinateProofProvider provider) {
+  if (!provider)
+    return ProofProviderRegistration::Invalid;
+  std::lock_guard<std::mutex> lock(servicesMutex);
+  if (legacyProvider)
+    return legacyProvider == provider
+               ? ProofProviderRegistration::AlreadyRegistered
+               : ProofProviderRegistration::Conflict;
+  legacyProvider = provider;
+  return ProofProviderRegistration::Registered;
