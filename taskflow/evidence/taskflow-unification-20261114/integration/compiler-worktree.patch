-inline bool hasNoAliasTaskFunctionArgument(func::FuncOp function,
-                                           unsigned index) {
-  Attribute proof = function.getArgAttr(index, "amoeba.noalias");
-  if (auto boolean = dyn_cast_or_null<BoolAttr>(proof))
-    return boolean.getValue();
-  return isa_and_nonnull<UnitAttr>(proof);
-}
-
-inline bool isNoAliasTaskFunctionArgument(Value value) {
-  auto argument = dyn_cast<BlockArgument>(value);
-  if (!argument)
-    return false;
-  auto function =
-      dyn_cast_or_null<func::FuncOp>(argument.getOwner()->getParentOp());
-  return function && argument.getOwner() == &function.getBody().front() &&
-         hasNoAliasTaskFunctionArgument(function, argument.getArgNumber());
-}
