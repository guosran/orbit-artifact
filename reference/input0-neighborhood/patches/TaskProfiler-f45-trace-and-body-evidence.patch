+static LogicalResult
+buildStaticCounterSignature(TaskflowTaskOp task,
+                            SmallVectorImpl<TaskflowCounterOp> &counters,
+                            std::string &signature, int &sample_trip_count) {
+  for (Operation &op : task.getBody().front()) {
+    if (auto counter = dyn_cast<TaskflowCounterOp>(&op))
+      counters.push_back(counter);
+  }
+  if (counters.empty()) {
+    task.emitError("body equivalence requires at least one taskflow.counter");
+    return failure();
+  }
+
+  SmallVector<int64_t> trips;
+  SmallVector<int64_t> lower_bounds;
+  SmallVector<int64_t> upper_bounds;
+  SmallVector<int64_t> steps;
+  llvm::DenseMap<Value, unsigned> counter_indices;
+  for (auto [index, counter] : llvm::enumerate(counters))
+    counter_indices[counter.getCounterIndex()] = index;
+
+  SmallVector<SmallVector<unsigned, 4>> children(counters.size());
+  SmallVector<unsigned> roots;
+  for (auto [index, counter] : llvm::enumerate(counters)) {
+    if (Value parent = counter.getParentIndex()) {
+      auto parent_index = counter_indices.find(parent);
+      if (parent_index == counter_indices.end()) {
+        task.emitError(
+            "body equivalence found a counter parent outside its task");
+        return failure();
+      }
+      children[parent_index->second].push_back(index);
+    } else {
+      roots.push_back(index);
+    }
+
+    std::optional<int64_t> lower = getConstantIndex(counter.getLowerBound());
+    std::optional<int64_t> upper = getConstantIndex(counter.getUpperBound());
+    std::optional<int64_t> step = getConstantIndex(counter.getStep());
+    auto hierarchy = counter->getAttrOfType<StringAttr>("counter_hierarchy");
+    auto dynamism = counter->getAttrOfType<StringAttr>("counter_dynamism");
+    auto counter_id = counter->getAttrOfType<IntegerAttr>("counter_id");
+    if (!lower || !upper || !step || *step <= 0 || *upper <= *lower ||
+        !hierarchy || !dynamism || !counter_id) {
+      task.emitError("body equivalence requires fully static counter bounds, "
+                     "positive steps, and complete counter metadata");
+      return failure();
+    }
+
+    __int128 range = static_cast<__int128>(*upper) - *lower;
+    __int128 trip = (range + *step - 1) / *step;
+    if (trip <= 0 || trip > std::numeric_limits<int>::max()) {
+      task.emitError("body equivalence counter trip count is out of range");
+      return failure();
+    }
+    lower_bounds.push_back(*lower);
+    upper_bounds.push_back(*upper);
+    steps.push_back(*step);
+    trips.push_back(static_cast<int64_t>(trip));
+  }
+
+  if (roots.empty()) {
+    task.emitError("body equivalence counter graph has no root");
+    return failure();
+  }
+  int64_t max_chain_trip_count = 0;
+  for (unsigned root : roots) {
+    int64_t chain_trip_count = 1;
+    SmallVector<unsigned> worklist{root};
+    llvm::DenseSet<unsigned> visited;
+    while (!worklist.empty()) {
+      unsigned current = worklist.pop_back_val();
+      if (!visited.insert(current).second) {
+        task.emitError("body equivalence counter graph contains a cycle");
+        return failure();
+      }
+      if (chain_trip_count > std::numeric_limits<int>::max() / trips[current]) {
+        task.emitError(
+            "body equivalence nested counter trip count is out of range");
+        return failure();
+      }
+      chain_trip_count *= trips[current];
+      for (unsigned child : children[current])
+        worklist.push_back(child);
+    }
+    max_chain_trip_count = std::max(max_chain_trip_count, chain_trip_count);
+  }
+
+  if (max_chain_trip_count <= 0 ||
+      max_chain_trip_count > std::numeric_limits<int>::max()) {
+    task.emitError("body equivalence task trip count is out of range");
+    return failure();
+  }
+  sample_trip_count = static_cast<int>(max_chain_trip_count);
+  for (auto [index, counter] : llvm::enumerate(counters)) {
+    auto hierarchy = counter->getAttrOfType<StringAttr>("counter_hierarchy");
+    auto dynamism = counter->getAttrOfType<StringAttr>("counter_dynamism");
+    auto counter_id = counter->getAttrOfType<IntegerAttr>("counter_id");
+    signature += "counter[" + std::to_string(index) +
+                 "]{id=" + std::to_string(counter_id.getInt()) +
+                 ",hierarchy=" + printAttribute(hierarchy) +
+                 ",dynamism=" + printAttribute(dynamism) + ",parent=";
+    if (Value parent = counter.getParentIndex())
+      signature += std::to_string(counter_indices.lookup(parent));
+    else
+      signature += "none";
+    signature += ",lower=" + std::to_string(lower_bounds[index]) +
+                 ",upper=" + std::to_string(upper_bounds[index]) +
+                 ",step=" + std::to_string(steps[index]) +
+                 ",trip=" + std::to_string(trips[index]) + "}\n";
+  }
+  signature +=
+      "task_static_trip_count=" + std::to_string(sample_trip_count) + "\n";
+  return success();
+}
+
+static FailureOr<std::string>
+serializeValueRange(StringRef role, ValueRange values,
+                    TaskSourceValueSerializer &serializer) {
+  std::string text = role.str() + "[";
+  for (auto [index, value] : llvm::enumerate(values)) {
+    FailureOr<std::string> identity = serializer.serialize(value);
+    if (failed(identity))
+      return failure();
+    if (index != 0)
+      text += ";";
+    text += "type=" + printType(value.getType()) + ",source=" + *identity;
+  }
+  text += "]\n";
+  return text;
+}
+
+static FailureOr<PreMapperTaskBodyRecord>
+collectPreMapperTaskBody(func::FuncOp function, TaskflowTaskOp task) {
+  PreMapperTaskBodyRecord record;
+  record.task_name = task.getTaskName().str();
+  SmallVector<TaskflowCounterOp> counters;
+  if (failed(buildStaticCounterSignature(
+          task, counters, record.counter_signature, record.static_trip_count)))
+    return failure();
+
+  TaskSourceValueSerializer serializer(function, counters);
+  auto appendRange = [&](std::string &into, StringRef role,
+                         ValueRange values) -> LogicalResult {
+    FailureOr<std::string> serialized =
+        serializeValueRange(role, values, serializer);
+    if (failed(serialized))
+      return failure();
+    into += *serialized;
+    return success();
+  };
+
+  record.task_signature = "task=" + record.task_name + "\n";
+  if (failed(appendRange(record.task_signature, "dependency_read_in",
+                         task.getDependencyReadIn())) ||
+      failed(appendRange(record.task_signature, "dependency_write_in",
+                         task.getDependencyWriteIn())) ||
+      failed(appendRange(record.task_signature, "value_inputs",
+                         task.getValueInputs())) ||
+      failed(appendRange(record.task_signature, "original_read_memrefs",
+                         task.getOriginalReadMemrefs())) ||
+      failed(appendRange(record.task_signature, "original_write_memrefs",
+                         task.getOriginalWriteMemrefs())) ||
+      failed(appendRange(record.task_signature, "dependency_read_out_types",
+                         task.getDependencyReadOut())) ||
+      failed(appendRange(record.task_signature, "dependency_write_out_types",
+                         task.getDependencyWriteOut())) ||
+      failed(appendRange(record.task_signature, "value_output_types",
+                         task.getValueOutputs()))) {
+    task.emitError("body equivalence cannot serialize task input/output "
+                   "source semantics");
+    return failure();
+  }
+
+  TaskflowYieldOp task_yield =
+      dyn_cast<TaskflowYieldOp>(task.getBody().front().getTerminator());
+  if (!task_yield ||
+      task_yield.getReadResults().size() !=
+          task.getDependencyReadOut().size() ||
+      task_yield.getMemoryResults().size() !=
+          task.getDependencyWriteOut().size() ||
+      task_yield.getValueResults().size() != task.getValueOutputs().size()) {
+    task.emitError(
+        "body equivalence found an incomplete taskflow.yield signature");
+    return failure();
+  }
+  if (failed(appendRange(record.task_signature, "yield_read_states",
+                         task_yield.getReadResults())) ||
+      failed(appendRange(record.task_signature, "yield_write_states",
+                         task_yield.getMemoryResults())) ||
+      failed(appendRange(record.task_signature, "yield_value_results",
+                         task_yield.getValueResults()))) {
+    task.emitError("body equivalence cannot serialize taskflow.yield sources");
+    return failure();
+  }
+
+  SmallVector<neura::KernelOp> kernels;
+  task.walk([&](neura::KernelOp kernel) { kernels.push_back(kernel); });
+  if (kernels.size() != 1) {
+    task.emitError(
+        "body equivalence requires exactly one neura.kernel per task");
+    return failure();
+  }
+  neura::KernelOp kernel = kernels.front();
+  record.kernel_binding_signature = "";
+  if (failed(appendRange(record.kernel_binding_signature, "kernel_inputs",
+                         kernel.getInputs())) ||
+      failed(appendRange(record.kernel_binding_signature,
+                         "kernel_iter_args_init", kernel.getIterArgsInit()))) {
+    task.emitError("body equivalence cannot serialize kernel input bindings");
+    return failure();
+  }
+  record.kernel_binding_signature += "kernel_result_types=[";
+  for (auto [index, type] : llvm::enumerate(kernel.getResultTypes())) {
+    if (index != 0)
+      record.kernel_binding_signature += ";";
+    record.kernel_binding_signature += printType(type);
+  }
+  record.kernel_binding_signature += "]\n";
+
+  std::optional<std::string> wrapper_text =
+      buildMapperWrapperModuleText(kernel);
+  if (!wrapper_text) {
+    task.emitError("body equivalence could not build the mapper wrapper");
+    return failure();
+  }
+  MLIRContext mapper_context;
+  mapper_context.disableMultithreading();
+  loadMapperDialects(mapper_context);
+  ParserConfig parser_config(&mapper_context);
+  OwningOpRef<ModuleOp> module = parseSourceString<ModuleOp>(
+      *wrapper_text, parser_config, "task-profile-body-equivalence.mlir");
+  if (!module) {
+    task.emitError("body equivalence mapper wrapper could not be parsed");
+    return failure();
+  }
+  PassManager lowering_pm(&mapper_context);
+  lowering_pm.enableVerifier(false);
+  addMapperLoweringPipeline(lowering_pm);
+  if (failed(lowering_pm.run(*module))) {
+    task.emitError(
+        "body equivalence exact pre-mapper lowering pipeline failed");
+    return failure();
+  }
+  func::FuncOp lowered_function =
+      module->lookupSymbol<func::FuncOp>("__task_profile__");
+  if (!lowered_function) {
+    task.emitError(
+        "body equivalence lowering removed the task wrapper function");
+    return failure();
+  }
+  llvm::raw_string_ostream body_stream(record.normalized_mapper_body);
+  OpPrintingFlags print_flags;
+  print_flags.useLocalScope();
+  lowered_function->print(body_stream, print_flags);
+  body_stream.flush();
+  return record;
+}
+
+static FailureOr<PreMapperFunctionRecord>
+collectPreMapperFunction(func::FuncOp function) {
+  PreMapperFunctionRecord record;
+  record.function_name = function.getSymName().str();
+  std::string function_type;
+  llvm::raw_string_ostream type_stream(function_type);
+  function.getFunctionType().print(type_stream);
+  record.function_signature = "function_type=" + type_stream.str();
+
+  TaskSourceValueSerializer function_value_serializer(function, {});
+  func::ReturnOp return_op;
+  for (Block &block : function.getBody()) {
+    if (auto terminator = dyn_cast<func::ReturnOp>(block.getTerminator()))
+      return_op = terminator;
+  }
+  if (!return_op) {
+    function.emitError("body equivalence requires a func.return terminator");
+    return failure();
+  }
+  record.function_result_signature = "function_results=[";
+  for (auto [index, value] : llvm::enumerate(return_op.getOperands())) {
+    FailureOr<std::string> identity =
+        function_value_serializer.serialize(value);
+    if (failed(identity)) {
+      function.emitError("body equivalence cannot serialize function return "
+                         "source semantics");
+      return failure();
+    }
+    if (index != 0)
+      record.function_result_signature += ";";
+    record.function_result_signature +=
+        "type=" + printType(value.getType()) + ",source=" + *identity;
+  }
+  record.function_result_signature += "]";
+
+  SmallVector<TaskflowTaskOp> tasks;
+  function.walk([&](TaskflowTaskOp task) { tasks.push_back(task); });
+  for (TaskflowTaskOp task : tasks) {
+    std::string name = task.getTaskName().str();
+    if (name.empty() || record.tasks.count(name) != 0) {
+      task.emitError("body equivalence requires unique nonempty task names");
+      return failure();
+    }
+    FailureOr<PreMapperTaskBodyRecord> task_record =
+        collectPreMapperTaskBody(function, task);
+    if (failed(task_record))
+      return failure();
+    record.tasks[name] = std::move(*task_record);
+  }
+  return record;
+}
+
+static void writePreMapperTaskBodyRecord(raw_ostream &os,
+                                         const PreMapperTaskBodyRecord &record,
+                                         StringRef indent) {
+  os << indent << "{\n" << indent << "  \"task\": ";
+  writeJsonString(os, record.task_name);
+  os << ",\n"
+     << indent << "  \"static_trip_count\": " << record.static_trip_count
+     << ",\n"
+     << indent << "  \"task_signature\": ";
+  writeJsonString(os, record.task_signature);
+  os << ",\n" << indent << "  \"counter_signature\": ";
+  writeJsonString(os, record.counter_signature);
+  os << ",\n" << indent << "  \"kernel_binding_signature\": ";
+  writeJsonString(os, record.kernel_binding_signature);
+  os << ",\n" << indent << "  \"normalized_mapper_body\": ";
+  writeJsonString(os, record.normalized_mapper_body);
+  os << "\n" << indent << "}";
+}
+
+static LogicalResult writePreMapperExport(func::FuncOp function,
+                                          const PreMapperFunctionRecord &record,
+                                          StringRef output_file) {
+  std::error_code error;
+  llvm::raw_fd_ostream os(output_file, error);
+  if (error) {
+    function.emitError() << "failed to open pre-mapper body export '"
+                         << output_file << "': " << error.message();
+    return failure();
+  }
+  os << "{\n  \"format\": \"amoeba-pre-mapper-task-bodies-v1\",\n"
+     << "  \"function\": ";
+  writeJsonString(os, record.function_name);
+  os << ",\n  \"function_signature\": ";
+  writeJsonString(os, record.function_signature);
+  os << ",\n  \"function_result_signature\": ";
+  writeJsonString(os, record.function_result_signature);
+  os << ",\n  \"task_count\": " << record.tasks.size() << ",\n"
+     << "  \"tasks\": [\n";
+  unsigned index = 0;
+  for (const auto &entry : record.tasks) {
+    writePreMapperTaskBodyRecord(os, entry.second, "    ");
+    if (++index != record.tasks.size())
+      os << ",";
+    os << "\n";
+  }
+  os << "  ]\n}\n";
+  return success();
+}
+
+static LogicalResult writePreMapperComparison(
+    func::FuncOp reference, func::FuncOp candidate,
+    const PreMapperFunctionRecord *reference_record,
+    const PreMapperFunctionRecord *candidate_record,
+    ArrayRef<std::string> function_mismatches,
+    const std::map<std::string, SmallVector<std::string>> &task_mismatches,
+    StringRef unsupported_reason, StringRef output_file) {
+  std::error_code error;
+  llvm::raw_fd_ostream os(output_file, error);
+  if (error) {
+    candidate.emitError() << "failed to open pre-mapper equivalence report '"
+                          << output_file << "': " << error.message();
+    return failure();
+  }
+
+  bool supported = reference_record && candidate_record;
+  bool equivalent =
+      supported && function_mismatches.empty() && task_mismatches.empty();
+  os << "{\n  \"format\": \"amoeba-pre-mapper-body-equivalence-v1\",\n"
+     << "  \"supported\": " << (supported ? "true" : "false") << ",\n"
+     << "  \"equivalent\": " << (equivalent ? "true" : "false") << ",\n"
+     << "  \"unsupported_reason\": ";
+  writeJsonString(os, unsupported_reason);
+  os << ",\n  \"reference_function\": ";
+  writeJsonString(os, reference ? reference.getSymName() : StringRef());
+  os << ",\n  \"candidate_function\": ";
+  writeJsonString(os, candidate ? candidate.getSymName() : StringRef());
+  os << ",\n  \"function_mismatches\": [";
+  for (auto [index, mismatch] : llvm::enumerate(function_mismatches)) {
+    if (index != 0)
+      os << ", ";
+    writeJsonString(os, mismatch);
+  }
+  os << "],\n  \"reference_function_signature\": ";
+  if (reference_record)
+    writeJsonString(os, reference_record->function_signature);
+  else
+    os << "null";
+  os << ",\n  \"candidate_function_signature\": ";
+  if (candidate_record)
+    writeJsonString(os, candidate_record->function_signature);
+  else
+    os << "null";
+  os << ",\n  \"reference_function_result_signature\": ";
+  if (reference_record)
+    writeJsonString(os, reference_record->function_result_signature);
+  else
+    os << "null";
+  os << ",\n  \"candidate_function_result_signature\": ";
+  if (candidate_record)
+    writeJsonString(os, candidate_record->function_result_signature);
+  else
+    os << "null";
+  os << ",\n  \"tasks\": [\n";
+
+  std::set<std::string> task_names;
+  if (reference_record)
+    for (const auto &entry : reference_record->tasks)
+      task_names.insert(entry.first);
+  if (candidate_record)
+    for (const auto &entry : candidate_record->tasks)
+      task_names.insert(entry.first);
+
+  bool first_task = true;
+  for (const std::string &name : task_names) {
+    const PreMapperTaskBodyRecord *reference_task = nullptr;
+    const PreMapperTaskBodyRecord *candidate_task = nullptr;
+    if (reference_record) {
+      auto it = reference_record->tasks.find(name);
+      if (it != reference_record->tasks.end())
+        reference_task = &it->second;
+    }
+    if (candidate_record) {
+      auto it = candidate_record->tasks.find(name);
+      if (it != candidate_record->tasks.end())
+        candidate_task = &it->second;
+    }
+    auto mismatches = task_mismatches.find(name);
+    if (!first_task)
+      os << ",\n";
+    first_task = false;
+    os << "    {\n      \"task\": ";
+    writeJsonString(os, name);
+    os << ",\n      \"equivalent\": "
+       << (reference_task && candidate_task &&
+                   mismatches == task_mismatches.end()
+               ? "true"
+               : "false")
+       << ",\n      \"mismatches\": [";
+    if (mismatches != task_mismatches.end()) {
+      for (auto [index, mismatch] : llvm::enumerate(mismatches->second)) {
+        if (index != 0)
+          os << ", ";
+        writeJsonString(os, mismatch);
+      }
+    } else if (!reference_task || !candidate_task) {
+      writeJsonString(os, "task missing from one function");
+    }
+    os << "],\n      \"reference\": ";
+    if (reference_task)
+      writePreMapperTaskBodyRecord(os, *reference_task, "      ");
+    else
+      os << "null";
+    os << ",\n      \"candidate\": ";
+    if (candidate_task)
+      writePreMapperTaskBodyRecord(os, *candidate_task, "      ");
+    else
+      os << "null";
+    os << "\n    }";
+  }
+  os << "\n  ]\n}\n";
+  return success();
+}
+
+LogicalResult
+TaskProfiler::exportPreMapperTaskBodies(func::FuncOp func,
+                                        llvm::StringRef output_file) {
+  FailureOr<PreMapperFunctionRecord> record = collectPreMapperFunction(func);
+  if (failed(record)) {
+    std::error_code error;
+    llvm::raw_fd_ostream os(output_file, error);
+    if (!error) {
+      os << "{\n  \"format\": \"amoeba-pre-mapper-task-bodies-v1\",\n"
+         << "  \"supported\": false,\n"
+         << "  \"error\": \"could not lower or serialize every task\"\n}\n";
+    }
+    return failure();
+  }
+  return writePreMapperExport(func, *record, output_file);
+}
+
+LogicalResult
+TaskProfiler::verifyPreMapperTaskBodyEquivalence(func::FuncOp reference,
+                                                 func::FuncOp candidate,
+                                                 llvm::StringRef output_file) {
+  FailureOr<PreMapperFunctionRecord> reference_record =
+      collectPreMapperFunction(reference);
+  FailureOr<PreMapperFunctionRecord> candidate_record =
+      collectPreMapperFunction(candidate);
+  if (failed(reference_record) || failed(candidate_record)) {
+    if (failed(writePreMapperComparison(
+            reference, candidate, /*reference_record=*/nullptr,
+            /*candidate_record=*/nullptr, {}, {},
+            "one or both functions could not be lowered or serialized",
+            output_file)))
+      return failure();
+    return failure();
+  }
+
+  SmallVector<std::string> function_mismatches;
+  if (reference_record->function_name != candidate_record->function_name)
+    function_mismatches.push_back("function_name");
+  if (reference_record->function_signature !=
+      candidate_record->function_signature)
+    function_mismatches.push_back("function_signature");
+  if (reference_record->function_result_signature !=
+      candidate_record->function_result_signature)
+    function_mismatches.push_back("function_result_signature");
+  if (reference_record->tasks.size() != candidate_record->tasks.size())
+    function_mismatches.push_back("task_count");
+
+  std::set<std::string> task_names;
+  for (const auto &entry : reference_record->tasks)
+    task_names.insert(entry.first);
+  for (const auto &entry : candidate_record->tasks)
+    task_names.insert(entry.first);
+
+  std::map<std::string, SmallVector<std::string>> task_mismatches;
+  for (const std::string &name : task_names) {
+    auto reference_it = reference_record->tasks.find(name);
+    auto candidate_it = candidate_record->tasks.find(name);
+    SmallVector<std::string> mismatches;
+    if (reference_it == reference_record->tasks.end() ||
+        candidate_it == candidate_record->tasks.end()) {
+      mismatches.push_back("task missing from one function");
+    } else {
+      const PreMapperTaskBodyRecord &reference_task = reference_it->second;
+      const PreMapperTaskBodyRecord &candidate_task = candidate_it->second;
+      if (reference_task.static_trip_count != candidate_task.static_trip_count)
+        mismatches.push_back("static_trip_count");
+      if (reference_task.task_signature != candidate_task.task_signature)
+        mismatches.push_back("task_signature");
+      if (reference_task.counter_signature != candidate_task.counter_signature)
+        mismatches.push_back("counter_signature");
+      if (reference_task.kernel_binding_signature !=
+          candidate_task.kernel_binding_signature)
+        mismatches.push_back("kernel_binding_signature");
+      if (reference_task.normalized_mapper_body !=
+          candidate_task.normalized_mapper_body)
+        mismatches.push_back("normalized_mapper_body");
+    }
+    if (!mismatches.empty())
+      task_mismatches.emplace(name, std::move(mismatches));
+  }
+
+  if (failed(writePreMapperComparison(reference, candidate, &*reference_record,
+                                      &*candidate_record, function_mismatches,
+                                      task_mismatches,
+                                      /*unsupported_reason=*/"", output_file)))
+    return failure();
+  if (!function_mismatches.empty() || !task_mismatches.empty()) {
+    candidate.emitError("pre-mapper task body equivalence check failed");
+    return failure();
+  }
+  return success();
+}
