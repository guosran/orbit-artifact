+static std::optional<int64_t>
+evaluateAffineExpression(AffineExpr expression, ArrayRef<int64_t> operands,
+                         unsigned num_dims) {
+  if (auto constant = dyn_cast<AffineConstantExpr>(expression))
+    return constant.getValue();
+  if (auto dim = dyn_cast<AffineDimExpr>(expression)) {
+    if (dim.getPosition() >= num_dims || dim.getPosition() >= operands.size())
+      return std::nullopt;
+    return operands[dim.getPosition()];
+  }
+  if (auto symbol = dyn_cast<AffineSymbolExpr>(expression)) {
+    size_t position = static_cast<size_t>(num_dims) + symbol.getPosition();
+    if (position >= operands.size())
+      return std::nullopt;
+    return operands[position];
+  }
+  auto binary = dyn_cast<AffineBinaryOpExpr>(expression);
+  if (!binary)
+    return std::nullopt;
+  std::optional<int64_t> lhs =
+      evaluateAffineExpression(binary.getLHS(), operands, num_dims);
+  std::optional<int64_t> rhs =
+      evaluateAffineExpression(binary.getRHS(), operands, num_dims);
+  if (!lhs || !rhs)
+    return std::nullopt;
+
+  __int128 value;
+  switch (expression.getKind()) {
+  case AffineExprKind::Add:
+    value = static_cast<__int128>(*lhs) + *rhs;
+    break;
+  case AffineExprKind::Mul:
+    value = static_cast<__int128>(*lhs) * *rhs;
+    break;
+  default:
+    // Division/modulo semantics are intentionally unsupported here. The
+    // proof stays fail-closed unless all bound arithmetic is handled exactly.
+    return std::nullopt;
+  }
+  if (value < std::numeric_limits<int64_t>::min() ||
+      value > std::numeric_limits<int64_t>::max())
+    return std::nullopt;
+  return static_cast<int64_t>(value);
+}
