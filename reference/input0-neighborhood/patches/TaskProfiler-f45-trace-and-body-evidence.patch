+// Stable source identities are part of the reuse proof. Unknown region-valued
+// sources fail closed rather than allowing distinct dependency states to
+// collapse to the same signature.
+class TaskSourceValueSerializer {
+public:
+  TaskSourceValueSerializer(func::FuncOp function,
+                            ArrayRef<TaskflowCounterOp> counters) {
+    unsigned ordinal = 0;
+    function.walk([&](Operation *op) { operation_ordinals_[op] = ordinal++; });
+    for (unsigned index = 0; index < counters.size(); ++index) {
+      TaskflowCounterOp counter = counters[index];
+      counter_ordinals_[counter.getCounterIndex()] = index;
+    }
+  }
+
+  FailureOr<std::string> serialize(Value value) {
+    llvm::DenseSet<Value> active;
+    return serializeImpl(value, active);
+  }
+
+private:
+  FailureOr<std::string> serializeImpl(Value value,
+                                       llvm::DenseSet<Value> &active) {
+    if (!value)
+      return failure();
+    auto cached = serialized_values_.find(value);
+    if (cached != serialized_values_.end())
+      return cached->second;
+    if (!active.insert(value).second)
+      return failure();
+
+    std::string result;
+    if (auto argument = dyn_cast<BlockArgument>(value)) {
+      Operation *parent = argument.getOwner()->getParentOp();
+      if (isa<func::FuncOp>(parent)) {
+        result = "function-arg[" + std::to_string(argument.getArgNumber()) +
+                 "]:" + printType(argument.getType());
+      } else if (auto task = dyn_cast<TaskflowTaskOp>(parent)) {
+        unsigned number = argument.getArgNumber();
+        Value source;
+        std::string role;
+        if (number < task.getDependencyReadIn().size()) {
+          source = task.getDependencyReadIn()[number];
+          role = "dependency_read_in[" + std::to_string(number) + "]";
+        } else if ((number -= task.getDependencyReadIn().size()) <
+                   task.getDependencyWriteIn().size()) {
+          source = task.getDependencyWriteIn()[number];
+          role = "dependency_write_in[" + std::to_string(number) + "]";
+        } else {
+          number -= task.getDependencyWriteIn().size();
+          if (number >= task.getValueInputs().size())
+            return failure();
+          source = task.getValueInputs()[number];
+          role = "value_input[" + std::to_string(number) + "]";
+        }
+        FailureOr<std::string> source_identity = serializeImpl(source, active);
+        if (failed(source_identity))
+          return failure();
+        result = "task-arg{" + role + ",type=" + printType(argument.getType()) +
+                 ",source=" + *source_identity + "}";
+      } else {
+        return failure();
+      }
+    } else {
+      Operation *definition = value.getDefiningOp();
+      if (!definition)
+        return failure();
+      if (auto constant = dyn_cast<arith::ConstantOp>(definition)) {
+        result = "constant{" + printType(value.getType()) +
+                 ",value=" + printAttribute(constant.getValue()) + "}";
+      } else if (auto channel = dyn_cast<TaskflowChannelOp>(definition)) {
+        FailureOr<std::string> source_identity =
+            serializeImpl(channel.getSource(), active);
+        if (failed(source_identity))
+          return failure();
+        result = "channel{" + *source_identity + "}";
+      } else if (auto producer = dyn_cast<TaskflowTaskOp>(definition)) {
+        unsigned result_number = cast<OpResult>(value).getResultNumber();
+        result = "task-result{" + producer.getTaskName().str() + "," +
+                 getTaskResultRole(producer, result_number) +
+                 ",type=" + printType(value.getType()) + "}";
+      } else if (auto counter = dyn_cast<TaskflowCounterOp>(definition)) {
+        auto ordinal = counter_ordinals_.find(counter.getCounterIndex());
+        if (ordinal == counter_ordinals_.end())
+          return failure();
+        result = "task-counter[" + std::to_string(ordinal->second) +
+                 "]:" + printType(value.getType());
+      } else if (isa<neura::KernelOp>(definition)) {
+        result = "kernel-result[" +
+                 std::to_string(cast<OpResult>(value).getResultNumber()) +
+                 "]:" + printType(value.getType());
+      } else {
+        if (definition->getNumRegions() != 0)
+          return failure();
+        auto ordinal = operation_ordinals_.find(definition);
+        if (ordinal == operation_ordinals_.end())
+          return failure();
+        result = "source-op{" + definition->getName().getStringRef().str() +
+                 "#" + std::to_string(ordinal->second) + ",result=" +
+                 std::to_string(cast<OpResult>(value).getResultNumber()) +
+                 ",type=" + printType(value.getType()) +
+                 ",attrs=" + printAttribute(definition->getAttrDictionary()) +
+                 ",operands=[";
+        bool first = true;
+        for (Value operand : definition->getOperands()) {
+          FailureOr<std::string> operand_identity =
+              serializeImpl(operand, active);
+          if (failed(operand_identity))
+            return failure();
+          if (!first)
+            result += ";";
+          first = false;
+          result += *operand_identity;
+        }
+        result += "]}";
+      }
+    }
+
+    active.erase(value);
+    serialized_values_[value] = result;
+    return result;
+  }
+
+  llvm::DenseMap<const Operation *, unsigned> operation_ordinals_;
+  llvm::DenseMap<Value, unsigned> counter_ordinals_;
+  llvm::DenseMap<Value, std::string> serialized_values_;
+};
