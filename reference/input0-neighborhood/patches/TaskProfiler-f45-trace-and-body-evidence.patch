+namespace mlir {
+namespace taskflow {
+namespace {
+
+class TaskProfilerBodyEquivalencePass
+    : public PassWrapper<TaskProfilerBodyEquivalencePass,
+                         OperationPass<ModuleOp>> {
+public:
+  MLIR_DEFINE_EXPLICIT_INTERNAL_INLINE_TYPE_ID(TaskProfilerBodyEquivalencePass)
+
+  TaskProfilerBodyEquivalencePass() = default;
+  TaskProfilerBodyEquivalencePass(const TaskProfilerBodyEquivalencePass &other)
+      : PassWrapper(other) {}
+
+  StringRef getArgument() const final {
+    return "verify-task-profiler-body-equivalence";
+  }
+
+  StringRef getDescription() const final {
+    return "export or exactly compare task profiler pre-mapper bodies";
+  }
+
+  void getDependentDialects(DialectRegistry &registry) const override {
+    registry.insert<affine::AffineDialect, arith::ArithDialect,
+                    cf::ControlFlowDialect, func::FuncDialect,
+                    LLVM::LLVMDialect, memref::MemRefDialect,
+                    neura::NeuraDialect, scf::SCFDialect, TaskflowDialect>();
+  }
+
+  void runOnOperation() override {
+    ModuleOp candidate_module = getOperation();
+    if (outputFile.empty()) {
+      candidate_module.emitError(
+          "body equivalence pass requires a nonempty output option");
+      signalPassFailure();
+      return;
+    }
+
+    func::FuncOp candidate = findFunction(candidate_module, functionName);
+    if (!candidate) {
+      candidate_module.emitError()
+          << "body equivalence pass requires exactly one matching function; "
+             "set the function option explicitly";
+      signalPassFailure();
+      return;
+    }
+
+    if (referenceFile.empty()) {
+      if (failed(
+              TaskProfiler::exportPreMapperTaskBodies(candidate, outputFile)))
+        signalPassFailure();
+      return;
+    }
+
+    auto buffer = llvm::MemoryBuffer::getFile(referenceFile);
+    if (!buffer) {
+      candidate.emitError()
+          << "failed to read reference module '" << referenceFile
+          << "': " << buffer.getError().message();
+      signalPassFailure();
+      return;
+    }
+
+    MLIRContext *context = candidate_module.getContext();
+    context->getOrLoadDialect<affine::AffineDialect>();
+    context->getOrLoadDialect<arith::ArithDialect>();
+    context->getOrLoadDialect<cf::ControlFlowDialect>();
+    context->getOrLoadDialect<func::FuncDialect>();
+    context->getOrLoadDialect<LLVM::LLVMDialect>();
+    context->getOrLoadDialect<memref::MemRefDialect>();
+    context->getOrLoadDialect<neura::NeuraDialect>();
+    context->getOrLoadDialect<scf::SCFDialect>();
+    context->getOrLoadDialect<TaskflowDialect>();
+    ParserConfig parser_config(context);
+    OwningOpRef<ModuleOp> reference_module = parseSourceString<ModuleOp>(
+        (*buffer)->getBuffer(), parser_config, referenceFile);
+    if (!reference_module) {
+      candidate.emitError()
+          << "failed to parse reference module '" << referenceFile << "'";
+      signalPassFailure();
+      return;
+    }
+
+    func::FuncOp reference = findFunction(*reference_module, functionName);
+    if (!reference) {
+      candidate.emitError()
+          << "reference module has no unique function selected by '"
+          << functionName << "'";
+      signalPassFailure();
+      return;
+    }
+    if (failed(TaskProfiler::verifyPreMapperTaskBodyEquivalence(
+            reference, candidate, outputFile)))
+      signalPassFailure();
+  }
+
+  Option<std::string> referenceFile{
+      *this, "reference",
+      llvm::cl::desc("reference module; omit to export only"),
+      llvm::cl::init("")};
+  Option<std::string> functionName{*this, "function",
+                                   llvm::cl::desc("function symbol to inspect"),
+                                   llvm::cl::init("")};
+  Option<std::string> outputFile{*this, "output",
+                                 llvm::cl::desc("JSON export/report path"),
+                                 llvm::cl::init("")};
+
+private:
+  static func::FuncOp findFunction(ModuleOp module, StringRef requested_name) {
+    if (!requested_name.empty())
+      return module.lookupSymbol<func::FuncOp>(requested_name);
+    func::FuncOp found;
+    unsigned count = 0;
+    module.walk([&](func::FuncOp function) {
+      if (function.isExternal())
+        return;
+      found = function;
+      ++count;
+    });
+    return count == 1 ? found : func::FuncOp();
+  }
+};
+
+} // namespace
+
+std::unique_ptr<Pass> createTaskProfilerBodyEquivalencePass() {
+  return std::make_unique<TaskProfilerBodyEquivalencePass>();
+}
