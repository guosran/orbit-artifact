+    return "dependency_read_out[" + std::to_string(result_number) + "]";
+  result_number -= task.getDependencyReadOut().size();
+  if (result_number < task.getDependencyWriteOut().size())
+    return "dependency_write_out[" + std::to_string(result_number) + "]";
+  result_number -= task.getDependencyWriteOut().size();
+  if (result_number < task.getValueOutputs().size())
+    return "value_output[" + std::to_string(result_number) + "]";
+  return "invalid-result[" + std::to_string(result_number) + "]";
