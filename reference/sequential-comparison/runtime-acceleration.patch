+  static size_t typedActionReplayMemoEntryBytes(
+      const TypedActionReplayMemoEntry &entry) {
+    size_t bytes = sizeof(entry) + entry.moduleIR.size() + entry.key.size() +
+                   entry.factKey.size();
+    for (const std::string &action : entry.actionPrefixBytes)
+      bytes += sizeof(action) + action.size();
+    for (const NeighborhoodShape &shape : entry.shapes)
+      bytes += sizeof(shape) + shape.task.size();
+    bytes += entry.actionHistory.actions.size() *
+             sizeof(NeighborhoodAction);
+    for (const NeighborhoodAction &action : entry.actionHistory.actions) {
+      bytes += action.family.size() + action.label.size() +
+               action.shapeTask.size();
+      for (const NeighborhoodPrimitive &primitive : action.primitives)
+        bytes += primitive.kind.size() + primitive.firstTask.size() +
+                 primitive.secondTask.size() + primitive.mode.size();
+    }
+    return bytes;
+  }
