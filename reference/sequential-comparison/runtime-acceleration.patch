+    appendLengthPrefixed(context, typedActionReplayMemoFunction);
+    appendLengthPrefixed(context, typedActionReplayMemoOutputDirectory);
+    appendLengthPrefixed(context, typedActionReplayMemoOptionsKey);
+    appendLengthPrefixed(context, history.canonicalFactKey);
