+    while (!typedActionReplayMemoEntries.empty() &&
+           (typedActionReplayMemoEntries.size() >=
+                kTypedActionReplayMemoMaxEntries ||
+            typedActionReplayMemoBytes >
+                kTypedActionReplayMemoMaxBytes - entry.retainedBytes)) {
+      auto oldest = std::min_element(
+          typedActionReplayMemoEntries.begin(),
+          typedActionReplayMemoEntries.end(),
+          [](const TypedActionReplayMemoEntry &lhs,
+             const TypedActionReplayMemoEntry &rhs) {
+            return lhs.lastUse < rhs.lastUse;
+          });
+      eraseTypedActionReplayMemoEntry(
+          static_cast<size_t>(oldest - typedActionReplayMemoEntries.begin()));
+    }
+    typedActionReplayMemoBytes += entry.retainedBytes;
+    typedActionReplayMemoEntries.push_back(std::move(entry));
+  }
