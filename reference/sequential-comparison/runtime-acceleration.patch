+  void eraseTypedActionReplayMemoEntry(size_t index) {
+    if (index >= typedActionReplayMemoEntries.size())
+      return;
+    typedActionReplayMemoBytes -=
+        typedActionReplayMemoEntries[index].retainedBytes;
+    typedActionReplayMemoEntries.erase(
+        typedActionReplayMemoEntries.begin() + index);
+  }
+
+  std::optional<size_t> findTypedActionReplayMemoPrefix(
+      ArrayRef<std::string> actionBytes) {
+    std::optional<size_t> best;
+    size_t bestPrefixLength = 0;
+    for (size_t index = 0; index < typedActionReplayMemoEntries.size();
+         ++index) {
+      const TypedActionReplayMemoEntry &entry =
+          typedActionReplayMemoEntries[index];
+      const size_t prefixLength = entry.actionPrefixBytes.size();
+      if (prefixLength > actionBytes.size() ||
+          (best && prefixLength <= bestPrefixLength) ||
+          !std::equal(entry.actionPrefixBytes.begin(),
+                      entry.actionPrefixBytes.end(), actionBytes.begin()))
+        continue;
+      best = index;
+      bestPrefixLength = prefixLength;
+    }
+    if (best)
+      typedActionReplayMemoEntries[*best].lastUse =
+          ++typedActionReplayMemoClock;
+    return best;
+  }
+
+  void rememberTypedActionReplayPrefix(
+      ArrayRef<std::string> actionBytes, size_t prefixLength,
+      const SearchState &replayed) {
+    if (!replayed.module || replayed.key.empty() || replayed.factKey.empty() ||
+        prefixLength > actionBytes.size() ||
+        replayed.actionHistory.actions.size() != prefixLength)
+      return;
+
+    TypedActionReplayMemoEntry entry;
+    entry.actionPrefixBytes.assign(actionBytes.begin(),
+                                   actionBytes.begin() + prefixLength);
+    entry.moduleIR = neighborhoodReplaySourceText(replayed.module.get());
+    entry.shapes = replayed.shapes;
+    entry.key = replayed.key;
+    entry.factKey = replayed.factKey;
+    entry.actionHistory = replayed.actionHistory;
+    entry.lastUse = ++typedActionReplayMemoClock;
+    entry.retainedBytes = typedActionReplayMemoEntryBytes(entry);
+    if (entry.retainedBytes > kTypedActionReplayMemoMaxBytes)
+      return;
+
+    for (size_t index = 0; index < typedActionReplayMemoEntries.size();
+         ++index) {
+      TypedActionReplayMemoEntry &previous =
+          typedActionReplayMemoEntries[index];
+      if (previous.actionPrefixBytes != entry.actionPrefixBytes)
+        continue;
+      if (previous.moduleIR == entry.moduleIR &&
+          previous.key == entry.key && previous.factKey == entry.factKey &&
+          shapeSignature(previous.shapes) == shapeSignature(entry.shapes)) {
+        previous.lastUse = entry.lastUse;
+        return;
+      }
+      // An identical exact input prefix produced different state bytes.  Do
+      // not let memoized outputs authorize any later replay in this context.
+      clearTypedActionReplayMemoEntries();
+      return;
+    }
