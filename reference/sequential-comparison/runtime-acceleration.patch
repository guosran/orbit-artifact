+        typedActionReplayMemoContext != canonical.getContext() ||
+        typedActionReplayMemoFunction != functionName ||
+        typedActionReplayMemoOutputDirectory != outputDirectory ||
+        typedActionReplayMemoOptionsKey != optionsKey) {
+      clearTypedActionReplayMemoEntries();
+      typedActionReplayMemoCanonical = canonical.getOperation();
+      typedActionReplayMemoContext = canonical.getContext();
+      typedActionReplayMemoCanonicalIR = neighborhoodReplaySourceText(canonical);
+      typedActionReplayMemoFunction = functionName.str();
+      typedActionReplayMemoOutputDirectory = outputDirectory.str();
+      typedActionReplayMemoOptionsKey = optionsKey;
+    }
