+  static bool isResourceHistoryAction(const NeighborhoodAction &action) {
+    if (action.canonicalReset) return false;
+    if (action.family == "shape")
+      return action.primitives.empty() && !action.shapeTask.empty() &&
+             action.shapeRows > 0 && action.shapeCols > 0;
+    if (action.family == "replica")
+      return action.shapeTask.empty() && !action.primitives.empty() &&
+             llvm::all_of(action.primitives, [](const auto &primitive) {
+               return primitive.kind == "replica";
+             });
+    return false;
+  }
