+  bool rebindCachedRecordVocabulary(
+      const ArchiveRecord &record, func::FuncOp targetFunction,
+      ArrayRef<NeighborhoodShape> expectedShapes,
+      bool requireTargetTaskNames,
+      SmallVectorImpl<TaskShapeChoice> &reboundChoices,
+      std::vector<NeighborhoodShape> &reboundShapes,
