+  bool hasFrozenPrefix(const SearchState::TypedActionHistory &history) const {
+    if (!history.known ||
+        history.actions.size() < frozenPrefixActions.size() ||
+        history.fissionActions.size() != frozenFissionActions.size() ||
+        shapeSignature(history.initialShapes) !=
+            shapeSignature(frozenInitialShapes) ||
+        history.canonicalFactKey != frozenCanonicalFactKey)
+      return false;
+    auto exactActionBytes = [](const NeighborhoodAction &action) {
+      return jsonText(json::Value(typedActionObject(action)));
+    };
+    for (size_t index = 0; index < frozenPrefixActions.size(); ++index)
+      if (exactActionBytes(history.actions[index]) !=
+          exactActionBytes(frozenPrefixActions[index]))
+        return false;
+    for (size_t index = 0; index < frozenFissionActions.size(); ++index)
+      if (exactActionBytes(history.fissionActions[index]) !=
+          exactActionBytes(frozenFissionActions[index]))
+        return false;
+    for (size_t index = frozenPrefixActions.size();
+         index < history.actions.size(); ++index)
+      if (!isResourceHistoryAction(history.actions[index]))
+        return false;
+    return true;
+  }
