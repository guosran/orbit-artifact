+      error = metadataError.empty()
+                  ? "cross-phase cached score target task metadata is unknown"
+                  : "cross-phase cached score target task metadata is unknown: " +
+                        metadataError;
+      return false;
+    }
+    const size_t taskCount = metadata->size();
+    if (taskCount == 0 || expectedShapes.size() != taskCount ||
+        record.shapes.size() != taskCount ||
+        record.choices.size() != taskCount ||
+        record.costs.size() != taskCount ||
+        record.durations.size() != taskCount ||
+        record.schedule.dispatch.size() != taskCount ||
+        record.schedule.placements.size() != taskCount ||
+        record.score <= 0 || record.schedule.makespan != record.score) {
+      error = "cross-phase cached score task, cost, duration, or schedule counts disagree";
+      return false;
+    }
+    if (requireTargetTaskNames && !sameTaskSet(*metadata, expectedShapes)) {
+      error = "authenticated phase-B shapes do not match the target module task order";
+      return false;
+    }
+
