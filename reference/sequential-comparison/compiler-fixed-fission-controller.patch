+    for (unsigned task : record.schedule.dispatch)
+      if (task >= taskCount || !dispatchTasks.insert(task).second) {
+        error = "cross-phase cached production dispatch is not a task permutation";
+        return false;
+      }
+    std::set<unsigned> placementTasks;
+    for (const ExactSchedulePlacement &placement : record.schedule.placements)
+      if (placement.task >= taskCount || placement.start < 0 ||
+          placement.end <= placement.start ||
+          (placement.task < record.durations.size() &&
+           placement.end - placement.start !=
+               record.durations[placement.task]) ||
+          !placementTasks.insert(placement.task).second) {
+        error = "cross-phase cached production placement is incomplete or malformed";
+        return false;
+      }
+
+    reboundChoices.clear();
+    reboundShapes.clear();
+    for (size_t index = 0; index < taskCount; ++index) {
+      const TaskMetadata &task = (*metadata)[index];
+      const TaskShapeChoice &cachedChoice = record.choices[index];
+      const NeighborhoodShape &cachedShape = record.shapes[index];
+      const NeighborhoodShape &expectedShape = expectedShapes[index];
+      const TaskShapeCost &cost = record.costs[index];
+      if (!task.tripCountKnown || task.tripCount <= 0 ||
+          cachedChoice.task != cachedShape.task ||
+          cachedChoice.tripCount != task.tripCount ||
+          cachedShape.rows != cachedChoice.shape.rows ||
+          cachedShape.cols != cachedChoice.shape.cols ||
+          expectedShape.rows != cachedChoice.shape.rows ||
+          expectedShape.cols != cachedChoice.shape.cols ||
+          cachedChoice.shape.rows <= 0 || cachedChoice.shape.cols <= 0 ||
+          cachedChoice.shape.mapperRows <= 0 ||
+          cachedChoice.shape.mapperCols <= 0 || !cost.supported) {
