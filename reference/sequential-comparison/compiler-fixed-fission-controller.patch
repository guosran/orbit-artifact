+// Selecting one item by a stable rotation leaves all other items in their
+// original relative order. Keep that order as immutable ordinals instead of
+// rescanning and moving an entire frontier for each attempted action. Scores
+// (including reservations within a batch) and ties are still resolved exactly
+// as in prioritizeNextPendingActionFamily above.
+class IndexedPendingFamilies {
+public:
+  IndexedPendingFamilies(const std::vector<PendingNeighbor> &pending,
+                         size_t cursor)
+      : original(pending), consumed(pending.size(), false),
+        firstCursor(cursor), nextCursor(cursor), sourceData(pending.data()) {
+    for (size_t index = cursor; index < original.size(); ++index)
+      byFamily[original[index].action.family].push_back(index);
+  }
+
+  void prioritize(std::vector<PendingNeighbor> &pending, size_t cursor,
+                  const std::map<std::string, uint64_t> &successful,
+                  const std::map<std::string, uint64_t> &reserved) {
+    assert(cursor == nextCursor && cursor < original.size());
+    uint64_t bestScore = std::numeric_limits<uint64_t>::max();
+    size_t ordinal = std::numeric_limits<size_t>::max();
+    auto chosen = byFamily.end();
+    for (auto it = byFamily.begin(); it != byFamily.end(); ++it) {
+      auto done = successful.find(it->first);
+      auto held = reserved.find(it->first);
+      const uint64_t score =
+          (done == successful.end() ? 0 : done->second) +
+          (held == reserved.end() ? 0 : held->second);
+      const size_t first = it->second.front();
+      if (score < bestScore || (score == bestScore && first < ordinal)) {
+        bestScore = score;
+        ordinal = first;
+        chosen = it;
+      }
+    }
+    assert(chosen != byFamily.end());
+    pending[cursor] = original[ordinal];
+    consumed[ordinal] = true;
+    chosen->second.pop_front();
+    if (chosen->second.empty())
+      byFamily.erase(chosen);
+    ++nextCursor;
+  }
+
+  bool matches(ArrayRef<PendingNeighbor> pending, size_t cursor) const {
+    return pending.data() == sourceData && pending.size() == original.size() &&
+           cursor == nextCursor;
+  }
+
+  // Checkpoints retain the exact legacy vector: chosen prefix followed by
+  // the untouched relative order of all remaining items. Thus restoration
+  // needs no new schema or acceleration-specific continuation state.
+  template <typename Emit>
+  void snapshot(ArrayRef<PendingNeighbor> pending, Emit emit) const {
+    for (size_t index = 0; index < nextCursor; ++index)
+      emit(pending[index]);
+    for (size_t index = firstCursor; index < original.size(); ++index)
+      if (!consumed[index])
+        emit(original[index]);
+  }
+
+private:
+  std::vector<PendingNeighbor> original;
+  std::vector<bool> consumed;
+  std::map<std::string, std::deque<size_t>> byFamily;
+  size_t firstCursor, nextCursor;
+  const PendingNeighbor *sourceData;
+};
