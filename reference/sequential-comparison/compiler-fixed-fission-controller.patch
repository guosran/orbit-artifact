+  void appendActionAttempt(StringRef phase, const NeighborhoodAction &action,
+                           StringRef outcome, bool materialized, bool legal,
+                           bool freezeVerified) {
+    if (decisionFlow == "legacy")
+      return;
+    const std::string phaseName = phase.str();
+    ++phaseActionAttempts[phaseName];
+    const bool duplicate = outcome.contains("duplicate");
+    if (materialized)
+      ++phaseActionMaterialized[phaseName];
+    if (duplicate)
+      ++phaseActionDeduplicated[phaseName];
+    if (legal)
+      ++phaseActionLegal[phaseName];
+    if (!legal && !duplicate)
+      ++phaseActionFailed[phaseName];
+    json::Object event{
+        {"schema", "orbit-search-action-attempt-v1"},
+        {"phase", phase.str()},
+        {"action", typedActionObject(action)},
+        {"action_signature", actionSignature(action)},
+        {"outcome", outcome.str()},
+        {"materialized", materialized},
+        {"accepted", legal},
+        {"legal", legal},
+        {"frozen_prefix_verified", freezeVerified}};
+    actionAttemptTraceLines.push_back(
+        jsonText(json::Value(std::move(event))) + "\n");
+  }
